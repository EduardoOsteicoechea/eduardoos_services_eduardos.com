PORT=
MONGODB_URI=
MONGO_DATABASE=
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
COOKIE_SECURE=
ENABLE_ADMIN_DIAGNOSTICS=
BOOTSTRAP_ADMIN_EMAIL=
# 8-128 characters when set.
BOOTSTRAP_ADMIN_PASSWORD=
ADMIN_EMAIL=
# 8-128 characters when set.
ADMIN_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=eduardooost@gmail.com
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=eduardooost@gmail.com
SMTP_FROM_NAME=Eduardoos
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=
DEEPSEEK_MODEL=
KIMI_API_KEY=
KIMI_API_BASE=
KIMI_MODEL=kimi-k3
MEDIA_ROOT=
# Production default resolves to /var/www/eduardoos.com/data/calvin-institutes-paragraphs
# when that directory exists (deploy syncs the pack there).
CALVIN_INSTITUTES_PARAGRAPHS_ROOT=
EREPORT_MEDIA_ROOT=
EREPORT_MAX_IMAGE_BYTES=
EREPORT_MAX_IMAGE_EDGE=
EREPORT_MAX_PAYLOAD_BYTES=
# eoProject media. Defaults: media root + /eoproject, 4 GiB video cap, 100 MiB doc cap.
EOPROJECT_MEDIA_ROOT=
EOPROJECT_MAX_VIDEO_BYTES=
EOPROJECT_MAX_DOCUMENT_BYTES=
EVOICE_MEDIA_ROOT=
EVOICE_PYTHON=
EVOICE_FAKE_TTS=
EVOICE_WORKER_SCRIPT=
# Global voice (speech-to-text + spoken replies). Off unless VOICE_ENABLED=true.
# When off, /api/voice/* is not registered (404) and the mic UI stays hidden.
VOICE_ENABLED=false
# Self-hosted Vosk STT worker (backend/voice-worker/stt_server.py) over loopback.
VOICE_STT_URL=http://127.0.0.1:8090
# Default transcription language: es or en.
VOICE_STT_LANG_DEFAULT=es
# Python that can import vosk (a venv for voice-worker). Empty -> python3.
VOICE_PYTHON=
# Piper + ffmpeg sentence synthesizer. Empty -> backend/voice-worker/speak.py.
VOICE_TTS_SCRIPT=
# Piper .onnx voice models. Required in production (per language).
VOICE_PIPER_MODEL_ES=
VOICE_PIPER_MODEL_EN=
# Max PCM bytes per chunk, max session seconds, max concurrent streams.
VOICE_MAX_CHUNK_BYTES=262144
VOICE_MAX_SESSION_SECONDS=300
VOICE_MAX_CONCURRENT=8
# Local/testing: skip the workers entirely (no Vosk/Piper installed).
VOICE_FAKE_STT=false
VOICE_FAKE_TTS=false
PUBLIC_BASE_URL=
