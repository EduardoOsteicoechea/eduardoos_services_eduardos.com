PORT=
MONGODB_URI=
MONGO_DATABASE=
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
COOKIE_SECURE=
ENABLE_ADMIN_DIAGNOSTICS=
BOOTSTRAP_ADMIN_EMAIL=
# 8-128 characters when set.
BOOTSTRAP_ADMIN_PASSWORD=
ADMIN_EMAIL=
# 8-128 characters when set.
ADMIN_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=eduardooost@gmail.com
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=eduardooost@gmail.com
SMTP_FROM_NAME=Eduardoos
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=
DEEPSEEK_MODEL=
KIMI_API_KEY=
KIMI_API_BASE=
KIMI_MODEL=kimi-k3
# Local development media lives under backend/.data/media. On the VPS the API
# anchors any relative root below to /var/www/<domain>/media so deploys never
# orphan uploads; set an absolute path only to override that location.
MEDIA_ROOT=.data/media
# Production default resolves to /var/www/eduardoos.com/data/calvin-institutes-paragraphs
# when that directory exists (deploy syncs the pack there).
CALVIN_INSTITUTES_PARAGRAPHS_ROOT=.data/calvin-institutes-paragraphs
# Defaults: MEDIA_ROOT/ereport; 8 MiB image/payload cap; 8192 px max edge.
EREPORT_MEDIA_ROOT=.data/media/ereport
EREPORT_MAX_IMAGE_BYTES=8388608
EREPORT_MAX_IMAGE_EDGE=8192
EREPORT_MAX_PAYLOAD_BYTES=8388608
# eoProject media. Defaults: media root + /eoproject, 4 GiB video cap, 100 MiB doc cap.
EOPROJECT_MEDIA_ROOT=.data/media/eoproject
EOPROJECT_MAX_VIDEO_BYTES=4294967296
EOPROJECT_MAX_DOCUMENT_BYTES=104857600
# eVoice (batch TTS). Local dev uses the fake runner; no Python/ffmpeg needed.
EVOICE_MEDIA_ROOT=.data/media/evoice
EVOICE_PYTHON=python3
EVOICE_FAKE_TTS=true
EVOICE_WORKER_SCRIPT=evoice-worker/linux_sync.py
# Global voice (speech-to-text + spoken replies). Set VOICE_ENABLED=false to disable.
# Local dev uses the fake workers so no Vosk/Piper install is needed; set both fakes
# to false and point the model paths at real files to run the self-hosted workers.
VOICE_ENABLED=true
VOICE_STT_URL=http://127.0.0.1:8090
VOICE_STT_LANG_DEFAULT=es
VOICE_PYTHON=python3
VOICE_TTS_SCRIPT=voice-worker/speak.py
VOICE_PIPER_MODEL_ES=voice-worker/models/es_ES-sharvard-medium.onnx
VOICE_PIPER_MODEL_EN=voice-worker/models/en_US-amy-medium.onnx
VOICE_MAX_CHUNK_BYTES=262144
VOICE_MAX_SESSION_SECONDS=300
VOICE_MAX_CONCURRENT=8
VOICE_FAKE_STT=true
VOICE_FAKE_TTS=true
PUBLIC_BASE_URL=http://127.0.0.1:4321
