---
/**
 * Pamphlet hub + editor host.
 * Pretty paths: /documents/pamphlet and /documents/pamphlet/{view}.
 * Legacy ?view= is rewritten client-side so old links keep working.
 */
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="EPAM"
  description="Cloud EPAM editor, .epam documents, and print export."
  page="pamphlet"
  robots="noindex,nofollow"
>
  <span slot="dhs" hidden></span>

  <section id="pamphlet-dash" class="pamphlet-vanilla-dash" aria-label="EPAM">
    <section class="pamphlet-vanilla-dash__recents" data-dashboard-recents>
      <h2 class="pamphlet-vanilla-dash__section-title">Recent EPAMs</h2>
      <div class="pamphlet-vanilla-dash__recents-grid" data-dashboard-recent-cards></div>
      <p class="pamphlet-vanilla-dash__hint" data-dashboard-recents-empty hidden>
        No recent EPAMs yet. Create one to get started.
      </p>
    </section>

    <section class="pamphlet-vanilla-dash__options" aria-labelledby="pamphlet-options-title">
      <h2 class="pamphlet-vanilla-dash__section-title" id="pamphlet-options-title">EPAM options</h2>
      <div class="pamphlet-vanilla-dash__grid">
        <a class="pamphlet-vanilla-dash__card" href="/documents/pamphlet/new" data-pamphlet-nav="new">
          <span class="material-symbols-outlined" aria-hidden="true">note_add</span>
          <span class="pamphlet-vanilla-dash__card-title">New</span>
          <span class="pamphlet-vanilla-dash__card-desc">Create a new EPAM.</span>
        </a>
        <a class="pamphlet-vanilla-dash__card" href="/documents/pamphlet/open" data-pamphlet-nav="open">
          <span class="material-symbols-outlined" aria-hidden="true">folder_open</span>
          <span class="pamphlet-vanilla-dash__card-title">Open</span>
          <span class="pamphlet-vanilla-dash__card-desc">Open a cloud or local .epam.</span>
        </a>
        <a class="pamphlet-vanilla-dash__card" href="/documents/pamphlet/recent" data-pamphlet-nav="recent">
          <span class="material-symbols-outlined" aria-hidden="true">history</span>
          <span class="pamphlet-vanilla-dash__card-title">Recent</span>
          <span class="pamphlet-vanilla-dash__card-desc">Continue a recent EPAM.</span>
        </a>
        <a class="pamphlet-vanilla-dash__card" href="/documents/pamphlet/manage" data-pamphlet-nav="manage">
          <span class="material-symbols-outlined" aria-hidden="true">folder_managed</span>
          <span class="pamphlet-vanilla-dash__card-title">Manage</span>
          <span class="pamphlet-vanilla-dash__card-desc">Hide, delete, or edit headers and footers.</span>
        </a>
        <a class="pamphlet-vanilla-dash__card" href="/documents/pamphlet/series" data-pamphlet-nav="series">
          <span class="material-symbols-outlined" aria-hidden="true">account_tree</span>
          <span class="pamphlet-vanilla-dash__card-title">Series</span>
          <span class="pamphlet-vanilla-dash__card-desc">Create series, chapters, authors; manage articles.</span>
        </a>
        <a class="pamphlet-vanilla-dash__card" href="/documents/pamphlet/footers" data-pamphlet-nav="footers">
          <span class="material-symbols-outlined" aria-hidden="true">vertical_align_bottom</span>
          <span class="pamphlet-vanilla-dash__card-title">Footers</span>
          <span class="pamphlet-vanilla-dash__card-desc">Footer profiles.</span>
        </a>
      </div>
    </section>
  </section>

  <section id="pamphlet-manage" class="pamphlet-manage" aria-label="Manage EPAMs" hidden>
    <header class="pamphlet-manage__head">
      <a class="pamphlet-manage__back" href="/documents/pamphlet" data-pamphlet-nav="dashboard">← Back to EPAM</a>
      <p class="pamphlet-manage__hint" data-manage-hint>Select a cloud pamphlet to hide from Articles, delete, or edit its header and footer.</p>
      <p class="pamphlet-manage__status" data-manage-status hidden></p>
    </header>

    <div class="pamphlet-manage__layout">
      <section class="pamphlet-manage__list-panel" aria-label="Cloud pamphlets">
        <h2 class="pamphlet-manage__section-title">Cloud EPAMs</h2>
        <div class="pamphlet-manage__list" data-manage-list role="list"></div>
      </section>

      <section class="pamphlet-manage__detail product-dash__card" data-manage-detail hidden>
        <h2 class="pamphlet-manage__section-title" data-manage-detail-title>Selected pamphlet</h2>
        <label class="pamphlet-manage__toggle">
          <input type="checkbox" data-manage-public />
          Visible in Articles
        </label>
        <form class="pamphlet-manage__chrome-form" data-manage-chrome-form>
          <fieldset>
            <legend>Header</legend>
            <label>Title <input data-manage-header-title name="title" type="text" autocomplete="off" /></label>
            <label>Subtitle <input data-manage-header-subtitle name="subtitle" type="text" autocomplete="off" /></label>
            <label>Author
              <select data-manage-header-author name="author">
                <option value="">Sin autor</option>
              </select>
            </label>
            <label>Series
              <select data-manage-header-series name="series">
                <option value="">Sin serie</option>
              </select>
            </label>
            <label>Chapter
              <select data-manage-header-chapter name="series_chapter">
                <option value="">Sin capítulo</option>
              </select>
            </label>
            <p class="pamphlet-manage__hint" data-manage-header-date-display>Date follows last update (yyyy - mm - dd).</p>
          </fieldset>
          <fieldset>
            <legend>Footer</legend>
            <label>Action <input data-manage-footer-action name="action" type="text" autocomplete="off" /></label>
            <label>Message <input data-manage-footer-message name="message" type="text" autocomplete="off" /></label>
            <label>Label 1 <input data-manage-footer-label1 name="label1" type="text" autocomplete="off" placeholder="WhatsApp:" /></label>
            <label>Value 1 <input data-manage-footer-value1 name="value1" type="text" autocomplete="off" /></label>
            <label>Label 2 <input data-manage-footer-label2 name="label2" type="text" autocomplete="off" placeholder="Teléfono:" /></label>
            <label>Value 2 <input data-manage-footer-value2 name="value2" type="text" autocomplete="off" /></label>
            <label>Label 3 <input data-manage-footer-label3 name="label3" type="text" autocomplete="off" placeholder="Dirección:" /></label>
            <label>Value 3 <input data-manage-footer-value3 name="value3" type="text" autocomplete="off" /></label>
            <label>Label 4 <input data-manage-footer-label4 name="label4" type="text" autocomplete="off" placeholder="Actividades:" /></label>
            <label>Value 4 <input data-manage-footer-value4 name="value4" type="text" autocomplete="off" /></label>
          </fieldset>
          <div class="pamphlet-manage__actions">
            <button type="submit">Save header &amp; footer</button>
            <button type="button" data-manage-delete>Delete</button>
          </div>
        </form>
      </section>
    </div>

    <section class="pamphlet-manage__profiles" aria-labelledby="manage-profiles-title">
      <h2 class="pamphlet-manage__section-title" id="manage-profiles-title">Footer profiles</h2>
      <p class="pamphlet-manage__hint">Create reusable footers. With a pamphlet selected, Copy or Link applies it.</p>
      <div class="pamphlet-manage__profile-list" data-manage-profile-list></div>
      <form class="pamphlet-manage__profile-form product-dash__card" data-manage-profile-form>
        <input type="hidden" data-manage-profile-id value="" />
        <label>Name <input data-manage-profile-name name="name" type="text" required autocomplete="off" /></label>
        <label>Action <input data-manage-profile-action name="action" type="text" autocomplete="off" /></label>
        <label>Message <input data-manage-profile-message name="message" type="text" autocomplete="off" /></label>
        <label>Label 1 <input data-manage-profile-label1 name="label1" type="text" autocomplete="off" placeholder="WhatsApp:" /></label>
        <label>Value 1 <input data-manage-profile-value1 name="value1" type="text" autocomplete="off" /></label>
        <label>Label 2 <input data-manage-profile-label2 name="label2" type="text" autocomplete="off" placeholder="Teléfono:" /></label>
        <label>Value 2 <input data-manage-profile-value2 name="value2" type="text" autocomplete="off" /></label>
        <label>Label 3 <input data-manage-profile-label3 name="label3" type="text" autocomplete="off" placeholder="Dirección:" /></label>
        <label>Value 3 <input data-manage-profile-value3 name="value3" type="text" autocomplete="off" /></label>
        <label>Label 4 <input data-manage-profile-label4 name="label4" type="text" autocomplete="off" placeholder="Actividades:" /></label>
        <label>Value 4 <input data-manage-profile-value4 name="value4" type="text" autocomplete="off" /></label>
        <div class="pamphlet-manage__actions">
          <button type="button" data-manage-profile-reset>New</button>
          <button type="button" data-manage-profile-from-doc>Use selected footer</button>
          <button type="submit">Save profile</button>
        </div>
      </form>
    </section>
  </section>

  <section id="pamphlet-series" class="pamphlet-manage" aria-label="Series catalog" hidden>
    <header class="pamphlet-manage__head">
      <a class="pamphlet-manage__back" href="/documents/pamphlet" data-pamphlet-nav="dashboard">← Back to EPAM</a>
      <p class="pamphlet-manage__hint" data-series-hint>Create authors and series. Pamphlets pick them from dropdowns in Manage and the editor.</p>
      <p class="pamphlet-manage__status" data-series-status hidden></p>
    </header>

    <section class="pamphlet-manage__profiles" aria-labelledby="series-authors-title">
      <h2 class="pamphlet-manage__section-title" id="series-authors-title">Authors</h2>
      <div class="pamphlet-manage__profile-list" data-series-authors></div>
      <form class="pamphlet-manage__profile-form product-dash__card" data-series-author-form>
        <input type="hidden" data-series-author-id value="" />
        <label>Name <input data-series-author-name name="name" type="text" required autocomplete="off" /></label>
        <div class="pamphlet-manage__actions">
          <button type="button" data-series-author-reset>New</button>
          <button type="submit">Save author</button>
        </div>
      </form>
    </section>

    <section class="pamphlet-manage__profiles" aria-labelledby="series-catalog-title">
      <h2 class="pamphlet-manage__section-title" id="series-catalog-title">Series &amp; chapters</h2>
      <p class="pamphlet-manage__hint">Chapters: comma-separated names.</p>
      <div class="pamphlet-manage__profile-list" data-series-catalog></div>
      <form class="pamphlet-manage__profile-form product-dash__card" data-series-form>
        <input type="hidden" data-series-id value="" />
        <label>Series name <input data-series-name name="name" type="text" required autocomplete="off" /></label>
        <label>Chapters <input data-series-chapters name="chapters" type="text" autocomplete="off" placeholder="1, 2, Intro" /></label>
        <div class="pamphlet-manage__actions">
          <button type="button" data-series-reset>New</button>
          <button type="submit">Save series</button>
        </div>
      </form>
    </section>

    <section class="pamphlet-manage__list-panel" aria-labelledby="series-articles-title">
      <h2 class="pamphlet-manage__section-title" id="series-articles-title">Articles by series</h2>
      <p class="pamphlet-manage__hint">Show/hide in Articles or delete pamphlets.</p>
      <div class="pamphlet-manage__list" data-series-articles role="list"></div>
    </section>
  </section>

  <div id="pamphlet-root" class="pamphlet-route-root pamphlet-layout-workspace" hidden></div>
</Layout>

<style is:global>
  .pamphlet-vanilla-dash {
    display: flex;
    flex-direction: column;
    gap: var(--space-padding);
    /* Shell main already supplies --main-inline / --main-padding. */
    padding: 0;
    color: var(--color-text);
  }

  .pamphlet-vanilla-dash[hidden] {
    display: none;
  }

  .pamphlet-vanilla-dash__section-title {
    margin: 0;
    font-size: var(--font-size-md);
    font-weight: 650;
  }

  .pamphlet-vanilla-dash__hint {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }

  .pamphlet-vanilla-dash__recents,
  .pamphlet-vanilla-dash__options {
    display: flex;
    flex-direction: column;
    gap: var(--space-padding);
    width: auto;
    min-width: 0;
  }

  .pamphlet-vanilla-dash__recents-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-padding);
    margin: 0;
    padding: 0;
  }

  .pamphlet-vanilla-dash__recent-card {
    min-height: calc(var(--control-height) * 4);
    text-decoration: none;
  }

  .pamphlet-vanilla-dash__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: var(--space-padding);
  }

  @media (max-width: 63.999rem) {
    .pamphlet-vanilla-dash__recents-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 47.999rem) {
    .pamphlet-vanilla-dash__recents-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .pamphlet-vanilla-dash__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-padding);
    padding: var(--space-padding);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    cursor: pointer;
  }

  .pamphlet-vanilla-dash__card:hover {
    border-color: var(--color-accent);
  }

  .pamphlet-vanilla-dash__card .material-symbols-outlined {
    font-size: var(--icon-size);
  }

  .pamphlet-vanilla-dash__card-title {
    font-size: var(--font-size-md);
    font-weight: 600;
  }

  .pamphlet-vanilla-dash__card-desc {
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }

  .pamphlet-route-root {
    box-sizing: border-box;
    width: auto;
    min-height: 24rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pamphlet-route-root[hidden] {
    display: none;
  }

  .pamphlet-manage {
    display: flex;
    flex-direction: column;
    gap: var(--space-padding);
    color: var(--color-text);
  }

  .pamphlet-manage[hidden] {
    display: none;
  }

  .pamphlet-manage__head,
  .pamphlet-manage__layout,
  .pamphlet-manage__profiles,
  .pamphlet-manage__list-panel,
  .pamphlet-manage__detail,
  .pamphlet-manage__chrome-form,
  .pamphlet-manage__profile-form,
  .pamphlet-manage__profile-list,
  .pamphlet-manage__chapter-items,
  .pamphlet-manage__actions,
  .pamphlet-manage__profile-actions {
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
  }

  .pamphlet-manage__back {
    color: var(--color-link);
    font-size: var(--font-size-sm);
    width: fit-content;
  }

  .pamphlet-manage__hint,
  .pamphlet-manage__item-meta,
  .pamphlet-manage__profile-meta,
  .pamphlet-manage__empty {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }

  .pamphlet-manage__status {
    margin: 0;
    font-size: var(--font-size-sm);
  }

  .pamphlet-manage__status[data-kind="success"] {
    color: var(--color-ok);
  }

  .pamphlet-manage__status[data-kind="error"] {
    color: var(--color-err);
  }

  .pamphlet-manage__section-title {
    margin: 0;
    font-size: var(--font-size-md);
    font-weight: 650;
  }

  .pamphlet-manage__item {
    align-items: flex-start;
    text-align: left;
    cursor: pointer;
  }

  .pamphlet-manage__item.is-selected,
  .pamphlet-manage__profile.is-current {
    border-color: var(--color-accent);
    outline: var(--border-width) solid var(--color-accent);
  }

  .pamphlet-manage__item-title,
  .pamphlet-manage__profile-name {
    margin: 0;
    font-size: var(--font-size-sm);
    font-weight: 650;
  }

  .pamphlet-manage__toggle {
    display: flex;
    align-items: center;
    gap: var(--rail-gap);
    font-size: var(--font-size-sm);
  }

  .pamphlet-manage__chrome-form fieldset,
  .pamphlet-manage__profile-form {
    margin: 0;
    padding: var(--space-padding);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius);
  }

  .pamphlet-manage__chrome-form legend {
    font-size: var(--font-size-sm);
    font-weight: 650;
    padding-inline: var(--control-padding-inline);
  }

  .pamphlet-manage__chrome-form label,
  .pamphlet-manage__profile-form label {
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
    font-size: var(--font-size-xs);
  }

  .pamphlet-manage__chrome-form input,
  .pamphlet-manage__profile-form input,
  .pamphlet-manage__actions button,
  .pamphlet-manage__profile-actions button {
    height: var(--control-height);
    padding: var(--control-padding-block) var(--control-padding-inline);
    font-size: var(--font-size-sm);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius);
    background: var(--color-bg);
    color: var(--color-text);
  }

  .pamphlet-manage__actions,
  .pamphlet-manage__profile-actions {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .pamphlet-manage__list {
    display: flex;
    flex-direction: column;
    gap: calc(var(--space-padding) * 2);
  }

  .pamphlet-manage__series,
  .pamphlet-manage__chapter {
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius);
    padding: var(--space-padding);
    display: flex;
    flex-direction: column;
    gap: var(--space-padding);
  }

  .pamphlet-manage__series + .pamphlet-manage__series {
    margin-top: 0;
  }

  .pamphlet-manage__series summary,
  .pamphlet-manage__chapter summary {
    cursor: pointer;
    font-size: var(--font-size-sm);
    font-weight: 650;
  }

  @media (min-width: 48rem) {
    .pamphlet-manage__layout {
      flex-direction: row;
      align-items: flex-start;
    }

    .pamphlet-manage__list-panel,
    .pamphlet-manage__detail {
      flex: 1;
      min-width: 0;
    }
  }
</style>

<script>
  import { fetchEpams } from "../../lib/epams";
  import { mountPamphletManagePage } from "../../lib/pamphletManagePage";
  import type { PamphletManageHandle } from "../../lib/pamphletManagePage";
  import { mountPamphletSeriesPage } from "../../lib/pamphletSeriesPage";
  import type { PamphletSeriesHandle } from "../../lib/pamphletSeriesPage";
  import { mountPamphletGenerator } from "../../lib/pamphlet-generator/src/index.ts";
  import type { PamphletMountHandle } from "../../lib/pamphlet-generator/src/index.ts";
  import { pushClientUrl, replaceClientUrl } from "../../lib/router";

  const PAMPHLET_BASE = "/documents/pamphlet";
  const PAMPHLET_VIEWS = new Set(["new", "open", "recent", "manage", "series", "footers", "edit"]);

  let handle: PamphletMountHandle | null = null;
  let manageHandle: PamphletManageHandle | null = null;
  let seriesHandle: PamphletSeriesHandle | null = null;

  function formatEpamDate(value: string | undefined): string {
    if (!value) return "";
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return "";
    return d.toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" });
  }

  async function loadDashboardRecents(): Promise<void> {
    const dash = document.getElementById("pamphlet-dash");
    if (!dash || dash.hidden) return;
    const grid = dash.querySelector("[data-dashboard-recent-cards]");
    const empty = dash.querySelector("[data-dashboard-recents-empty]");
    if (!(grid instanceof HTMLElement)) return;

    try {
      const { epams } = await fetchEpams();
      const items = [...epams]
        .sort((a, b) => Date.parse(b.updatedAt || "") - Date.parse(a.updatedAt || ""))
        .slice(0, 5);
      grid.replaceChildren();
      if (empty instanceof HTMLElement) empty.hidden = items.length > 0;
      for (const epam of items) {
        const card = document.createElement("a");
        card.className = "pamphlet-vanilla-dash__card pamphlet-vanilla-dash__recent-card";
        // Use /open#id — a real static page. /e/{id} needs Nginx rewrite; without it the VPS serves home HTML.
        card.href = `${PAMPHLET_BASE}/open#${encodeURIComponent(epam.epamId)}`;
        card.dataset.pamphletOpen = epam.epamId;
        card.setAttribute("data-astro-reload", "");
        card.title = epam.title || epam.fileName || epam.epamId;

        const title = document.createElement("span");
        title.className = "pamphlet-vanilla-dash__card-title";
        title.textContent = epam.title || epam.fileName || "Untitled pamphlet";

        const meta = document.createElement("span");
        meta.className = "pamphlet-vanilla-dash__card-desc";
        const when = formatEpamDate(epam.updatedAt);
        meta.textContent = when ? `Updated ${when}` : (epam.series || "Cloud pamphlet");

        card.append(title, meta);
        grid.append(card);
      }
    } catch {
      grid.replaceChildren();
      if (empty instanceof HTMLElement) {
        empty.hidden = false;
        empty.textContent = "Could not load recent pamphlets.";
      }
    }
  }

  function pamphletPath(view: string): string {
    if (!view || view === "dashboard") return PAMPHLET_BASE;
    return `${PAMPHLET_BASE}/${view}`;
  }

  /** Prefer /documents/pamphlet/{view}; migrate legacy ?view= so reloads stay deep-linked. */
  function normalizeLegacyQuery(): void {
    const url = new URL(window.location.href);
    const legacy = url.searchParams.get("view")?.trim().toLowerCase() || "";
    if (!legacy) return;
    url.searchParams.delete("view");
    url.pathname = pamphletPath(legacy);
    replaceClientUrl(url.toString());
  }

  function readRoute(): { view: string; epamId: string } {
    const path = window.location.pathname.replace(/\/+$/, "") || "/";
    if (path === PAMPHLET_BASE) return { view: "dashboard", epamId: "" };
    const editMatch = new RegExp(`^${PAMPHLET_BASE}/e/([^/]+)$`).exec(path);
    if (editMatch) {
      try {
        return { view: "edit", epamId: decodeURIComponent(editMatch[1]) };
      } catch {
        return { view: "edit", epamId: editMatch[1] };
      }
    }
    if (path.startsWith(`${PAMPHLET_BASE}/`)) {
      const seg = path.slice(PAMPHLET_BASE.length + 1).split("/")[0]?.toLowerCase() || "";
      if (PAMPHLET_VIEWS.has(seg)) {
        const hash = seg === "open" ? window.location.hash.slice(1).trim() : "";
        try {
          return { view: hash ? "edit" : seg, epamId: hash ? decodeURIComponent(hash) : "" };
        } catch {
          return { view: hash ? "edit" : seg, epamId: hash };
        }
      }
    }
    const legacy = new URLSearchParams(window.location.search).get("view");
    if (legacy && legacy.trim()) return { view: legacy.trim().toLowerCase(), epamId: "" };
    return { view: "dashboard", epamId: "" };
  }

  function setViewInUrl(view: string): void {
    const url = new URL(window.location.href);
    url.searchParams.delete("view");
    url.pathname = pamphletPath(view);
    pushClientUrl(url.toString());
  }

  function destroyEditor(): void {
    handle?.destroy();
    handle = null;
    const host = document.getElementById("pamphlet-root");
    if (host) host.replaceChildren();
  }

  function clearBleed(): void {
    document.documentElement.classList.remove("layout-editor-bleed", "page-pamphlet");
    document.body.classList.remove("page-pamphlet");
  }

  function applyBleed(): void {
    document.documentElement.classList.add("layout-editor-bleed", "page-pamphlet");
    document.body.classList.add("page-pamphlet");
  }

  function destroyManage(): void {
    manageHandle?.destroy();
    manageHandle = null;
  }

  function destroySeries(): void {
    seriesHandle?.destroy();
    seriesHandle = null;
  }

  function hideAllSurfaces(): void {
    const dash = document.getElementById("pamphlet-dash");
    const manage = document.getElementById("pamphlet-manage");
    const series = document.getElementById("pamphlet-series");
    const host = document.getElementById("pamphlet-root");
    if (dash) dash.hidden = true;
    if (manage) manage.hidden = true;
    if (series) series.hidden = true;
    if (host) host.hidden = true;
  }

  function showDashboard(): void {
    destroyEditor();
    destroyManage();
    destroySeries();
    clearBleed();
    hideAllSurfaces();
    const dash = document.getElementById("pamphlet-dash");
    if (dash) dash.hidden = false;
    void loadDashboardRecents();
  }

  function showManage(): void {
    destroyEditor();
    destroyManage();
    destroySeries();
    clearBleed();
    hideAllSurfaces();
    const manage = document.getElementById("pamphlet-manage");
    if (!manage) {
      console.error("[pamphlet] missing #pamphlet-manage");
      return;
    }
    manage.hidden = false;
    try {
      manageHandle = mountPamphletManagePage(manage);
    } catch (err) {
      console.error("[pamphlet] manage mount failed", err);
      const message = err instanceof Error ? err.message : String(err);
      manage.textContent = `Could not open manage page: ${message}`;
    }
  }

  function showSeries(): void {
    destroyEditor();
    destroyManage();
    destroySeries();
    clearBleed();
    hideAllSurfaces();
    const series = document.getElementById("pamphlet-series");
    if (!series) {
      console.error("[pamphlet] missing #pamphlet-series");
      return;
    }
    series.hidden = false;
    try {
      seriesHandle = mountPamphletSeriesPage(series);
    } catch (err) {
      console.error("[pamphlet] series mount failed", err);
      const message = err instanceof Error ? err.message : String(err);
      series.textContent = `Could not open series page: ${message}`;
    }
  }

  function showEditor(view: string, epamId = ""): void {
    const host = document.getElementById("pamphlet-root");
    if (!host) {
      console.error("[pamphlet] missing #pamphlet-root");
      return;
    }

    destroyEditor();
    destroyManage();
    destroySeries();
    hideAllSurfaces();
    host.hidden = false;
    applyBleed();

    host.dataset.pamphletView = view;
    if (epamId) host.dataset.pamphletEpamId = epamId;
    else delete host.dataset.pamphletEpamId;
    window.__eduardoosPamphletView = view;
    window.__eduardoosPamphletEpamId = epamId || undefined;

    try {
      handle = mountPamphletGenerator(host);
    } catch (err) {
      console.error("[pamphlet] mount failed", err);
      const message = err instanceof Error ? err.message : String(err);
      host.textContent = `Could not open pamphlet editor: ${message}`;
    }
  }

  function syncFromUrl(): void {
    const { view, epamId } = readRoute();
    if (view === "dashboard") showDashboard();
    else if (view === "manage") showManage();
    else if (view === "series") showSeries();
    else showEditor(view, epamId);
  }

  function onClick(event: Event): void {
    const el = event.target;
    if (!(el instanceof Element)) return;

    const open = el.closest<HTMLAnchorElement>("[data-pamphlet-open]");
    if (open) {
      event.preventDefault();
      const epamId = (open.dataset.pamphletOpen || "").trim();
      if (!epamId) return;
      const url = new URL(window.location.href);
      url.searchParams.delete("view");
      url.pathname = `${PAMPHLET_BASE}/open`;
      url.hash = encodeURIComponent(epamId);
      pushClientUrl(url.toString());
      showEditor("edit", epamId);
      return;
    }

    const nav = el.closest<HTMLAnchorElement>("[data-pamphlet-nav]");
    if (!nav) return;
    event.preventDefault();
    const view = (nav.dataset.pamphletNav || "new").toLowerCase();
    if (view === "dashboard") {
      setViewInUrl("dashboard");
      showDashboard();
      return;
    }
    setViewInUrl(view);
    if (view === "manage") showManage();
    else if (view === "series") showSeries();
    else showEditor(view);
  }

  function boot(): void {
    normalizeLegacyQuery();
    const onPageLoad = () => {
      normalizeLegacyQuery();
      syncFromUrl();
    };
    const onBeforeSwap = () => {
      destroyEditor();
      destroyManage();
      destroySeries();
      clearBleed();
      document.removeEventListener("click", onClick);
      window.removeEventListener("popstate", syncFromUrl);
      document.removeEventListener("astro:page-load", onPageLoad);
      document.removeEventListener("astro:before-swap", onBeforeSwap);
    };
    document.addEventListener("click", onClick);
    window.addEventListener("popstate", syncFromUrl);
    document.addEventListener("astro:page-load", onPageLoad);
    document.addEventListener("astro:before-swap", onBeforeSwap);
    syncFromUrl();
  }

  boot();

  declare global {
    interface Window {
      __eduardoosPamphletView?: string;
      __eduardoosPamphletEpamId?: string;
    }
  }
</script>
