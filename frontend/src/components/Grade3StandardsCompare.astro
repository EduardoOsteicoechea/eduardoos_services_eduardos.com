---
import {
  FIT_LABEL,
  GRADE3_STANDARDS_CROSSWALK,
  type Grade3CrosswalkRow,
} from "../lib/eoschool-grade3-standards-crosswalk";
import { GRADE3_PROGRAM_GAPS } from "../lib/eoschool-grade3-gaps";
import {
  STANDARDS_PROGRESS_THROUGH_DAY,
  foreignStars,
  learningsCoveredThroughDay,
  venezuelaStars,
} from "../lib/eoschool-grade3-standards-score";

interface Props {
  mode?: "compare" | "gaps";
}

const { mode = "compare" } = Astro.props;
const gaps = mode === "gaps";
const viewName = gaps ? "gaps-area" : "standards-area";
const viewId = gaps ? "gaps" : "standards";
const { areas } = gaps ? GRADE3_PROGRAM_GAPS : GRADE3_STANDARDS_CROSSWALK;
const covered = learningsCoveredThroughDay(STANDARDS_PROGRESS_THROUGH_DAY);
const tones = ["a", "b", "c", "d"] as const;
const starSlots = [0, 1, 2, 3, 4];

type RatedRow = Grade3CrosswalkRow & {
  tone: (typeof tones)[number];
  covered: boolean;
  vzlaStars: number;
  usStars: number;
  ukStars: number;
  bestVzla: boolean;
  bestUs: boolean;
  bestUk: boolean;
};

function groupsOf(rows: RatedRow[]) {
  const groups: { title: string; rows: RatedRow[] }[] = [];
  for (const row of rows) {
    const last = groups[groups.length - 1];
    if (last && last.title === row.unitTitle) last.rows.push(row);
    else groups.push({ title: row.unitTitle, rows: [row] });
  }
  return groups;
}

const panels = areas.map((area) => {
  const rows: RatedRow[] = area.rows.map((row, index) => {
    const vzlaStars = gaps ? 0 : venezuelaStars(row.us, row.uk);
    const usStars = foreignStars(row.us);
    const ukStars = foreignStars(row.uk);
    const best = Math.max(vzlaStars, usStars, ukStars);
    return {
      ...row,
      tone: tones[index % tones.length],
      covered: covered.has(row.learning),
      vzlaStars,
      usStars,
      ukStars,
      bestVzla: !gaps && vzlaStars === best,
      bestUs: usStars === best,
      bestUk: ukStars === best,
    };
  });
  return { ...area, groups: groupsOf(rows) };
});

function starLabel(count: number, best: boolean) {
  return best ? `${count} de 5. La mejor de la fila.` : `${count} de 5.`;
}
---

<div class="standards-compare">
  {
    panels.map((area, index) => (
      <input
        class="standards-rail__input"
        type="radio"
        name={viewName}
        id={`${viewId}-${area.id}`}
        data-area={area.id}
        checked={index === 0}
      />
    ))
  }
  <nav class="standards-rail" aria-label="Materias">
    {
      panels.map((area) => (
        <label class="standards-rail__btn" for={`${viewId}-${area.id}`} data-area={area.id} title={area.title}>
          <span class="material-symbols-outlined" aria-hidden="true">{area.icon}</span>
          <span class="page-title-sr">{area.title}</span>
        </label>
      ))
    }
  </nav>

  <div class="standards-body">
    <div class="standards-main">
      {
        panels.map((area) => (
          <section class="standards-panel" data-area={area.id} aria-label={area.title}>
            {
              area.groups.map((group) => (
                <section class="standards-unit">
                  <h3 class="standards-unit__title">{group.title}</h3>
                  {
                    group.rows.map((row) => (
                      <div class:list={["standards-row", `standards-row--${row.tone}`]}>
                        <div class="standards-row__cards">
                          <article class:list={["product-dash__card", "standards-card", row.bestVzla && "standards-card--best"]}>
                            <p class="standards-card__place">Venezuela</p>
                            <p class="standards-card__text">{row.learning}</p>
                            <p class="standards-stars" aria-label={starLabel(row.vzlaStars, row.bestVzla)}>
                              {starSlots.map((slot) => (
                                <span class:list={["material-symbols-outlined", "standards-star", slot < row.vzlaStars && "standards-star--on"]} aria-hidden="true">star</span>
                              ))}
                            </p>
                          </article>
                          <article class:list={["product-dash__card", "standards-card", row.bestUs && "standards-card--best"]}>
                            <p class="standards-card__place">Estados Unidos</p>
                            <a class="standards-card__code" href={row.us.href} rel="noopener noreferrer">{row.us.code}</a>
                            <p class="standards-card__text">{row.us.text}</p>
                            <span class:list={["standards-fit", `standards-fit--${row.us.fit}`]}>{FIT_LABEL[row.us.fit]}</span>
                            <p class="standards-stars" aria-label={starLabel(row.usStars, row.bestUs)}>
                              {starSlots.map((slot) => (
                                <span class:list={["material-symbols-outlined", "standards-star", slot < row.usStars && "standards-star--on"]} aria-hidden="true">star</span>
                              ))}
                            </p>
                          </article>
                          <article class:list={["product-dash__card", "standards-card", row.bestUk && "standards-card--best"]}>
                            <p class="standards-card__place">Inglaterra</p>
                            <a class="standards-card__code" href={row.uk.href} rel="noopener noreferrer">{row.uk.code}</a>
                            <p class="standards-card__text">{row.uk.text}</p>
                            <span class:list={["standards-fit", `standards-fit--${row.uk.fit}`]}>{FIT_LABEL[row.uk.fit]}</span>
                            <p class="standards-stars" aria-label={starLabel(row.ukStars, row.bestUk)}>
                              {starSlots.map((slot) => (
                                <span class:list={["material-symbols-outlined", "standards-star", slot < row.ukStars && "standards-star--on"]} aria-hidden="true">star</span>
                              ))}
                            </p>
                          </article>
                        </div>
                        <p class="standards-row__mark">
                          {!gaps && row.covered ? (
                            <span class="material-symbols-outlined" aria-hidden="true">check</span>
                          ) : null}
                          <span class="page-title-sr">
                            {gaps
                              ? "No está en el programa de Venezuela"
                              : row.covered
                                ? `Visto hasta el día ${STANDARDS_PROGRESS_THROUGH_DAY}`
                                : "Todavía no está en el plan"}
                          </span>
                        </p>
                      </div>
                    ))
                  }
                </section>
              ))
            }
          </section>
        ))
      }
    </div>

    {!gaps && (
    <footer class="standards-sources">
      <h2 class="product-dash__section-title">Fuentes</h2>
      <ul>
        {
          GRADE3_STANDARDS_CROSSWALK.meta.sources.map((source) => (
            <li>
              <a
                href={source.href}
                rel={source.href.startsWith("https://") ? "noopener noreferrer" : undefined}
                data-route={source.href.startsWith("/") ? true : undefined}
              >{source.title}</a>
              <span>{source.note}</span>
            </li>
          ))
        }
      </ul>
    </footer>
    )}
  </div>
</div>

<style>
  .standards-compare {
    display: flex;
    align-items: flex-start;
    gap: var(--rail-gap);
    padding-left: var(--space-padding);
  }

  .standards-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-padding);
    flex: 1;
    min-width: 0;
  }

  .standards-rail__input {
    position: absolute;
    width: 0.0625rem;
    height: 0.0625rem;
    padding: 0;
    margin: -0.0625rem;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .standards-rail {
    position: sticky;
    top: var(--space-padding);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--rail-gap);
    width: 3.125rem;
    flex: 0 0 3.125rem;
    padding-left: 0;
    padding-right: 0;
  }

  .standards-rail__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--button-size);
    height: var(--button-size);
    margin: 0;
    padding: 0;
    color: var(--color-text);
    background: transparent;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius);
    cursor: pointer;
  }

  .standards-rail__btn .material-symbols-outlined {
    font-size: var(--icon-size);
  }

  .standards-rail__input[data-area="len"]:checked ~ .standards-rail label[data-area="len"],
  .standards-rail__input[data-area="mat"]:checked ~ .standards-rail label[data-area="mat"],
  .standards-rail__input[data-area="cie"]:checked ~ .standards-rail label[data-area="cie"],
  .standards-rail__input[data-area="ide"]:checked ~ .standards-rail label[data-area="ide"],
  .standards-rail__input[data-area="len"]:focus-visible ~ .standards-rail label[data-area="len"],
  .standards-rail__input[data-area="mat"]:focus-visible ~ .standards-rail label[data-area="mat"],
  .standards-rail__input[data-area="cie"]:focus-visible ~ .standards-rail label[data-area="cie"],
  .standards-rail__input[data-area="ide"]:focus-visible ~ .standards-rail label[data-area="ide"] {
    color: var(--color-bg);
    background: var(--color-text);
    border-color: var(--color-text);
  }

  .standards-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-padding);
    min-width: 0;
  }

  .standards-panel {
    display: none;
    flex-direction: column;
    gap: var(--space-padding);
  }

  .standards-rail__input[data-area="len"]:checked ~ .standards-body .standards-panel[data-area="len"],
  .standards-rail__input[data-area="mat"]:checked ~ .standards-body .standards-panel[data-area="mat"],
  .standards-rail__input[data-area="cie"]:checked ~ .standards-body .standards-panel[data-area="cie"],
  .standards-rail__input[data-area="ide"]:checked ~ .standards-body .standards-panel[data-area="ide"] {
    display: flex;
  }

  .standards-unit {
    display: flex;
    flex-direction: column;
  }

  .standards-unit__title {
    margin: calc(var(--space-padding) * 2) 0 var(--space-padding);
    padding: 0 var(--space-padding);
    font-size: var(--font-size-sm);
    font-weight: 650;
  }

  .standards-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: stretch;
    gap: var(--rail-gap);
    padding: var(--rail-gap) var(--space-padding);
    border-bottom: var(--border-width) solid color-mix(in srgb, var(--color-text) 22%, var(--color-border));
  }

  .standards-row--a {
    background: color-mix(in srgb, #d7e6f8 78%, var(--color-bg));
  }

  .standards-row--b {
    background: color-mix(in srgb, #d9f3e6 78%, var(--color-bg));
  }

  .standards-row--c {
    background: color-mix(in srgb, #f8ebc8 78%, var(--color-bg));
  }

  .standards-row--d {
    background: color-mix(in srgb, #f7d9e6 78%, var(--color-bg));
  }

  .standards-row__cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: calc(var(--space-padding) + var(--rail-gap));
    min-width: 0;
  }

  .standards-row__mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--button-size);
    margin: 0;
    color: var(--color-text);
  }

  .standards-row__mark .material-symbols-outlined {
    font-size: var(--icon-size);
    font-variation-settings: "FILL" 1;
  }

  .standards-card.product-dash__card {
    height: 100%;
    padding-left: var(--rail-gap);
    background: transparent;
    border-color: transparent;
    cursor: default;
  }

  .standards-card.product-dash__card:hover {
    border-color: transparent;
  }

  .standards-card--best.product-dash__card,
  .standards-card--best.product-dash__card:hover {
    background: color-mix(in srgb, var(--color-bg) 45%, transparent);
    border-color: var(--color-text);
  }

  .standards-card__place,
  .standards-card__code,
  .standards-card__text,
  .standards-stars {
    margin: 0;
  }

  .standards-card__place,
  .standards-card__code {
    font-size: var(--font-size-xs);
  }

  .standards-card__place {
    color: var(--color-muted);
  }

  .standards-card__code {
    color: var(--color-link);
  }

  .standards-card__text {
    font-size: var(--font-size-sm);
  }

  .standards-stars {
    display: flex;
    gap: 0.125rem;
    margin-top: auto;
    background: transparent;
  }

  .standards-card.product-dash__card .standards-star {
    width: auto;
    height: auto;
    background: transparent;
    border-radius: 0;
    font-size: var(--font-size-sm);
    color: color-mix(in srgb, var(--color-text) 28%, var(--color-bg));
  }

  .standards-card.product-dash__card .standards-star--on,
  .standards-card--best.product-dash__card .standards-star--on {
    font-variation-settings: "FILL" 1;
    color: #eab308;
  }

  .standards-fit {
    font-size: var(--font-size-xs);
    font-weight: 650;
  }

  .standards-sources {
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
  }

  .standards-sources ul {
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--font-size-sm);
  }

  .standards-sources li {
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
  }

  .standards-sources span {
    color: var(--color-muted);
  }

  @media (min-width: 64rem) {
    .standards-row__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .standards-card__place {
      position: absolute;
      width: 0.0625rem;
      height: 0.0625rem;
      padding: 0;
      margin: -0.0625rem;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }
</style>
