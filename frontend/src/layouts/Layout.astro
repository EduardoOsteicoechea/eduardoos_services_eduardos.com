---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import "../styles/ereport-chrome.css";
import "../styles/product-suite.css";
import "../styles/scrib.css";
import "../styles/pamphlet-layout.css";
import "../styles/pamphlet-hub.css";
import "../styles/evoice.css";
import "../styles/eoproject.css";
import "../styles/apikeys.css";
import "../styles/eduardoos.css";
import "../components/HeaderDynamicMenu/HeaderDynamicMenu.css";

type JsonLd = Record<string, unknown> | Record<string, unknown>[] | string;

type Props = {
  title?: string;
  description?: string;
  page?: string;
  robots?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: JsonLd;
  /** Visible H1 band in main. Defaults on except workspaces. */
  showPageTitle?: boolean;
  /** H1 text; defaults to `title`. */
  pageHeading?: string;
  /** Optional id on the page H1 (e.g. home FAQ anchor). */
  pageTitleId?: string;
};

const siteTitle = "Eduardo Osteicoechea - AEC AI Technologist";
const siteName = "Eduardoos";
const {
  title,
  description = "Eduardo Osteicoechea — AEC Technologist. Licensed Building Architect, BIM practitioner, and full-stack developer.",
  page = "",
  robots: robotsProp,
  ogImage = "/og-default.png",
  ogType = "website",
  jsonLd,
  showPageTitle: showPageTitleProp,
  pageHeading: pageHeadingProp,
  pageTitleId = "page-title",
} = Astro.props;
const documentTitle = (() => {
  const pageTitle = title?.replace(/\s·\sEduardoos$/, "");
  return pageTitle ? `${pageTitle} · ${siteTitle}` : siteTitle;
})();
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const hasDhsSlot = Astro.slots.has("dhs");
const htmlPage = page || (path.startsWith("/ereport") ? path.slice(1).replace(/\//g, "-") : "");
const isEreport = htmlPage.startsWith("ereport");
const isWorkspace =
	htmlPage === "ereport-workspace" ||
  htmlPage === "ereport-invite" ||
  htmlPage === "homescool-workspace" ||
  htmlPage === "latin-institutes" ||
  htmlPage === "scrib-sheet" ||
  /(?:^|-)workspace(?:-|$)/.test(htmlPage) ||
  path.includes("/workspace");
const pageHeading = (pageHeadingProp ?? title?.replace(/\s·\sEduardoos$/, "") ?? "").trim();
const showPageTitle =
  showPageTitleProp ?? (Boolean(pageHeading) && !isWorkspace);
const privateByDefault =
  path.startsWith("/session") ||
  path.startsWith("/admin") ||
  path.startsWith("/ereport") ||
  path.startsWith("/scrib") ||
  path.startsWith("/homescool") ||
  path.startsWith("/documents/pamphlet") ||
  path.startsWith("/evoice") ||
  path.startsWith("/eoproject") ||
  path.startsWith("/publisher") ||
  path.startsWith("/payments");
const robots = robotsProp ?? (privateByDefault ? "noindex,nofollow" : "index,follow");
const canonical = new URL(Astro.url.pathname, Astro.site).toString().replace(/\/$/, "") || "https://eduardoos.com";
const canonicalUrl = path === "/" ? "https://eduardoos.com/" : canonical;
const ogImageUrl = new URL(ogImage, Astro.site).toString();
const jsonLdString =
  typeof jsonLd === "string" ? jsonLd : jsonLd ? JSON.stringify(jsonLd) : "";
---

<!doctype html>
<html lang="en" data-theme="dark" data-page={htmlPage || undefined}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem("theme");
          if (theme === "light" || theme === "dark") {
            document.documentElement.setAttribute("data-theme", theme);
          }
          const font = localStorage.getItem("root-font-size");
          if (font) {
            document.documentElement.style.fontSize = font;
          }
        } catch (_) {}
      })();
    </script>
    <style is:inline>
      html { background: #0b0b0c; }
      html[data-theme="light"] { background: #f6f5f1; }
      html[data-theme="dark"] { background: #0b0b0c; }
      #boot-veil {
        position: fixed;
        inset: 0;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0;
        padding: var(--space-padding, 1rem);
        gap: var(--rail-gap, 0.5rem);
        background: #0b0b0c;
        color: #f4f4f5;
      }
      html[data-theme="light"] #boot-veil {
        background: #f6f5f1;
        color: #17171a;
      }
      html[data-theme="dark"] #boot-veil {
        background: #0b0b0c;
        color: #f4f4f5;
      }
      #boot-veil[hidden] { display: none !important; }
      #boot-veil .boot-veil__panel {
        position: relative;
        width: 4.5rem;
        height: 4.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0;
        padding: 0;
        gap: 0;
        background: #141416;
        border: 0.0625rem solid currentColor;
        border-radius: 0.25rem;
        overflow: hidden;
      }
      html[data-theme="light"] #boot-veil .boot-veil__panel { background: #ffffff; }
      #boot-veil .boot-veil__ring {
        position: absolute;
        inset: 0.55rem;
        border: 0.125rem solid transparent;
        border-top-color: currentColor;
        border-right-color: currentColor;
        border-radius: 50%;
        animation: boot-veil-spin 0.95s linear infinite;
      }
      #boot-veil .boot-veil__ring--inner {
        inset: 1.15rem;
        border-width: 0.094rem;
        animation-duration: 1.4s;
        animation-direction: reverse;
        opacity: 0.55;
      }
      #boot-veil .boot-veil__core {
        width: 0.55rem;
        height: 0.55rem;
        border-radius: 50%;
        background: currentColor;
        animation: boot-veil-pulse 1.15s ease-in-out infinite;
      }
      #boot-veil .boot-veil__label {
        position: absolute;
        width: 0.0625rem;
        height: 0.0625rem;
        padding: 0;
        margin: -0.0625rem;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
      @keyframes boot-veil-spin { to { transform: rotate(360deg); } }
      @keyframes boot-veil-pulse {
        0%, 100% { transform: scale(0.65); opacity: 0.45; }
        50% { transform: scale(1.2); opacity: 1; }
      }
      @media (prefers-reduced-motion: reduce) {
        #boot-veil .boot-veil__ring,
        #boot-veil .boot-veil__ring--inner,
        #boot-veil .boot-veil__core { animation: none; }
      }
    </style>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" sizes="180x180" />
    <link
      rel="shortcut icon"
      href="/favicon-32.png"
      sizes="32x32"
      type="image/png"
    />
    <meta
      name="google-site-verification"
      content="RQdklgFawBo75p5tN7wranunENDjUu27gol9MENm-SM"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" />
    <link rel="preload" href="/fonts/material-symbols-outlined.woff2" as="font" type="font/woff2" crossorigin />
    <title>{documentTitle}</title>
    {jsonLdString ? <script type="application/ld+json" set:html={jsonLdString} /> : null}
    <ClientRouter />
  </head>
  <body>
    <div
      id="boot-veil"
      class="boot-veil"
      transition:persist
      role="status"
      aria-live="polite"
      aria-busy="true"
      data-boot-veil
    >
      <div class="boot-veil__panel" aria-hidden="true">
        <span class="boot-veil__ring"></span>
        <span class="boot-veil__ring boot-veil__ring--inner"></span>
        <span class="boot-veil__core"></span>
      </div>
      <span class="boot-veil__label">Loading</span>
    </div>
    <script is:inline>
      (() => {
        const MAX_MS = 60000;
        const FONT_SOFT_MS = 4000;
        let generation = 0;
        let maxTimer = 0;

        const veil = () => document.getElementById("boot-veil");

        const stylesReady = () => {
          try {
            return Boolean(
              getComputedStyle(document.documentElement).getPropertyValue("--color-bg").trim(),
            );
          } catch (_) {
            return false;
          }
        };

        const waitCss = () =>
          new Promise((resolve) => {
            const tick = () => {
              if (stylesReady()) resolve();
              else requestAnimationFrame(tick);
            };
            tick();
          });

        const waitFonts = () => {
          if (!document.fonts || !document.fonts.ready) return Promise.resolve();
          return Promise.race([
            document.fonts.ready.then(() => undefined, () => undefined),
            new Promise((resolve) => setTimeout(resolve, FONT_SOFT_MS)),
          ]);
        };

        const waitDom = () =>
          new Promise((resolve) => {
            if (document.readyState === "interactive" || document.readyState === "complete") resolve();
            else document.addEventListener("DOMContentLoaded", () => resolve(), { once: true });
          });

        const paintSettle = () =>
          new Promise((resolve) => {
            requestAnimationFrame(() => requestAnimationFrame(() => resolve()));
          });

        const dismiss = (gen) => {
          if (gen !== generation) return;
          const el = veil();
          if (!el || el.hasAttribute("hidden")) return;
          el.setAttribute("hidden", "");
          el.setAttribute("aria-busy", "false");
          document.documentElement.setAttribute("data-boot-ready", "");
          if (maxTimer) {
            clearTimeout(maxTimer);
            maxTimer = 0;
          }
        };

        const armMax = (gen) => {
          if (maxTimer) clearTimeout(maxTimer);
          maxTimer = window.setTimeout(() => dismiss(gen), MAX_MS);
        };

        const showVeil = () => {
          document.documentElement.removeAttribute("data-boot-ready");
          const el = veil();
          if (!el) return;
          el.removeAttribute("hidden");
          el.setAttribute("aria-busy", "true");
        };

        const settleAndDismiss = async (gen) => {
          try {
            await Promise.race([
              Promise.all([waitDom(), waitCss(), waitFonts()]).then(() => paintSettle()),
              new Promise((resolve) => setTimeout(resolve, MAX_MS)),
            ]);
          } catch (_) {}
          dismiss(gen);
        };

        const gen0 = ++generation;
        armMax(gen0);
        settleAndDismiss(gen0);

        document.addEventListener("astro:before-preparation", () => {
          const gen = ++generation;
          showVeil();
          armMax(gen);
        });

        document.addEventListener("astro:page-load", () => {
          settleAndDismiss(generation);
        });
      })();
    </script>
    <div class="shell">
      <button type="button" class="tray-backdrop" data-tray-backdrop hidden aria-label="Close panel"></button>
      <header class="app-header app-header--start">
        {isEreport ? (
          <div class="ereport-guest-auth" data-header-chrome data-guest-only>
            <a class="ereport-guest-auth__link" href="/session/register" data-route>Register</a>
            <a class="ereport-guest-auth__link ereport-guest-auth__link--primary" href="/session" data-route>Log in</a>
          </div>
        ) : null}
        <div class="header-cluster header-cluster--menu" data-header-chrome>
          <button class="header-menu icon-btn" type="button" aria-controls="main-menu" aria-expanded="false" aria-label="Open menu" title="Open menu">
            <svg class="header-menu-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <line x1="5" y1="9" x2="19" y2="9" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              <line x1="5" y1="15" x2="19" y2="15" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
          </button>
        </div>
      </header>

      <aside id="main-menu" class="sidebar-left" hidden>
        <header class="sidebar-toolbar">
          <button class="icon-btn" type="button" data-font="-" aria-label="Decrease font size" title="Decrease font size">
            <span class="material-symbols-outlined" aria-hidden="true">text_decrease</span>
          </button>
          <button class="icon-btn" type="button" data-font="+" aria-label="Increase font size" title="Increase font size">
            <span class="material-symbols-outlined" aria-hidden="true">text_increase</span>
          </button>
          <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle theme" title="Toggle theme">
            <span class="material-symbols-outlined" aria-hidden="true">contrast</span>
          </button>
          <button class="agent-fab icon-btn" type="button" aria-controls="agent-sidebar" aria-expanded="false" aria-label="Open AI agent" title="Open AI agent">
            <span class="agent-fab-label" aria-hidden="true">AI</span>
          </button>
          <a
            href="/session/profile"
            class="header-session icon-btn"
            data-route
            data-header-avatar
            data-authed-only
            hidden
            aria-label="Profile"
            title="Profile"
          >
            <img class="header-session-photo" data-header-avatar-img hidden alt="" />
            <span class="material-symbols-outlined header-session-fallback" data-header-avatar-fallback aria-hidden="true">account_circle</span>
          </a>
          <button class="icon-btn" type="button" data-close-menu aria-label="Close menu" title="Close menu">
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
          </button>
        </header>
        <nav aria-label="Primary">
          <div class="sidebar-nav-section sidebar-nav-section--site">
            <a href="/" data-route aria-current={path === "/" ? "page" : undefined}>
              <span class="material-symbols-outlined" aria-hidden="true">home</span>
              Home
            </a>
            <a href="/contact" data-route aria-current={path === "/contact" ? "page" : undefined}>
              <span class="material-symbols-outlined" aria-hidden="true">mail</span>
              Contact
            </a>
          </div>
          <div class="sidebar-nav-section sidebar-nav-section--services">
            <a href="/articles" data-route aria-current={path.startsWith("/articles") ? "page" : undefined}>
              <span class="material-symbols-outlined" aria-hidden="true">article</span>
              Articles
            </a>
            <a href="/scrib" data-route data-service="scrib" hidden aria-current={path === "/scrib" || path.startsWith("/scrib/") ? "page" : undefined}>
              <span class="material-symbols-outlined" aria-hidden="true">edit_note</span>
              Scrib
            </a>
            <a href="/dashboard/latin/calvins-institutes" data-route data-authed-only data-full-nav hidden aria-current={path.includes("calvins-institutes") ? "page" : undefined}>
              <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
              Institutes
            </a>
            <a href="/homescool" data-route data-service="homescool" hidden aria-current={path === "/homescool" || path.startsWith("/homescool/") ? "page" : undefined}>
              <span class="material-symbols-outlined" aria-hidden="true">school</span>
              Homescool
            </a>
            <a href="/documents/pamphlet" data-route data-service="epam" hidden aria-current={path.startsWith("/documents/pamphlet") ? "page" : undefined}>
              <span class="material-symbols-outlined" aria-hidden="true">description</span>
              EPAM
            </a>
            <a href="/evoice" data-route data-service="evoice" hidden aria-current={path === "/evoice" || path.startsWith("/evoice/") ? "page" : undefined}>
              <span class="material-symbols-outlined" aria-hidden="true">record_voice_over</span>
              eVoice
            </a>
            <a href="/eoproject" data-route data-service="eoproject" hidden aria-current={path === "/eoproject" || path.startsWith("/eoproject/") ? "page" : undefined}>
              <span class="material-symbols-outlined" aria-hidden="true">foundation</span>
              eoProject
            </a>
            <a href="/ereport" data-route data-service="ereport" hidden aria-current={path === "/ereport" || path.startsWith("/ereport/") ? "page" : undefined}>
              <span class="material-symbols-outlined" aria-hidden="true">assignment</span>
              eReport
            </a>
            <a href="/api-docs" data-route data-service="api" hidden aria-current={path === "/api-docs" ? "page" : undefined}>
              <span class="material-symbols-outlined" aria-hidden="true">api</span>
              API docs
            </a>
            <a
              href="/publisher"
              data-route
              data-admin-only
              hidden
              aria-current={path === "/publisher" || path.startsWith("/publisher/") ? "page" : undefined}
            >
              <span class="material-symbols-outlined" aria-hidden="true">campaign</span>
              Publisher
            </a>
          </div>
          <div class="sidebar-nav-section sidebar-nav-section--subscriptions">
            <a href="/payments/subscription" data-route aria-current={path.startsWith("/payments") ? "page" : undefined}>
              <span class="material-symbols-outlined" aria-hidden="true">payments</span>
              Subscriptions
            </a>
          </div>
          <div class="sidebar-nav-section sidebar-nav-section--admin" data-admin-only hidden>
            <a href="/admin/users" data-route aria-current={path === "/admin/users" ? "page" : undefined}>
              <span class="material-symbols-outlined" aria-hidden="true">group</span>
              Users
            </a>
            <a href="/admin/api" data-route aria-current={path === "/admin/api" ? "page" : undefined}>
              <span class="material-symbols-outlined" aria-hidden="true">key</span>
              API keys
            </a>
          </div>
          <div class="sidebar-nav-section sidebar-nav-section--session">
            <a class="sidebar-nav-action" href="/session" data-route data-guest-only aria-current={path === "/session" ? "page" : undefined}>
              <span class="material-symbols-outlined" aria-hidden="true">login</span>
              Sign in
            </a>
            <button type="button" data-logout data-authed-only hidden>
              <span class="material-symbols-outlined" aria-hidden="true">logout</span>
              Sign out
            </button>
          </div>
        </nav>
      </aside>

      <aside id="dynamic-header" class="sidebar-right" hidden>
        <div id="header-dynamic-menu-host" class="header-dynamic-menu-host" data-hds-host></div>
        {hasDhsSlot ? <slot name="dhs" /> : null}
      </aside>

      <main>
        {showPageTitle ? (
          <header class="page-title">
            <h1 id={pageTitleId} data-page-title data-title>{pageHeading}</h1>
          </header>
        ) : null}
        <slot />
      </main>

      <aside id="agent-sidebar" class="sidebar-right" hidden aria-label="Ask Eduardoos">
<div class="agent-chat-log" data-agent-log>
          <p class="hint" data-agent-empty>Ask a short question about this site.</p>
        </div>
        <div class="agent-chat-select-bar" data-agent-select-bar hidden>
          <button type="button" data-agent-copy-selected>Copy selected</button>
          <button type="button" data-agent-cancel-select>Cancel</button>
        </div>
        <div class="agent-chat-history" data-agent-history hidden></div>
        <form class="agent-chat-form" data-agent-form>
          <p class="agent-chat-reply" data-agent-reply hidden></p>
          <p class="agent-chat-voice" data-agent-voice hidden aria-live="polite"></p>
          <div class="agent-chat-composer">
            <div class="agent-chat-compose-row agent-chat-compose-row--tools">
              <div class="agent-chat-tools">
                <button class="icon-btn" type="button" data-agent-new aria-label="New chat">
                  <span class="material-symbols-outlined" aria-hidden="true">add_comment</span>
                </button>
                <button class="icon-btn" type="button" data-agent-history-toggle aria-expanded="false" aria-label="Chat history">
                  <span class="material-symbols-outlined" aria-hidden="true">history</span>
                </button>
                <button class="icon-btn" type="button" data-agent-speak-toggle hidden aria-pressed="true" aria-label="Speak replies" title="Speak replies">
                  <span class="material-symbols-outlined" aria-hidden="true">volume_up</span>
                </button>
                <button class="icon-btn" type="button" data-agent-mic hidden aria-pressed="false" aria-label="Record voice" title="Record voice">
                  <span class="material-symbols-outlined" aria-hidden="true">mic</span>
                </button>
              </div>
            </div>
            <div class="agent-chat-compose-row">
              <textarea id="agent-chat-input" data-agent-input maxlength="500" rows="1" aria-label="Message" placeholder="Ask a short question about this site."></textarea>
            </div>
            <div class="agent-chat-compose-row">
              <div class="agent-chat-drop" data-agent-drop>
                <input type="file" data-agent-files accept="image/jpeg,image/png,image/webp,image/gif" multiple hidden />
                <span class="material-symbols-outlined" aria-hidden="true">imagesmode</span>
                <span class="hint" data-agent-drop-label>Images</span>
                <div class="agent-chat-thumbs" data-agent-thumbs></div>
              </div>
              <button class="icon-btn" type="submit" data-agent-send disabled aria-label="Send">
                <span class="material-symbols-outlined" aria-hidden="true">send</span>
              </button>
            </div>
          </div>
        </form>
      </aside>
    </div>
    <div id="error-modal" class="error-modal error-toast" hidden>
      <div class="error-modal-dialog" role="alertdialog" aria-modal="true" aria-labelledby="error-modal-title">
        <header class="error-modal-toolbar">
          <h2 id="error-modal-title">Something went wrong</h2>
          <button class="icon-btn" type="button" data-error-close aria-label="Close">
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
          </button>
        </header>
        <div class="error-modal-box" data-error-message></div>
        <div class="error-modal-box" data-error-details></div>
        <div class="error-modal-actions">
          <button type="button" data-error-copy-message>Copy message</button>
          <button type="button" data-error-copy-details>Copy details</button>
          <button type="button" data-error-download-epam hidden>Download .epam</button>
          <button type="button" data-error-load-ereport hidden>Load .ereport</button>
        </div>
        <div class="error-modal-box" data-error-debug hidden></div>
        <button type="button" data-error-copy-debug hidden>Copy debug</button>
      </div>
    </div>
    <script>
      import { startChrome } from "../lib/chrome";
      import { startErrorModal } from "../lib/error-modal";
      import { startProfileActions } from "../lib/session-ui";
      startErrorModal();
      startChrome();
      startProfileActions();
      window.dispatchEvent(new Event("eduardoos:hds-host-ready"));
    </script>
  </body>
</html>
