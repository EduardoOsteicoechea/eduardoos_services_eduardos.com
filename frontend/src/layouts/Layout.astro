---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

type Props = {
  title: string;
  description?: string;
};

const { title, description = "Personal site of Eduardo Osteicoechea." } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="shell">
      <header class="nav">
        <a class="brand" href="/" data-route>Eduardoos</a>
        <nav class="links" aria-label="Primary">
          <a href="/" data-route aria-current={path === "/" ? "page" : undefined}>Home</a>
          <a href="/about" data-route aria-current={path === "/about" ? "page" : undefined}>About</a>
          <a href="/contact" data-route aria-current={path === "/contact" ? "page" : undefined}>Contact</a>
          <a id="nav-diagnostics" href="/diagnostics" data-route hidden aria-current={path === "/diagnostics" ? "page" : undefined}>
            <span class="material-symbols-outlined" aria-hidden="true">monitor_heart</span>
            Diagnostics
          </a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="footer">eduardoos.com</footer>
    </div>
    <script>
      import { startClientRouting } from "../lib/router";
      import { getMe } from "../lib/api";
      startClientRouting();
      const stored = localStorage.getItem("theme");
      if (stored === "light" || stored === "dark") {
        document.documentElement.dataset.theme = stored;
      }
      void getMe().then(({ status, data }) => {
        if (status === 200 && data.role === "admin") {
          document.querySelector("#nav-diagnostics")?.removeAttribute("hidden");
        }
      });
    </script>
  </body>
</html>
