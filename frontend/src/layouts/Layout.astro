---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

type Props = {
  title: string;
  description?: string;
};

const { title, description = "Personal site of Eduardo Osteicoechea." } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="shell">
      <header class="app-header">
        <a class="header-logo icon-btn" href="/" data-route aria-label="Eduardoos">
          <span class="material-symbols-outlined" aria-hidden="true">terminal</span>
        </a>
        <button class="header-menu icon-btn" type="button" aria-controls="main-menu" aria-label="Open main menu">
          <span class="material-symbols-outlined" aria-hidden="true">menu</span>
        </button>
        <button class="header-dynamic icon-btn" type="button" aria-controls="dynamic-header" aria-label="Open page actions">
          <span class="material-symbols-outlined" aria-hidden="true">space_dashboard</span>
        </button>
        <a class="header-avatar icon-btn" href="/session" data-route data-guest-href="/session" data-authed-href="/session/profile" data-guest-label="Sign in" data-authed-label="Profile" aria-label="Sign in">
          <span class="material-symbols-outlined" aria-hidden="true">account_circle</span>
        </a>
      </header>

      <aside id="main-menu" class="sidebar-left" hidden>
        <header class="sidebar-toolbar">
          <button class="icon-btn" type="button" data-font="-" aria-label="Decrease font size">
            <span class="material-symbols-outlined" aria-hidden="true">text_decrease</span>
          </button>
          <button class="icon-btn" type="button" data-font="+" aria-label="Increase font size">
            <span class="material-symbols-outlined" aria-hidden="true">text_increase</span>
          </button>
          <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle theme">
            <span class="material-symbols-outlined" aria-hidden="true">contrast</span>
          </button>
        </header>
        <nav aria-label="Primary">
          <a href="/" data-route aria-current={path === "/" ? "page" : undefined}>
            <span class="material-symbols-outlined" aria-hidden="true">home</span>
            Home
          </a>
          <a href="/about" data-route aria-current={path === "/about" ? "page" : undefined}>
            <span class="material-symbols-outlined" aria-hidden="true">info</span>
            About
          </a>
          <a href="/contact" data-route aria-current={path === "/contact" ? "page" : undefined}>
            <span class="material-symbols-outlined" aria-hidden="true">mail</span>
            Contact
          </a>
          <a href="/session" data-route data-guest-only aria-current={path === "/session" ? "page" : undefined}>
            <span class="material-symbols-outlined" aria-hidden="true">login</span>
            Sign in
          </a>
          <a href="/session/register" data-route data-guest-only aria-current={path === "/session/register" ? "page" : undefined}>
            <span class="material-symbols-outlined" aria-hidden="true">person_add</span>
            Create account
          </a>
          <a href="/session/verify-email" data-route data-guest-only aria-current={path === "/session/verify-email" ? "page" : undefined}>
            <span class="material-symbols-outlined" aria-hidden="true">mark_email_read</span>
            Verify email
          </a>
          <a href="/session/forgot-password" data-route data-guest-only aria-current={path === "/session/forgot-password" ? "page" : undefined}>
            <span class="material-symbols-outlined" aria-hidden="true">lock_reset</span>
            Forgot password
          </a>
          <a href="/session/profile" data-route data-authed-only hidden aria-current={path === "/session/profile" ? "page" : undefined}>
            <span class="material-symbols-outlined" aria-hidden="true">manage_accounts</span>
            Profile
          </a>
          <a href="/session/change-password" data-route data-authed-only hidden aria-current={path === "/session/change-password" ? "page" : undefined}>
            <span class="material-symbols-outlined" aria-hidden="true">password</span>
            Change password
          </a>
          <button type="button" data-logout data-authed-only hidden>
            <span class="material-symbols-outlined" aria-hidden="true">logout</span>
            Sign out
          </button>
          <a href="/diagnostics" data-route data-admin-only hidden aria-current={path === "/diagnostics" ? "page" : undefined}>
            <span class="material-symbols-outlined" aria-hidden="true">monitor_heart</span>
            Diagnostics
          </a>
        </nav>
      </aside>

      <aside id="dynamic-header" class="sidebar-left" hidden>
        {path === "/diagnostics" ? (
          <a class="icon-btn" href="/diagnostics" data-route aria-label="Diagnostics">
            <span class="material-symbols-outlined" aria-hidden="true">monitor_heart</span>
          </a>
        ) : path.startsWith("/session") ? (
          <a class="icon-btn" href="/session" data-route aria-label="Session">
            <span class="material-symbols-outlined" aria-hidden="true">manage_accounts</span>
          </a>
        ) : (
          <a class="icon-btn" href="/about" data-route aria-label="About">
            <span class="material-symbols-outlined" aria-hidden="true">info</span>
          </a>
        )}
      </aside>

      <main>
        <slot />
      </main>

      <button class="agent-fab icon-btn" type="button" aria-controls="agent-sidebar" aria-label="Open AI agent">
        <span class="material-symbols-outlined" aria-hidden="true">smart_toy</span>
      </button>
      <aside id="agent-sidebar" class="sidebar-right" hidden>
        <p>The AI agent talks only through this site’s API.</p>
      </aside>
    </div>
    <script>
      import { startChrome } from "../lib/chrome";
      startChrome();
    </script>
  </body>
</html>
