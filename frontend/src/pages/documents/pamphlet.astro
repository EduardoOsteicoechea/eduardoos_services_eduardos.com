---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Pamphlet · Eduardoos"
  description="Cloud pamphlet editor and print export."
  page="pamphlet"
  robots="noindex,nofollow"
>
  <Fragment slot="dhs">
    <button class="dhs-action" type="button" data-view="dashboard" title="Dashboard" aria-label="Dashboard">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">dashboard</span>
      </span>
      Dashboard
    </button>
    <button class="dhs-action" type="button" data-view="recent" title="Recent" aria-label="Recent">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">history</span>
      </span>
      Recent
    </button>
    <button class="dhs-action" type="button" data-view="open" title="Open" aria-label="Open">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">folder_open</span>
      </span>
      Open
    </button>
    <button class="dhs-action" type="button" data-view="new" title="New" aria-label="New">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">note_add</span>
      </span>
      New
    </button>
    <button class="dhs-action" type="button" data-view="manage" title="Manage" aria-label="Manage">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">folder_managed</span>
      </span>
      Manage
    </button>
    <button class="dhs-action" type="button" data-view="footers" title="Footers" aria-label="Footers">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">vertical_align_bottom</span>
      </span>
      Footers
    </button>
  </Fragment>

  <div class="pamphlet-hub" data-pamphlet>
    <p class="status" data-banner>Loading…</p>
    <div data-gate hidden class="product-gate">
      <p class="hint">Pamphlet subscription required.</p>
      <p class="hint"><a href="/payments/subscription" data-route>Subscribe</a></p>
    </div>
    <div data-dash hidden class="product-dash">
      <h1>Pamphlet</h1>
      <div class="product-dash__grid">
        <button class="product-dash__card" type="button" data-view="recent">
          <span class="material-symbols-outlined" aria-hidden="true">history</span>
          <span class="product-dash__card-title">Recent</span>
          <span class="product-dash__card-desc">Continue recent pamphlets.</span>
        </button>
        <button class="product-dash__card" type="button" data-view="open">
          <span class="material-symbols-outlined" aria-hidden="true">folder_open</span>
          <span class="product-dash__card-title">Open</span>
          <span class="product-dash__card-desc">Open a cloud pamphlet.</span>
        </button>
        <button class="product-dash__card" type="button" data-view="new">
          <span class="material-symbols-outlined" aria-hidden="true">note_add</span>
          <span class="product-dash__card-title">New</span>
          <span class="product-dash__card-desc">Create a new pamphlet.</span>
        </button>
        <button class="product-dash__card" type="button" data-view="manage">
          <span class="material-symbols-outlined" aria-hidden="true">folder_managed</span>
          <span class="product-dash__card-title">Manage</span>
          <span class="product-dash__card-desc">Manage cloud documents.</span>
        </button>
        <button class="product-dash__card" type="button" data-view="footers">
          <span class="material-symbols-outlined" aria-hidden="true">vertical_align_bottom</span>
          <span class="product-dash__card-title">Footers</span>
          <span class="product-dash__card-desc">Footer profiles.</span>
        </button>
      </div>
      <h2 class="product-dash__section-title">Cloud documents</h2>
      <ul class="product-list" data-list></ul>
    </div>
    <div class="pamphlet-hub__hint-bar" data-editor-hint hidden>
      <span data-view-label>View</span>
      <button type="button" class="btn" data-view="dashboard">Dashboard</button>
    </div>
    <div
      id="pamphlet-root"
      class="pamphlet-route-root pamphlet-layout-workspace pamphlet-host"
      data-editor
      hidden
    ></div>
  </div>
</Layout>

<script>
  import { refreshAuthSession } from "../../lib/auth";
  import { mustLog } from "../../lib/dev-log";
  import { fetchEpams } from "../../lib/epams";
  import { showErrorModal } from "../../lib/error-modal";
  import { mountPamphletGenerator } from "../../lib/pamphlet-generator/src/index";
  import { PREF_PAMPHLET_LAST_EPAM, getPreference } from "../../lib/preferences";
  import { apiFail, requireService, setHidden } from "../../lib/productGate";

  const EDITOR_VIEWS = new Set(["recent", "open", "new", "manage", "footers"]);
  const root = document.querySelector("[data-pamphlet]");
  if (!(root instanceof HTMLElement)) throw new Error("pamphlet root missing");
  const banner = root.querySelector("[data-banner]");
  const gate = root.querySelector("[data-gate]");
  const dash = root.querySelector("[data-dash]");
  const editor = root.querySelector("[data-editor]");
  const editorHint = root.querySelector("[data-editor-hint]");
  const viewLabel = root.querySelector("[data-view-label]");
  const list = root.querySelector("[data-list]");
  let handle: { destroy: () => void } | null = null;

  function readView(): string {
    const q = new URLSearchParams(window.location.search).get("view");
    if (q && (q === "dashboard" || EDITOR_VIEWS.has(q))) return q;
    return "dashboard";
  }

  function writeView(view: string) {
    const url = new URL(window.location.href);
    if (view === "dashboard") url.searchParams.delete("view");
    else url.searchParams.set("view", view);
    window.history.replaceState({}, "", url.toString());
  }

  function destroyEditor() {
    handle?.destroy();
    handle = null;
    if (editor instanceof HTMLElement) editor.innerHTML = "";
  }

  function showEditor(view: string) {
    destroyEditor();
    setHidden(dash, true);
    setHidden(editor, false);
    setHidden(editorHint, false);
    if (viewLabel instanceof HTMLElement) viewLabel.textContent = `View: ${view}`;
    root.classList.add("pamphlet-hub--editor");
    if (!(editor instanceof HTMLElement)) return;
    editor.dataset.pamphletView = view;
    (window as Window & { __eduardoosPamphletView?: string }).__eduardoosPamphletView = view;
    document.documentElement.classList.add("layout-editor-bleed", "page-pamphlet");
    document.body.classList.add("page-pamphlet");
    handle = mountPamphletGenerator(editor);
    window.dispatchEvent(new Event("eduardoos:hds-host-ready"));
    if (mustLog) console.log("[pamphlet] editor mounted", { view });
  }

  function showDash() {
    destroyEditor();
    document.documentElement.classList.remove("layout-editor-bleed", "page-pamphlet");
    document.body.classList.remove("page-pamphlet");
    root.classList.remove("pamphlet-hub--editor");
    setHidden(editor, true);
    setHidden(editorHint, true);
    setHidden(dash, false);
  }

  async function applyView(view: string) {
    writeView(view);
    if (view === "dashboard") {
      showDash();
      await refreshList();
      return;
    }
    if (view === "recent") {
      const pref = await getPreference<string>(PREF_PAMPHLET_LAST_EPAM);
      if (!pref.value) {
        showErrorModal({ message: "No recent pamphlet saved yet." });
        writeView("dashboard");
        showDash();
        return;
      }
    }
    showEditor(view);
  }

  async function refreshList() {
    if (!(list instanceof HTMLElement)) return;
    try {
      const { epams } = await fetchEpams();
      list.replaceChildren();
      if (epams.length === 0) {
        const li = document.createElement("li");
        li.textContent = "No cloud pamphlets yet.";
        list.appendChild(li);
        return;
      }
      for (const epam of epams) {
        const li = document.createElement("li");
        const open = document.createElement("button");
        open.type = "button";
        open.className = "btn btn--primary";
        open.textContent = epam.title || epam.epamId;
        open.addEventListener("click", () => void applyView("open"));
        li.appendChild(open);
        list.appendChild(li);
      }
    } catch (err) {
      showErrorModal({ message: err instanceof Error ? err.message : "Could not list pamphlets." });
    }
  }

  root.querySelectorAll("[data-view]").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!(btn instanceof HTMLElement)) return;
      void applyView(btn.dataset.view || "dashboard");
    });
  });
  document.querySelectorAll("[data-view]").forEach((btn) => {
    if (root.contains(btn)) return;
    btn.addEventListener("click", () => {
      if (!(btn instanceof HTMLElement)) return;
      void applyView(btn.dataset.view || "dashboard");
    });
  });

  await refreshAuthSession();
  const gateResult = await requireService("pamphlet");
  if (!gateResult.sessionOk || !gateResult.access.allowed) {
    if (banner instanceof HTMLElement) {
      banner.textContent = gateResult.sessionOk ? "Subscription required." : "Sign in required.";
    }
    setHidden(gate, false);
    setHidden(dash, true);
  } else {
    if (banner instanceof HTMLElement) banner.textContent = "";
    setHidden(gate, true);
    await applyView(readView());
  }
</script>
