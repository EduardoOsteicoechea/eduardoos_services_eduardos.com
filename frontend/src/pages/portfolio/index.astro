---
import Layout from "../../layouts/Layout.astro";
import { caseStudies } from "../../lib/caseStudies";

const description =
  "Case studies from Eduardo Osteicoechea — Revit/AutoCAD APIs, APS/ACC, ASP.NET on AWS, eReport, eoProject, and path-scoped CI.";
---

<Layout
  title="Portfolio · Senior BIM Software Developer"
  description={description}
  robots="index,follow"
  page="portfolio"
>
  <section class="product-dash" aria-labelledby="portfolio-heading">
    <p class="lede">
      Selected work that maps to a Senior BIM Software Developer role: Autodesk APIs, add-in engineering,
      ASP.NET/AWS cloud, and AEC web tools.
    </p>
    <div class="product-dash__grid">
      {caseStudies.map((c) => (
        <a class="product-dash__card" href={`/portfolio/${c.slug}`} data-route>
          <div class="product-dash__card-head">
            <span class="material-symbols-outlined" aria-hidden="true">{c.icon}</span>
            <h2 class="product-dash__card-title">{c.title}</h2>
          </div>
          <p class="product-dash__card-desc">{c.summary}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
