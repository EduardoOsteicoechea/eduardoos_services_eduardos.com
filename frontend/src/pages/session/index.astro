---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Sign in">
  <section class="session-grid" data-session>
    <p class="status" data-banner>Loading session…</p>
    <form class="panel" data-login>
      <label>
        Email or username
        <input name="identifier" autocomplete="username" required />
      </label>
      <label>
        Password
        <span class="password-field">
          <input type="password" name="password" autocomplete="current-password" required minlength="8" maxlength="128" data-password-input />
          <button type="button" class="password-field__toggle" data-password-toggle aria-label="Show password" aria-pressed="false" title="Show password">
            <span class="material-symbols-outlined" aria-hidden="true">visibility</span>
          </button>
        </span>
      </label>
      <p class="hint">Passwords are 8–128 characters.</p>
      <button type="submit" data-session-login>Sign in</button>
      <p class="hint session-links">
        <a href="/session/register" data-route>Create account</a>
        <a href="/session/verify-email" data-route>Verify email</a>
        <a href="/session/forgot-password" data-route>Forgot password</a>
      </p>
    </form>
  </section>
</Layout>

<script>
  import { attachFormAntibot } from "../../lib/antibot";
  import { onSessionPageReady, requireGuest, sessionCopy } from "../../lib/session-ui";

  onSessionPageReady((root) => {
    void requireGuest(root, sessionCopy());
    const form = root.querySelector("[data-login]");
    if (form instanceof HTMLFormElement) {
      attachFormAntibot(form);
    }
  });
</script>
