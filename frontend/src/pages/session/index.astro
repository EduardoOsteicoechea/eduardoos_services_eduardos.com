---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Sign in · Eduardoos">
  <section class="session-grid" data-session>
    <h1>Sign in</h1>
    <p class="lede">Sign-in uses HttpOnly cookies. CSRF tokens stay in memory. This page cannot authorize anything the Go API would deny.</p>
    <p class="status" data-banner>Loading session…</p>
    <form class="panel" data-login>
      <h2>Sign in</h2>
      <label>
        Email or username
        <input name="identifier" autocomplete="username" required />
      </label>
      <label>
        Password
        <input type="password" name="password" autocomplete="current-password" required minlength="8" maxlength="128" />
      </label>
      <p class="hint">Passwords are 8–128 characters.</p>
      <button type="submit">Sign in</button>
      <p class="hint session-links">
        <a href="/session/register" data-route>Create account</a>
        <a href="/session/verify-email" data-route>Verify email</a>
        <a href="/session/forgot-password" data-route>Forgot password</a>
      </p>
    </form>
  </section>
</Layout>

<script>
  import { getCsrf, postJSON, type MeResponse } from "../../lib/api";
  import { afterAuthChange, loginBodyFromForm, reportFailure, requireGuest, sessionCopy, setBanner, setBusy } from "../../lib/session-ui";
  import { go } from "../../lib/router";

  const root = document.querySelector("[data-session]");
  if (root instanceof HTMLElement) {
    const copy = sessionCopy();
    void getCsrf().then(() => requireGuest(root, copy));
    root.querySelector("[data-login]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;
      const body = loginBodyFromForm(form);
      setBusy(form, true);
      const result = await postJSON<MeResponse>("/auth/login", body);
      setBusy(form, false);
      const message = reportFailure(copy, result.status, result.data, "Signed in.");
      setBanner(root, message.text, message.kind);
      if (result.status === 200) {
        await afterAuthChange();
        go("/session/profile");
      }
    });
  }
</script>
