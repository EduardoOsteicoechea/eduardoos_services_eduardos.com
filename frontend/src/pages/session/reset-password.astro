---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Reset password · Eduardoos">
  <section class="session-grid" data-session>
    <h1>Reset password</h1>
    <p class="lede">Use the six-digit email code. A successful reset signs you out everywhere.</p>
    <p class="status" data-banner>Loading session…</p>
    <form class="panel" data-reset>
      <h2>Reset password</h2>
      <label>
        Email
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label>
        Six-digit code
        <input name="otp" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required />
      </label>
      <label>
        New password
        <input type="password" name="new_password" autocomplete="new-password" required minlength="8" maxlength="128" />
      </label>
      <p class="hint">Passwords are 8–128 characters.</p>
      <button type="submit">Reset password</button>
      <p class="hint session-links">
        <a href="/session" data-route>Sign in</a>
        <a href="/session/forgot-password" data-route>Forgot password</a>
      </p>
    </form>
  </section>
</Layout>

<script>
  import { getCsrf, postJSON, type MeResponse } from "../../lib/api";
  import { afterAuthChange, reportFailure, requireGuest, sessionCopy, setBanner, setBusy } from "../../lib/session-ui";

  const root = document.querySelector("[data-session]");
  if (root instanceof HTMLElement) {
    const copy = sessionCopy();
    void getCsrf().then(() => requireGuest(root, copy));
    root.querySelector("[data-reset]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;
      setBusy(form, true);
      const data = new FormData(form);
      const result = await postJSON<MeResponse>("/auth/reset-password", {
        email: String(data.get("email") ?? ""),
        otp: String(data.get("otp") ?? ""),
        new_password: String(data.get("new_password") ?? ""),
      });
      setBusy(form, false);
      const message = reportFailure(copy, result.status, result.data, "Password updated. Sign in with the new password.");
      setBanner(root, message.text, message.kind);
      if (result.status === 200) {
        await afterAuthChange();
      }
    });
  }
</script>
