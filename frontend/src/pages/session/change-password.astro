---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Change password · Eduardoos">
  <section class="session-grid" data-session>
    <h1>Change password</h1>
    <p class="lede">Requires your current password. Other sessions are revoked; this browser stays signed in.</p>
    <p class="status" data-banner>Loading session…</p>
    <p class="panel" data-guest-fallback hidden>
      Sign in to change your password.
      <span class="hint session-links">
        <a href="/session" data-route>Sign in</a>
      </span>
    </p>
    <form class="panel" data-authed-panel data-password-form hidden>
      <label>
        Current password
        <input type="password" name="current_password" autocomplete="current-password" required minlength="8" maxlength="128" />
      </label>
      <label>
        New password
        <input type="password" name="new_password" autocomplete="new-password" required minlength="8" maxlength="128" />
      </label>
      <p class="hint">Passwords are 8–128 characters.</p>
      <button type="submit">Update password</button>
      <p class="hint session-links">
        <a href="/session/profile" data-route>Profile</a>
      </p>
    </form>
  </section>
</Layout>

<script>
  import { postJSON, type MeResponse } from "../../lib/api";
  import { reportFailure, onSessionPageReady, requireAuth, sessionCopy, setBanner, setBusy } from "../../lib/session-ui";

  onSessionPageReady((root) => {
    const copy = sessionCopy();
    void (async () => {
      const me = await requireAuth(root, copy);
      if (me) {
        setBanner(root, "Signed in.", "ok");
      }
    })();
    root.querySelector("[data-password-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;
      setBusy(form, true);
      const data = new FormData(form);
      const result = await postJSON<MeResponse>("/auth/change-password", {
        current_password: String(data.get("current_password") ?? ""),
        new_password: String(data.get("new_password") ?? ""),
      });
      setBusy(form, false);
      const message = reportFailure(copy, result.status, result.data, "Password changed.");
      setBanner(root, message.text, message.kind);
    });
  });
</script>
