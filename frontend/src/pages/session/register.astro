---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Create account · Eduardoos">
  <section class="session-grid" data-session>
    <h1>Create account</h1>
    <p class="lede">New accounts stay pending until the email is verified. This page cannot authorize anything the Go API would deny.</p>
    <p class="status" data-banner>Loading session…</p>
    <form class="panel" data-register>
      <label>
        Email
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label>
        Username
        <input name="username" autocomplete="username" required minlength="3" maxlength="32" pattern="[a-z0-9_]+" />
      </label>
      <label>
        Password
        <input type="password" name="password" autocomplete="new-password" required minlength="8" maxlength="128" />
      </label>
      <p class="hint">Usernames are 3–32 characters: lowercase letters, digits, underscore. Passwords are 8–128 characters.</p>
      <button type="submit">Register</button>
      <p class="hint session-links">
        <a href="/session" data-route>Sign in</a>
        <a href="/session/verify-email" data-route>Verify email</a>
      </p>
    </form>
  </section>
</Layout>

<script>
  import { postJSON, type MeResponse } from "../../lib/api";
  import { reportFailure, onSessionPageReady, requireGuest, sessionCopy, setBanner, setBusy } from "../../lib/session-ui";

  onSessionPageReady((root) => {
    const copy = sessionCopy();
    void requireGuest(root, copy);
    root.querySelector("[data-register]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;
      setBusy(form, true);
      const data = new FormData(form);
      const result = await postJSON<MeResponse>("/auth/register", {
        email: String(data.get("email") ?? ""),
        username: String(data.get("username") ?? ""),
        password: String(data.get("password") ?? ""),
      });
      setBusy(form, false);
      const message = reportFailure(copy, result.status, result.data, "If that email can be used, a verification code was sent.");
      setBanner(root, message.text, message.kind);
    });
  });
</script>
