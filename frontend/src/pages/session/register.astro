---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Create account">
  <section class="session-grid" data-session>
    <p class="status" data-banner>Loading session…</p>
    <form class="panel" data-register>
      <label>
        Email
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label>
        Username
        <input name="username" autocomplete="username" required minlength="3" maxlength="32" pattern="[a-z0-9_]+" />
      </label>
      <label>
        Password
        <span class="password-field">
          <input type="password" name="password" autocomplete="new-password" required minlength="8" maxlength="128" data-password-input />
          <button type="button" class="password-field__toggle" data-password-toggle aria-label="Show password" aria-pressed="false" title="Show password">
            <span class="material-symbols-outlined" aria-hidden="true">visibility</span>
          </button>
        </span>
      </label>
      <p class="hint">Usernames are 3–32 characters: lowercase letters, digits, underscore. Passwords are 8–128 characters.</p>
      <button type="submit">Register</button>
      <p class="hint session-links">
        <a href="/session" data-route>Sign in</a>
        <a href="/session/verify-email" data-route>Verify email</a>
      </p>
    </form>
  </section>
</Layout>

<script>
  import { attachFormAntibot, consumeAntibot, isAntibotArmed } from "../../lib/antibot";
  import { postJSON, type MeResponse } from "../../lib/api";
  import { go } from "../../lib/router";
  import { reportFailure, onSessionPageReady, requireGuest, sessionCopy, setBanner, setBusy } from "../../lib/session-ui";

  onSessionPageReady((root) => {
    const copy = sessionCopy();
    void requireGuest(root, copy);
    const registerForm = root.querySelector("[data-register]");
    if (registerForm instanceof HTMLFormElement) {
      attachFormAntibot(registerForm);
    }
    root.querySelector("[data-register]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;
      const actionBtn = form.querySelector<HTMLButtonElement>("button[type='submit']");
      if (!isAntibotArmed(actionBtn)) return;
      consumeAntibot(actionBtn);
      setBusy(form, true);
      const data = new FormData(form);
      const result = await postJSON<MeResponse>("/auth/register", {
        email: String(data.get("email") ?? ""),
        username: String(data.get("username") ?? ""),
        password: String(data.get("password") ?? ""),
      });
      setBusy(form, false);
      const message = reportFailure(copy, result.status, result.data, "If that email can be used, a verification code was sent.");
      if (result.status === 200 && message.kind === "ok") {
        const email = String(data.get("email") ?? "");
        go(`/session/verify-email?email=${encodeURIComponent(email)}`);
        return;
      }
      setBanner(root, message.text, message.kind);
    });
  });
</script>
