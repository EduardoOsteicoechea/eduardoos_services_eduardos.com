---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Profile · Eduardoos">
  <section class="session-grid" data-session>
    <h1>Profile</h1>
    <p class="lede">Profile changes apply only to your account. The Go API remains the authority.</p>
    <p class="status" data-banner>Loading session…</p>
    <p class="panel" data-guest-fallback hidden>
      Sign in to view your profile.
      <span class="hint session-links">
        <a href="/session" data-route>Sign in</a>
      </span>
    </p>
    <div class="panel" data-authed-panel hidden>
      <h2>Profile</h2>
      <p class="hint" data-profile-summary></p>
      <img class="session-avatar" data-avatar-img hidden alt="Profile photo" />
      <p class="hint session-avatar-fallback" data-avatar-fallback hidden>No profile photo</p>
      <form data-profile-form>
        <label>
          Display name
          <input name="display_name" maxlength="80" />
        </label>
        <label>
          Username
          <input name="username" required minlength="3" maxlength="32" pattern="[a-z0-9_]+" />
        </label>
        <label>
          Phone (E.164)
          <input name="phone" placeholder="+15551234567" />
        </label>
        <button type="submit">Save profile</button>
      </form>
      <form data-avatar-form>
        <label>
          Avatar (JPEG, PNG, or WebP)
          <input type="file" name="file" accept="image/jpeg,image/png,image/webp" />
        </label>
        <button type="submit">Upload avatar</button>
        <button type="button" data-avatar-delete>Remove avatar</button>
      </form>
      <p class="hint session-links">
        <a href="/session/change-password" data-route>Change password</a>
        <a href="/api-docs" data-route>API docs</a>
      </p>
      <div data-apikeys>
        <h2>API keys</h2>
        <p class="hint">Keys are shown once. They require the api product entitlement. External clients use Bearer keys only for /api/v1; signed-in pages keep cookie auth.</p>
        <form data-apikey-form>
          <label>
            Label
            <input name="label" required maxlength="80" />
          </label>
          <button type="submit">Create key</button>
        </form>
        <p class="hint" data-apikey-secret hidden></p>
        <ul class="ereport-list" data-apikey-list></ul>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { deleteAvatar, getCsrf, patchJSON, uploadAvatar, type MeResponse } from "../../lib/api";
  import { createAPIKey, listAPIKeys, revokeAPIKey } from "../../lib/ereport";
  import { showErrorModal } from "../../lib/error-modal";
  import { fillProfile, reportFailure, requireAuth, sessionCopy, setBanner, setBusy } from "../../lib/session-ui";

  const root = document.querySelector("[data-session]");
  if (root instanceof HTMLElement) {
    const copy = sessionCopy();
    void getCsrf().then(async () => {
      const me = await requireAuth(root, copy);
      if (me) {
        fillProfile(root, me);
        setBanner(root, "Signed in. Profile changes apply only to your account.", "ok");
        await paintKeys();
      }
    });
    root.querySelector("[data-profile-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;
      setBusy(form, true);
      const data = new FormData(form);
      const phone = String(data.get("phone") ?? "").trim();
      const displayName = String(data.get("display_name") ?? "").trim();
      const result = await patchJSON<MeResponse>("/profile", {
        display_name: displayName === "" ? null : displayName,
        username: String(data.get("username") ?? ""),
        phone,
      });
      setBusy(form, false);
      const message = reportFailure(copy, result.status, result.data, "Profile saved.");
      setBanner(root, message.text, message.kind);
      if (result.status === 200) fillProfile(root, result.data);
    });
    root.querySelector("[data-avatar-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;
      const fileInput = form.elements.namedItem("file");
      if (!(fileInput instanceof HTMLInputElement) || !fileInput.files?.[0]) {
        setBanner(root, "Choose an image file.", "err");
        showErrorModal({ message: "Choose an image file." });
        return;
      }
      setBusy(form, true);
      const result = await uploadAvatar(fileInput.files[0]);
      setBusy(form, false);
      const message = reportFailure(copy, result.status, result.data, "Avatar updated.");
      setBanner(root, message.text, message.kind);
      if (result.status === 200) fillProfile(root, result.data);
    });
    root.querySelector("[data-avatar-delete]")?.addEventListener("click", async () => {
      const result = await deleteAvatar();
      const message = reportFailure(copy, result.status, result.data, "Avatar removed.");
      setBanner(root, message.text, message.kind);
      if (result.status === 200) fillProfile(root, result.data);
    });

    const paintKeys = async () => {
      const list = root.querySelector("[data-apikey-list]");
      if (!(list instanceof HTMLElement)) return;
      const res = await listAPIKeys();
      list.replaceChildren();
      if (res.status !== 200) return;
      for (const key of res.data.keys || []) {
        const li = document.createElement("li");
        li.textContent = `${key.label} · ${key.prefix}`;
        const btn = document.createElement("button");
        btn.type = "button";
        btn.textContent = "Revoke";
        btn.dataset.revokeKey = key.id;
        li.append(btn);
        list.append(li);
      }
    };

    root.querySelector("[data-apikey-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;
      setBusy(form, true);
      const result = await createAPIKey(String(new FormData(form).get("label") || ""));
      setBusy(form, false);
      const message = reportFailure(copy, result.status, result.data, "API key created.");
      setBanner(root, message.text, message.kind);
      const secret = root.querySelector("[data-apikey-secret]");
      if (secret instanceof HTMLElement && result.data.key) {
        secret.hidden = false;
        secret.textContent = result.data.key;
      }
      if (result.status === 201) await paintKeys();
    });

    root.addEventListener("click", async (event) => {
      const node = event.target;
      if (!(node instanceof HTMLElement) || !node.dataset.revokeKey) return;
      const result = await revokeAPIKey(node.dataset.revokeKey);
      const message = reportFailure(copy, result.status, result.data, "API key revoked.");
      setBanner(root, message.text, message.kind);
      if (result.status === 200) await paintKeys();
    });
  }
</script>
