---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Forgot password · Eduardoos">
  <section class="session-grid" data-session>
    <h1>Forgot password</h1>
    <p class="lede">Request a six-digit reset code. The response is the same whether or not the account exists.</p>
    <p class="status" data-banner>Loading session…</p>
    <form class="panel" data-request-reset>
      <h2>Request password reset</h2>
      <label>
        Email
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <button type="submit">Send reset code</button>
      <p class="hint session-links">
        <a href="/session" data-route>Sign in</a>
        <a href="/session/reset-password" data-route>Reset password</a>
      </p>
    </form>
  </section>
</Layout>

<script>
  import { postJSON, type MeResponse } from "../../lib/api";
  import { reportFailure, onSessionPageReady, requireGuest, sessionCopy, setBanner, setBusy } from "../../lib/session-ui";

  onSessionPageReady((root) => {
    const copy = sessionCopy();
    void requireGuest(root, copy);
    root.querySelector("[data-request-reset]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;
      setBusy(form, true);
      const data = new FormData(form);
      const result = await postJSON<MeResponse>("/auth/request-password-reset", { email: String(data.get("email") ?? "") });
      setBusy(form, false);
      const message = reportFailure(copy, result.status, result.data, "If that account exists, a reset code was sent.");
      setBanner(root, message.text, message.kind);
    });
  });
</script>
