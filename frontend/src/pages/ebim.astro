---
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import Layout from "../layouts/Layout.astro";
import { loadEbimDocs, type EbimDoc } from "../lib/ebimVault";

const docs = loadEbimDocs(
  join(dirname(fileURLToPath(import.meta.url)), "../../../iso19650_study_vault"),
);

const byId = new Map(docs.map((doc) => [doc.id, doc]));
const topicOf = (id: string) => {
  const doc = byId.get(id);
  if (!doc) throw new Error(`eBim topic missing: ${id}`);
  return doc;
};

const topics: { id: string; nav: string; summary: EbimDoc; sources: EbimDoc | null }[] = [
  { id: "index", nav: "Mapa", summary: topicOf("index"), sources: null },
  { id: "concepts", nav: "Conceptos", summary: topicOf("p1-summary"), sources: topicOf("p1-sources") },
  { id: "delivery", nav: "Entrega", summary: topicOf("p2-summary"), sources: topicOf("p2-sources") },
  { id: "operation", nav: "Operación", summary: topicOf("p3-summary"), sources: topicOf("p3-sources") },
  { id: "exchange", nav: "Intercambio", summary: topicOf("p4-summary"), sources: topicOf("p4-sources") },
  { id: "security", nav: "Seguridad", summary: topicOf("p5-summary"), sources: topicOf("p5-sources") },
  { id: "openbim", nav: "Formatos abiertos", summary: topicOf("p6-summary"), sources: topicOf("p6-sources") },
  { id: "plan", nav: "Preguntas", summary: topicOf("plan"), sources: null },
];

const references = docs.filter((doc) => doc.subgroup);
---

<Layout
  title="eBim"
  description="Admin study reader for the ISO 19650 series and the openBIM notes kept with this site."
  robots="noindex,nofollow"
>
  <p class="status" data-ebim-status>Comprobando la sesión…</p>

  <div class="ebim" data-ebim hidden>
    <aside class="ebim-nav" data-ebim-nav>
      <button
        class="ebim-nav__collapse icon-btn"
        type="button"
        data-ebim-collapse
        aria-expanded="true"
        aria-controls="ebim-toc"
        aria-label="Cerrar el índice"
        title="Cerrar el índice"
      >
        <span class="material-symbols-outlined" aria-hidden="true" data-ebim-collapse-icon>left_panel_close</span>
      </button>
      <nav id="ebim-toc" aria-label="Temas">
        <div class="ebim-nav__items">
          {
            topics.map((topic) => (
              <button type="button" data-ebim-open={topic.id}>
                {topic.nav}
              </button>
            ))
          }
          <details class="ebim-nav__group">
            <summary>Consulta técnica</summary>
            <div class="ebim-nav__items">
              {
                references.map((doc) => (
                  <button type="button" data-ebim-open={doc.id}>
                    {doc.label}
                  </button>
                ))
              }
            </div>
          </details>
        </div>
      </nav>
    </aside>

    <article class="ebim-read">
      {
        topics.map((topic) => (
          <section id={`ebim-${topic.id}`} class="ebim-topic" data-ebim-section={topic.id}>
            <header class="ebim-guide">
              <p class="ebim-guide__kicker">{topic.nav}</p>
              <p class="ebim-guide__text">{topic.summary.guide}</p>
            </header>
            <div class="ebim-doc" set:html={topic.summary.html} />
            {
              topic.sources ? (
                <div class="ebim-sources" id={`ebim-${topic.sources.id}`}>
                  <h2 class="ebim-sources__title">Fuentes</h2>
                  <p class="ebim-sources__note">{topic.sources.guide}</p>
                  <div class="ebim-doc" set:html={topic.sources.html} />
                </div>
              ) : null
            }
          </section>
        ))
      }
      <section id="ebim-reference" class="ebim-topic" data-ebim-section="reference">
        <header class="ebim-guide ebim-guide--reference">
          <p class="ebim-guide__kicker">Consulta técnica</p>
          <p class="ebim-guide__text">
            Manual y esquema de IDS, en inglés. Está aquí para comprobar un detalle, no para leerlo como el resto de la página.
          </p>
        </header>
        {
          references.map((doc) => (
            <section id={`ebim-${doc.id}`} class="ebim-ref" data-ebim-section={doc.id}>
              <h2 class="ebim-sources__title">{doc.label}</h2>
              <p class="ebim-sources__note">{doc.guide}</p>
              <div class="ebim-doc" set:html={doc.html} />
            </section>
          ))
        }
      </section>
    </article>
  </div>
</Layout>

<script>
  import { getMe } from "../lib/api";
  import { mustLog } from "../lib/dev-log";
  import { go } from "../lib/router";

  const status = document.querySelector("[data-ebim-status]");
  const root = document.querySelector("[data-ebim]");

  const fail = (message: string) => {
    if (status instanceof HTMLElement) {
      status.textContent = message;
      status.className = "status err";
    }
  };

  if (root instanceof HTMLElement) {
    const openers = [...root.querySelectorAll<HTMLButtonElement>("[data-ebim-open]")];
    const collapse = root.querySelector("[data-ebim-collapse]");
    const toc = root.querySelector("#ebim-toc");
    const collapseIcon = root.querySelector("[data-ebim-collapse-icon]");

    const mark = (id: string) => {
      for (const button of openers) {
        if (button.getAttribute("data-ebim-open") === id) button.setAttribute("aria-current", "page");
        else button.removeAttribute("aria-current");
      }
    };

    const goTo = (id: string) => {
      const section = root.querySelector(`#ebim-${id}`);
      if (!(section instanceof HTMLElement)) return;
      const opener = openers.find((button) => button.getAttribute("data-ebim-open") === id);
      const details = opener?.closest("details");
      if (details) details.open = true;
      section.scrollIntoView({ block: "start" });
      mark(id);
      if (mustLog) console.log("ebim.section", { id });
    };

    root.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const opener = target.closest("[data-ebim-open]");
      if (opener instanceof HTMLButtonElement && root.contains(opener)) {
        const id = opener.getAttribute("data-ebim-open");
        if (id) goTo(id);
        return;
      }
      const jump = target.closest("[data-ebim-jump]");
      if (jump instanceof HTMLAnchorElement && root.contains(jump)) {
        event.preventDefault();
        const id = jump.getAttribute("data-ebim-jump");
        if (id) goTo(id);
      }
    });

    const observed = [...root.querySelectorAll<HTMLElement>(".ebim-topic, .ebim-ref")];
    if (typeof IntersectionObserver !== "undefined" && observed.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          const id = visible?.target.getAttribute("data-ebim-section");
          if (id) mark(id);
        },
        { rootMargin: "-6rem 0rem -12rem 0rem", threshold: [0.1, 0.6] },
      );
      for (const section of observed) observer.observe(section);
    }
    collapse?.addEventListener("click", () => {
      const expanded = collapse.getAttribute("aria-expanded") !== "false";
      const nextExpanded = !expanded;
      collapse.setAttribute("aria-expanded", nextExpanded ? "true" : "false");
      collapse.setAttribute("aria-label", nextExpanded ? "Cerrar el índice" : "Abrir el índice");
      collapse.setAttribute("title", nextExpanded ? "Cerrar el índice" : "Abrir el índice");
      if (toc instanceof HTMLElement) toc.hidden = !nextExpanded;
      if (collapseIcon instanceof HTMLElement) {
        collapseIcon.textContent = nextExpanded ? "left_panel_close" : "left_panel_open";
      }
      root.classList.toggle("ebim--nav-closed", !nextExpanded);
    });

    const start = async () => {
      const me = await getMe();
      const isAdmin = me.status === 200 && String(me.data.role || "").trim().toLowerCase() === "admin";
      if (mustLog) console.log("ebim.session", { status: me.status, isAdmin, requestId: me.requestId });
      if (!isAdmin) {
        fail("Esta página solo está disponible para administradores.");
        go("/404");
        return;
      }
      if (status instanceof HTMLElement) status.hidden = true;
      root.hidden = false;
      mark("index");
    };

    void start();
  }
</script>
