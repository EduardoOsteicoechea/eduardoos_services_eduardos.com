---
import Layout from "../layouts/Layout.astro";
import { loadCurriculum } from "../lib/ebimCurriculum";

const screens = loadCurriculum();
const groups: { id: string; label: string; items: typeof screens }[] = [];
for (const screen of screens) {
  let group = groups.find((item) => item.id === screen.group);
  if (!group) {
    group = { id: screen.group, label: screen.groupLabel, items: [] };
    groups.push(group);
  }
  group.items.push(screen);
}
---

<Layout
  title="eBim"
  description="ISO 19650 and openBIM reading, from fundamentals to particulars."
  robots="noindex,nofollow"
>
  <p class="status" data-ebim-status>Checking the session…</p>

  <div class="ebim" data-ebim hidden>
    <aside class="ebim-nav" data-ebim-nav>
      <button
        class="ebim-nav__collapse icon-btn"
        type="button"
        data-ebim-collapse
        aria-expanded="true"
        aria-controls="ebim-toc"
        aria-label="Close the contents"
        title="Close the contents"
      >
        <span class="material-symbols-outlined" aria-hidden="true" data-ebim-collapse-icon>left_panel_close</span>
      </button>
      <nav id="ebim-toc" aria-label="Topics, from fundamentals to particulars">
        {
          groups.map((group) => (
            <details class="ebim-nav__group" open={group.id === "base"}>
              <summary>{group.label}</summary>
              <div class="ebim-nav__items">
                {group.items.map((screen) => (
                  <button type="button" data-ebim-open={screen.id}>
                    {screen.nav}
                  </button>
                ))}
              </div>
            </details>
          ))
        }
      </nav>
    </aside>

    <div class="ebim-read">
      <div class="ebim-pager">
        <button type="button" data-ebim-prev>Previous</button>
        <p class="ebim-pager__label" data-ebim-label></p>
        <button type="button" data-ebim-next>Next</button>
      </div>
      {
        screens.map((screen) => (
          <section id={`ebim-${screen.id}`} data-ebim-section={screen.id} hidden>
            <div class="ebim-doc" set:html={screen.html} />
          </section>
        ))
      }
    </div>
  </div>
</Layout>

<script>
  import { mustLog } from "../lib/dev-log";
  import { requireService } from "../lib/productGate";
  import { go } from "../lib/router";

  const status = document.querySelector("[data-ebim-status]");
  const root = document.querySelector("[data-ebim]");

  const fail = (message: string) => {
    if (status instanceof HTMLElement) {
      status.textContent = message;
      status.className = "status err";
    }
  };

  if (root instanceof HTMLElement) {
    const sections = [...root.querySelectorAll<HTMLElement>("[data-ebim-section]")];
    const openers = [...root.querySelectorAll<HTMLButtonElement>("[data-ebim-open]")];
    const prev = root.querySelector("[data-ebim-prev]");
    const next = root.querySelector("[data-ebim-next]");
    const label = root.querySelector("[data-ebim-label]");
    const collapse = root.querySelector("[data-ebim-collapse]");
    const toc = root.querySelector("#ebim-toc");
    const collapseIcon = root.querySelector("[data-ebim-collapse-icon]");
    let index = 0;

    const show = (nextIndex: number, scroll = false) => {
      index = Math.min(Math.max(nextIndex, 0), sections.length - 1);
      const id = sections[index]?.getAttribute("data-ebim-section") || "";
      for (const section of sections) {
        section.hidden = section.getAttribute("data-ebim-section") !== id;
      }
      for (const button of openers) {
        const current = button.getAttribute("data-ebim-open") === id;
        if (current) button.setAttribute("aria-current", "page");
        else button.removeAttribute("aria-current");
        const details = button.closest("details");
        if (current && details) details.open = true;
      }
      const opener = openers.find((button) => button.getAttribute("data-ebim-open") === id);
      if (label instanceof HTMLElement) {
        label.textContent = opener?.textContent?.trim() || "";
      }
      if (prev instanceof HTMLButtonElement) prev.disabled = index === 0;
      if (next instanceof HTMLButtonElement) next.disabled = index === sections.length - 1;
      if (mustLog) console.log("ebim.section", { id, index });
      if (scroll) sections[index]?.scrollIntoView({ block: "start" });
    };

    root.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element) || !root.contains(target)) return;
      const opener = target.closest("[data-ebim-open]");
      if (opener instanceof HTMLButtonElement) {
        const id = opener.getAttribute("data-ebim-open");
        const found = sections.findIndex((section) => section.getAttribute("data-ebim-section") === id);
        if (found >= 0) show(found, true);
      }
    });

    prev?.addEventListener("click", () => show(index - 1, true));
    next?.addEventListener("click", () => show(index + 1, true));
    collapse?.addEventListener("click", () => {
      const expanded = collapse.getAttribute("aria-expanded") !== "false";
      const nextExpanded = !expanded;
      collapse.setAttribute("aria-expanded", nextExpanded ? "true" : "false");
      collapse.setAttribute("aria-label", nextExpanded ? "Close the contents" : "Open the contents");
      collapse.setAttribute("title", nextExpanded ? "Close the contents" : "Open the contents");
      if (toc instanceof HTMLElement) toc.hidden = !nextExpanded;
      if (collapseIcon instanceof HTMLElement) {
        collapseIcon.textContent = nextExpanded ? "left_panel_close" : "left_panel_open";
      }
      root.classList.toggle("ebim--nav-closed", !nextExpanded);
    });

    const start = async () => {
      const result = await requireService("ebim", { requireSubscription: true });
      const allowed = result.sessionOk && (result.access.isAdmin || result.access.hasEntitlement);
      if (mustLog) console.log("ebim.session", { allowed, isAdmin: result.access.isAdmin });
      if (!allowed) {
        fail("Subscription required.");
        go("/404");
        return;
      }
      if (status instanceof HTMLElement) status.hidden = true;
      root.hidden = false;
      show(0);
    };

    void start();
  }
</script>
