---
import { Fragment } from "astro/jsx-runtime";
import Layout from "../../../layouts/Layout.astro";
---

<Layout
  title="Estudiantes MPPE"
  description="Gestiona los niños del currículo MPPE."
  page="eoschool-students"
  robots="noindex,nofollow"
>
  <Fragment slot="dhs">
    <a class="dhs-action" href="/eoschool" data-route title="Dashboard" aria-label="Dashboard">
      <span class="icon-btn" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">dashboard</span></span>
      Dashboard
    </a>
    <a class="dhs-action" href="/eoschool/students/register" data-route title="Registrar" aria-label="Registrar">
      <span class="icon-btn" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">person_add</span></span>
      Registrar
    </a>
  </Fragment>

  <section class="product-dash page-span-all" data-students>
    <p class="status" data-banner>Cargando…</p>
    <div data-gate hidden class="product-gate">
      <p class="hint">Necesitas sesión y suscripción Homescool.</p>
      <a class="button" href="/session" data-route>Sign in</a>
    </div>
    <div class="product-dash__grid" data-list hidden></div>
  </section>
</Layout>

<script>
  import {
    deleteCurriculumStudent,
    fetchCurriculumStudents,
    updateCurriculumStudent,
    type CurriculumStudent,
  } from "../../../lib/eoschool-curriculum-api";
  import { apiFail, onAstroPageLoad, requireService, setHidden } from "../../../lib/productGate";

  onAstroPageLoad("eoschool-students", async () => {
    const root = document.querySelector("[data-students]");
    const banner = root?.querySelector("[data-banner]");
    const gate = root?.querySelector("[data-gate]");
    const list = root?.querySelector("[data-list]");
    if (banner instanceof HTMLElement) {
      banner.hidden = false;
      banner.textContent = "Cargando…";
    }

    const access = await requireService("homescool", { requireSubscription: true });
    if (!access.sessionOk || !access.access.allowed) {
      if (banner instanceof HTMLElement) {
        banner.textContent = access.sessionOk
          ? "Necesitas suscripción Homescool."
          : "Inicia sesión para continuar.";
      }
      setHidden(gate, false);
      setHidden(list, true);
      return;
    }
    setHidden(gate, true);
    setHidden(list, false);
    await reloadList(banner, list);
  });

  async function reloadList(banner: Element | null | undefined, list: Element | null | undefined) {
    const loaded = await fetchCurriculumStudents();
    if (!loaded.ok) {
      apiFail("No se pudo cargar estudiantes.", { requestId: loaded.requestId });
      return;
    }
    if (!(list instanceof HTMLElement)) return;
    const students = loaded.data.students;
    if (banner instanceof HTMLElement) {
      banner.textContent = students.length
        ? `${students.length} estudiante(s)`
        : "Sin estudiantes. Registra el primero.";
    }
    list.replaceChildren();
    for (const s of students) {
      list.appendChild(renderCard(s));
    }
  }

  function iconAction(
    tag: "a" | "button",
    opts: { icon: string; label: string; danger?: boolean; href?: string },
  ): HTMLElement {
    const el = document.createElement(tag);
    el.className = opts.danger
      ? "icon-btn eoschool-students__action eoschool-students__action--danger"
      : "icon-btn eoschool-students__action";
    el.title = opts.label;
    el.setAttribute("aria-label", opts.label);
    if (tag === "a" && opts.href) {
      (el as HTMLAnchorElement).href = opts.href;
      (el as HTMLAnchorElement).dataset.route = "";
    } else {
      (el as HTMLButtonElement).type = "button";
    }
    const icon = document.createElement("span");
    icon.className = "material-symbols-outlined";
    icon.setAttribute("aria-hidden", "true");
    icon.textContent = opts.icon;
    el.append(icon);
    return el;
  }

  function photoSrc(url: string | undefined): string {
    if (!url) return "";
    const sep = url.includes("?") ? "&" : "?";
    return `${url}${sep}v=${Date.now()}`;
  }

  function renderCard(s: CurriculumStudent): HTMLElement {
    const card = document.createElement("article");
    card.className = "product-dash__card eoschool-students__card";
    card.dataset.studentKey = s.studentKey;

    const profile = document.createElement("div");
    profile.className = "eoschool-students__profile";

    const fileInput = document.createElement("input");
    fileInput.type = "file";
    fileInput.accept = "image/jpeg,image/png,image/webp";
    fileInput.className = "eoschool-students__photo-input";
    fileInput.setAttribute("aria-label", `Subir foto de ${s.displayName}`);

    const avatarBtn = document.createElement("button");
    avatarBtn.type = "button";
    avatarBtn.className = "eoschool-students__avatar";
    avatarBtn.title = "Subir o cambiar foto";
    avatarBtn.setAttribute("aria-label", `Subir o cambiar foto de ${s.displayName}`);

    const avatarImg = document.createElement("img");
    avatarImg.className = "eoschool-students__photo";
    avatarImg.alt = "";
    const avatarPlaceholder = document.createElement("span");
    avatarPlaceholder.className = "material-symbols-outlined eoschool-students__avatar-icon";
    avatarPlaceholder.setAttribute("aria-hidden", "true");
    avatarPlaceholder.textContent = "person";
    const cameraBadge = document.createElement("span");
    cameraBadge.className = "eoschool-students__avatar-badge material-symbols-outlined";
    cameraBadge.setAttribute("aria-hidden", "true");
    cameraBadge.textContent = "photo_camera";

    if (s.hasPhoto && s.photoUrl) {
      avatarImg.src = photoSrc(s.photoUrl);
      avatarImg.hidden = false;
      avatarPlaceholder.hidden = true;
    } else {
      avatarImg.hidden = true;
      avatarPlaceholder.hidden = false;
    }
    avatarBtn.append(avatarImg, avatarPlaceholder, cameraBadge);

    const identity = document.createElement("div");
    identity.className = "eoschool-students__identity";
    const title = document.createElement("h2");
    title.className = "product-dash__card-title";
    title.textContent = s.displayName;
    const desc = document.createElement("p");
    desc.className = "product-dash__card-desc";
    desc.textContent = `${s.age} años · ${s.grade} · ${s.studentKey}`;
    identity.append(title, desc);

    profile.append(avatarBtn, fileInput, identity);

    avatarBtn.addEventListener("click", () => fileInput.click());
    fileInput.addEventListener("change", async () => {
      const file = fileInput.files?.[0];
      fileInput.value = "";
      if (!(file instanceof File) || file.size <= 0) return;
      const res = await updateCurriculumStudent(s.studentKey, { photo: file });
      if (!res.ok) {
        apiFail(res.error, { requestId: res.requestId });
        return;
      }
      await reloadList(
        document.querySelector("[data-students] [data-banner]"),
        document.querySelector("[data-students] [data-list]"),
      );
    });

    const actions = document.createElement("div");
    actions.className = "eoschool-students__actions";

    const study = iconAction("a", {
      icon: "school",
      label: "Estudio",
      href: `/eoschool/requirements/curriculum?mode=study&studentKey=${encodeURIComponent(s.studentKey)}`,
    });
    const progress = iconAction("a", {
      icon: "monitoring",
      label: "Progreso",
      href: `/eoschool/progress?studentKey=${encodeURIComponent(s.studentKey)}`,
    });
    const portfolio = iconAction("a", {
      icon: "folder_special",
      label: "Portafolio",
      href: `/eoschool/portfolio?studentKey=${encodeURIComponent(s.studentKey)}`,
    });
    const edit = iconAction("button", { icon: "edit", label: "Editar" });
    const del = iconAction("button", { icon: "delete", label: "Eliminar", danger: true });

    const form = document.createElement("form");
    form.className = "eoschool-students__edit";
    form.hidden = true;
    const previewSrc =
      s.hasPhoto && s.photoUrl
        ? photoSrc(s.photoUrl)
        : "";
    form.innerHTML = `
      <div class="eoschool-students__photo-field">
        <span class="eoschool-students__photo-label">Foto de perfil</span>
        <div class="eoschool-students__photo-row">
          <img class="eoschool-students__photo eoschool-students__photo--preview" data-edit-preview alt="" ${
            previewSrc ? `src="${escapeAttr(previewSrc)}"` : "hidden"
          } />
          <span class="material-symbols-outlined eoschool-students__avatar-icon" data-edit-placeholder ${
            previewSrc ? "hidden" : ""
          } aria-hidden="true">person</span>
          <label class="eoschool-students__photo-pick">
            Elegir imagen
            <input name="photo" type="file" accept="image/jpeg,image/png,image/webp" />
          </label>
        </div>
        ${
          s.hasPhoto
            ? `<label class="eoschool-students__clear-photo"><input name="clearPhoto" type="checkbox" value="true" /> Quitar foto</label>`
            : ""
        }
      </div>
      <label>Nombre <input name="firstName" required maxlength="80" value="${escapeAttr(s.firstName || "")}" /></label>
      <label>Apellido <input name="lastName" required maxlength="80" value="${escapeAttr(s.lastName || "")}" /></label>
      <label>Edad <input name="age" type="number" min="3" max="18" required value="${s.age}" /></label>
      <label>Grado <input name="grade" required maxlength="80" value="${escapeAttr(s.grade)}" /></label>
      <div class="eoschool-students__edit-actions">
        <button type="submit" class="button">Guardar</button>
        <button type="button" class="button" data-cancel-edit>Cancelar</button>
      </div>
    `;

    const editPhoto = form.querySelector<HTMLInputElement>('input[name="photo"]');
    const editPreview = form.querySelector<HTMLImageElement>("[data-edit-preview]");
    const editPlaceholder = form.querySelector<HTMLElement>("[data-edit-placeholder]");
    editPhoto?.addEventListener("change", () => {
      const file = editPhoto.files?.[0];
      if (!(file instanceof File) || !editPreview) return;
      const url = URL.createObjectURL(file);
      editPreview.src = url;
      editPreview.hidden = false;
      if (editPlaceholder) editPlaceholder.hidden = true;
    });

    edit.addEventListener("click", () => {
      form.hidden = !form.hidden;
    });
    form.querySelector("[data-cancel-edit]")?.addEventListener("click", () => {
      form.hidden = true;
    });
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const fd = new FormData(form);
      const photo = fd.get("photo");
      const clearPhoto = fd.get("clearPhoto") === "true";
      const res = await updateCurriculumStudent(s.studentKey, {
        firstName: String(fd.get("firstName") || "").trim(),
        lastName: String(fd.get("lastName") || "").trim(),
        age: Number(fd.get("age") || 0),
        grade: String(fd.get("grade") || "").trim(),
        photo: !clearPhoto && photo instanceof File && photo.size > 0 ? photo : null,
        clearPhoto,
      });
      if (!res.ok) {
        apiFail(res.error, { requestId: res.requestId });
        return;
      }
      await reloadList(
        document.querySelector("[data-students] [data-banner]"),
        document.querySelector("[data-students] [data-list]"),
      );
    });

    del.addEventListener("click", async () => {
      if (!confirm(`¿Eliminar a ${s.displayName}? Esta acción no se puede deshacer.`)) return;
      const res = await deleteCurriculumStudent(s.studentKey);
      if (!res.ok) {
        apiFail(res.error, { requestId: res.requestId });
        return;
      }
      card.remove();
      const liveBanner = document.querySelector("[data-students] [data-banner]");
      const liveList = document.querySelector("[data-students] [data-list]");
      if (liveBanner instanceof HTMLElement && liveList instanceof HTMLElement) {
        const n = liveList.querySelectorAll(".eoschool-students__card").length;
        liveBanner.textContent = n ? `${n} estudiante(s)` : "Sin estudiantes. Registra el primero.";
      }
    });

    actions.append(study, progress, portfolio, edit, del);
    card.append(profile, actions, form);
    return card;
  }

  function escapeAttr(value: string): string {
    return value
      .replace(/&/g, "&amp;")
      .replace(/"/g, "&quot;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;");
  }
</script>

<style>
  /* Cards are built in JS — scoped selectors never match; use :global. */
  :global(.eoschool-students__card) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-padding);
    cursor: default;
  }

  :global(.eoschool-students__profile) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-padding);
    min-width: 0;
  }

  :global(.eoschool-students__identity) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  :global(.eoschool-students__avatar) {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.5rem;
    height: 4.5rem;
    padding: 0;
    overflow: hidden;
    color: var(--color-text);
    background: var(--color-bg);
    border: var(--border-width) solid var(--color-border);
    border-radius: 50%;
    cursor: pointer;
  }

  :global(.eoschool-students__avatar:hover),
  :global(.eoschool-students__avatar:focus-visible) {
    border-color: var(--color-accent);
  }

  :global(.eoschool-students__photo) {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    object-fit: cover;
  }

  :global(.eoschool-students__photo--preview) {
    width: 3.5rem;
    height: 3.5rem;
  }

  :global(.eoschool-students__avatar .material-symbols-outlined),
  :global(.eoschool-students__photo-row .material-symbols-outlined) {
    width: auto;
    height: auto;
    background: transparent;
  }

  :global(.eoschool-students__avatar-icon) {
    font-size: var(--font-size-2xl);
    color: var(--color-muted);
  }

  :global(.eoschool-students__avatar-badge) {
    position: absolute;
    right: 0.15rem;
    bottom: 0.15rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    font-size: var(--font-size-sm);
    color: var(--color-bg);
    background: var(--color-text);
    border-radius: 50%;
  }

  :global(.eoschool-students__photo-input) {
    position: absolute;
    width: 0;
    height: 0;
    opacity: 0;
    overflow: hidden;
  }

  :global(.eoschool-students__actions) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--rail-gap);
  }

  :global(.eoschool-students__action.icon-btn) {
    color: var(--color-text);
    background: transparent;
    border: var(--border-width) solid var(--color-border);
  }

  :global(.eoschool-students__action.icon-btn:hover),
  :global(.eoschool-students__action.icon-btn:focus-visible) {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  :global(.eoschool-students__action .material-symbols-outlined) {
    display: inline-flex;
    width: auto;
    height: auto;
    font-size: var(--icon-size);
    color: inherit;
    background: transparent;
  }

  :global(.eoschool-students__action--danger.icon-btn) {
    color: var(--color-err);
    border-color: var(--color-err);
  }

  :global(.eoschool-students__action--danger.icon-btn:hover),
  :global(.eoschool-students__action--danger.icon-btn:focus-visible) {
    color: var(--color-err);
    border-color: var(--color-err);
  }

  :global(.eoschool-students__edit) {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--rail-gap);
    max-width: 24rem;
  }

  :global(.eoschool-students__edit label) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: var(--font-size-sm);
  }

  :global(.eoschool-students__edit input:not([type="file"]):not([type="checkbox"])),
  :global(.eoschool-students__edit .button) {
    min-height: var(--control-height);
    padding: var(--control-padding-block) var(--control-padding-inline);
    font-size: var(--font-size-md);
    color: var(--color-text);
    background: var(--color-bg);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius);
  }

  :global(.eoschool-students__photo-field) {
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
  }

  :global(.eoschool-students__photo-label) {
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }

  :global(.eoschool-students__photo-row) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--rail-gap);
  }

  :global(.eoschool-students__photo-pick) {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--control-height);
    padding: var(--control-padding-block) var(--control-padding-inline);
    font-size: var(--font-size-sm);
    color: var(--color-text);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius);
    cursor: pointer;
  }

  :global(.eoschool-students__photo-pick input) {
    position: absolute;
    width: 0;
    height: 0;
    opacity: 0;
    overflow: hidden;
  }

  :global(.eoschool-students__clear-photo) {
    flex-direction: row;
    align-items: center;
    gap: var(--rail-gap);
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }

  :global(.eoschool-students__edit-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--rail-gap);
  }
</style>
