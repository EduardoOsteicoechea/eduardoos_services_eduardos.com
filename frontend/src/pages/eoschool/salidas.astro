---
import { Fragment } from "astro/jsx-runtime";
import EoschoolDashBack from "../../components/EoschoolDashBack.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Salidas"
  description="Planilla de salidas pedagógicas del estudiante."
  page="eoschool-salidas"
  robots="noindex,nofollow"
>
  <Fragment slot="dhs">
    <a class="dhs-action" href="/eoschool" data-route title="Dashboard" aria-label="Dashboard">
      <span class="icon-btn" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">dashboard</span></span>
      Dashboard
    </a>
  </Fragment>

  <section class="product-dash page-span-all" data-salidas>
    <EoschoolDashBack />
    <p class="status" data-banner>Cargando…</p>
    <div data-gate hidden class="product-gate">
      <p class="hint">Necesitas sesión y suscripción Homescool.</p>
      <a class="button" href="/session" data-route>Sign in</a>
    </div>
    <article class="product-dash__card" data-authed hidden>
      <h2 class="product-dash__card-title">Salidas pedagógicas o educativas</h2>
      <p class="product-dash__card-desc">
        La misma planilla: fecha, semestre, lugar, objetivo, materia y qué se aprendió.
        En 3.er grado no hay un número mínimo de salidas. La planilla sí tiene que existir.
      </p>
      <label>
        Estudiante
        <select data-student-select></select>
      </label>
      <p data-student-meta></p>
      <label>
        Año
        <input data-year type="text" maxlength="9" autocomplete="off" />
      </label>
      <div data-rows></div>
      <div class="eoschool-salidas__actions">
        <button type="button" class="button" data-add>Agregar fila</button>
        <button type="button" class="button" data-save>Guardar planilla</button>
      </div>
      <p class="hint" data-status></p>
    </article>
  </section>
</Layout>

<script>
  import {
    fetchCurriculumProgress,
    fetchCurriculumStudents,
    putCurriculumOutings,
    type CurriculumOuting,
    type CurriculumStudent,
  } from "../../lib/eoschool-curriculum-api";
  import { apiFail, onAstroPageLoad, requireService, setHidden } from "../../lib/productGate";

  type Row = CurriculumOuting;

  function field(label: string, name: string, value: string): HTMLLabelElement {
    const wrap = document.createElement("label");
    wrap.textContent = label;
    const input = document.createElement("input");
    input.name = name;
    input.value = value;
    input.autocomplete = "off";
    if (name === "date") input.type = "date";
    if (name === "semester") {
      input.remove();
      const select = document.createElement("select");
      select.name = name;
      for (const semester of [1, 2]) {
        const option = document.createElement("option");
        option.value = String(semester);
        option.textContent = semester === 1 ? "1.er semestre" : "2.º semestre";
        if (String(semester) === value) option.selected = true;
        select.append(option);
      }
      wrap.append(select);
      return wrap;
    }
    input.maxLength = name === "date" ? 10 : 200;
    wrap.append(input);
    return wrap;
  }

  function renderRow(host: HTMLElement, row: Partial<Row>) {
    const card = document.createElement("div");
    card.className = "eoschool-salidas__row";
    card.append(
      field("Fecha", "date", row.date ?? ""),
      field("Semestre", "semester", String(row.semester ?? 1)),
      field("Entidad o lugar visitado", "place", row.place ?? ""),
      field("Objetivo de la salida", "objective", row.objective ?? ""),
      field("Asignatura relacionada", "subject", row.subject ?? ""),
      field("Evaluación o aspectos significativos", "notes", row.notes ?? ""),
    );
    const remove = document.createElement("button");
    remove.type = "button";
    remove.className = "button";
    remove.textContent = "Quitar fila";
    remove.addEventListener("click", () => card.remove());
    card.append(remove);
    host.append(card);
  }

  function readRows(host: HTMLElement): { ok: true; rows: CurriculumOuting[] } | { ok: false } {
    const rows: CurriculumOuting[] = [];
    for (const card of host.querySelectorAll<HTMLElement>(".eoschool-salidas__row")) {
      const value = (name: string) =>
        (card.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${name}"]`)?.value ?? "").trim();
      const date = value("date");
      const place = value("place");
      const objective = value("objective");
      const subject = value("subject");
      const notes = value("notes");
      if (!date && !place && !objective && !subject && !notes) continue;
      if (!date || !place || !objective || !subject || !notes) return { ok: false };
      rows.push({
        date,
        semester: Number(value("semester")) || 1,
        place,
        objective,
        subject,
        notes,
      });
    }
    return { ok: true, rows };
  }

  onAstroPageLoad("eoschool-salidas", async () => {
    const root = document.querySelector("[data-salidas]");
    const banner = root?.querySelector("[data-banner]");
    const gate = root?.querySelector("[data-gate]");
    const authed = root?.querySelector("[data-authed]");
    const select = root?.querySelector<HTMLSelectElement>("[data-student-select]");
    const meta = root?.querySelector("[data-student-meta]");
    const year = root?.querySelector<HTMLInputElement>("[data-year]");
    const rows = root?.querySelector<HTMLElement>("[data-rows]");
    const statusEl = root?.querySelector("[data-status]");
    if (banner instanceof HTMLElement) banner.textContent = "Cargando…";
    const access = await requireService("homescool", { requireSubscription: true, adminOnly: true });
    if (!access.sessionOk || !access.access.allowed) {
      if (banner instanceof HTMLElement) {
        banner.textContent = access.sessionOk ? "Necesitas suscripción Homescool." : "Inicia sesión para continuar.";
      }
      setHidden(gate, false);
      setHidden(authed, true);
      return;
    }
    setHidden(gate, true);
    setHidden(authed, false);
    if (banner instanceof HTMLElement) banner.hidden = true;
    if (!select || !rows || !year) return;

    const students = await fetchCurriculumStudents();
    const list: CurriculumStudent[] = students.ok ? students.data.students : [];
    select.replaceChildren();
    for (const student of list) {
      const option = document.createElement("option");
      option.value = student.studentKey;
      option.textContent = student.displayName || student.studentKey;
      select.append(option);
    }

    async function load() {
      rows.replaceChildren();
      const loaded = await fetchCurriculumProgress(select.value);
      if (!loaded.ok) {
        apiFail("No se pudo abrir la planilla.", { requestId: loaded.requestId });
        return;
      }
      const student = loaded.data.student;
      if (meta) meta.textContent = `${student.displayName}. Grado: ${student.grade}.`;
      year.value = loaded.data.outingYear || "";
      const saved = loaded.data.outings ?? [];
      if (saved.length === 0) renderRow(rows, {});
      for (const row of saved) renderRow(rows, row);
      if (statusEl) statusEl.textContent = saved.length === 0 ? "Todavía no hay filas guardadas." : `${saved.length} filas en eoschool.`;
    }

    select.addEventListener("change", () => {
      void load().catch((err: unknown) => {
        apiFail(err instanceof Error ? err.message : "No se pudo abrir la planilla.");
      });
    });
    root?.querySelector("[data-add]")?.addEventListener("click", () => renderRow(rows, {}));
    root?.querySelector("[data-save]")?.addEventListener("click", () => {
      const parsed = readRows(rows);
      if (!parsed.ok) {
        apiFail("Cada fila necesita fecha, lugar, objetivo, materia y qué se aprendió.");
        return;
      }
      void putCurriculumOutings({ studentKey: select.value, year: year.value.trim(), outings: parsed.rows })
        .then(async () => {
          if (statusEl) statusEl.textContent = "Planilla guardada en eoschool.";
          await load();
        })
        .catch((err: unknown) => {
          const requestId = err && typeof err === "object" && "requestId" in err ? String((err as { requestId?: string }).requestId ?? "") : "";
          apiFail(err instanceof Error ? err.message : "No se pudo guardar la planilla.", { requestId });
        });
    });
    if (select.value) await load();
  });
</script>

<style>
  .eoschool-salidas__row,
  .eoschool-salidas__actions,
  [data-salidas] .product-dash__card {
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
    min-width: 0;
  }

  .eoschool-salidas__row {
    padding: var(--space-padding);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius);
  }

  .eoschool-salidas__actions {
    flex-direction: row;
    flex-wrap: wrap;
  }
</style>
