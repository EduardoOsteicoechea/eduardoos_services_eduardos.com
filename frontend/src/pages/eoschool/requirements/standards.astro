---
import { Fragment } from "astro/jsx-runtime";
import EoschoolDashBack from "../../../components/EoschoolDashBack.astro";
import Grade3StandardsCompare from "../../../components/Grade3StandardsCompare.astro";
import Layout from "../../../layouts/Layout.astro";
---

<Layout
  title="Estándares 3.er grado"
  description="Cruce de 3.er grado: aprendizajes MPPE de Venezuela con Common Core, NGSS y el National Curriculum de Inglaterra, Year 4."
  page="eoschool-standards"
  robots="noindex,nofollow"
>
  <Fragment slot="dhs">
    <a class="dhs-action" href="/eoschool/requirements/curriculum?mode=browse" data-route title="Programa" aria-label="Programa">
      <span class="icon-btn" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">calendar_view_week</span></span>
      Programa
    </a>
  </Fragment>

  <section class="product-dash page-span-all" data-grade3-standards>
    <EoschoolDashBack />
    <p class="status" data-banner>Cargando…</p>
    <div data-gate hidden class="product-gate">
      <p class="hint">Necesitas sesión y suscripción Homescool.</p>
      <a class="button" href="/session" data-route>Sign in</a>
    </div>
    <div data-authed hidden>
      <Grade3StandardsCompare />
    </div>
  </section>
</Layout>

<script>
  import { onAstroPageLoad, requireService, setHidden } from "../../../lib/productGate";

  onAstroPageLoad("eoschool-standards", async () => {
    const root = document.querySelector("[data-grade3-standards]");
    const banner = root?.querySelector("[data-banner]");
    const gate = root?.querySelector("[data-gate]");
    const authed = root?.querySelector("[data-authed]");
    if (banner instanceof HTMLElement) {
      banner.hidden = false;
      banner.textContent = "Cargando…";
    }
    const result = await requireService("homescool", { requireSubscription: true });
    if (!result.sessionOk || !result.access.allowed) {
      if (banner instanceof HTMLElement) {
        banner.textContent = result.sessionOk
          ? "Necesitas suscripción Homescool."
          : "Inicia sesión para continuar.";
      }
      setHidden(gate, false);
      setHidden(authed, true);
    } else {
      if (banner instanceof HTMLElement) banner.hidden = true;
      setHidden(gate, true);
      setHidden(authed, false);
    }
  });
</script>
