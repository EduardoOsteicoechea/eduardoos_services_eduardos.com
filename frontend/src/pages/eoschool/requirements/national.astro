---
import { Fragment } from "astro/jsx-runtime";
import Layout from "../../../layouts/Layout.astro";
import { MPPE_NATIONAL_REQUIREMENTS } from "../../../lib/eoschool-mppe-national-requirements";

const { areas } = MPPE_NATIONAL_REQUIREMENTS;
---

<Layout
  title="Requisitos nacionales MPPE"
  description="Objetivos generales y aprendizajes esperados de tercer grado según la consulta curricular del MPPE (Venezuela)."
  page="eoschool-requirements-national"
  robots="noindex,nofollow"
  showPageTitle={false}
>
  <Fragment slot="dhs">
    <a class="dhs-action" href="/homescool" data-route title="Homescool" aria-label="Homescool">
      <span class="icon-btn" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">school</span></span>
      Homescool
    </a>
    <a class="dhs-action" href="/eoschool/revision" data-route title="Revisión eoschool" aria-label="Revisión eoschool">
      <span class="icon-btn" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">grading</span></span>
      Revisión
    </a>
  </Fragment>

  <h1 class="page-title-sr">Requisitos nacionales MPPE</h1>

  <section class="product-dash eoschool-req-dash">
    <p class="lede">
      Referencia compilada de las propuestas de contenidos del MPPE (consulta curricular). En tercer grado, cada
      objetivo o contenido esencial se expande para ver sus aprendizajes esperados.
    </p>

    <div class="eoschool-req-stack">
      {
        areas.map((area) => (
          <article class="product-dash__card eoschool-req-card">
            <header class="product-dash__card-head">
              <h2 class="product-dash__card-title">{area.title}</h2>
              <p class="product-dash__card-desc">{area.pdf}</p>
            </header>

            <section class="eoschool-req-subsection" aria-labelledby={`mppe-general-${area.id}`}>
              <h3 class="eoschool-req-subsection__title" id={`mppe-general-${area.id}`}>Objetivos generales</h3>
              <ul class="eoschool-req-list">
                {area.general.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </section>

            <section class="eoschool-req-subsection" aria-labelledby={`mppe-g3-${area.id}`}>
              <h3 class="eoschool-req-subsection__title" id={`mppe-g3-${area.id}`}>Objetivos de tercer grado</h3>
              <div class="eoschool-req-details-stack">
                {area.grade3Units.map((unit, index) => {
                  const prev = index > 0 ? area.grade3Units[index - 1] : null;
                  const showAxis = unit.axis && unit.axis !== prev?.axis;
                  return (
                    <>
                      {showAxis ? <h4 class="eoschool-req-axis">{unit.axis}</h4> : null}
                      <details class="eoschool-req-details">
                        <summary class="eoschool-req-details__summary">
                          <span class="eoschool-req-details__chevron material-symbols-outlined" aria-hidden="true">
                            expand_more
                          </span>
                          <span class="eoschool-req-details__label">{unit.title}</span>
                        </summary>
                        <div class="eoschool-req-details__body">
                          {unit.contenidos && unit.contenidos.length > 0 ? (
                            <div class="eoschool-req-details__block">
                              <p class="eoschool-req-details__kicker">Contenidos</p>
                              <ul class="eoschool-req-list eoschool-req-list--nested">
                                {unit.contenidos.map((item) => (
                                  <li>{item}</li>
                                ))}
                              </ul>
                            </div>
                          ) : null}
                          <div class="eoschool-req-details__block">
                            <p class="eoschool-req-details__kicker">Aprendizajes esperados</p>
                            <ul class="eoschool-req-list eoschool-req-list--nested">
                              {unit.learnings.map((item) => (
                                <li>{item}</li>
                              ))}
                            </ul>
                          </div>
                        </div>
                      </details>
                    </>
                  );
                })}
              </div>
            </section>
          </article>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .eoschool-req-dash {
    cursor: default;
    min-width: 0;
    max-width: 100%;
  }

  .eoschool-req-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-padding);
    min-width: 0;
    width: 100%;
  }

  .eoschool-req-card {
    cursor: default;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    min-height: 0;
    box-sizing: border-box;
    align-items: stretch;
  }

  .eoschool-req-card:hover,
  .eoschool-req-card:focus-visible {
    transform: none;
  }

  .eoschool-req-card .product-dash__card-head {
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    min-width: 0;
  }

  .eoschool-req-card .product-dash__card-title,
  .eoschool-req-card .product-dash__card-desc {
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .eoschool-req-subsection {
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
    width: 100%;
    min-width: 0;
  }

  .eoschool-req-subsection + .eoschool-req-subsection {
    margin-block-start: var(--rail-gap);
    padding-block-start: var(--space-padding);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .eoschool-req-subsection__title {
    margin: 0;
    font-size: var(--font-size-md);
    font-weight: 650;
    overflow-wrap: anywhere;
  }

  .eoschool-req-details-stack {
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
    min-width: 0;
    width: 100%;
  }

  .eoschool-req-axis {
    margin: var(--space-padding) 0 0 0;
    font-size: var(--font-size-sm);
    font-weight: 650;
    color: var(--color-muted);
    overflow-wrap: anywhere;
  }

  .eoschool-req-axis:first-child {
    margin-block-start: 0;
  }

  .eoschool-req-details {
    min-width: 0;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius);
    background: var(--color-bg);
  }

  .eoschool-req-details[open] {
    border-color: var(--color-accent);
  }

  .eoschool-req-details__summary {
    display: flex;
    align-items: flex-start;
    gap: var(--rail-gap);
    padding: var(--space-padding);
    font-size: var(--font-size-sm);
    font-weight: 650;
    line-height: 1.45;
    cursor: pointer;
    list-style: none;
    overflow-wrap: anywhere;
  }

  .eoschool-req-details__summary::-webkit-details-marker {
    display: none;
  }

  .eoschool-req-details__chevron {
    flex-shrink: 0;
    font-size: var(--icon-size);
    color: var(--color-muted);
    transition: transform 0.15s ease;
  }

  .eoschool-req-details[open] .eoschool-req-details__chevron {
    transform: rotate(180deg);
    color: var(--color-accent);
  }

  .eoschool-req-details__label {
    flex: 1;
    min-width: 0;
  }

  .eoschool-req-details__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-padding);
    padding: 0 var(--space-padding) var(--space-padding);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .eoschool-req-details__block {
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
    min-width: 0;
  }

  .eoschool-req-details__kicker {
    margin: var(--space-padding) 0 0 0;
    font-size: var(--font-size-xs);
    font-weight: 650;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.04rem;
  }

  .eoschool-req-list {
    margin: 0;
    padding-inline-start: 1rem;
    font-size: var(--font-size-sm);
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
    min-width: 0;
    max-width: 100%;
  }

  .eoschool-req-list--nested {
    padding-inline-start: 0.875rem;
  }

  .eoschool-req-list li {
    line-height: 1.45;
    overflow-wrap: anywhere;
    max-width: 100%;
  }

  @media (max-width: 47.999rem) {
    .eoschool-req-dash .lede {
      font-size: var(--font-size-sm);
    }

    .eoschool-req-list {
      padding-inline-start: 0.875rem;
    }

    .eoschool-req-subsection__title {
      font-size: var(--font-size-sm);
    }

    .eoschool-req-details__summary {
      padding: 0.75rem;
    }

    .eoschool-req-details__body {
      padding: 0 0.75rem 0.75rem;
    }
  }
</style>
