<script>
  import { initCurriculumDayHeights } from "../../../lib/eoschool-curriculum-day-heights";
  import { initCurriculumDayModal } from "../../../lib/eoschool-curriculum-day-modal";
  import { initCurriculumProgress } from "../../../lib/eoschool-curriculum-progress";
  import { initCurriculumSubjectCollapse } from "../../../lib/eoschool-curriculum-subject-collapse";
  import { bindCurriculumTreatModal } from "../../../lib/eoschool-curriculum-treat-modal";
  import { initCurriculumWeekPrint } from "../../../lib/eoschool-curriculum-week-print";
  import { initCurriculumWeekCollapse } from "../../../lib/eoschool-curriculum-week-collapse";

  function bootCurriculumChrome() {
    const params = new URLSearchParams(location.search);
    const view = params.get("view");
    const planRadio = document.querySelector<HTMLInputElement>("#curriculum-view-plan");
    const standardsRadio = document.querySelector<HTMLInputElement>("#curriculum-view-standards");
    const gapsRadio = document.querySelector<HTMLInputElement>("#curriculum-view-gaps");
    if (view === "standards" && standardsRadio) standardsRadio.checked = true;
    else if (view === "gaps" && gapsRadio) gapsRadio.checked = true;
    else if (planRadio) planRadio.checked = true;
    const root = document.querySelector<HTMLElement>("[data-curriculum-progress]");
    if (root && params.get("mode") === "browse") root.dataset.curriculumMode = "browse";
    bindCurriculumTreatModal();
    const mode = root?.dataset.curriculumMode || "study";
    if (mode === "browse") {
      root?.querySelectorAll<HTMLInputElement>("[data-curriculum-section-check]").forEach((input) => {
        input.disabled = true;
        const label = input.closest("label");
        if (label) label.hidden = true;
      });
      const banner = root?.querySelector<HTMLElement>("[data-curriculum-student-banner]");
      if (banner) {
        banner.hidden = false;
        banner.textContent = "Modo consulta: sin seguimiento de progreso.";
      }
    } else {
      void initCurriculumProgress(root);
    }
    initCurriculumSubjectCollapse(root);
    initCurriculumWeekCollapse(root);
    initCurriculumDayModal(root);
    initCurriculumWeekPrint(root);
    initCurriculumDayHeights(root);
  }

  bootCurriculumChrome();
  document.addEventListener("astro:page-load", bootCurriculumChrome);
</script>

