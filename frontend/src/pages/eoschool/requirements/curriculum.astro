---
import { Fragment } from "astro/jsx-runtime";
import Grade3StandardsCompare from "../../../components/Grade3StandardsCompare.astro";
import Layout from "../../../layouts/Layout.astro";
import { MPPE_40WEEK_CURRICULUM } from "../../../lib/eoschool-mppe-40week-curriculum";
import {
  bibleGroupsForDay,
  groupLearningRefs,
  identityGroups,
  scheduledSectionsForBlock,
} from "../../../lib/eoschool-mppe-curriculum-view";
import {
  englishGroupsForDay,
  englishSheetLink,
  englishWeekday,
} from "../../../lib/eoschool-english-signature";
import { aiGroupsForDay } from "../../../lib/eoschool-ai-signature";
import { DEFAULT_CURRENT_WEEK } from "../../../lib/eoschool-curriculum-week-collapse";

const { meta, weeks } = MPPE_40WEEK_CURRICULUM;
const curriculumMode = Astro.url.searchParams.get("mode") === "browse" ? "browse" : "study";
const standardsView = Astro.url.searchParams.get("view") === "standards";
const gapsView = Astro.url.searchParams.get("view") === "gaps";
const initialStudentKey = Astro.url.searchParams.get("studentKey")?.trim() || "";

const bibleMeta = meta.bible;

const areaDefs = [
  { num: 1, label: "Biblia", kind: "bible" as const, sectionId: "bib" as const, icon: "menu_book" },
  { num: 2, label: "Identidad", kind: "identity" as const, sectionId: "ide" as const, icon: "public" },
  { num: 3, label: "Lenguaje", kind: "len" as const, sectionId: "len" as const, icon: "article" },
  { num: 4, label: "Matemáticas", kind: "mat" as const, sectionId: "mat" as const, icon: "calculate" },
  { num: 5, label: "Ciencias Naturales", kind: "cie" as const, sectionId: "cie" as const, icon: "science" },
  { num: 6, label: "Inglés", kind: "english" as const, sectionId: "eng" as const, icon: "translate" },
  { num: 7, label: "Inteligencia Artificial", kind: "ia" as const, sectionId: "ia" as const, icon: "psychology" },
];
const areaBySection = Object.fromEntries(areaDefs.map((a) => [a.sectionId, a]));

const HOLIDAY_FIXED = [
  { name: "Año Nuevo", when: "1 de enero" },
  { name: "Declaración de la Independencia", when: "19 de abril" },
  { name: "Día del Trabajador", when: "1 de mayo" },
  { name: "Batalla de Carabobo", when: "24 de junio" },
  { name: "Día de la Independencia", when: "5 de julio" },
  { name: "Natalicio de Simón Bolívar", when: "24 de julio" },
  { name: "Día de la Resistencia Indígena", when: "12 de octubre" },
  { name: "Nochebuena", when: "24 de diciembre" },
  { name: "Navidad", when: "25 de diciembre" },
  { name: "Fin de Año", when: "31 de diciembre" },
] as const;

const HOLIDAY_MOVABLE = [
  { name: "Lunes de Carnaval", when: "móvil (2 días antes del Miércoles de Ceniza)" },
  { name: "Martes de Carnaval", when: "móvil (1 día antes del Miércoles de Ceniza)" },
  { name: "Jueves Santo", when: "móvil (Semana Santa)" },
  { name: "Viernes Santo", when: "móvil (Semana Santa)" },
] as const;

const planHolidays = meta.holidays ?? [];

function formatPlanDate(iso: string | undefined): string {
  if (!iso) return "";
  const [y, m, d] = iso.split("-");
  if (!y || !m || !d) return iso;
  return `${d}/${m}/${y}`;
}

function weekStartDate(weekPlan: (typeof weeks)[number]): string | undefined {
  const rows = weekPlan.blocks
    .flatMap((block) =>
      (block.bible?.days ?? []).map((bibleDay) => ({
        dayInPlan: bibleDay.dayInPlan,
        calendarDate: block.calendarDate,
      })),
    )
    .sort((a, b) => a.dayInPlan - b.dayInPlan);
  return rows[0]?.calendarDate;
}

function weekForPlanDay(planDay: number): number {
  return Math.ceil(planDay / (meta.daysPerWeek ?? 5));
}
---

<Layout
  title="Currículo MPPE 40 semanas"
  description="Planificación 3er grado: 40 semanas, 200 días escolares, lectura bíblica diaria y saberes MPPE con clases eoschool."
  page="eoschool-requirements-curriculum"
  robots="noindex,nofollow"
  showPageTitle={false}
>
  <Fragment slot="dhs">
    <a class="dhs-action" href="/eoschool" data-route title="Homeschool" aria-label="Homeschool">
      <span class="icon-btn" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">dashboard</span></span>
      Dashboard
    </a>
  </Fragment>

  <h1 class="page-title-sr">Currículo MPPE 40 semanas</h1>

  <section
    class="product-dash eoschool-curriculum page-span-all"
    data-curriculum-progress
    data-curriculum-mode={curriculumMode}
    data-curriculum-student-key={initialStudentKey || undefined}
  >
    <input
      class="eoschool-curriculum__view-input"
      type="radio"
      name="curriculum-view"
      id="curriculum-view-plan"
      checked={!standardsView && !gapsView}
    />
    <input
      class="eoschool-curriculum__view-input"
      type="radio"
      name="curriculum-view"
      id="curriculum-view-standards"
      checked={standardsView}
    />
    <input
      class="eoschool-curriculum__view-input"
      type="radio"
      name="curriculum-view"
      id="curriculum-view-gaps"
      checked={gapsView}
    />
    <div class="eoschool-curriculum__plan">
    <div class="eoschool-curriculum__weeks">
      {
        weeks.map((weekPlan) => {
          const weekPlanDays = weekPlan.blocks
            .flatMap((block) => (block.bible?.days ?? []).map((bibleDay) => bibleDay.dayInPlan))
            .sort((a, b) => a - b);
          const weekDateLabel = formatPlanDate(weekStartDate(weekPlan));
          const weekSubjectsOpen = weekPlan.week === DEFAULT_CURRENT_WEEK;
          return (
          <section
            class:list={[
              "product-dash__card",
              "eoschool-curriculum__week",
              weekPlan.week !== DEFAULT_CURRENT_WEEK && "eoschool-curriculum__week--collapsed",
            ]}
            id={`week-${weekPlan.week}`}
            data-curriculum-week={`w${weekPlan.week}`}
            data-week={weekPlan.week}
            data-week-plan-days={weekPlanDays.join(",")}
            aria-labelledby={`week-title-${weekPlan.week}`}
            aria-current={weekPlan.week === DEFAULT_CURRENT_WEEK ? "true" : undefined}
          >
            <div
              class="eoschool-curriculum__week-progress"
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="0"
              aria-label={`Progreso de la semana ${weekPlan.week}`}
              data-curriculum-week-progress
            >
              <span class="eoschool-curriculum__week-progress__fill" data-curriculum-week-progress-fill></span>
            </div>
            <div class="eoschool-curriculum__week-layout">
              <div class="eoschool-curriculum__week-rail">
                <label class="eoschool-curriculum__week-current" title={`Semana ${weekPlan.week} actual`}>
                  <input
                    class="eoschool-curriculum__week-radio"
                    type="radio"
                    name="eoschool-current-week"
                    value={weekPlan.week}
                    checked={weekPlan.week === DEFAULT_CURRENT_WEEK}
                    aria-label={`Hacer actual la semana ${weekPlan.week}`}
                    data-curriculum-week-current
                  />
                </label>
                <button
                  class="icon-btn eoschool-curriculum__week-print"
                  type="button"
                  title={`Imprimir PDF de la semana ${weekPlan.week} (5 días)`}
                  aria-label={`Imprimir PDF de la semana ${weekPlan.week}, cinco días`}
                  data-curriculum-week-print
                >
                  <span class="material-symbols-outlined" aria-hidden="true">print</span>
                </button>
                <h2
                  class="eoschool-curriculum__week-title"
                  id={`week-title-${weekPlan.week}`}
                  aria-label={`Semana ${weekPlan.week}${weekDateLabel ? `, ${weekDateLabel}` : ""}`}
                >
                  <span class="eoschool-curriculum__week-name">{weekPlan.week}</span>
                  {weekDateLabel ? <span class="eoschool-curriculum__week-date">{weekDateLabel}</span> : null}
                </h2>
              </div>

              <div
                class="eoschool-curriculum__week-days"
                id={`week-days-${weekPlan.week}`}
                hidden={weekPlan.week !== DEFAULT_CURRENT_WEEK}
              >
              {weekPlan.blocks
                .flatMap((block) => (block.bible?.days ?? []).map((bibleDay) => ({ block, bibleDay })))
                .sort((a, b) => a.bibleDay.dayInPlan - b.bibleDay.dayInPlan)
                .map(({ block, bibleDay }, daySlot) => {
                const dayId = `d${bibleDay.dayInPlan}`;
                const blockId = `w${weekPlan.week}-b${block.block}`;
                const scheduled = scheduledSectionsForBlock(block, weekPlan.week);
                const isExpo = block.dayKind === "exposition";
                const subjectsOpen = weekSubjectsOpen && !isExpo;
                const isHoliday = block.dayKind === "holiday";
                const ariaDay = isHoliday
                  ? `Abrir día ${bibleDay.dayInPlan}, feriado ${block.holidayName ?? ""}`
                  : isExpo
                    ? `Abrir día ${bibleDay.dayInPlan}, exposiciones`
                    : `Abrir día ${bibleDay.dayInPlan}`;
                return (
                  <article
                    class:list={[
                      "product-dash__card",
                      "eoschool-curriculum__day-card",
                      daySlot === 4 && "eoschool-curriculum__day-card--slot5",
                      isExpo && "eoschool-curriculum__day-card--expo",
                      isHoliday && "eoschool-curriculum__day-card--holiday",
                    ]}
                    data-curriculum-day={dayId}
                    data-curriculum-block={blockId}
                    data-plan-day={bibleDay.dayInPlan}
                    data-curriculum-day-slot={daySlot + 1}
                    data-curriculum-scheduled={scheduled.join(",")}
                    data-curriculum-week={weekPlan.week}
                    data-curriculum-day-kind={block.dayKind ?? "teach"}
                    data-holiday-name={isHoliday ? (block.holidayName ?? "Feriado") : undefined}
                  >
                    <button
                      class="eoschool-curriculum__day-bubble"
                      type="button"
                      data-curriculum-day-bubble
                      aria-label={ariaDay}
                    >
                      <span
                        class="eoschool-curriculum__day-bubble__fill"
                        data-curriculum-day-bubble-fill
                        role="progressbar"
                        aria-valuemin="0"
                        aria-valuemax="100"
                        aria-valuenow="0"
                        aria-label={`Progreso del día ${bibleDay.dayInPlan}`}
                      ></span>
                      <span class="eoschool-curriculum__day-bubble__num">{bibleDay.dayInPlan}</span>
                    </button>
                    <div class="eoschool-curriculum__day-body">
                      {scheduled.map((sectionId) => {
                        const area = areaBySection[sectionId];
                        if (!area) return null;
                        const englishDay = englishWeekday(block.calendarDate, daySlot + 1);
                        const englishSheet = sectionId === "eng" ? englishSheetLink(block.calendarDate) : null;
                        const groups =
                          area.kind === "bible"
                            ? bibleGroupsForDay(bibleDay)
                            : area.kind === "identity"
                              ? identityGroups(block)
                            : area.kind === "english"
                              ? englishGroupsForDay(weekPlan.week, englishDay, block.calendarDate)
                              : area.kind === "ia"
                                ? aiGroupsForDay(bibleDay.dayInPlan)
                              : groupLearningRefs(
                                    (area.kind === "len"
                                      ? block.len
                                      : area.kind === "mat"
                                        ? block.mat
                                        : block.cie) ?? [],
                                  );
                        const label = isHoliday
                          ? `${area.label} · Feriado`
                          : isExpo
                            ? `${area.label} · Expo`
                            : area.label;
                        const subjectBodyId = `${blockId}-${area.sectionId}-body`;
                        const expoBible = isExpo && area.sectionId === "bib";
                        const subjectOpen = isExpo ? expoBible : subjectsOpen;
                        return (
                          <div
                            class:list={[
                              "eoschool-curriculum__subject",
                              subjectOpen && "eoschool-curriculum__subject--open",
                            ]}
                            data-curriculum-section={area.sectionId}
                          >
                            <div
                              class="eoschool-curriculum__subject-progress"
                              role="progressbar"
                              aria-valuemin="0"
                              aria-valuemax="100"
                              aria-valuenow="10"
                              aria-orientation="vertical"
                              aria-label={`Progreso de ${label}`}
                              data-curriculum-subject-progress
                            >
                              <span class="eoschool-curriculum__subject-progress__fill"></span>
                            </div>
                            <div class="eoschool-curriculum__subject-rail">
                              <span class="eoschool-curriculum__subject-icon" title={label}>
                                <span class="material-symbols-outlined" aria-hidden="true">{area.icon}</span>
                              </span>
                              {isExpo && !expoBible ? (
                                <button
                                  type="button"
                                  class="eoschool-curriculum__subject-toggle eoschool-curriculum__subject-toggle--icon"
                                  data-curriculum-subject-toggle
                                  aria-expanded={subjectOpen ? "true" : "false"}
                                  aria-controls={subjectBodyId}
                                  title={subjectOpen ? `Ocultar ${label}` : `Mostrar ${label}`}
                                  aria-label={subjectOpen ? `Ocultar ${label}` : `Mostrar ${label}`}
                                >
                                  <span
                                    class="material-symbols-outlined eoschool-curriculum__subject-chevron"
                                    data-curriculum-subject-chevron
                                    aria-hidden="true"
                                  >
                                    {subjectOpen ? "expand_less" : "expand_more"}
                                  </span>
                                </button>
                              ) : null}
                              <label class="eoschool-curriculum__section-check">
                                <input type="checkbox" data-curriculum-section-check />
                                <span class="page-title-sr">Sección completada: {label}</span>
                                <span class="eoschool-curriculum__section-check-box" aria-hidden="true">
                                  <span class="material-symbols-outlined eoschool-curriculum__section-check-icon">
                                    check
                                  </span>
                                </span>
                              </label>
                            </div>
                            <div class="eoschool-curriculum__subject-copy">
                            <h4 class="eoschool-curriculum__subject-title">
                              {label}
                              <span class="eoschool-curriculum__subject-score" data-curriculum-subject-score hidden></span>
                            </h4>
                            {isExpo && !expoBible ? (
                              <p class="eoschool-curriculum__expo-word">Expo</p>
                            ) : null}
                            <div
                              class="eoschool-curriculum__subject-body eoschool-curriculum__subject-body--card"
                              id={subjectBodyId}
                              data-curriculum-subject-body
                              hidden={!subjectOpen}
                            >
                              {isHoliday ? (
                                <p class="eoschool-curriculum__expo-hint">
                                  Feriado: solo lectura bíblica
                                  {block.calendarDate ? ` · ${block.calendarDate}` : ""}
                                </p>
                              ) : null}
                              {expoBible && weekPlan.week === 7 ? (
                                <p class="eoschool-curriculum__expo-hint">
                                  <a
                                    href="/homescool/expo/semana-7-dia-5"
                                    data-route
                                    data-expo-route
                                  >
                                    Escribir e imprimir
                                  </a>
                                </p>
                              ) : null}
                              {groups.some((g) => g.learnings.length) ? (
                                <ul class="eoschool-curriculum__learnings eoschool-curriculum__learnings--card">
                                  {groups.flatMap((group) =>
                                    group.learnings.map((learning) => <li>{learning}</li>),
                                  )}
                                </ul>
                              ) : (
                                <p class="eoschool-curriculum__empty">—</p>
                              )}
                              {englishSheet ? (
                                <p class="eoschool-curriculum__expo-hint">
                                  <a href={englishSheet.href} data-eng-sheet>
                                    {englishSheet.label}
                                  </a>
                                </p>
                              ) : null}
                            </div>
                            <div class="eoschool-curriculum__subject-detail" hidden>
                              {groups.map((group) => (
                                <div class="eoschool-curriculum__objective-block">
                                  <p class="eoschool-curriculum__objective">
                                    <span class="eoschool-curriculum__objective-label">Objetivo</span>
                                    {isExpo ? `Exposición · ${group.objective}` : group.objective}
                                  </p>
                                  {group.learnings.length ? (
                                    <div class="eoschool-curriculum__specific-learning">
                                      <p class="eoschool-curriculum__learning-label">Aprendizaje específico</p>
                                      <ol class="eoschool-curriculum__learnings">
                                        {group.learnings.map((learning) => (
                                          <li>{learning}</li>
                                        ))}
                                      </ol>
                                    </div>
                                  ) : null}
                                </div>
                              ))}
                              {englishSheet ? (
                                <p class="eoschool-curriculum__objective">
                                  <a href={englishSheet.href} data-eng-sheet>{englishSheet.label}</a>
                                </p>
                              ) : null}
                            </div>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </article>
                );
              })}
              </div>
            </div>
          </section>
          );
        })
      }
    </div>

    <section
      class="product-dash__card eoschool-curriculum__holidays"
      aria-labelledby="curriculum-holidays-title"
    >
      <h2 class="eoschool-curriculum__holidays-title" id="curriculum-holidays-title">
        Feriados oficiales (VE)
      </h2>
      <h3 class="eoschool-curriculum__holidays-subtitle">Fijos y móviles</h3>
      <div class="eoschool-curriculum__holidays-cards">
        {HOLIDAY_FIXED.map((h) => (
          <article class="eoschool-curriculum__holiday-card">
            <span class="eoschool-curriculum__holiday-card-kind">Fijo</span>
            <span class="eoschool-curriculum__holidays-name">{h.name}</span>
            <span class="eoschool-curriculum__holidays-when">{h.when}</span>
          </article>
        ))}
        {HOLIDAY_MOVABLE.map((h) => (
          <article class="eoschool-curriculum__holiday-card">
            <span class="eoschool-curriculum__holiday-card-kind">Móvil</span>
            <span class="eoschool-curriculum__holidays-name">{h.name}</span>
            <span class="eoschool-curriculum__holidays-when">{h.when}</span>
          </article>
        ))}
      </div>
      {planHolidays.length ? (
        <div class="eoschool-curriculum__holidays-plan">
          <h3 class="eoschool-curriculum__holidays-subtitle">
            En este año escolar ({meta.schoolYearStart} → {meta.schoolYearEnd})
          </h3>
          <div class="eoschool-curriculum__holidays-cards">
            {planHolidays.map((h) => (
              <a
                class="eoschool-curriculum__holiday-card eoschool-curriculum__holiday-card--plan"
                href={`#week-${weekForPlanDay(h.planDay)}`}
              >
                <span class="eoschool-curriculum__holidays-when">{formatPlanDate(h.date)}</span>
                <span class="eoschool-curriculum__holidays-name">{h.name}</span>
                <span class="eoschool-curriculum__holidays-when">Día {h.planDay}</span>
              </a>
            ))}
          </div>
        </div>
      ) : null}
    </section>

    <div class="eoschool-curriculum__meta">
      <p class="lede">
        {meta.grade ?? "3er grado"} · {meta.weeks} semanas × {meta.daysPerWeek ?? 5} días ={" "}
        {meta.totalPlanDays ?? bibleMeta.readingDays} días escolares
        {meta.schoolYearStart && meta.schoolYearEnd
          ? ` (${meta.schoolYearStart} → ${meta.schoolYearEnd})`
          : ""}
        . Cada día: Biblia y Lenguaje. Días 1 y 3: Identidad y Ciencias. Días 2 y 4: Matemáticas. Día 5:
        exposiciones de las cinco asignaturas. Inglés, de la semana 8 en adelante: lunes presente, martes
        pasado, miércoles futuro, jueves preposición, viernes repaso. Inteligencia Artificial, desde el día 38:
        una pregunta por día. En feriados oficiales VE solo Biblia
        {meta.holidays?.length ? ` (${meta.holidays.length} días)` : ""}. Abre un día para ver objetivo,
        aprendizaje y hoja PDF.
      </p>
      <p class="eoschool-curriculum__student" data-curriculum-student-banner hidden></p>
      <p class="lede eoschool-curriculum__bible-report">
        {bibleMeta.canon}: {bibleMeta.tracks.genEster.totalChapters}+{bibleMeta.tracks.jobMal.totalChapters}+
        {bibleMeta.tracks.nt.totalChapters} capítulos en {bibleMeta.readingDays} días. NT hasta{" "}
        {bibleMeta.tracks.nt.maxChaptersPerDay} cap./día; AT hasta{" "}
        {bibleMeta.tracks.genEster.maxChaptersPerDay} cap./día por pista. Cobertura: Gén–Ester{" "}
        {bibleMeta.tracks.genEster.chaptersReadInPlan}/{bibleMeta.tracks.genEster.totalChapters}, Job–Mal{" "}
        {bibleMeta.tracks.jobMal.chaptersReadInPlan}/{bibleMeta.tracks.jobMal.totalChapters}, NT{" "}
        {bibleMeta.tracks.nt.chaptersReadInPlan}/{bibleMeta.tracks.nt.totalChapters}
        {meta.totalPlanDays === 200 ? " (Plan 40 semanas · 200 días escolares · 3er grado)." : "."}
      </p>
    </div>
    </div>

    <div class="eoschool-curriculum__standards">
      <Grade3StandardsCompare />
    </div>

    <div class="eoschool-curriculum__gaps">
      <Grade3StandardsCompare mode="gaps" />
    </div>

  </section>

  <div class="eoschool-curriculum-modal" data-curriculum-day-modal hidden>
    <div
      class="eoschool-curriculum-modal__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="curriculum-day-modal-title"
    >
      <header class="eoschool-curriculum-modal__toolbar">
        <h2 class="eoschool-curriculum-modal__title" id="curriculum-day-modal-title" data-curriculum-modal-title>
          Día
        </h2>
        <button class="icon-btn eoschool-curriculum-modal__close" type="button" data-curriculum-modal-close aria-label="Cerrar">
          <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
      </header>

      <div class="eoschool-curriculum-modal__tabs" role="tablist" aria-label="Áreas del día">
        <button type="button" class="eoschool-curriculum-modal__tab" data-curriculum-modal-tab="bib" role="tab">
          Biblia
        </button>
        <button type="button" class="eoschool-curriculum-modal__tab" data-curriculum-modal-tab="ide" role="tab">
          Identidad
        </button>
        <button type="button" class="eoschool-curriculum-modal__tab" data-curriculum-modal-tab="len" role="tab">
          Lenguaje
        </button>
        <button type="button" class="eoschool-curriculum-modal__tab" data-curriculum-modal-tab="mat" role="tab">
          Mat
        </button>
        <button type="button" class="eoschool-curriculum-modal__tab" data-curriculum-modal-tab="cie" role="tab">
          Ciencias
        </button>
        <button type="button" class="eoschool-curriculum-modal__tab" data-curriculum-modal-tab="eng" role="tab">
          Inglés
        </button>
        <button type="button" class="eoschool-curriculum-modal__tab" data-curriculum-modal-tab="ia" role="tab" aria-label="Inteligencia Artificial">
          IA
        </button>
      </div>

      <div class="eoschool-curriculum-modal__body">
        <section class="eoschool-curriculum-modal__panel" aria-label="Contenido MPPE">
          <div class="eoschool-curriculum-activity" data-curriculum-activity hidden></div>
          <h3 class="eoschool-curriculum-modal__panel-title">Contenido del día</h3>
