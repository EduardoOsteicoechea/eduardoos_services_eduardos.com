---
import { Fragment } from "astro/jsx-runtime";
import Layout from "../../../layouts/Layout.astro";
import { MPPE_40WEEK_CURRICULUM } from "../../../lib/eoschool-mppe-40week-curriculum";
import {
  bibleGroupsForDay,
  buildWeekIndexRow,
  groupLearningRefs,
  identityGroups,
} from "../../../lib/eoschool-mppe-curriculum-view";

const { meta, weeks } = MPPE_40WEEK_CURRICULUM;
const indexRows = weeks.map(buildWeekIndexRow);

const bibleMeta = meta.bible;
const areaDefs = [
  { num: 1, label: "Biblia", kind: "bible" as const, sectionId: "bib" as const },
  { num: 2, label: "Identidad", kind: "identity" as const, sectionId: "ide" as const },
  { num: 3, label: "Prácticas del Lenguaje", kind: "len" as const, sectionId: "len" as const },
  { num: 4, label: "Matemáticas", kind: "mat" as const, sectionId: "mat" as const },
  { num: 5, label: "Ciencias Naturales", kind: "cie" as const, sectionId: "cie" as const },
];
---

<Layout
  title="Currículo MPPE 40 semanas"
  description="Planificación 3er grado: 40 semanas, 200 días escolares, lectura bíblica diaria y saberes MPPE con clases eoschool."
  page="eoschool-requirements-curriculum"
  robots="noindex,nofollow"
  showPageTitle={false}
>
  <Fragment slot="dhs">
    <a class="dhs-action" href="/eoschool/requirements/national" data-route title="Requisitos MPPE" aria-label="Requisitos MPPE">
      <span class="icon-btn" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">menu_book</span></span>
      Requisitos
    </a>
    <a class="dhs-action" href="/homescool" data-route title="Homescool" aria-label="Homescool">
      <span class="icon-btn" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">school</span></span>
      Homescool
    </a>
  </Fragment>

  <h1 class="page-title-sr">Currículo MPPE 40 semanas</h1>

  <section class="product-dash eoschool-curriculum page-span-all" data-curriculum-progress>
    <p class="lede">
      {meta.grade ?? "3er grado"} · {meta.weeks} semanas × {meta.daysPerWeek ?? 5} días = {meta.totalPlanDays ?? bibleMeta.readingDays}{" "}
      días escolares. Cada día: lectura bíblica (tres pistas) más Identidad, Lenguaje, Matemáticas y Ciencias. Abre un día para ver
      objetivo, aprendizaje y clase PDF.
    </p>
    <p class="eoschool-curriculum__student" data-curriculum-student-banner hidden></p>

    <p class="lede eoschool-curriculum__bible-report">
      {bibleMeta.canon}: {bibleMeta.tracks.genEster.totalChapters}+{bibleMeta.tracks.jobMal.totalChapters}+
      {bibleMeta.tracks.nt.totalChapters} capítulos en {bibleMeta.readingDays} días. NT hasta{" "}
      {bibleMeta.tracks.nt.maxChaptersPerDay} cap./día; AT hasta {bibleMeta.tracks.genEster.maxChaptersPerDay} cap./día por pista.
      Cobertura: Gén–Ester {bibleMeta.tracks.genEster.chaptersReadInPlan}/{bibleMeta.tracks.genEster.totalChapters}, Job–Mal{" "}
      {bibleMeta.tracks.jobMal.chaptersReadInPlan}/{bibleMeta.tracks.jobMal.totalChapters}, NT {bibleMeta.tracks.nt.chaptersReadInPlan}/
      {bibleMeta.tracks.nt.totalChapters}
      {meta.totalPlanDays === 200 ? " (Plan 40 semanas · 200 días escolares · 3er grado)." : "."}
    </p>

    <nav class="eoschool-curriculum__index" data-curriculum-index aria-label="Índice por semana">
      <div class="eoschool-curriculum__index-head">
        <span class="eoschool-curriculum__index-cell eoschool-curriculum__index-cell--sem">Sem</span>
        <span class="eoschool-curriculum__index-cell eoschool-curriculum__index-cell--bordered">
          Bibl
          <button
            type="button"
            class="eoschool-curriculum__index-resizer"
            data-resize-col="bib"
            aria-label="Ajustar ancho de columna Biblia"
          ></button>
        </span>
        <span class="eoschool-curriculum__index-cell eoschool-curriculum__index-cell--bordered">
          Identidad
          <button
            type="button"
            class="eoschool-curriculum__index-resizer"
            data-resize-col="ide"
            aria-label="Ajustar ancho de columna Identidad"
          ></button>
        </span>
        <span class="eoschool-curriculum__index-cell eoschool-curriculum__index-cell--bordered">
          Leng
          <button
            type="button"
            class="eoschool-curriculum__index-resizer"
            data-resize-col="len"
            aria-label="Ajustar ancho de columna Lenguaje"
          ></button>
        </span>
        <span class="eoschool-curriculum__index-cell eoschool-curriculum__index-cell--bordered">
          Mat
          <button
            type="button"
            class="eoschool-curriculum__index-resizer"
            data-resize-col="mat"
            aria-label="Ajustar ancho de columna Matemáticas"
          ></button>
        </span>
        <span class="eoschool-curriculum__index-cell">Cienc</span>
      </div>
      {
        indexRows.map((row) => (
          <a class="eoschool-curriculum__index-row" href={`#week-${row.week}`}>
            <span class="eoschool-curriculum__index-cell eoschool-curriculum__index-cell--sem eoschool-curriculum__index-week">
              S{row.week}
            </span>
            <span class="eoschool-curriculum__index-cell eoschool-curriculum__index-cell--bordered">{row.bib}</span>
            <span class="eoschool-curriculum__index-cell eoschool-curriculum__index-cell--bordered">{row.ide}</span>
            <span class="eoschool-curriculum__index-cell eoschool-curriculum__index-cell--bordered">{row.len}</span>
            <span class="eoschool-curriculum__index-cell eoschool-curriculum__index-cell--bordered">{row.mat}</span>
            <span class="eoschool-curriculum__index-cell">{row.cie}</span>
          </a>
        ))
      }
    </nav>

    <div class="eoschool-curriculum__weeks">
      {
        weeks.map((weekPlan) => (
          <section
            class="product-dash__card eoschool-curriculum__week"
            id={`week-${weekPlan.week}`}
            data-curriculum-week={`w${weekPlan.week}`}
            aria-labelledby={`week-title-${weekPlan.week}`}
          >
            <header class="product-dash__card-head eoschool-curriculum__week-head">
              <h2 class="product-dash__card-title" id={`week-title-${weekPlan.week}`}>Semana {weekPlan.week}</h2>
              <p class="eoschool-curriculum__week-status" data-curriculum-week-status aria-live="polite"></p>
            </header>

            <div class="eoschool-curriculum__week-days">
              {weekPlan.blocks
                .flatMap((block) => (block.bible?.days ?? []).map((bibleDay) => ({ block, bibleDay })))
                .sort((a, b) => a.bibleDay.dayInPlan - b.bibleDay.dayInPlan)
                .map(({ block, bibleDay }) => {
                const dayId = `d${bibleDay.dayInPlan}`;
                const blockId = `w${weekPlan.week}-b${block.block}`;
                return (
                  <article
                    class="product-dash__card eoschool-curriculum__day-card"
                    data-curriculum-day={dayId}
                    data-curriculum-block={blockId}
                    data-plan-day={bibleDay.dayInPlan}
                    data-curriculum-day-trigger
                    tabindex="0"
                    role="button"
                    aria-label={`Abrir día ${bibleDay.dayInPlan}`}
                  >
                    <header class="eoschool-curriculum__day-head">
                      <h3 class="eoschool-curriculum__day-title">Día {bibleDay.dayInPlan}</h3>
                      <span class="eoschool-curriculum__day-open-hint" aria-hidden="true">
                        <span class="material-symbols-outlined">open_in_full</span>
                      </span>
                    </header>

                    <div class="eoschool-curriculum__day-body">
                      {areaDefs.map((area) => {
                        const groups =
                          area.kind === "bible"
                            ? bibleGroupsForDay(bibleDay)
                            : area.kind === "identity"
                              ? identityGroups(block)
                              : groupLearningRefs(
                                  area.kind === "len" ? block.len : area.kind === "mat" ? block.mat : block.cie,
                                );
                        return (
                          <div
                            class="eoschool-curriculum__subject"
                            data-curriculum-section={area.sectionId}
                          >
                            <div class="eoschool-curriculum__subject-head">
                              <label class="eoschool-curriculum__section-check">
                                <input type="checkbox" data-curriculum-section-check />
                                <span class="page-title-sr">Sección completada: {area.label}</span>
                                <span class="eoschool-curriculum__section-check-box" aria-hidden="true">
                                  <span class="material-symbols-outlined eoschool-curriculum__section-check-icon">
                                    check
                                  </span>
                                </span>
                              </label>
                              <h4 class="eoschool-curriculum__subject-title">
                                <span class="eoschool-curriculum__subject-num">{area.num}.</span>
                                {area.label}
                              </h4>
                            </div>
                            <div class="eoschool-curriculum__subject-body eoschool-curriculum__subject-body--card">
                              {groups.some((g) => g.learnings.length) ? (
                                <ul class="eoschool-curriculum__learnings eoschool-curriculum__learnings--card">
                                  {groups.flatMap((group) =>
                                    group.learnings.map((learning) => <li>{learning}</li>),
                                  )}
                                </ul>
                              ) : (
                                <p class="eoschool-curriculum__empty">—</p>
                              )}
                            </div>
                            <div class="eoschool-curriculum__subject-detail" hidden>
                              {groups.map((group) => (
                                <div class="eoschool-curriculum__objective-block">
                                  <p class="eoschool-curriculum__objective">
                                    <span class="eoschool-curriculum__objective-label">Objetivo</span>
                                    {group.objective}
                                  </p>
                                  {group.learnings.length ? (
                                    <div class="eoschool-curriculum__specific-learning">
                                      <p class="eoschool-curriculum__learning-label">Aprendizaje específico</p>
                                      <ol class="eoschool-curriculum__learnings">
                                        {group.learnings.map((learning) => (
                                          <li>{learning}</li>
                                        ))}
                                      </ol>
                                    </div>
                                  ) : null}
                                </div>
                              ))}
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        ))
      }
    </div>
  </section>

  <div class="eoschool-curriculum-modal" data-curriculum-day-modal hidden>
    <div
      class="eoschool-curriculum-modal__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="curriculum-day-modal-title"
    >
      <header class="eoschool-curriculum-modal__toolbar">
        <h2 class="eoschool-curriculum-modal__title" id="curriculum-day-modal-title" data-curriculum-modal-title>
          Día
        </h2>
        <button class="icon-btn eoschool-curriculum-modal__close" type="button" data-curriculum-modal-close aria-label="Cerrar">
          <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
      </header>

      <div class="eoschool-curriculum-modal__tabs" role="tablist" aria-label="Áreas del día">
        <button type="button" class="eoschool-curriculum-modal__tab" data-curriculum-modal-tab="bib" role="tab">
          Biblia
        </button>
        <button type="button" class="eoschool-curriculum-modal__tab" data-curriculum-modal-tab="ide" role="tab">
          Identidad
        </button>
        <button type="button" class="eoschool-curriculum-modal__tab" data-curriculum-modal-tab="len" role="tab">
          Lenguaje
        </button>
        <button type="button" class="eoschool-curriculum-modal__tab" data-curriculum-modal-tab="mat" role="tab">
          Mat
        </button>
        <button type="button" class="eoschool-curriculum-modal__tab" data-curriculum-modal-tab="cie" role="tab">
          Ciencias
        </button>
      </div>

      <div class="eoschool-curriculum-modal__body">
        <section class="eoschool-curriculum-modal__panel" aria-label="Contenido MPPE">
          <h3 class="eoschool-curriculum-modal__panel-title">Contenido del día</h3>
          <div class="eoschool-curriculum-modal__section-content" data-curriculum-modal-section-content></div>
        </section>
        <section class="eoschool-curriculum-modal__panel eoschool-curriculum-modal__panel--pdf" aria-label="Clase PDF">
          <div class="eoschool-curriculum-modal__panel-head">
            <h3 class="eoschool-curriculum-modal__panel-title">Hoja del día (5 materias)</h3>
            <button type="button" class="eoschool-curriculum-modal__download" data-curriculum-modal-download disabled>
              Descargar PDF
            </button>
          </div>
          <p class="eoschool-curriculum-modal__pdf-empty" data-curriculum-modal-pdf-empty hidden>
            Clase en preparación para este día.
          </p>
          <p class="eoschool-curriculum-modal__pdf-loading" data-curriculum-modal-pdf-loading hidden>
            <span class="eoschool-curriculum-modal__pdf-spinner" aria-hidden="true"></span>
            Generando PDF en el servidor…
          </p>
          <div class="eoschool-curriculum-modal__pdf" data-curriculum-modal-pdf data-homescool-stage></div>
        </section>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { initCurriculumIndexResize } from "../../../lib/eoschool-curriculum-index-resize";
  import { initCurriculumDayModal } from "../../../lib/eoschool-curriculum-day-modal";
  import { initCurriculumProgress } from "../../../lib/eoschool-curriculum-progress";

  function bootCurriculumChrome() {
    const root = document.querySelector("[data-curriculum-progress]");
    initCurriculumIndexResize(document.querySelector("[data-curriculum-index]"));
    void initCurriculumProgress(root);
    initCurriculumDayModal(root);
  }

  bootCurriculumChrome();
  document.addEventListener("astro:page-load", bootCurriculumChrome);
</script>

<style>
  .eoschool-curriculum {
    min-width: 0;
    max-width: 100%;
  }

  .eoschool-curriculum__student {
    margin: 0;
    font-size: var(--font-size-sm);
    font-weight: 650;
    color: var(--color-text);
  }

  .eoschool-curriculum__bible-report {
    color: var(--color-muted);
  }

  .eoschool-curriculum__index {
    --idx-sem: 2.25rem;
    --idx-bib: 1fr;
    --idx-ide: 1fr;
    --idx-len: 1fr;
    --idx-mat: 1fr;
    --idx-cie: 1fr;
    --idx-grid: var(--idx-sem) var(--idx-bib) var(--idx-ide) var(--idx-len) var(--idx-mat) var(--idx-cie);
    display: flex;
    flex-direction: column;
    gap: 0;
    font-size: var(--font-size-xs);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius);
    overflow: hidden;
    margin-block-end: var(--space-padding);
    width: 100%;
    min-width: 0;
  }

  .eoschool-curriculum__index-head,
  .eoschool-curriculum__index-row {
    display: grid;
    grid-template-columns: var(--idx-grid);
    column-gap: 0;
    align-items: start;
    padding-block: var(--rail-gap);
    padding-inline: var(--space-padding);
    min-width: 0;
    width: 100%;
  }

  .eoschool-curriculum__index-cell {
    min-width: 0;
    padding-inline: var(--rail-gap);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .eoschool-curriculum__index-cell--sem {
    padding-inline-start: 0;
    flex-shrink: 0;
  }

  .eoschool-curriculum__index-cell--bordered {
    border-inline-end: var(--border-width) solid var(--color-border);
  }

  .eoschool-curriculum__index-head .eoschool-curriculum__index-cell {
    position: relative;
  }

  .eoschool-curriculum__index-resizer {
    position: absolute;
    inset-block: -0.375rem;
    inset-inline-end: 0;
    width: 0.5rem;
    transform: translateX(50%);
    padding: 0;
    border: 0;
    margin: 0;
    cursor: col-resize;
    background: transparent;
    touch-action: none;
    z-index: 2;
  }

  .eoschool-curriculum__index-resizer:hover,
  .eoschool-curriculum__index-resizer:focus-visible {
    background: color-mix(in srgb, var(--color-accent) 35%, transparent);
  }

  .eoschool-curriculum__index-head {
    font-weight: 650;
    color: var(--color-muted);
    background: var(--color-surface);
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .eoschool-curriculum__index-row {
    color: var(--color-link);
    text-decoration: none;
    border-block-end: var(--border-width) solid var(--color-border);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .eoschool-curriculum__index-row:last-child {
    border-block-end: 0;
  }

  .eoschool-curriculum__index-row:hover,
  .eoschool-curriculum__index-row:focus-visible {
    background: var(--color-surface);
  }

  .eoschool-curriculum__index-week {
    font-weight: 650;
    color: var(--color-text);
  }

  .eoschool-curriculum__weeks {
    display: flex;
    flex-direction: column;
    gap: var(--space-padding);
    min-width: 0;
    width: 100%;
  }

  .eoschool-curriculum__week {
    min-width: 0;
    width: 100%;
    max-width: none;
    min-height: 0;
    align-items: stretch;
    cursor: default;
  }

  .eoschool-curriculum__week:hover,
  .eoschool-curriculum__week:focus-visible {
    transform: none;
  }

  .eoschool-curriculum__week-head {
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    margin-block-end: var(--rail-gap);
  }

  .eoschool-curriculum__week-status {
    margin: 0;
    font-size: var(--font-size-xs);
    color: var(--color-muted);
  }

  .eoschool-curriculum__week--done .eoschool-curriculum__week-status {
    color: var(--color-ok);
  }

  .eoschool-curriculum__week-days {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--rail-gap);
    width: 100%;
    min-width: 0;
    align-items: stretch;
  }

  .eoschool-curriculum__day-card {
    cursor: pointer;
    align-items: stretch;
    gap: 0;
    min-width: 0;
    min-height: 0;
    padding: var(--space-padding);
    display: flex;
    flex-direction: column;
  }

  .eoschool-curriculum__day-card.product-dash__card {
    min-height: 0;
  }

  .eoschool-curriculum__day-body {
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
    min-width: 0;
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    max-height: 40rem;
  }

  .eoschool-curriculum__day-card:hover,
  .eoschool-curriculum__day-card:focus-visible {
    transform: none;
  }

  .eoschool-curriculum__day-card--done,
  .eoschool-curriculum__day-card.product-dash__card--done {
    border-color: var(--color-ok);
    background: color-mix(in srgb, var(--color-ok) 10%, var(--color-surface));
  }

  .eoschool-curriculum__week.product-dash__card--done {
    border-color: var(--color-ok);
    background: color-mix(in srgb, var(--color-ok) 6%, var(--color-surface));
  }

  .eoschool-curriculum__day-head {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--rail-gap);
    width: 100%;
    padding-block-end: var(--rail-gap);
    margin-block-end: var(--rail-gap);
    border-block-end: var(--border-width) solid var(--color-border);
    flex-shrink: 0;
    min-height: 0;
  }

  .eoschool-curriculum__day-title {
    margin: 0;
    font-size: var(--font-size-sm);
    font-weight: 650;
    line-height: 1;
    min-width: 0;
    flex: 1;
  }

  .eoschool-curriculum__day-open-hint {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--color-muted);
    font-size: var(--font-size-sm);
    line-height: 1;
    height: 1em;
  }

  .eoschool-curriculum__day-card .eoschool-curriculum__day-open-hint .material-symbols-outlined {
    font-size: 1em;
    width: 1em;
    height: 1em;
    line-height: 1;
  }

  .eoschool-curriculum__subject-head {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    margin-block-end: 0.25rem;
  }

  .eoschool-curriculum__section-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    font-size: var(--font-size-sm);
    line-height: 1.45;
    padding: 0;
    margin: 0;
  }

  .eoschool-curriculum__section-check:has(input:focus-visible) .eoschool-curriculum__section-check-box {
    outline: var(--border-width) solid var(--color-accent);
    outline-offset: 0.125rem;
  }

  .eoschool-curriculum__section-check input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .eoschool-curriculum__section-check-box {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1em;
    height: 1em;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius);
    background: transparent;
    color: var(--color-muted);
  }

  .eoschool-curriculum__day-card .eoschool-curriculum__section-check .material-symbols-outlined {
    font-size: 0.75em;
    width: 1em;
    height: 1em;
    line-height: 1;
    color: inherit;
  }

  .eoschool-curriculum__section-check-icon {
    opacity: 0;
  }

  .eoschool-curriculum__subject--done .eoschool-curriculum__section-check-box {
    border-color: var(--color-ok);
    color: var(--color-ok);
  }

  .eoschool-curriculum__subject--done .eoschool-curriculum__section-check-icon {
    opacity: 1;
  }

  .eoschool-curriculum__subject--done .eoschool-curriculum__subject-title {
    color: var(--color-ok);
  }

  .eoschool-curriculum__subject {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
    padding-block-start: var(--rail-gap);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .eoschool-curriculum__day-body > .eoschool-curriculum__subject:first-child {
    border-block-start: 0;
    padding-block-start: 0;
    margin-block-start: 0;
  }

  .eoschool-curriculum__subject-title {
    margin: 0;
    font-size: var(--font-size-sm);
    font-weight: 650;
