---
import { Fragment } from "astro/jsx-runtime";
import Layout from "../../../layouts/Layout.astro";
import { MPPE_28WEEK_CURRICULUM } from "../../../lib/eoschool-mppe-28week-curriculum";
import {
  bibleGroups,
  buildWeekIndexRow,
  groupLearningRefs,
  identityGroups,
} from "../../../lib/eoschool-mppe-curriculum-view";

const { meta, weeks } = MPPE_28WEEK_CURRICULUM;
const indexRows = weeks.map(buildWeekIndexRow);

const bibleMeta = meta.bible;
const areaDefs = [
  { num: 1, label: "Biblia", kind: "bible" as const },
  { num: 2, label: "Identidad", kind: "identity" as const },
  { num: 3, label: "Prácticas del Lenguaje", kind: "len" as const },
  { num: 4, label: "Matemáticas", kind: "mat" as const },
  { num: 5, label: "Ciencias Naturales", kind: "cie" as const },
];
---

<Layout
  title="Currículo MPPE 28 semanas"
  description="Plan de 28 semanas: lectura bíblica diaria (Gén–Ester, Job–Mal, NT), 14 objetivos de Identidad y saberes MPPE en 56 bloques."
  page="eoschool-requirements-curriculum"
  robots="noindex,nofollow"
  showPageTitle={false}
>
  <Fragment slot="dhs">
    <a class="dhs-action" href="/eoschool/requirements/national" data-route title="Requisitos MPPE" aria-label="Requisitos MPPE">
      <span class="icon-btn" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">menu_book</span></span>
      Requisitos
    </a>
    <a class="dhs-action" href="/homescool" data-route title="Homescool" aria-label="Homescool">
      <span class="icon-btn" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">school</span></span>
      Homescool
    </a>
  </Fragment>

  <h1 class="page-title-sr">Currículo MPPE 28 semanas</h1>

  <section class="product-dash eoschool-curriculum">
    <p class="lede">
      {meta.weeks} semanas · bloque 1 = 2 días, bloque 2 = 3 días ({bibleMeta.readingDays} días de lectura bíblica). Cada día: 1 cap.
      Génesis–Ester, 1 Job–Malaquías, 1 NT. Cada bloque además: Identidad, Lenguaje, Matemáticas y Ciencias.
    </p>
    <p class="lede eoschool-curriculum__bible-report">
      Biblia en 28 semanas: {bibleMeta.tracks.genEster.chaptersReadInPlan} de {bibleMeta.tracks.genEster.totalChapters} caps.
      (Gén–Ester), {bibleMeta.tracks.jobMal.chaptersReadInPlan} de {bibleMeta.tracks.jobMal.totalChapters} (Job–Mal),{" "}
      {bibleMeta.tracks.nt.chaptersReadInPlan} de {bibleMeta.tracks.nt.totalChapters} (NT). No coincide la Biblia entera en 140
      días a 1 capítulo por pista; el plan avanza en orden desde el inicio de cada pista.
    </p>

    <nav class="eoschool-curriculum__index" data-curriculum-index aria-label="Índice por semana">
      <div class="eoschool-curriculum__index-head">
        <span class="eoschool-curriculum__index-cell eoschool-curriculum__index-cell--sem">Sem</span>
        <span class="eoschool-curriculum__index-cell eoschool-curriculum__index-cell--bordered">
          Bibl
          <button
            type="button"
            class="eoschool-curriculum__index-resizer"
            data-resize-col="bib"
            aria-label="Ajustar ancho de columna Biblia"
          ></button>
        </span>
        <span class="eoschool-curriculum__index-cell eoschool-curriculum__index-cell--bordered">
          Identidad
          <button
            type="button"
            class="eoschool-curriculum__index-resizer"
            data-resize-col="ide"
            aria-label="Ajustar ancho de columna Identidad"
          ></button>
        </span>
        <span class="eoschool-curriculum__index-cell eoschool-curriculum__index-cell--bordered">
          Leng
          <button
            type="button"
            class="eoschool-curriculum__index-resizer"
            data-resize-col="len"
            aria-label="Ajustar ancho de columna Lenguaje"
          ></button>
        </span>
        <span class="eoschool-curriculum__index-cell eoschool-curriculum__index-cell--bordered">
          Mat
          <button
            type="button"
            class="eoschool-curriculum__index-resizer"
            data-resize-col="mat"
            aria-label="Ajustar ancho de columna Matemáticas"
          ></button>
        </span>
        <span class="eoschool-curriculum__index-cell">Cienc</span>
      </div>
      {
        indexRows.map((row) => (
          <a class="eoschool-curriculum__index-row" href={`#week-${row.week}`} data-route>
            <span class="eoschool-curriculum__index-cell eoschool-curriculum__index-cell--sem eoschool-curriculum__index-week">
              S{row.week}
            </span>
            <span class="eoschool-curriculum__index-cell eoschool-curriculum__index-cell--bordered">{row.bib}</span>
            <span class="eoschool-curriculum__index-cell eoschool-curriculum__index-cell--bordered">{row.ide}</span>
            <span class="eoschool-curriculum__index-cell eoschool-curriculum__index-cell--bordered">{row.len}</span>
            <span class="eoschool-curriculum__index-cell eoschool-curriculum__index-cell--bordered">{row.mat}</span>
            <span class="eoschool-curriculum__index-cell">{row.cie}</span>
          </a>
        ))
      }
    </nav>

    <div class="eoschool-curriculum__weeks">
      {
        weeks.map((weekPlan) => (
          <section
            class="product-dash__card eoschool-curriculum__week"
            id={`week-${weekPlan.week}`}
            aria-labelledby={`week-title-${weekPlan.week}`}
          >
            <header class="product-dash__card-head eoschool-curriculum__week-head">
              <h2 class="product-dash__card-title" id={`week-title-${weekPlan.week}`}>Semana {weekPlan.week}</h2>
            </header>

            <div class="eoschool-curriculum__blocks">
              {weekPlan.blocks.map((block) => (
                <article class="eoschool-curriculum__block" aria-labelledby={`w${weekPlan.week}-b${block.block}`}>
                  <h3 class="eoschool-curriculum__block-title" id={`w${weekPlan.week}-b${block.block}`}>
                    Bloque {block.block} · {block.days} días
                  </h3>

                  {areaDefs.map((area) => {
                    const groups =
                      area.kind === "bible"
                        ? bibleGroups(block)
                        : area.kind === "identity"
                          ? identityGroups(block)
                          : groupLearningRefs(
                              area.kind === "len" ? block.len : area.kind === "mat" ? block.mat : block.cie,
                            );
                    return (
                      <div class="eoschool-curriculum__subject">
                        <h4 class="eoschool-curriculum__subject-title">
                          <span class="eoschool-curriculum__subject-num">{area.num}.</span>
                          {area.label}
                        </h4>
                        {groups.map((group) => (
                          <div class="eoschool-curriculum__objective-block">
                            <p class="eoschool-curriculum__objective">
                              <span class="eoschool-curriculum__objective-label">Objetivo</span>
                              {group.objective}
                            </p>
                            <ol class="eoschool-curriculum__learnings">
                              {group.learnings.map((learning) => (
                                <li>{learning}</li>
                              ))}
                            </ol>
                          </div>
                        ))}
                      </div>
                    );
                  })}
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>
</Layout>

<script>
  import { initCurriculumIndexResize } from "../../../lib/eoschool-curriculum-index-resize";

  function bootCurriculumIndexResize() {
    initCurriculumIndexResize(document.querySelector("[data-curriculum-index]"));
  }

  bootCurriculumIndexResize();
  document.addEventListener("astro:page-load", bootCurriculumIndexResize);
</script>

<style>
  .eoschool-curriculum {
    min-width: 0;
    max-width: 100%;
  }

  .eoschool-curriculum__bible-report {
    color: var(--color-muted);
  }

  .eoschool-curriculum__index {
    --idx-bib: 7rem;
    --idx-ide: 7rem;
    --idx-len: 7rem;
    --idx-mat: 7rem;
    --idx-grid: 2.25rem var(--idx-bib) var(--idx-ide) var(--idx-len) var(--idx-mat) minmax(4rem, 1fr);
    display: flex;
    flex-direction: column;
    gap: 0;
    font-size: var(--font-size-xs);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius);
    overflow: hidden;
    margin-block-end: var(--space-padding);
    width: 100%;
    min-width: 0;
  }

  .eoschool-curriculum__index-head,
  .eoschool-curriculum__index-row {
    display: grid;
    grid-template-columns: var(--idx-grid);
    column-gap: 0;
    align-items: stretch;
    padding-block: 0.375rem;
    padding-inline: var(--space-padding);
    min-width: 0;
    width: 100%;
  }

  .eoschool-curriculum__index-cell {
    min-width: 0;
    padding-inline: var(--rail-gap);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .eoschool-curriculum__index-cell--sem {
    padding-inline-start: 0;
    flex-shrink: 0;
  }

  .eoschool-curriculum__index-cell--bordered {
    border-inline-end: var(--border-width) solid var(--color-border);
  }

  .eoschool-curriculum__index-head .eoschool-curriculum__index-cell {
    position: relative;
  }

  .eoschool-curriculum__index-resizer {
    position: absolute;
    inset-block: -0.375rem;
    inset-inline-end: 0;
    width: 0.5rem;
    transform: translateX(50%);
    padding: 0;
    border: 0;
    margin: 0;
    cursor: col-resize;
    background: transparent;
    touch-action: none;
    z-index: 2;
  }

  .eoschool-curriculum__index-resizer:hover,
  .eoschool-curriculum__index-resizer:focus-visible {
    background: color-mix(in srgb, var(--color-accent) 35%, transparent);
  }

  .eoschool-curriculum__index-head {
    font-weight: 650;
    color: var(--color-muted);
    background: var(--color-surface);
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .eoschool-curriculum__index-row {
    color: var(--color-link);
    text-decoration: none;
    border-block-end: var(--border-width) solid var(--color-border);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .eoschool-curriculum__index-row:last-child {
    border-block-end: 0;
  }

  .eoschool-curriculum__index-row:hover,
  .eoschool-curriculum__index-row:focus-visible {
    background: var(--color-surface);
  }

  .eoschool-curriculum__index-week {
    font-weight: 650;
    color: var(--color-text);
  }

  .eoschool-curriculum__weeks {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-padding);
    min-width: 0;
  }

  .eoschool-curriculum__week {
    min-width: 0;
    max-width: 100%;
    min-height: 0;
    align-items: stretch;
    cursor: default;
  }

  .eoschool-curriculum__week:hover,
  .eoschool-curriculum__week:focus-visible {
    transform: none;
  }

  .eoschool-curriculum__week-head {
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    margin-block-end: var(--rail-gap);
  }

  .eoschool-curriculum__blocks {
    display: flex;
    flex-direction: column;
    gap: var(--space-padding);
    width: 100%;
    min-width: 0;
  }

  .eoschool-curriculum__block {
    display: flex;
    flex-direction: column;
    gap: var(--space-padding);
    padding: var(--space-padding);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius);
    background: var(--color-bg);
    min-width: 0;
  }

  .eoschool-curriculum__block-title {
    margin: 0;
    font-size: var(--font-size-md);
    font-weight: 650;
    overflow-wrap: anywhere;
  }

  .eoschool-curriculum__subject {
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
    min-width: 0;
    padding-block-start: var(--space-padding);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .eoschool-curriculum__subject:first-of-type {
    border-block-start: 0;
    padding-block-start: 0;
  }

  .eoschool-curriculum__subject-title {
    margin: 0;
    font-size: var(--font-size-sm);
    font-weight: 650;
    color: var(--color-accent);
    overflow-wrap: anywhere;
  }

  .eoschool-curriculum__subject-num {
    margin-inline-end: 0.25rem;
  }

  .eoschool-curriculum__objective-block {
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
    min-width: 0;
  }

  .eoschool-curriculum__objective-block + .eoschool-curriculum__objective-block {
    margin-block-start: var(--rail-gap);
    padding-block-start: var(--rail-gap);
    border-block-start: var(--border-width) dashed var(--color-border);
  }

  .eoschool-curriculum__objective {
    margin: 0;
    font-size: var(--font-size-sm);
    font-weight: 650;
    overflow-wrap: anywhere;
  }

  .eoschool-curriculum__objective-label {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: 650;
    color: var(--color-muted);
    margin-block-end: 0.25rem;
  }

  .eoschool-curriculum__learnings {
    margin: 0;
    padding-inline-start: 1rem;
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
    font-size: var(--font-size-sm);
    min-width: 0;
    list-style: decimal;
  }

  .eoschool-curriculum__learnings li {
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  @media (min-width: 48rem) {
    .eoschool-curriculum__weeks {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  @media (max-width: 47.999rem) {
    .eoschool-curriculum .lede {
      font-size: var(--font-size-sm);
    }

    .eoschool-curriculum__index {
      overflow-x: auto;
    }

    .eoschool-curriculum__index-head,
    .eoschool-curriculum__index-row {
      min-width: min(100%, 28rem);
    }

    .eoschool-curriculum__learnings {
      padding-inline-start: 0.875rem;
    }
  }
</style>
