---
import { Fragment } from "astro/jsx-runtime";
import EoschoolDashBack from "../../components/EoschoolDashBack.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Gestionar tutores"
  description="Asigna estudiantes MPPE a tutores con acceso Homescool."
  page="eoschool-tutors"
  robots="noindex,nofollow"
>
  <Fragment slot="dhs">
    <a class="dhs-action" href="/eoschool" data-route title="Dashboard" aria-label="Dashboard">
      <span class="icon-btn" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">dashboard</span></span>
      Dashboard
    </a>
  </Fragment>

  <section class="product-dash page-span-all" data-tutors>
    <EoschoolDashBack />
    <p class="status" data-banner>Cargando…</p>
    <div data-gate hidden class="product-gate">
      <p class="hint">Solo el administrador puede gestionar tutores.</p>
      <a class="button" href="/eoschool" data-route>Volver</a>
    </div>
    <div class="product-dash__grid" data-list hidden></div>
  </section>
</Layout>

<script>
  import { apiSend } from "../../lib/api";
  import { isPlatformAdmin, refreshAuthSession } from "../../lib/auth";
  import { apiFail, onAstroPageLoad, requireService, setHidden } from "../../lib/productGate";
  import type { CurriculumStudent } from "../../lib/eoschool-curriculum-api";

  type TutorRow = {
    userId: string;
    email: string;
    username: string;
    displayName: string;
    studentKeys: string[];
  };

  type TutorsPayload = {
    tutors: TutorRow[];
    students: CurriculumStudent[];
  };

  onAstroPageLoad("eoschool-tutors", async () => {
    const root = document.querySelector("[data-tutors]");
    const banner = root?.querySelector("[data-banner]");
    const gate = root?.querySelector("[data-gate]");
    const list = root?.querySelector("[data-list]");
    if (banner instanceof HTMLElement) {
      banner.hidden = false;
      banner.textContent = "Cargando…";
    }

    const access = await requireService("homescool", { requireSubscription: true });
    await refreshAuthSession();
    if (!access.sessionOk || !access.access.allowed || !isPlatformAdmin()) {
      if (banner instanceof HTMLElement) {
        banner.textContent = !access.sessionOk
          ? "Inicia sesión para continuar."
          : "Solo el administrador puede gestionar tutores.";
      }
      setHidden(gate, false);
      setHidden(list, true);
      return;
    }
    setHidden(gate, true);
    setHidden(list, false);
    await reload(banner, list);
  });

  async function reload(banner: Element | null | undefined, list: Element | null | undefined) {
    const { status, data, requestId } = await apiSend<TutorsPayload>("/eoschool/curriculum/tutors", {
      method: "GET",
    });
    if (status < 200 || status >= 300) {
      apiFail("No se pudo cargar tutores.", { requestId });
      return;
    }
    const tutors = data.tutors || [];
    const students = data.students || [];
    if (banner instanceof HTMLElement) {
      banner.textContent = tutors.length
        ? `${tutors.length} usuario(s) — marca estudiantes y guarda`
        : "No hay usuarios verificados para asignar.";
    }
    if (!(list instanceof HTMLElement)) return;
    list.replaceChildren();
    for (const tutor of tutors) {
      list.appendChild(renderTutorCard(tutor, students, banner, list));
    }
  }

  function renderTutorCard(
    tutor: TutorRow,
    students: CurriculumStudent[],
    banner: Element | null | undefined,
    list: Element | null | undefined,
  ): HTMLElement {
    const card = document.createElement("article");
    card.className = "product-dash__card eoschool-tutors__card";

    const head = document.createElement("div");
    head.className = "product-dash__card-head";
    const title = document.createElement("span");
    title.className = "product-dash__card-title";
    title.textContent = tutor.displayName || tutor.username || tutor.email;
    const desc = document.createElement("span");
    desc.className = "product-dash__card-desc";
    desc.textContent = tutor.email;
    head.append(title, desc);
    card.appendChild(head);

    const form = document.createElement("form");
    form.className = "eoschool-tutors__form";

    const assigned = new Set(tutor.studentKeys || []);
    if (!students.length) {
      const empty = document.createElement("p");
      empty.className = "hint";
      empty.textContent = "Registra un estudiante primero.";
      form.appendChild(empty);
    } else {
      for (const s of students) {
        const label = document.createElement("label");
        label.className = "eoschool-tutors__check";
        const input = document.createElement("input");
        input.type = "checkbox";
        input.name = "studentKey";
        input.value = s.studentKey;
        input.checked = assigned.has(s.studentKey);
        const text = document.createElement("span");
        text.textContent = s.displayName || s.studentKey;
        label.append(input, text);
        form.appendChild(label);
      }
    }

    const save = document.createElement("button");
    save.className = "button";
    save.type = "submit";
    save.textContent = "Guardar asignación";
    save.disabled = students.length === 0;
    form.appendChild(save);

    form.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      save.disabled = true;
      const keys = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="studentKey"]:checked')).map(
        (el) => el.value,
      );
      const { status, data, requestId } = await apiSend<{ studentKeys?: string[]; message?: string }>(
        `/eoschool/curriculum/tutors/${encodeURIComponent(tutor.userId)}/students`,
        {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ studentKeys: keys }),
        },
      );
      if (status < 200 || status >= 300) {
        apiFail(data.message || "No se pudo guardar la asignación.", { requestId });
        save.disabled = false;
        return;
      }
      if (banner instanceof HTMLElement) {
        banner.textContent = `Asignación guardada para ${tutor.email}.`;
      }
      await reload(banner, list);
    });

    card.appendChild(form);
    return card;
  }
</script>

<style>
  .eoschool-tutors__form {
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
    margin-top: var(--space-padding);
  }
  .eoschool-tutors__check {
    display: flex;
    align-items: center;
    gap: var(--rail-gap);
    font-size: var(--font-size-sm);
  }
</style>
