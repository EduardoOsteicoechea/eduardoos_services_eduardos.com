---
import { Fragment } from "astro/jsx-runtime";
import EoschoolDashBack from "../../components/EoschoolDashBack.astro";
import Layout from "../../layouts/Layout.astro";
import { MPPE_40WEEK_CURRICULUM } from "../../lib/eoschool-mppe-40week-curriculum";
import { CURRICULUM_SECTION_IDS } from "../../lib/eoschool-curriculum-plan-classes";

const sectionLabels: Record<string, string> = {
  bib: "Bib",
  ide: "Ide",
  len: "Len",
  mat: "Mat",
  cie: "Cie",
};

const dayRows = MPPE_40WEEK_CURRICULUM.weeks.flatMap((week) =>
  week.blocks
    .flatMap((block) => (block.bible?.days ?? []).map((d) => ({ week: week.week, planDay: d.dayInPlan })))
    .sort((a, b) => a.planDay - b.planDay)
    .map((d) => ({ week: d.week, planDay: d.planDay, dayId: `d${d.planDay}` })),
);
---

<Layout
  title="Progreso MPPE"
  description="Semáforo de avance por día y materia del currículo MPPE."
  page="eoschool-progress"
  robots="noindex,nofollow"
>
  <Fragment slot="dhs">
    <a class="dhs-action" href="/eoschool" data-route title="Dashboard" aria-label="Dashboard">
      <span class="icon-btn" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">dashboard</span></span>
      Dashboard
    </a>
  </Fragment>

  <section class="product-dash page-span-all" data-mppe-progress>
    <EoschoolDashBack />
    <p class="status" data-banner>Cargando…</p>
    <div data-gate hidden class="product-gate">
      <p class="hint">Necesitas sesión y suscripción Homescool.</p>
      <a class="button" href="/session" data-route>Sign in</a>
    </div>

    <div class="eoschool-progress__body" data-authed hidden>
      <div class="eoschool-progress__toolbar">
        <label class="eoschool-progress__student">
          <span class="eoschool-progress__label">Estudiante</span>
          <select data-student-select></select>
        </label>
        <p class="eoschool-progress__meta" data-student-meta></p>
      </div>

      <div class="eoschool-progress-table-wrap">
        <table class="eoschool-progress-table" data-progress-table>
          <thead>
            <tr>
              <th scope="col">Sem</th>
              <th scope="col">Día</th>
              {CURRICULUM_SECTION_IDS.map((id) => <th scope="col">{sectionLabels[id]}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              dayRows.map((day) => (
                <tr data-day-row={day.dayId}>
                  <td>{day.week}</td>
                  <td>{day.planDay}</td>
                  {CURRICULUM_SECTION_IDS.map((sid) => (
                    <td>
                      <span
                        class="eoschool-dot"
                        data-section-dot
                        data-section={sid}
                        aria-label={sectionLabels[sid]}
                      ></span>
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Layout>

<script>
  import {
    fetchCurriculumProgress,
    fetchCurriculumStudents,
    type CurriculumStudent,
  } from "../../lib/eoschool-curriculum-api";
  import { sectionDone } from "../../lib/eoschool-curriculum-progress-status";
  import type { CurriculumPlanSectionId } from "../../lib/eoschool-curriculum-plan-classes";
  import { apiFail, onAstroPageLoad, requireService, setHidden } from "../../lib/productGate";

  onAstroPageLoad("eoschool-progress", async () => {
    const root = document.querySelector("[data-mppe-progress]");
    const banner = root?.querySelector("[data-banner]");
    const gate = root?.querySelector("[data-gate]");
    const authed = root?.querySelector("[data-authed]");
    const select = root?.querySelector<HTMLSelectElement>("[data-student-select]");
    const meta = root?.querySelector("[data-student-meta]");
    if (banner instanceof HTMLElement) {
      banner.hidden = false;
      banner.textContent = "Cargando…";
    }

    const access = await requireService("homescool", { requireSubscription: true });
    if (!access.sessionOk || !access.access.allowed) {
      if (banner instanceof HTMLElement) {
        banner.textContent = access.sessionOk
          ? "Necesitas suscripción Homescool."
          : "Inicia sesión para continuar.";
      }
      setHidden(gate, false);
      setHidden(authed, true);
      return;
    }
    setHidden(gate, true);
    setHidden(authed, false);
    const studentsRes = await fetchCurriculumStudents();
    if (!studentsRes.ok) {
      apiFail("No se pudo cargar estudiantes.", { requestId: studentsRes.requestId });
      return;
    }
    const students = studentsRes.data.students;
    const qKey = new URLSearchParams(location.search).get("studentKey") || "";
    if (select) {
      select.replaceChildren();
      for (const s of students) {
        const opt = document.createElement("option");
        opt.value = s.studentKey;
        opt.textContent = s.displayName;
        if (s.studentKey === qKey) opt.selected = true;
        select.append(opt);
      }
    }
    if (!students.length) {
      if (banner instanceof HTMLElement) banner.textContent = "Registra un estudiante primero.";
      return;
    }
    if (banner instanceof HTMLElement) banner.hidden = true;
    const initial = (select?.value || students[0].studentKey).trim();
    await loadProgress(root, meta, initial, students);
    select?.addEventListener("change", () => {
      void loadProgress(root, meta, select.value, students);
    });
  });

  async function loadProgress(
    root: Element | null,
    meta: Element | null | undefined,
    studentKey: string,
    students: CurriculumStudent[],
  ) {
    const student = students.find((s) => s.studentKey === studentKey);
    if (meta instanceof HTMLElement && student) {
      meta.textContent = `${student.displayName} · ${student.age} años · ${student.grade}`;
    }
    const loaded = await fetchCurriculumProgress(studentKey);
    if (!loaded.ok) {
      apiFail("No se pudo cargar el progreso.", { requestId: loaded.requestId });
      return;
    }
    const done = new Set(loaded.data.sectionsDone);
    root?.querySelectorAll<HTMLElement>("[data-day-row]").forEach((row) => {
      const dayId = row.dataset.dayRow || "";
      row.querySelectorAll<HTMLElement>("[data-section-dot]").forEach((dot) => {
        const sid = dot.dataset.section as CurriculumPlanSectionId;
        const ok = sectionDone(dayId, sid, done);
        dot.className = `eoschool-dot eoschool-dot--${ok ? "green" : "red"}`;
      });
    });
  }
</script>

<style>
  .eoschool-progress__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-padding);
    min-width: 0;
  }

  .eoschool-progress__toolbar {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--rail-gap);
    max-width: 24rem;
  }

  .eoschool-progress__student {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.25rem;
    font-size: var(--font-size-sm);
  }

  .eoschool-progress__label {
    color: var(--color-muted);
  }

  .eoschool-progress__student select {
    min-height: var(--control-height);
    padding: var(--control-padding-block) var(--control-padding-inline);
    font-size: var(--font-size-md);
    color: var(--color-text);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius);
  }

  .eoschool-progress__meta {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }

  .eoschool-progress-table-wrap {
    overflow-x: auto;
    min-width: 0;
  }

  .eoschool-progress-table {
    border-collapse: collapse;
    font-size: var(--font-size-sm);
  }

  .eoschool-progress-table th,
  .eoschool-progress-table td {
    padding: 0.25rem 0.5rem;
    border-bottom: var(--border-width) solid var(--color-border);
    text-align: center;
  }

  .eoschool-progress-table th {
    background: var(--color-surface);
  }

  /* Sem + Día: same discrete surface as the header row */
  .eoschool-progress-table td:nth-child(1),
  .eoschool-progress-table td:nth-child(2) {
    background: var(--color-surface);
    color: var(--color-muted);
  }

  .eoschool-dot {
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--color-muted);
  }

  /* Brand --color-ok is grey; traffic-light green is intentional here. */
  .eoschool-dot--green {
    background: #22c55e;
  }

  .eoschool-dot--red {
    background: var(--color-err);
  }
</style>
