---
import Layout from "../../layouts/Layout.astro";

const primary = [
  {
    href: "/eoschool/requirements/curriculum?mode=study",
    title: "Clases (estudio)",
    desc: "Programa con checks por niño y espacio de estudio.",
    icon: "school",
    tone: "study",
  },
  {
    href: "/eoschool/progress",
    title: "Progreso",
    desc: "Materias completadas en clase y puntaje en las que tienen score.",
    icon: "monitoring",
  },
  {
    href: "/eoschool/portfolio",
    title: "Portafolio",
    desc: "Vista previa PDF con temas y fotos de demostración.",
    icon: "folder_special",
  },
  {
    href: "/eoschool/proyecto-semestral",
    title: "Proyecto semestral",
    desc: "Trabajo del semestre escolar.",
    icon: "assignment",
  },
];

const standards = [
  {
    href: "/eoschool/requirements/curriculum?mode=browse&view=standards",
    title: "Estándares 3.er grado",
    desc: "Venezuela, Estados Unidos e Inglaterra, tema por tema.",
    icon: "view_column",
  },
  {
    href: "/eoschool/requirements/curriculum?mode=browse&view=gaps",
    title: "Carencias 3.er grado",
    desc: "Lo que el programa de Venezuela no pide y sí piden Estados Unidos e Inglaterra.",
    icon: "difference",
  },
];

const registry = [
  {
    href: "/eoschool/students/register",
    title: "Registrar estudiante",
    desc: "Nombre, apellido, edad, grado y foto del niño.",
    icon: "person_add",
  },
  {
    href: "/eoschool/students",
    title: "Gestionar estudiantes",
    desc: "Lista, edita o elimina niños del currículo.",
    icon: "group",
  },
  {
    href: "/eoschool/program/print",
    title: "Imprimir programa",
    desc: "PDF estructurado de las 40 semanas completas.",
    icon: "print",
  },
];
---

<Layout
  title="Homeschool"
  description="Dashboard del currículo MPPE: clases, progreso, portafolio y proyecto semestral."
  page="eoschool-hub"
  robots="noindex,nofollow"
>
  <section class="product-dash page-span-all" data-eoschool-hub>
    <p class="status" data-banner>Cargando…</p>
    <div data-gate hidden class="product-gate">
      <p class="hint">Necesitas sesión y suscripción Homescool.</p>
      <a class="button" href="/session" data-route>Sign in</a>
    </div>
    <div class="eoschool-hub__rows" data-authed hidden>
      <div class="product-dash__grid">
        {
          primary.map((card) => (
            <a class:list={["product-dash__card", card.tone && `product-dash__card--${card.tone}`]} href={card.href} data-route>
              <span class="material-symbols-outlined" aria-hidden="true">{card.icon}</span>
              <span class="product-dash__card-title">{card.title}</span>
              <span class="product-dash__card-desc">{card.desc}</span>
            </a>
          ))
        }
      </div>
      <div class="product-dash__grid">
        {
          standards.map((card) => (
            <a class="product-dash__card" href={card.href} data-route>
              <span class="material-symbols-outlined" aria-hidden="true">{card.icon}</span>
              <span class="product-dash__card-title">{card.title}</span>
              <span class="product-dash__card-desc">{card.desc}</span>
            </a>
          ))
        }
      </div>
      <div class="product-dash__grid">
        {
          registry.map((card) => (
            <a class="product-dash__card" href={card.href} data-route>
              <span class="material-symbols-outlined" aria-hidden="true">{card.icon}</span>
              <span class="product-dash__card-title">{card.title}</span>
              <span class="product-dash__card-desc">{card.desc}</span>
            </a>
          ))
        }
        <a class="product-dash__card" href="/eoschool/tutors" data-route data-admin-tutors hidden>
          <span class="material-symbols-outlined" aria-hidden="true">supervisor_account</span>
          <span class="product-dash__card-title">Gestionar tutores</span>
          <span class="product-dash__card-desc">Asigna estudiantes a tutores con acceso Homeschool.</span>
        </a>
      </div>
      <article class="product-dash__card eoschool-instructivo">
        <h2 class="product-dash__card-title">Notas, evidencias y aprobación</h2>
        <p>
          El año se aprueba cuando, dentro del calendario, el tutor recibió el PDF y la intranet tiene la boleta.
          Cerrado el año, el sistema no reabre y el grado se pierde.
        </p>

        <section>
          <h3>Orden de cada semestre</h3>
          <ol>
            <li>Arme un solo PDF, súbalo a Drive y pegue el enlace en la intranet. Antes, dé acceso a ese archivo al correo del tutor.</li>
            <li>Espere el informe. Si lo devuelven, rehaga el trabajo y use esas correcciones en la entrega siguiente.</li>
            <li>Cargue la boleta de todas las materias, los días y horas de estudio, y los libros leídos.</li>
          </ol>
        </section>

        <section>
          <h3>El PDF de evidencias</h3>
          <ul>
            <li>Portada: nombre completo, id de la intranet, grado, semestre, correo donde recibirá el informe y fecha de envío. La portada la hace el padre.</li>
            <li>Materias que el PDF tiene que mostrar: Biblia, Matemáticas, Castellano, Ciencias Naturales y Ciencias Sociales.</li>
            <li>Dos PDF en el año, uno por semestre. Los dos son obligatorios para aprobar.</li>
            <li>Cada PDF: alrededor de 26 páginas. Tope de 30 si agrega Inglés u otra materia inscrita.</li>
            <li>El estudiante hace el trabajo. En niños pequeños, los padres ayudan.</li>
            <li>En 3.er grado va escrito a mano y con fotografías. No se envía escrito en computadora.</li>
            <li>A mano, con el lápiz de grafito más oscuro. Matemática en hoja cuadriculada. Escritura en hoja de líneas. Lo central del PDF son los ejercicios de matemática y las redacciones a mano.</li>
            <li>En los grados que sí van en computadora: Arial 12, texto justificado, interlineado 1,5, y al menos una página escrita a mano.</li>
            <li>Cada hoja o foto ocupa una página del PDF. Cada foto dice qué hace el estudiante y qué está aprendiendo.</li>
            <li>Un video se pone como enlace, con una frase de qué muestra.</li>
            <li>Con otro currículo: elija los mejores trabajos del semestre, no solo el último tema. En Ciencias, el segundo semestre incluye un proyecto del grado.</li>
            <li>Si el trabajo está incompleto, o si más del 40% no se lee, el tutor lo devuelve.</li>
            <li>Si el informe dice que faltó acompañamiento de la familia, los padres responden por escrito qué pasó y qué van a hacer.</li>
            <li>Si una condición física o mental impide el trabajo del grado, la familia escribe el caso antes de la evaluación.</li>
          </ul>
        </section>

        <section>
          <h3>3.er grado, dentro de cada PDF</h3>
          <p>Primer semestre, todo a mano:</p>
          <ul>
            <li>Línea de tiempo con los hechos principales del Evangelio según Lucas.</li>
            <li>Tablas de multiplicar del 1 al 10, escritas a mano. Ya debe decirlas de memoria.</li>
            <li>Tres ejercicios de operaciones combinadas de suma, resta y multiplicación.</li>
            <li>Cinco hojas de ejercicios de división.</li>
            <li>Definición de verbo, verbos hallados en las tres primeras páginas del libro que leen, y cuáles están en infinitivo.</li>
            <li>Ensayo: quién fue Constantino I, con línea de tiempo de su nacimiento y del Edicto de Milán.</li>
            <li>Un trabajo sobre la fuerza.</li>
          </ul>
          <p>Segundo semestre, todo a mano:</p>
          <ul>
            <li>Línea de tiempo con los hechos principales de Hechos.</li>
            <li>Cinco hojas de fracciones resueltas por el estudiante.</li>
            <li>Clasificación de polígonos regulares e irregulares, dibujados por él.</li>
            <li>Cinco oraciones con conectores distintos.</li>
            <li>Diez oraciones con verbos auxiliares distintos.</li>
            <li>Identidad: dibujo de sí mismo, mapa mental de dones y talentos, lista de actividades que le gusta, y respuestas a cuáles son sus dones, qué lo hace distinto y cómo potenciarlos.</li>
            <li>Sistemas del cuerpo humano: memorización, fotos de lo que usó para memorizarlos y un trabajo que diga para qué funciona cada sistema.</li>
          </ul>
        </section>

        <section>
          <h3>La boleta</h3>
          <ul>
            <li>Lleva todas las materias del plan familiar y las obligatorias del país donde vive.</li>
            <li>Se carga al menos dos veces en el año, en la ventana del calendario.</li>
            <li>La nota que carga la familia queda atada al informe del tutor.</li>
            <li>Los padres responden por nombres, materias, notas y ortografía. Con esos datos se emite la boleta.</li>
            <li>Si el grado quedó mal inscrito, la corrección se pide dentro de los tres meses siguientes a la inscripción.</li>
          </ul>
        </section>

        <section>
          <h3>Días, libros y salidas</h3>
          <ul>
            <li>Kinder: 172 días al año, 2 horas por día. Primaria de 1.º a 8.º: 172 días, 4 horas por día. Secundaria: 120 días al año.</li>
            <li>Bitácora mensual firmada: materia o actividad, días del mes y total de horas.</li>
            <li>Literatura: libro, autor, páginas, inicio, fin, semestre y comentario. Los documentos no fijan un número mínimo de libros.</li>
            <li>Salidas: fecha, semestre, lugar, objetivo, materia y qué se aprendió. En 3.er grado la planilla es obligatoria en el portafolio y no hay un número mínimo.</li>
            <li>El PDF de evidencias sí pide un número, y solo en estos grados: preescolar, 2.º semestre, 2 salidas a parques o jardines; prekínder, 1.er semestre, 2 paseos por la naturaleza; kínder, 2.º semestre, 3 salidas al aire libre. En los tres casos van con dibujos de lo que vio.</li>
          </ul>
        </section>

        <section>
          <h3>Papeles del portafolio</h3>
          <ul>
            <li>Plan de estudios, ejemplos de actividades y ensayos.</li>
            <li>Documento de identidad de los padres y del estudiante, y copia de la partida de nacimiento.</li>
            <li>Si viene de otro colegio, el récord anterior. Si hay una condición médica que deba considerarse, el informe.</li>
          </ul>
        </section>

        <section>
          <h3>Calendario norte regular</h3>
          <p>Inicio 15 de septiembre. Inscripción regular: 15 de agosto al 15 de noviembre. Rezagada: 16 de noviembre al 14 de enero.</p>
          <p>1.er semestre, evidencias y notas: 1 de diciembre al 10 de febrero.</p>
          <p>2.º semestre, evidencias y notas: 1 de abril al 20 de junio.</p>
          <p>Cierre: 10 de julio.</p>
        </section>
      </article>
    </div>
  </section>
</Layout>

<script>
  import { isPlatformAdmin, refreshAuthSession } from "../../lib/auth";
  import { onAstroPageLoad, requireService, setHidden } from "../../lib/productGate";

  onAstroPageLoad("eoschool-hub", async () => {
    const root = document.querySelector("[data-eoschool-hub]");
    const banner = root?.querySelector("[data-banner]");
    const gate = root?.querySelector("[data-gate]");
    const authed = root?.querySelector("[data-authed]");
    const tutorsCard = root?.querySelector("[data-admin-tutors]");
    if (banner instanceof HTMLElement) {
      banner.hidden = false;
      banner.textContent = "Cargando…";
    }

    const result = await requireService("homescool", { requireSubscription: true, adminOnly: true });
    await refreshAuthSession();
    if (!result.sessionOk || !result.access.allowed) {
      if (banner instanceof HTMLElement) {
        banner.textContent = result.sessionOk
          ? "Necesitas suscripción Homescool."
          : "Inicia sesión para continuar.";
      }
      setHidden(gate, false);
      setHidden(authed, true);
    } else {
      if (banner instanceof HTMLElement) banner.hidden = true;
      setHidden(gate, true);
      setHidden(authed, false);
      setHidden(tutorsCard, !isPlatformAdmin());
    }
  });
</script>

<style>
  .eoschool-hub__rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-padding);
    min-width: 0;
  }

  a.product-dash__card {
    text-decoration: none;
    color: inherit;
  }

  a.product-dash__card--study {
    background: #d8f3dc;
    color: #14281a;
    border-color: #b7e4c7;
  }

  a.product-dash__card--study .material-symbols-outlined {
    color: #1b4332;
  }

  a.product-dash__card--study .product-dash__card-desc {
    color: #2d4a38;
  }

  a.product-dash__card--study:hover,
  a.product-dash__card--study:focus-visible {
    border-color: #1b4332;
  }

  .eoschool-instructivo {
    gap: var(--space-padding);
  }

  .eoschool-instructivo h2,
  .eoschool-instructivo h3,
  .eoschool-instructivo p {
    margin: 0;
  }

  .eoschool-instructivo h3 {
    font-size: var(--font-size-sm);
    font-weight: 650;
  }

  .eoschool-instructivo p,
  .eoschool-instructivo li {
    font-size: var(--font-size-sm);
    color: var(--color-text);
  }

  .eoschool-instructivo section,
  .eoschool-instructivo ol,
  .eoschool-instructivo ul {
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
    min-width: 0;
  }

  .eoschool-instructivo ol,
  .eoschool-instructivo ul {
    margin: 0;
    padding-left: 1.25rem;
  }

</style>
