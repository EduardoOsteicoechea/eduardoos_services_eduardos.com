---
import Layout from "../../layouts/Layout.astro";

const primary = [
  {
    href: "/eoschool/requirements/curriculum?mode=study",
    title: "Clases (estudio)",
    desc: "Programa con checks por niño y espacio de estudio.",
    icon: "school",
    tone: "study",
  },
  {
    href: "/eoschool/progress",
    title: "Progreso",
    desc: "Materias completadas en clase y puntaje en las que tienen score.",
    icon: "monitoring",
  },
  {
    href: "/eoschool/portfolio",
    title: "Portafolio",
    desc: "Vista previa PDF con temas y fotos de demostración.",
    icon: "folder_special",
  },
  {
    href: "/eoschool/proyecto-semestral",
    title: "Proyecto semestral",
    desc: "Trabajo del semestre escolar.",
    icon: "assignment",
  },
  {
    href: "/eoschool/salidas",
    title: "Salidas",
    desc: "Planilla con dibujos y fotos de cada salida.",
    icon: "hiking",
  },
];

const standards = [
  {
    href: "/eoschool/requirements/curriculum?mode=browse&view=standards",
    title: "Estándares 3.er grado",
    desc: "Venezuela, Estados Unidos e Inglaterra, tema por tema.",
    icon: "view_column",
  },
  {
    href: "/eoschool/requirements/curriculum?mode=browse&view=gaps",
    title: "Carencias 3.er grado",
    desc: "Lo que el programa de Venezuela no pide y sí piden Estados Unidos e Inglaterra.",
    icon: "difference",
  },
  {
    href: "/eoschool/requirements/criterios",
    title: "Criterios 3.er grado",
    desc: "La barra más alta de tercer grado: UNESCO, América Latina, Inglaterra, Cambridge, Australia y Common Core.",
    icon: "fact_check",
  },
];

const registry = [
  {
    href: "/eoschool/students/register",
    title: "Registrar estudiante",
    desc: "Nombre, apellido, edad, grado y foto del niño.",
    icon: "person_add",
  },
  {
    href: "/eoschool/students",
    title: "Gestionar estudiantes",
    desc: "Lista, edita o elimina niños del currículo.",
    icon: "group",
  },
  {
    href: "/eoschool/program/print",
    title: "Imprimir programa",
    desc: "PDF estructurado de las 40 semanas completas.",
    icon: "print",
  },
];
---

<Layout
  title="Homeschool"
  description="Dashboard del currículo MPPE: clases, progreso, portafolio y proyecto semestral."
  page="eoschool-hub"
  robots="noindex,nofollow"
  showPageTitle={false}
>
  <section class="product-dash page-span-all" data-eoschool-hub>
    <p class="status" data-banner>Cargando…</p>
    <div data-gate hidden class="product-gate">
      <p class="hint">Necesitas sesión y suscripción Homescool.</p>
      <a class="button" href="/session" data-route>Sign in</a>
    </div>
    <div class="eoschool-hub__rows" data-authed hidden>
      <div class="eoschool-hub__main">
      <div class="product-dash__grid">
        {
          primary.map((card) => (
            <a class:list={["product-dash__card", card.tone && `product-dash__card--${card.tone}`]} href={card.href} data-route>
              <span class="material-symbols-outlined" aria-hidden="true">{card.icon}</span>
              <span class="product-dash__card-title">{card.title}</span>
              <span class="product-dash__card-desc">{card.desc}</span>
            </a>
          ))
        }
      </div>
      <div class="product-dash__grid">
        {
          standards.map((card) => (
            <a class="product-dash__card" href={card.href} data-route>
              <span class="material-symbols-outlined" aria-hidden="true">{card.icon}</span>
              <span class="product-dash__card-title">{card.title}</span>
              <span class="product-dash__card-desc">{card.desc}</span>
            </a>
          ))
        }
      </div>
      <div class="product-dash__grid">
        {
          registry.map((card) => (
            <a class="product-dash__card" href={card.href} data-route>
              <span class="material-symbols-outlined" aria-hidden="true">{card.icon}</span>
              <span class="product-dash__card-title">{card.title}</span>
              <span class="product-dash__card-desc">{card.desc}</span>
            </a>
          ))
        }
        <a class="product-dash__card" href="/eoschool/tutors" data-route data-admin-tutors hidden>
          <span class="material-symbols-outlined" aria-hidden="true">supervisor_account</span>
          <span class="product-dash__card-title">Gestionar tutores</span>
          <span class="product-dash__card-desc">Asigna estudiantes a tutores con acceso Homeschool.</span>
        </a>
      </div>
      </div>
      <aside class="eoschool-hub__side" aria-label="Pendientes">
        <article class="product-dash__card eoschool-instructivo">
          <h2 class="product-dash__card-title">Dos trabajos semestrales</h2>
          <section data-pending-block>
            <h3>Obligatorio, y lo que falta en eoschool</h3>
            <label>
              Estudiante
              <select data-pending-student></select>
            </label>
            <ul data-pending-list>
              <li>Cargando lo que ya está en eoschool…</li>
            </ul>
            <p>
              Cada materia queda en <u>Pendiente</u> hasta tener <u>5 fotos</u> en clase.
              Cinco materias por 5 fotos arman el PDF de unas 26 páginas.
            </p>
          </section>

          <section>
            <h3>El trabajo semestral es el PDF. El portafolio es la carpeta.</h3>
            <p>
              El trabajo de cada semestre es <u>un PDF de unas 26 páginas, tope de 30</u>.
              Se sube a Drive y en la intranet va <u>solo el enlace</u>.
              <u>Dos PDF en el año, uno por semestre.</u> <u>Con uno solo el año no se aprueba.</u>
            </p>
            <p>
              El portafolio es otra cosa: la carpeta en casa, con el plan, las cédulas, la partida,
              la lista de libros, la planilla de salidas, ejemplos y ensayos. Los dos PDF van dentro de esa carpeta.
            </p>
          </section>

          <section>
            <h3>Qué es «otro currículo»</h3>
            <p>
              Olive Trees llama así a un plan distinto de las guías de La Vid.
              <u>Este programa de eoschool es el MPPE, así que es ese caso.</u>
              El PDF se arma con los mejores trabajos ya hechos en clase, no con una lista aparte.
              En Ciencias, el segundo semestre incluye un proyecto del grado.
            </p>
            <p>
              La lista de La Vid para 3.er grado (línea de tiempo de Lucas, tablas, Constantino, fuerza, Hechos, fracciones, polígonos, identidad, sistemas del cuerpo) es obligatoria solo si la familia sigue las guías de La Vid.
              <u>En este programa esa lista no es una tarea extra.</u>
              Clase ya cubre Lucas, Hechos, polígonos y la fuerza, pero no pide esos productos tal como los escribe La Vid.
            </p>
            <p>
              El formato sí aplica en 3.er grado: <u>escrito a mano y con fotos, no en computadora</u>,
              <u>grafito más oscuro</u>, <u>una imagen por página</u>.
              Si <u>más del 40% no se lee</u>, lo devuelven.
            </p>
          </section>

          <section>
            <h3>Salidas y horas</h3>
            <p>
              El número de aquí es de <u>salidas</u>, no de páginas del PDF.
              En 3.er grado la planilla es necesaria y <u>no hay un mínimo de salidas</u>.
              El mínimo de páginas es el del PDF: unas 26, tope 30.
            </p>
            <p>
              Preescolar, prekínder y kínder sí tienen un mínimo de salidas, y solo ellos:
              preescolar 2 en el 2.º semestre, prekínder 2 en el 1.er semestre, kínder 3 en el 2.º semestre, con dibujos.
            </p>
            <p>
              La planilla de horas por mes está marcada como opcional en la lista del portafolio.
              Esa hoja sí escribe los mínimos: kínder 172 días × 2 horas, primaria 172 días × 4 horas, secundaria 120 días.
              eoschool guarda las clases hechas, no las horas de cada mes, así que no arma esa planilla.
            </p>
          </section>

          <section>
            <h3>Fechas del calendario norte regular</h3>
            <p>1.er semestre: <u>1 de diciembre al 10 de febrero</u>. 2.º semestre: <u>1 de abril al 20 de junio</u>. Cierre: <u>10 de julio</u>.</p>
            <p>Después del cierre el sistema no reabre y <u>el grado se pierde</u>. La boleta se carga <u>al menos dos veces</u> y queda atada al informe del tutor.</p>
          </section>
        </article>
      </aside>
    </div>
  </section>
</Layout>

<script>
  import { isPlatformAdmin, refreshAuthSession } from "../../lib/auth";
  import { fetchCurriculumProgress, fetchCurriculumStudents } from "../../lib/eoschool-curriculum-api";
  import { olivePendingItems } from "../../lib/eoschool-olive-pending";
  import { apiFail, onAstroPageLoad, requireService, setHidden } from "../../lib/productGate";

  function paintPending(list: Element, studentKey: string) {
    return fetchCurriculumProgress(studentKey).then((loaded) => {
      if (!loaded.ok) {
        apiFail("No se pudo leer lo cargado en eoschool.", { requestId: loaded.requestId });
        return;
      }
      const items = olivePendingItems(loaded.data);
      list.replaceChildren();
      for (const item of items) {
        const li = document.createElement("li");
        if (item.pending) li.className = "eoschool-pending";
        li.textContent = `${item.label}. ${item.detail}`;
        list.append(li);
      }
    });
  }

  onAstroPageLoad("eoschool-hub", async () => {
    const root = document.querySelector("[data-eoschool-hub]");
    const banner = root?.querySelector("[data-banner]");
    const gate = root?.querySelector("[data-gate]");
    const authed = root?.querySelector("[data-authed]");
    const tutorsCard = root?.querySelector("[data-admin-tutors]");
    const pendingList = root?.querySelector("[data-pending-list]");
    const pendingStudent = root?.querySelector<HTMLSelectElement>("[data-pending-student]");
    if (banner instanceof HTMLElement) {
      banner.hidden = false;
      banner.textContent = "Cargando…";
    }

    const result = await requireService("homescool", { requireSubscription: true });
    await refreshAuthSession();
    if (!result.sessionOk || !result.access.allowed) {
      if (banner instanceof HTMLElement) {
        banner.textContent = result.sessionOk
          ? "Necesitas suscripción Homescool."
          : "Inicia sesión para continuar.";
      }
      setHidden(gate, false);
      setHidden(authed, true);
    } else {
      if (banner instanceof HTMLElement) banner.hidden = true;
      setHidden(gate, true);
      setHidden(authed, false);
      setHidden(tutorsCard, !isPlatformAdmin());
      if (pendingList && pendingStudent) {
        const students = await fetchCurriculumStudents();
        const rows = students.ok ? students.data.students : [];
        pendingStudent.replaceChildren();
        for (const student of rows) {
          const option = document.createElement("option");
          option.value = student.studentKey;
          option.textContent = student.displayName || student.studentKey;
          pendingStudent.append(option);
        }
        if (rows.length === 0) {
          const option = document.createElement("option");
          option.value = "elias-osteicoechea";
          option.textContent = "Estudiante";
          pendingStudent.append(option);
        }
        pendingStudent.addEventListener("change", () => {
          void paintPending(pendingList, pendingStudent.value).catch((err: unknown) => {
            apiFail(err instanceof Error ? err.message : "No se pudo leer lo cargado en eoschool.");
          });
        });
        try {
          await paintPending(pendingList, pendingStudent.value);
        } catch (err: unknown) {
          apiFail(err instanceof Error ? err.message : "No se pudo leer lo cargado en eoschool.");
        }
      }
    }
  });
</script>

<style>
  :global(html[data-page="eoschool-hub"]),
  :global(html[data-page="eoschool-hub"] body) {
    height: 100%;
  }

  :global(html[data-page="eoschool-hub"] body) {
    display: flex;
    flex-direction: column;
  }

  :global(html[data-page="eoschool-hub"] .shell) {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  :global(html[data-page="eoschool-hub"] main) {
    flex: 1;
    min-height: 0;
    grid-template-rows: minmax(0, 1fr);
    padding-top: var(--space-padding);
    overflow: hidden;
  }

  .product-dash {
    min-height: 0;
    overflow: hidden;
  }

  .eoschool-hub__rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-padding);
    flex: 1;
    min-width: 0;
    min-height: 0;
  }

  .eoschool-hub__main {
    display: flex;
    flex-direction: column;
    gap: var(--space-padding);
    flex: 1;
    min-width: 0;
    min-height: 0;
    overflow-y: auto;
  }

  .eoschool-hub__side {
    flex: 1;
    min-width: 0;
    min-height: 0;
    overflow-y: auto;
    padding-right: var(--rail-gap);
  }

  .eoschool-hub__side label {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--rail-gap);
    font-size: var(--font-size-sm);
  }

  .eoschool-hub__side select {
    align-self: stretch;
    min-width: 0;
    height: var(--control-height);
    padding: var(--control-padding-block) var(--control-padding-inline);
    font-size: var(--font-size-md);
    color: var(--color-text);
    background: var(--color-bg);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius);
  }

  @media (min-width: 48rem) {
    .eoschool-hub__rows {
      flex-direction: row;
      align-items: stretch;
    }

    .eoschool-hub__side {
      flex: 0 0 22rem;
      width: 22rem;
      order: -1;
      overflow-y: auto;
    }
  }

  a.product-dash__card {
    text-decoration: none;
    color: inherit;
  }

  a.product-dash__card--study {
    background: #d8f3dc;
    color: #14281a;
    border-color: #b7e4c7;
  }

  a.product-dash__card--study .material-symbols-outlined {
    color: #1b4332;
  }

  a.product-dash__card--study .product-dash__card-desc {
    color: #2d4a38;
  }

  a.product-dash__card--study:hover,
  a.product-dash__card--study:focus-visible {
    border-color: #1b4332;
  }

  .eoschool-instructivo {
    gap: var(--space-padding);
  }

  .eoschool-instructivo h2,
  .eoschool-instructivo h3,
  .eoschool-instructivo p {
    margin: 0;
  }

  .eoschool-instructivo h3 {
    font-size: var(--font-size-sm);
    font-weight: 650;
  }

  .eoschool-instructivo u,
  .eoschool-pending {
    text-decoration: underline;
    text-underline-offset: 0.12rem;
    font-weight: 650;
  }

  .eoschool-instructivo p,
  .eoschool-instructivo li {
    font-size: var(--font-size-sm);
    color: var(--color-text);
  }

  .eoschool-instructivo section,
  .eoschool-instructivo ol,
  .eoschool-instructivo ul {
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
    min-width: 0;
  }

  .eoschool-instructivo ol,
  .eoschool-instructivo ul {
    margin: 0;
    padding-left: 1.25rem;
  }

</style>
