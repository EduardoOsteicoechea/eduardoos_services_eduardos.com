---
import { Fragment } from "astro/jsx-runtime";
import Layout from "../../layouts/Layout.astro";
import "../../styles/product-tree-sidebar.css";
import "../../styles/homescool-workspace.css";
---

<Layout title="Homescool" description="Homescool study materials workspace." page="homescool-workspace" robots="noindex,nofollow" showPageTitle={false}>
  <Fragment slot="dhs">
    <button
      class="dhs-action"
      type="button"
      data-homescool-tree-toggle
      title="Toggle materials tree"
      aria-label="Toggle materials tree"
      aria-pressed="true"
      aria-controls="homescool-tree"
    >
      <span class="icon-btn" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">account_tree</span></span>
      Tree
    </button>
    <button
      class="dhs-action"
      type="button"
      data-homescool-print
      title="Print current material as PDF"
      aria-label="Print current material as PDF"
      disabled
    >
      <span class="icon-btn" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">print</span></span>
      Print
    </button>
  </Fragment>

  <h1 class="page-title-sr">Homescool</h1>

  <div data-homescool-gate hidden class="product-gate">
    <p class="hint">Sign in with Homescool access to view study materials.</p>
    <p class="hint"><a href="/session" data-route>Sign in</a> · <a href="/payments/subscription" data-route>Subscribe</a></p>
  </div>

  <section class="product-workspace product-workspace--tree-open homescool-workspace" data-homescool-workspace hidden>
    <aside id="homescool-tree" class="product-tree-sidebar" aria-label="Materials tree">
      <div data-homescool-tree-host></div>
    </aside>
    <div class="product-workspace__main">
      <p class="product-workspace__status" data-homescool-banner>Loading…</p>
      <div class="homescool-workspace__stage" data-homescool-stage>
        <p class="homescool-workspace__stage-empty" data-homescool-empty>Select a material from the tree.</p>
        <iframe
          class="homescool-sheet-frame"
          data-homescool-frame
          title="Study material"
          hidden
        ></iframe>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { requireService, setHidden } from "../../lib/productGate";
  import { fetchHomescoolMaterial, fetchHomescoolMaterials, type HomescoolMaterial } from "../../lib/homescool";
  import { buildHomescoolTree, type HomescoolTreeLeaf, type HomescoolTreeNode } from "../../lib/homescool-tree";
  import { productTreeChevron, productTreeLabel, productTreeLeafIcon } from "../../lib/product-tree";
  import { showErrorModal } from "../../lib/error-modal";

  type StudyPrintApi = {
    print?: () => void;
    printOrientation?: (orientation: "portrait" | "landscape") => void;
  };

  const gate = document.querySelector("[data-homescool-gate]");
  const workspace = document.querySelector("[data-homescool-workspace]");
  const banner = document.querySelector("[data-homescool-banner]");
  const treeHost = document.querySelector("[data-homescool-tree-host]");
  const empty = document.querySelector("[data-homescool-empty]");
  const frame = document.querySelector("[data-homescool-frame]");
  const treeToggle = document.querySelector("[data-homescool-tree-toggle]");
  const printBtn = document.querySelector("[data-homescool-print]");

  let materialsById = new Map<string, HomescoolMaterial>();
  let frameReady = false;
  let frameResizeObserver: ResizeObserver | null = null;

  const teacher = await requireService("homescool", { requireSubscription: true });
  const ok = teacher.sessionOk && teacher.access.allowed;
  if (!ok) {
    const guest = await requireService("homescool", { requireSubscription: false });
    if (!guest.sessionOk || !guest.access.allowed) {
      if (banner instanceof HTMLElement) {
        banner.textContent = guest.sessionOk ? "Homescool access required." : "Sign in required.";
      }
      setHidden(gate, false);
      setHidden(workspace, true);
    } else {
      await boot();
    }
  } else {
    await boot();
  }

  treeToggle?.addEventListener("click", () => {
    if (!(workspace instanceof HTMLElement) || !(treeToggle instanceof HTMLButtonElement)) return;
    const open = !workspace.classList.contains("product-workspace--tree-open");
    workspace.classList.toggle("product-workspace--tree-open", open);
    treeToggle.setAttribute("aria-pressed", open ? "true" : "false");
  });

  printBtn?.addEventListener("click", () => {
    if (!(printBtn instanceof HTMLButtonElement) || printBtn.disabled) return;
    printActiveMaterial();
  });

  frame?.addEventListener("load", () => {
    if (!(frame instanceof HTMLIFrameElement)) return;
    if (!frame.src || frame.src === "about:blank") return;
    prepareFrameDocument(frame);
    sizeFrameToContent(frame);
    frameReady = true;
    if (printBtn instanceof HTMLButtonElement) printBtn.disabled = false;
  });

  async function boot() {
    setHidden(gate, true);
    setHidden(workspace, false);
    if (banner instanceof HTMLElement) banner.textContent = "Loading materials…";
    const res = await fetchHomescoolMaterials();
    if (res.error) {
      showErrorModal({
        message: res.error,
        requestId: res.requestId,
        details: res.requestId ? `request_id=${res.requestId}` : "",
      });
      if (banner instanceof HTMLElement) banner.textContent = res.error;
      return;
    }
    materialsById = new Map(res.materials.map((m) => [m.id, m]));
    const tree = buildHomescoolTree(res.materials);
    renderTree(tree);
    const count = res.materials.length;
    if (banner instanceof HTMLElement) {
      banner.textContent = count ? `${count} material(es) · pick one in the tree` : "No materials yet.";
    }
    const deep = new URLSearchParams(window.location.search).get("material");
    if (deep && materialsById.has(deep)) {
      void openMaterial(deep);
    }
  }

  function renderTree(nodes: HomescoolTreeNode[]) {
    if (!(treeHost instanceof HTMLElement)) return;
    treeHost.replaceChildren();
    const root = document.createElement("ul");
    root.className = "product-tree";
    for (const node of nodes) root.append(renderNode(node, node.kind === "cycle"));
    treeHost.append(root);
  }

  function renderNode(node: HomescoolTreeNode, openDefault: boolean): HTMLLIElement {
    const li = document.createElement("li");
    const details = document.createElement("details");
    details.open = openDefault && node.children.length > 0;
    const summary = document.createElement("summary");
    summary.className = "product-tree__toggle";
    summary.append(productTreeChevron(), productTreeLabel(node.label));
    details.append(summary);
    const ul = document.createElement("ul");
    for (const child of node.children) {
      if (child.kind === "material") {
        ul.append(renderLeaf(child));
      } else {
        ul.append(renderNode(child, false));
      }
    }
    details.append(ul);
    li.append(details);
    return li;
  }

  function renderLeaf(leaf: HomescoolTreeLeaf): HTMLLIElement {
    const li = document.createElement("li");
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "product-tree__leaf";
    btn.dataset.materialId = leaf.id;
    btn.append(productTreeLeafIcon("description"), productTreeLabel(leaf.title));
    btn.addEventListener("click", () => {
      void openMaterial(leaf.id);
    });
    li.append(btn);
    return li;
  }

  async function openMaterial(id: string) {
    treeHost?.querySelectorAll(".product-tree__leaf").forEach((el) => {
      if (el instanceof HTMLElement) {
        el.setAttribute("aria-current", el.dataset.materialId === id ? "true" : "false");
      }
    });
    frameReady = false;
    if (printBtn instanceof HTMLButtonElement) printBtn.disabled = true;
    if (banner instanceof HTMLElement) banner.textContent = "Loading material…";
    const res = await fetchHomescoolMaterial(id);
    if (res.error || !res.material || !res.htmlUrl) {
      showErrorModal({
        message: res.error || "Could not load material.",
        requestId: res.requestId,
        details: res.requestId ? `request_id=${res.requestId}` : "",
      });
      if (banner instanceof HTMLElement) banner.textContent = res.error || "Not found.";
      return;
    }
    if (!(frame instanceof HTMLIFrameElement) || !(empty instanceof HTMLElement)) return;
    // Full document in iframe — isolates study `.page` / quiz CSS from site chrome.
    setHidden(empty, true);
    setHidden(frame, false);
    frame.src = res.htmlUrl;
    const m = res.material;
    if (banner instanceof HTMLElement) {
      banner.textContent = `Ciclo ${m.cycle} · Semana ${m.week} · Día ${m.day} · ${m.subject} · ${m.title}`;
    }
    document.title = `${m.title} · Homescool`;
  }

  function prepareFrameDocument(iframe: HTMLIFrameElement) {
    try {
      const doc = iframe.contentDocument;
      if (!doc?.head || !doc.body) return;
      // Match site rem so the 1rem gap between sheets matches chrome tokens.
      const parentFs = getComputedStyle(document.documentElement).fontSize;
      doc.documentElement.style.fontSize = parentFs;
      normalizeLetterSections(doc);
      let style = doc.getElementById("homescool-embed-chrome");
      if (!style) {
        style = doc.createElement("style");
        style.id = "homescool-embed-chrome";
        doc.head.appendChild(style);
      }
      style.textContent = [
        ".print-fab, .print-menu { display: none !important; }",
        "html, body { height: auto !important; min-height: 0 !important; overflow: visible !important; }",
        "body {",
        "  display: flex !important;",
        "  flex-direction: column !important;",
        "  align-items: center !important;",
        "  gap: 1rem !important;",
        "  margin: 0 !important;",
        "  padding: 1rem 0 !important;",
        "  background: #d8d8e4 !important;",
        "}",
        "/* Each section = one US Letter sheet (portrait or landscape). */",
        ".page {",
        "  margin: 0 !important;",
        "  flex: 0 0 auto !important;",
        "  box-sizing: border-box !important;",
        "}",
        ".page,",
        ".page.page--portrait {",
        "  width: 8.5in !important;",
        "  height: 11in !important;",
        "  min-width: 8.5in !important;",
        "  min-height: 11in !important;",
        "  max-width: 8.5in !important;",
        "  max-height: 11in !important;",
        "}",
        ".page.page--landscape {",
        "  width: 11in !important;",
        "  height: 8.5in !important;",
        "  min-width: 11in !important;",
        "  min-height: 8.5in !important;",
        "  max-width: 11in !important;",
        "  max-height: 8.5in !important;",
        "}",
        "@media print {",
        "  body { gap: 0 !important; padding: 0 !important; background: #fff !important; }",
        "  .page { box-shadow: none !important; }",
        "}",
      ].join("\n");
    } catch {
      /* cross-origin should not happen (same-origin API) */
    }
  }

  /** Keep only US Letter `.page` sections; tag portrait vs landscape. */
  function normalizeLetterSections(doc: Document) {
    const pages = Array.from(doc.body.querySelectorAll<HTMLElement>(":scope > .page, .page"));
    const unique: HTMLElement[] = [];
    const seen = new Set<HTMLElement>();
    for (const page of pages) {
      if (seen.has(page)) continue;
      // Prefer top-level pages; skip nested (should not exist).
      if (page.parentElement?.closest(".page")) continue;
      seen.add(page);
      unique.push(page);
    }
    if (!unique.length) {
      const wrap = doc.createElement("section");
      wrap.className = "page page--portrait";
      while (doc.body.firstChild) wrap.appendChild(doc.body.firstChild);
      doc.body.appendChild(wrap);
      return;
    }
    for (const page of unique) {
      page.classList.add("page");
      if (page.classList.contains("page--landscape")) {
        page.classList.remove("page--portrait");
      } else {
        page.classList.add("page--portrait");
      }
    }
    doc.body.replaceChildren(...unique);
  }

  function sizeFrameToContent(iframe: HTMLIFrameElement) {
    try {
      const doc = iframe.contentDocument;
      if (!doc?.body) return;
      frameResizeObserver?.disconnect();
      const rootFs = Number.parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
      const apply = () => {
        const h = Math.max(doc.body.scrollHeight, doc.documentElement.scrollHeight, 1);
        iframe.style.height = `${h / rootFs}rem`;
      };
      apply();
      frameResizeObserver = new ResizeObserver(() => apply());
      frameResizeObserver.observe(doc.body);
      // Fonts / images may expand layout after first paint.
      window.setTimeout(apply, 250);
      window.setTimeout(apply, 1000);
    } catch {
      /* ignore */
    }
  }

  function printActiveMaterial() {
    if (!(frame instanceof HTMLIFrameElement) || !frameReady) {
      showErrorModal({ message: "Open a material before printing." });
      return;
    }
    try {
      const win = frame.contentWindow;
      if (!win) throw new Error("no frame window");
      const api = (win as Window & { StudyPrint?: StudyPrintApi }).StudyPrint;
      if (api?.print) {
        api.print();
        return;
      }
      win.focus();
      win.print();
    } catch {
      showErrorModal({ message: "Could not print this material." });
    }
  }
</script>
