---
import { Fragment } from "astro/jsx-runtime";
import Layout from "../../layouts/Layout.astro";
import "../../styles/homescool-workspace.css";
---

<Layout title="Homescool" description="Homescool study materials workspace." page="homescool-workspace" robots="noindex,nofollow" showPageTitle={false}>
  <Fragment slot="dhs">
    <div class="homescool-dhs" data-homescool-dhs>
      <div class="homescool-dhs__scroll">
      <section class="homescool-dhs__section">
        <h2 class="homescool-dhs__heading" id="homescool-dhs-ciclo">Ciclo</h2>
        <div class="homescool-dhs__row homescool-dhs__row--tabs" role="group" aria-labelledby="homescool-dhs-ciclo" data-homescool-cycles>
          <button type="button" class="homescool-dhs__chip" data-cycle="3" aria-pressed="true" data-has-material>c3</button>
        </div>
      </section>
      <section class="homescool-dhs__section">
        <h2 class="homescool-dhs__heading" id="homescool-dhs-semana">Semana</h2>
        <div class="homescool-dhs__grid homescool-dhs__grid--weeks" role="group" aria-labelledby="homescool-dhs-semana" data-homescool-weeks></div>
      </section>
      <section class="homescool-dhs__section">
        <h2 class="homescool-dhs__heading" id="homescool-dhs-dia">Día</h2>
        <div class="homescool-dhs__grid homescool-dhs__grid--days" role="group" aria-labelledby="homescool-dhs-dia" data-homescool-days></div>
      </section>
      <section class="homescool-dhs__section">
        <h2 class="homescool-dhs__heading" id="homescool-dhs-materia">Materia</h2>
        <div class="homescool-dhs__grid homescool-dhs__grid--subjects" role="group" aria-labelledby="homescool-dhs-materia" data-homescool-subjects></div>
      </section>
      </div>
      <div class="homescool-dhs__footer">
        <button
          class="homescool-dhs__debug-btn"
          type="button"
          data-homescool-debug-toggle
          title="Mostrar u ocultar HC debug"
          aria-label="Mostrar u ocultar HC debug"
          aria-pressed="false"
        >
          <span class="material-symbols-outlined" aria-hidden="true">help</span>
        </button>
        <div class="homescool-dhs__print-row" data-homescool-print-row>
          <div class="homescool-dhs__print-tray" id="homescool-print-tray" data-homescool-print-tray hidden>
            <button type="button" class="homescool-dhs__print-option" data-print-mode="current">Clase actual</button>
            <button type="button" class="homescool-dhs__print-option" data-print-mode="subject-week">Clase actual, todos los días</button>
            <button type="button" class="homescool-dhs__print-option" data-print-mode="day-all">Día actual, todas las materias</button>
            <button type="button" class="homescool-dhs__print-option" data-print-mode="week-all">Todas las materias, toda la semana</button>
          </div>
          <div class="homescool-dhs__print-actions">
          <button
            class="homescool-dhs__print"
            type="button"
            data-homescool-print
            data-print-mode="current"
            title="Descargar PDF de la clase actual"
            aria-label="Descargar PDF de la clase actual"
            disabled
          >
            <span class="material-symbols-outlined" aria-hidden="true">download</span>
            PDF
          </button>
          <button
            class="homescool-dhs__print-menu-btn"
            type="button"
            data-homescool-print-menu
            title="Opciones de impresión"
            aria-label="Opciones de impresión"
            aria-expanded="false"
            aria-controls="homescool-print-tray"
            disabled
          >
            <span class="material-symbols-outlined" aria-hidden="true">more_vert</span>
          </button>
          </div>
        </div>
      </div>
      <button
        class="homescool-dhs__collapse"
        type="button"
        data-homescool-dhs-collapse
        title="Contraer menú de materias"
        aria-label="Contraer menú de materias"
        aria-expanded="true"
        aria-controls="dynamic-header"
      >
        <span class="material-symbols-outlined" aria-hidden="true" data-homescool-dhs-collapse-icon>chevron_left</span>
      </button>
    </div>
  </Fragment>

  <h1 class="page-title-sr">Homescool</h1>

  <div data-homescool-gate hidden class="product-gate">
    <p class="hint">Sign in with Homescool access to view study materials.</p>
    <p class="hint"><a href="/session" data-route>Sign in</a> · <a href="/payments/subscription" data-route>Subscribe</a></p>
  </div>

  <section class="product-workspace homescool-workspace" data-homescool-workspace hidden>
    <div class="product-workspace__main">
      <div class="homescool-support-admin" data-homescool-support-admin hidden>
        <label class="homescool-support-admin__label" for="homescool-support-url">Link de apoyo (admin)</label>
        <input
          id="homescool-support-url"
          class="homescool-support-admin__input"
          type="url"
          data-homescool-support-input
          placeholder="https://…"
          autocomplete="off"
        />
        <button type="button" class="homescool-support-admin__save" data-homescool-support-save>Guardar</button>
      </div>
      <div class="homescool-workspace__stage" data-homescool-stage>
        <div class="homescool-workspace__overlay" data-homescool-empty hidden>
          <p class="homescool-workspace__empty-msg" data-homescool-empty-msg>
            No se ha cargado material para esta selección.
          </p>
        </div>
        <div class="homescool-workspace__overlay homescool-workspace__overlay--loading" data-homescool-loading hidden>
          <span class="homescool-workspace__spinner" aria-hidden="true"></span>
          <p class="homescool-workspace__loading-msg">Cargando material…</p>
        </div>
        <div class="homescool-sheet-host" data-homescool-sheets hidden aria-label="Hojas de la clase"></div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { requireService, setHidden } from "../../lib/productGate";
  import { currentCsrf, getCsrf, getMe } from "../../lib/api";
  import {
    fetchHomescoolMaterial,
    fetchHomescoolMaterials,
    type EoschoolDocument,
    type HomescoolMaterial,
  } from "../../lib/homescool";
  import {
    findCurriculumClass,
    loadHomescoolCurriculum,
    toEoschoolDocument,
    type HomescoolCurriculum,
    type HomescoolCurriculumClass,
  } from "../../lib/homescool-curriculum";
  import { captureHomescoolLetterPages, downloadHomescoolStyledPdf } from "../../lib/homescoolPrint";
  import { showErrorModal } from "../../lib/error-modal";
  import {
    HOMESCOOL_SUBJECTS_ACTIVE,
    isHomescoolSubjectPaused,
    renderEoschoolPages,
    subjectClassNumber,
    subjectDisplayName,
  } from "../../lib/homescool-eoschool";
  import {
    hcLog,
    mountHomescoolDebugPanel,
    setHomescoolDebugPanelVisible,
    isHomescoolDebugPanelVisible,
  } from "../../lib/homescool-debug";

  const LEVEL = 6;
  const DEFAULT_SELECTION = { cycle: 3, week: 2, day: 1, subject: "LT" };
  const log = (step: string, detail: Record<string, unknown> = {}) => {
    hcLog("workspace", step, detail);
  };

  type CellSource = "mongo" | "fe-backup";
  type PrintMode = "current" | "subject-week" | "day-all" | "week-all";

  type WorkspaceCell = {
    key: string;
    cycle: number;
    week: number;
    day: number;
    subject: string;
    level: number;
    title: string;
    source: CellSource;
    materialId?: string;
    curriculum?: HomescoolCurriculumClass;
  };

  type Selection = { cycle: number; week: number; day: number; subject: string };

  let cells: WorkspaceCell[] = [];
  let curriculumBackup: HomescoolCurriculum | null = null;
  let sheetsReady = false;
  let currentMaterialId = "";
  let currentPdfName = "homescool.pdf";
  let currentDoc: EoschoolDocument | null = null;
  let isAdmin = false;
  let openSeq = 0;
  let bootSeq = 0;
  let selection: Selection = { ...DEFAULT_SELECTION };
  let printBound = false;
  let supportBound = false;
  let collapseBound = false;
  let debugToggleBound = false;
  const DHS_COLLAPSE_KEY = "homescool-dhs-collapsed";

  function qs<T extends Element>(sel: string): T | null {
    return document.querySelector(sel) as T | null;
  }

  function qsa<T extends Element>(sel: string): T[] {
    return Array.from(document.querySelectorAll(sel)) as T[];
  }

  function dhsRoot(): HTMLElement | null {
    const roots = qsa<HTMLElement>("[data-homescool-dhs]");
    return roots[roots.length - 1] ?? null;
  }

  function dhsQs<T extends Element>(sel: string): T | null {
    const root = dhsRoot();
    if (root) return root.querySelector(sel) as T | null;
    return qs<T>(sel);
  }

  function setStageMode(mode: "empty" | "loading" | "sheets") {
    setHidden(qs("[data-homescool-empty]"), mode !== "empty");
    setHidden(qs("[data-homescool-loading]"), mode !== "loading");
    setHidden(qs("[data-homescool-sheets]"), mode !== "sheets");
    log("stage.mode", { mode });
  }

  function cellKey(cycle: number, week: number, day: number, subject: string, level = LEVEL): string {
    return `c${cycle}-w${week}-d${day}-l${level}-${subject}`;
  }

  function levelCells(): WorkspaceCell[] {
    return cells.filter((m) => m.level === LEVEL && !isHomescoolSubjectPaused(m.subject));
  }

  function hasMaterial(partial: {
    cycle?: number;
    week?: number;
    day?: number;
    subject?: string;
  }): boolean {
    return levelCells().some(
      (m) =>
        (partial.cycle == null || m.cycle === partial.cycle) &&
        (partial.week == null || m.week === partial.week) &&
        (partial.day == null || m.day === partial.day) &&
        (partial.subject == null || m.subject === partial.subject),
    );
  }

  function pickFirstAvailable(preferred?: Partial<Selection>): WorkspaceCell | undefined {
    const rows = levelCells()
      .slice()
      .filter((m) => {
        if (preferred?.cycle != null && m.cycle !== preferred.cycle) return false;
        if (preferred?.week != null && m.week !== preferred.week) return false;
        if (preferred?.day != null && m.day !== preferred.day) return false;
        if (preferred?.subject != null && m.subject !== preferred.subject) return false;
        return true;
      })
      .sort((a, b) => {
        if (a.cycle !== b.cycle) return a.cycle - b.cycle;
        if (a.week !== b.week) return a.week - b.week;
        if (a.day !== b.day) return a.day - b.day;
        return subjectClassNumber(a.subject) - subjectClassNumber(b.subject);
      });
    return rows[0];
  }

  function applyCellToSelection(cell: WorkspaceCell) {
    selection = {
      cycle: cell.cycle,
      week: cell.week,
      day: cell.day,
      subject: cell.subject,
    };
  }

  function findCell(): WorkspaceCell | undefined {
    if (selection.subject === "pro") selection.day = 1;
    const key = cellKey(selection.cycle, selection.week, selection.day, selection.subject);
    return levelCells().find((c) => c.key === key);
  }

  function ensurePublishedSelection(reason: string): boolean {
    if (findCell()) return true;
    const near =
      pickFirstAvailable({ ...DEFAULT_SELECTION }) ||
      pickFirstAvailable({
        cycle: DEFAULT_SELECTION.cycle,
        week: DEFAULT_SELECTION.week,
      }) ||
      pickFirstAvailable({ cycle: DEFAULT_SELECTION.cycle }) ||
      pickFirstAvailable({ cycle: selection.cycle, week: selection.week }) ||
      pickFirstAvailable({ cycle: selection.cycle }) ||
      pickFirstAvailable();
    if (!near) {
      log("ensurePublished.empty", { reason, ...selection });
      return false;
    }
    applyCellToSelection(near);
    log("ensurePublished.snap", { reason, ...selection, key: near.key });
    return true;
  }

  function uniqueSorted(nums: number[]): number[] {
    return [...new Set(nums)].sort((a, b) => a - b);
  }

  function publishedCycles(): number[] {
    return uniqueSorted(levelCells().map((c) => c.cycle));
  }

  function publishedWeeks(cycle: number): number[] {
    return uniqueSorted(levelCells().filter((c) => c.cycle === cycle).map((c) => c.week));
  }

  function publishedDays(cycle: number, week: number): number[] {
    return uniqueSorted(
      levelCells()
        .filter((c) => c.cycle === cycle && c.week === week)
        .map((c) => c.day),
    );
  }

  function publishedSubjects(cycle: number, week: number, day: number): string[] {
    const set = new Set(
      levelCells()
        .filter((c) => c.cycle === cycle && c.week === week && c.day === day)
        .map((c) => c.subject),
    );
    const ordered = HOMESCOOL_SUBJECTS_ACTIVE.filter((s) => set.has(s));
    const extras = [...set]
      .filter((s) => !ordered.includes(s as (typeof HOMESCOOL_SUBJECTS_ACTIVE)[number]) && !isHomescoolSubjectPaused(s))
      .sort();
    return [...ordered, ...extras];
  }

  function mergeCells(
    materials: HomescoolMaterial[],
    curriculum: HomescoolCurriculum | null | undefined,
  ): WorkspaceCell[] {
    const byKey = new Map<string, WorkspaceCell>();
    if (!curriculum?.classes?.length) return [];

    const publishedKeys = new Set(
      curriculum.classes
        .filter((row) => (row.level ?? LEVEL) === LEVEL)
        .map((row) => row.key || cellKey(row.cycle, row.week, row.day, row.subject, row.level ?? LEVEL)),
    );

    for (const m of materials) {
      if (m.format !== "eoschool") continue;
      if (isHomescoolSubjectPaused(m.subject)) continue;
      const level = m.level ?? LEVEL;
      if (level !== LEVEL) continue;
      const key = cellKey(m.cycle, m.week, m.day, m.subject, level);
      if (!publishedKeys.has(key)) continue;
      byKey.set(key, {
        key,
        cycle: m.cycle,
        week: m.week,
        day: m.day,
        subject: m.subject,
        level,
        title: m.title,
        source: "mongo",
        materialId: m.id,
      });
    }

    for (const row of curriculum.classes) {
      if (isHomescoolSubjectPaused(row.subject)) continue;
      const level = row.level ?? LEVEL;
      if (level !== LEVEL) continue;
      const key = row.key || cellKey(row.cycle, row.week, row.day, row.subject, level);
      if (byKey.has(key)) {
        byKey.get(key)!.curriculum = row;
        continue;
      }
      byKey.set(key, {
        key,
        cycle: row.cycle,
        week: row.week,
        day: row.day,
        subject: row.subject,
        level,
        title: row.title,
        source: "fe-backup",
        curriculum: row,
      });
    }

    return Array.from(byKey.values());
  }

  function syncChipStates() {
    for (const root of qsa<HTMLElement>("[data-homescool-dhs]")) {
      root.querySelectorAll("[data-cycle]").forEach((el) => {
        if (!(el instanceof HTMLElement)) return;
        const cycle = Number(el.dataset.cycle);
        el.setAttribute("aria-pressed", cycle === selection.cycle ? "true" : "false");
        el.toggleAttribute("data-has-material", hasMaterial({ cycle }));
      });
      root.querySelectorAll("[data-week]").forEach((el) => {
        if (!(el instanceof HTMLElement)) return;
        const week = Number(el.dataset.week);
        el.setAttribute("aria-pressed", week === selection.week ? "true" : "false");
        el.toggleAttribute("data-has-material", hasMaterial({ cycle: selection.cycle, week }));
      });
      root.querySelectorAll("[data-day]").forEach((el) => {
        if (!(el instanceof HTMLElement)) return;
        const day = Number(el.dataset.day);
        el.setAttribute("aria-pressed", day === selection.day ? "true" : "false");
        el.toggleAttribute(
          "data-has-material",
          hasMaterial({ cycle: selection.cycle, week: selection.week, day }),
        );
      });
      root.querySelectorAll("[data-subject]").forEach((el) => {
        if (!(el instanceof HTMLElement)) return;
        const subject = el.dataset.subject || "";
        el.setAttribute("aria-pressed", subject === selection.subject ? "true" : "false");
        el.toggleAttribute(
          "data-has-material",
          hasMaterial({
            cycle: selection.cycle,
            week: selection.week,
            day: selection.day,
            subject,
          }),
        );
      });
    }
  }

  function makeChip(label: string): HTMLButtonElement {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "homescool-dhs__chip";
    btn.textContent = label;
    return btn;
  }

  function rebuildPublishedChips() {
    const cyclesHost = dhsQs<HTMLElement>("[data-homescool-cycles]");
    const weeksHost = dhsQs<HTMLElement>("[data-homescool-weeks]");
    const daysHost = dhsQs<HTMLElement>("[data-homescool-days]");
    const subjectsHost = dhsQs<HTMLElement>("[data-homescool-subjects]");

    if (cyclesHost) {
      cyclesHost.replaceChildren();
      for (const c of publishedCycles()) {
        const btn = makeChip(`c${c}`);
        btn.dataset.cycle = String(c);
        btn.addEventListener("click", () => {
          if (!hasMaterial({ cycle: c })) return;
          selection.cycle = c;
          ensurePublishedSelection("cycle-click");
          log("select.cycle", { ...selection });
          rebuildPublishedChips();
          void openSelection();
        });
        cyclesHost.append(btn);
      }
    }

    if (weeksHost) {
      weeksHost.replaceChildren();
      for (const w of publishedWeeks(selection.cycle)) {
        const btn = makeChip(`s${w}`);
        btn.dataset.week = String(w);
        btn.addEventListener("click", () => {
          if (!hasMaterial({ cycle: selection.cycle, week: w })) return;
          selection.week = w;
          ensurePublishedSelection("week-click");
          log("select.week", { ...selection });
          rebuildPublishedChips();
          void openSelection();
        });
        weeksHost.append(btn);
      }
    }

    if (daysHost) {
      daysHost.replaceChildren();
      // Proyecto = one project/week: no d1–d5 chips; single "du" (día único) → day 1.
      if (selection.subject === "pro") {
        selection.day = 1;
        const btn = makeChip("du");
        btn.dataset.day = "1";
        btn.title = "Día único";
        btn.setAttribute("aria-label", "Día único");
        btn.addEventListener("click", () => {
          if (
            !hasMaterial({
              cycle: selection.cycle,
              week: selection.week,
              day: 1,
              subject: "pro",
            })
          ) {
            return;
          }
          selection.day = 1;
          ensurePublishedSelection("day-click-pro-du");
          log("select.day", { ...selection, label: "du" });
          rebuildPublishedChips();
          void openSelection();
        });
        daysHost.append(btn);
      } else {
        for (const d of publishedDays(selection.cycle, selection.week)) {
          const btn = makeChip(`d${d}`);
          btn.dataset.day = String(d);
          btn.title = `Día ${d}`;
          btn.setAttribute("aria-label", `Día ${d}`);
          btn.addEventListener("click", () => {
            if (!hasMaterial({ cycle: selection.cycle, week: selection.week, day: d })) return;
            selection.day = d;
            ensurePublishedSelection("day-click");
            log("select.day", { ...selection });
            rebuildPublishedChips();
            void openSelection();
          });
          daysHost.append(btn);
        }
      }
    }

    if (subjectsHost) {
      subjectsHost.replaceChildren();
      const dayForSubjects = selection.subject === "pro" ? 1 : selection.day;
      for (const code of publishedSubjects(selection.cycle, selection.week, dayForSubjects)) {
        const n = subjectClassNumber(code);
        const fullName = subjectDisplayName(code);
        const btn = makeChip(n > 0 ? `${n}·${code}` : code);
        btn.dataset.subject = code;
        btn.title = fullName;
        btn.setAttribute("aria-label", n > 0 ? `${n}. ${fullName}` : fullName);
        btn.addEventListener("click", () => {
          const dayNeeded = code === "pro" ? 1 : selection.day;
          if (
            !hasMaterial({
              cycle: selection.cycle,
              week: selection.week,
              day: dayNeeded,
              subject: code,
            })
          ) {
            return;
          }
          selection.subject = code;
          if (code === "pro") selection.day = 1;
          log("select.subject", { ...selection, classNo: n });
          rebuildPublishedChips();
          void openSelection();
        });
        subjectsHost.append(btn);
      }
    }

    syncChipStates();
  }

  function setDhsCollapsed(collapsed: boolean) {
    document.documentElement.setAttribute("data-homescool-dhs-collapsed", collapsed ? "true" : "false");
    try {
      localStorage.setItem(DHS_COLLAPSE_KEY, collapsed ? "1" : "0");
    } catch {
      /* ignore */
    }
    for (const btn of qsa<HTMLButtonElement>("[data-homescool-dhs-collapse]")) {
      btn.setAttribute("aria-expanded", collapsed ? "false" : "true");
      btn.title = collapsed ? "Expandir menú de materias" : "Contraer menú de materias";
      btn.setAttribute("aria-label", btn.title);
      const icon = btn.querySelector("[data-homescool-dhs-collapse-icon]");
      if (icon) icon.textContent = collapsed ? "chevron_right" : "chevron_left";
    }
    log("dhs.collapse", { collapsed });
  }

  function bindCollapseOnce() {
    if (collapseBound) return;
    collapseBound = true;
    let collapsed = false;
    try {
      collapsed = localStorage.getItem(DHS_COLLAPSE_KEY) === "1";
    } catch {
      collapsed = false;
    }
    setDhsCollapsed(collapsed);
    document.addEventListener("click", (ev) => {
      const t = ev.target;
      if (!(t instanceof Element)) return;
      if (!t.closest("[data-homescool-dhs-collapse]")) return;
      const now =
        document.documentElement.getAttribute("data-homescool-dhs-collapsed") === "true";
      setDhsCollapsed(!now);
    });
  }

  function syncDebugToggleUi(visible: boolean) {
    for (const btn of qsa<HTMLButtonElement>("[data-homescool-debug-toggle]")) {
      btn.setAttribute("aria-pressed", visible ? "true" : "false");
      btn.title = visible ? "Ocultar HC debug" : "Mostrar HC debug";
      btn.setAttribute("aria-label", btn.title);
    }
  }

  function bindDebugToggleOnce() {
    if (debugToggleBound) return;
    debugToggleBound = true;
    setHomescoolDebugPanelVisible(false);
    syncDebugToggleUi(false);
    document.addEventListener("click", (ev) => {
      const t = ev.target;
      if (!(t instanceof Element)) return;
      if (!t.closest("[data-homescool-debug-toggle]")) return;
      const next = !isHomescoolDebugPanelVisible();
      setHomescoolDebugPanelVisible(next);
      syncDebugToggleUi(next);
      log("debug.toggle", { visible: next });
    });
  }

  function setPrintTrayOpen(open: boolean) {
    const tray = dhsQs<HTMLElement>("[data-homescool-print-tray]");
    const menuBtn = dhsQs<HTMLButtonElement>("[data-homescool-print-menu]");
    if (tray) setHidden(tray, !open);
    if (menuBtn) menuBtn.setAttribute("aria-expanded", open ? "true" : "false");
  }

  function bindPrintOnce() {
    if (printBound) return;
    printBound = true;
    document.addEventListener("click", (ev) => {
      const t = ev.target;
      if (!(t instanceof Element)) return;

      const menuBtn = t.closest("[data-homescool-print-menu]");
      if (menuBtn) {
        const tray = dhsQs<HTMLElement>("[data-homescool-print-tray]");
        const open = tray ? tray.hasAttribute("hidden") : false;
        setPrintTrayOpen(open);
        log("print.tray.toggle", { open });
        return;
      }

      const opt = t.closest("[data-print-mode]");
      if (opt instanceof HTMLElement && opt.closest("[data-homescool-print-tray]")) {
        const mode = (opt.dataset.printMode || "current") as PrintMode;
        setPrintTrayOpen(false);
        void downloadPrintMode(mode);
        return;
      }

      if (t.closest("[data-homescool-print]") && !t.closest("[data-homescool-print-menu]")) {
        void downloadPrintMode("current");
        return;
      }

      if (!t.closest("[data-homescool-print-row]")) {
        setPrintTrayOpen(false);
      }
    });
  }

  function bindSupportOnce() {
    if (supportBound) return;
    supportBound = true;
    document.addEventListener("click", (ev) => {
      const t = ev.target;
      if (!(t instanceof Element)) return;
      if (!t.closest("[data-homescool-support-save]")) return;
      void saveSupportUrl();
    });
  }

  function syncSupportAdminUi(doc: EoschoolDocument | null) {
    const bar = qs<HTMLElement>("[data-homescool-support-admin]");
    const input = qs<HTMLInputElement>("[data-homescool-support-input]");
    if (!bar || !input) return;
    const show = isAdmin && Boolean(currentMaterialId);
    setHidden(bar, !show);
    input.value = doc?.supportUrl?.trim() || "";
    log("support.ui", { show, hasUrl: Boolean(input.value), materialId: currentMaterialId });
  }

  async function saveSupportUrl() {
    const input = qs<HTMLInputElement>("[data-homescool-support-input]");
    if (!input || !currentMaterialId || !isAdmin) return;
    const supportUrl = input.value.trim();
    log("support.save.start", { materialId: currentMaterialId, hasUrl: Boolean(supportUrl) });
    await getCsrf();
    const headers = new Headers({ Accept: "application/json", "Content-Type": "application/json" });
    const csrf = currentCsrf();
    if (csrf) headers.set("X-CSRF-Token", csrf);
    try {
      const res = await fetch(`/api/homescool/materials/${encodeURIComponent(currentMaterialId)}/support`, {
        method: "PATCH",
        credentials: "include",
        headers,
        body: JSON.stringify({ supportUrl }),
      });
      const requestId = res.headers.get("X-Request-ID") || "";
      if (!res.ok) {
        let message = `No se pudo guardar el link (${res.status})`;
        try {
          const body = (await res.json()) as { message?: string };
          if (body.message) message = body.message;
        } catch {
          /* ignore */
        }
        showErrorModal({ message, requestId, details: requestId ? `request_id=${requestId}` : "" });
        hcLog("workspace", "support.save.fail", { status: res.status, requestId }, "error");
        return;
      }
      log("support.save.ok", { requestId });
      await openSelection();
    } catch (err) {
      hcLog("workspace", "support.save.error", { err: String(err) }, "error");
      showErrorModal({ message: "No se pudo guardar el link de apoyo." });
    }
  }

  async function loadDocForCell(cell: WorkspaceCell): Promise<EoschoolDocument | null> {
    if (cell.source === "mongo" && cell.materialId) {
      const res = await fetchHomescoolMaterial(cell.materialId);
      if (res.error || !res.material) {
        const backup =
          cell.curriculum ||
          (curriculumBackup
            ? findCurriculumClass(curriculumBackup, {
                cycle: cell.cycle,
                week: cell.week,
                day: cell.day,
                subject: cell.subject,
              }, LEVEL)
            : undefined);
        return backup ? toEoschoolDocument(backup) : null;
      }
      const docUrl = res.documentUrl || `/api/homescool/materials/${cell.materialId}/document`;
      const docRes = await fetch(docUrl, { credentials: "include" });
      if (!docRes.ok) throw new Error(`document ${docRes.status}`);
      const ctype = docRes.headers.get("content-type") || "";
      if (!ctype.includes("json")) throw new Error("Expected eoschool JSON");
      return (await docRes.json()) as EoschoolDocument;
    }
    const backup =
      cell.curriculum ||
      (curriculumBackup
        ? findCurriculumClass(curriculumBackup, {
            cycle: cell.cycle,
            week: cell.week,
            day: cell.day,
            subject: cell.subject,
          }, LEVEL)
        : undefined);
    return backup ? toEoschoolDocument(backup) : null;
  }

  function cellsForPrintMode(mode: PrintMode): WorkspaceCell[] {
    const base = levelCells().filter(
      (c) => c.cycle === selection.cycle && c.week === selection.week,
    );
    if (mode === "current") {
      const one = findCell();
      return one ? [one] : [];
    }
    if (mode === "subject-week") {
      return base
        .filter((c) => c.subject === selection.subject)
        .sort((a, b) => a.day - b.day);
    }
    if (mode === "day-all") {
      return base
        .filter((c) => c.day === selection.day)
        .sort((a, b) => subjectClassNumber(a.subject) - subjectClassNumber(b.subject));
    }
    // week-all
    return base.sort((a, b) => {
      const sa = subjectClassNumber(a.subject) - subjectClassNumber(b.subject);
      if (sa !== 0) return sa;
      return a.day - b.day;
    });
  }

  async function downloadPrintMode(mode: PrintMode) {
    const printBtn = qs<HTMLButtonElement>("[data-homescool-print]");
    const menuBtn = dhsQs<HTMLButtonElement>("[data-homescool-print-menu]");
    log("pdf.mode", { mode, sheetsReady, materialId: currentMaterialId });

    if (!sheetsReady) return;
    if (!currentMaterialId) {
      showErrorModal({
        message: "This class is only in the FE backup. Sync to Mongo to download a styled PDF.",
        details: "Run scripts/build-homescool-curriculum.mjs with EDUARDOOS_API_KEY set.",
      });
      return;
    }

    const targets = cellsForPrintMode(mode);
    if (!targets.length) {
      showErrorModal({ message: "No hay materiales para esta opción de impresión." });
      return;
    }

    if (printBtn) {
      printBtn.disabled = true;
      printBtn.setAttribute("aria-busy", "true");
    }
    if (menuBtn) menuBtn.disabled = true;

    try {
      if (mode === "current") {
        const sheetsHost = qs<HTMLElement>("[data-homescool-sheets]");
        if (!(sheetsHost instanceof HTMLElement)) return;
        const result = await downloadHomescoolStyledPdf(currentMaterialId, sheetsHost, currentPdfName);
        if (!result.ok) {
          showErrorModal({
            message: result.error || "Could not download PDF.",
            requestId: result.requestId,
            details: result.requestId ? `request_id=${result.requestId}` : "",
          });
          hcLog("workspace", "pdf.fail", { error: result.error, requestId: result.requestId }, "error");
          return;
        }
        log("pdf.ok", { mode, materialId: currentMaterialId, requestId: result.requestId });
        return;
      }

      // Multi-doc: render offscreen, capture all pages, post via current material id.
      const holder = document.createElement("div");
      holder.style.position = "absolute";
      holder.style.left = "-10000px";
      holder.style.top = "0";
      holder.style.visibility = "hidden";
      document.body.append(holder);
      const allPages: string[] = [];
      try {
        for (const cell of targets) {
          const doc = await loadDocForCell(cell);
          if (!doc) {
            hcLog("workspace", "pdf.batch.skip", { key: cell.key }, "warn");
            continue;
          }
          const pages = renderEoschoolPages(doc);
          holder.replaceChildren(...pages);
          const rasters = await captureHomescoolLetterPages(holder);
          allPages.push(...rasters);
          log("pdf.batch.cell", { key: cell.key, pages: rasters.length, total: allPages.length });
        }
      } finally {
        holder.remove();
      }

      if (!allPages.length) {
        showErrorModal({ message: "No se pudieron capturar páginas para el PDF." });
        return;
      }

      await getCsrf();
      const headers = new Headers({
        Accept: "application/pdf, application/json",
        "Content-Type": "application/json",
      });
      const csrf = currentCsrf();
      if (csrf) headers.set("X-CSRF-Token", csrf);
      const fileName = `homescool-c${selection.cycle}-w${selection.week}-${mode}.pdf`;
      const res = await fetch(`/api/homescool/materials/${encodeURIComponent(currentMaterialId)}/print/pdf`, {
        method: "POST",
        credentials: "include",
        headers,
        body: JSON.stringify({ pages: allPages, fileName }),
      });
      const requestId = res.headers.get("X-Request-ID") || "";
      if (!res.ok) {
        let message = `PDF download failed (${res.status})`;
        try {
          const body = (await res.json()) as { message?: string };
          if (body.message) message = body.message;
        } catch {
          /* ignore */
        }
        showErrorModal({ message, requestId, details: requestId ? `request_id=${requestId}` : "" });
        hcLog("workspace", "pdf.batch.fail", { status: res.status, requestId, pages: allPages.length }, "error");
        return;
      }
      const blob = await res.blob();
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = fileName;
      a.rel = "noopener";
      document.body.append(a);
      a.click();
      a.remove();
      window.setTimeout(() => URL.revokeObjectURL(url), 30_000);
      log("pdf.batch.ok", { mode, pages: allPages.length, requestId, bytes: blob.size });
    } catch (err) {
      hcLog("workspace", "pdf.error", { err: String(err), mode }, "error");
      showErrorModal({ message: "Could not download PDF." });
    } finally {
      if (printBtn) {
        printBtn.removeAttribute("aria-busy");
        printBtn.disabled = !currentMaterialId;
      }
      if (menuBtn) menuBtn.disabled = !currentMaterialId;
    }
  }

  async function boot() {
    const seq = ++bootSeq;
    log("boot.enter", { seq });
    selection = { ...DEFAULT_SELECTION };
    const gate = qs("[data-homescool-gate]");
    const workspace = qs("[data-homescool-workspace]");

    if (workspace instanceof HTMLElement) {
      mountHomescoolDebugPanel(workspace);
      setHomescoolDebugPanelVisible(false);
    }

    const me = await getMe();
    isAdmin = me.status === 200 && String(me.data.role || "").toLowerCase() === "admin";
    log("boot.me", { status: me.status, isAdmin, requestId: me.requestId });

    const teacher = await requireService("homescool", { requireSubscription: true });
    if (seq !== bootSeq) return;
    log("gate.teacher", { sessionOk: teacher.sessionOk, allowed: teacher.access.allowed });
    let allowed = teacher.sessionOk && teacher.access.allowed;
    if (!allowed) {
      const guest = await requireService("homescool", { requireSubscription: false });
      if (seq !== bootSeq) return;
      log("gate.guest", { sessionOk: guest.sessionOk, allowed: guest.access.allowed });
      allowed = Boolean(guest.sessionOk && guest.access.allowed);
      if (!allowed) {
        setHidden(gate, false);
        setHidden(workspace, true);
        log("gate.blocked", {
          reason: guest.sessionOk ? "homescool_access_required" : "sign_in_required",
        });
        return;
      }
    }

    setHidden(gate, true);
    setHidden(workspace, false);
    bindCollapseOnce();
    bindDebugToggleOnce();
    bindPrintOnce();
    bindSupportOnce();
    log("boot.loading_materials");

    const [mongoRes, feRes] = await Promise.all([
      fetchHomescoolMaterials(),
      loadHomescoolCurriculum(),
    ]);
    if (seq !== bootSeq) return;
    log("boot.mongo", {
      error: mongoRes.error,
      count: mongoRes.materials.length,
      requestId: mongoRes.requestId,
    });
    log("boot.fe_backup", {
      error: feRes.error,
      count: feRes.curriculum?.classCount ?? feRes.curriculum?.classes.length ?? 0,
    });

    if (!feRes.curriculum) {
      showErrorModal({
        message: feRes.error || mongoRes.error || "Could not load curriculum.",
        requestId: mongoRes.requestId,
        details: "Expected /homescool/curriculum.json as the published allowlist.",
      });
      log("boot.curriculum_missing", { error: feRes.error || mongoRes.error || "" });
      return;
    }

    curriculumBackup = feRes.curriculum;
    cells = mergeCells(mongoRes.materials ?? [], feRes.curriculum);
    log("boot.merged", {
      cells: cells.length,
      mongo: cells.filter((c) => c.source === "mongo").length,
      feBackup: cells.filter((c) => c.source === "fe-backup").length,
      cycles: publishedCycles(),
      weeks: publishedWeeks(DEFAULT_SELECTION.cycle),
      subjectOrder: [...HOMESCOOL_SUBJECTS_ACTIVE],
    });

    const deep =
      new URLSearchParams(window.location.search).get("material") ||
      new URLSearchParams(window.location.search).get("class");
    log("boot.deep_link", { deep });
    if (deep) {
      const m =
        cells.find((row) => row.materialId === deep) ||
        cells.find((row) => row.key === deep);
      if (m) {
        applyCellToSelection(m);
        log("boot.deep_applied", { ...selection, key: m.key });
      } else {
        log("boot.deep_miss", { deep });
      }
    }
    ensurePublishedSelection("boot");
    rebuildPublishedChips();
    await openSelection();
  }

  async function openSelection() {
    const seq = ++openSeq;
    const emptyMsg = qs<HTMLElement>("[data-homescool-empty-msg]");
    const sheetsHost = qs<HTMLElement>("[data-homescool-sheets]");
    const printBtn = qs<HTMLButtonElement>("[data-homescool-print]");
    const menuBtn = dhsQs<HTMLButtonElement>("[data-homescool-print-menu]");
    log("openSelection.enter", { ...selection, seq, classNo: subjectClassNumber(selection.subject) });
    sheetsReady = false;
    currentMaterialId = "";
    currentPdfName = "homescool.pdf";
    currentDoc = null;
    if (printBtn) printBtn.disabled = true;
    if (menuBtn) menuBtn.disabled = true;
    const match = findCell();
    if (!match) {
      const msg = `No se ha cargado material\n\nc${selection.cycle} · s${selection.week} · d${selection.day} · ${selection.subject} · nivel ${LEVEL}`;
      setStageMode("empty");
      if (sheetsHost) sheetsHost.replaceChildren();
      if (emptyMsg) emptyMsg.textContent = msg;
      syncSupportAdminUi(null);
      log("openSelection.empty");
      return;
    }
    setStageMode("loading");
    log("openSelection.loading", { key: match.key, source: match.source });

    try {
      let doc: EoschoolDocument;
      if (match.source === "mongo" && match.materialId) {
        const res = await fetchHomescoolMaterial(match.materialId);
        if (seq !== openSeq) return;
        if (res.error || !res.material) {
          const backup =
            match.curriculum ||
            (curriculumBackup
              ? findCurriculumClass(curriculumBackup, selection, LEVEL)
              : undefined);
          if (!backup) {
            setStageMode("empty");
            if (emptyMsg) emptyMsg.textContent = "No se pudo cargar el material. Intenta de nuevo.";
            showErrorModal({
              message: res.error || "Could not load material.",
              requestId: res.requestId,
              details: res.requestId ? `request_id=${res.requestId}` : "",
            });
            return;
          }
          doc = toEoschoolDocument(backup);
          currentMaterialId = "";
        } else {
          const docUrl = res.documentUrl || `/api/homescool/materials/${match.materialId}/document`;
          const docRes = await fetch(docUrl, { credentials: "include" });
          if (seq !== openSeq) return;
          if (!docRes.ok) throw new Error(`document ${docRes.status}`);
          const ctype = docRes.headers.get("content-type") || "";
          if (!ctype.includes("json")) throw new Error("Expected eoschool JSON");
          doc = (await docRes.json()) as EoschoolDocument;
          currentMaterialId = match.materialId;
        }
      } else {
        const backup =
          match.curriculum ||
          (curriculumBackup ? findCurriculumClass(curriculumBackup, selection, LEVEL) : undefined);
        if (!backup) throw new Error("missing fe backup");
        doc = toEoschoolDocument(backup);
        currentMaterialId = "";
      }

      if (seq !== openSeq) return;
      selection = {
        cycle: doc.cycle,
        week: doc.week,
        day: doc.day,
        subject: doc.subject,
      };
      currentDoc = doc;
      mountEoschool(doc);
      const safeTitle = (doc.title || "homescool").replace(/[\\/:*?"<>|]+/g, "_").trim() || "homescool";
      currentPdfName = `${safeTitle}-c${doc.cycle}w${doc.week}d${doc.day}.pdf`;
      const sourceHint = currentMaterialId ? "Mongo" : "FE backup";
      document.title = `${doc.title} · Homescool`;
      sheetsReady = true;
      if (printBtn) printBtn.disabled = !currentMaterialId;
      if (menuBtn) menuBtn.disabled = !currentMaterialId;
      syncSupportAdminUi(doc);
      rebuildPublishedChips();
      log("openSelection.ready", {
        key: match.key,
        materialId: currentMaterialId,
        source: match.source,
        sourceHint,
        selection,
        classNo: subjectClassNumber(doc.subject),
        supportUrl: Boolean(doc.supportUrl?.trim()),
        pages: qs("[data-homescool-sheets]")?.querySelectorAll(".homescool-letter-page").length ?? 0,
      });
    } catch (err) {
      if (seq !== openSeq) return;
      hcLog("workspace", "openSelection.fail", { err: String(err) }, "error");
      setStageMode("empty");
      if (emptyMsg) emptyMsg.textContent = "No se pudo cargar el documento.";
      showErrorModal({ message: "Could not load eoschool document." });
      syncSupportAdminUi(null);
    }
  }

  function mountEoschool(doc: EoschoolDocument) {
    const sheetsHost = qs<HTMLElement>("[data-homescool-sheets]");
    if (!(sheetsHost instanceof HTMLElement)) return;
    sheetsHost.replaceChildren();
    const pages = renderEoschoolPages(doc);
    let emptyHero = 0;
    for (const page of pages) {
      if (page.children.length <= 1) emptyHero += 1;
      sheetsHost.append(page);
    }
    log("mount.pages", {
      count: pages.length,
      emptyHeroSuspects: emptyHero,
      day: doc.day,
      subject: doc.subject,
    });
    setStageMode("sheets");
  }

  document.addEventListener("astro:page-load", () => {
    if (document.documentElement.getAttribute("data-page") !== "homescool-workspace") return;
    void boot();
  });
</script>
