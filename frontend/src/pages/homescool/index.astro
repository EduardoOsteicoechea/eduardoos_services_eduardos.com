---
import { Fragment } from "astro/jsx-runtime";
import Layout from "../../layouts/Layout.astro";
import "../../styles/homescool-workspace.css";
---

<Layout title="Homescool" description="Homescool study materials workspace." page="homescool-workspace" robots="noindex,nofollow" showPageTitle={false}>
  <Fragment slot="dhs">
    <div class="homescool-dhs" data-homescool-dhs>
      <section class="homescool-dhs__section">
        <h2 class="homescool-dhs__heading" id="homescool-dhs-ciclo">Ciclo</h2>
        <div class="homescool-dhs__row homescool-dhs__row--tabs" role="tablist" aria-labelledby="homescool-dhs-ciclo" data-homescool-cycles>
          <button type="button" class="homescool-dhs__chip" data-cycle="1" aria-pressed="true">c1</button>
          <button type="button" class="homescool-dhs__chip" data-cycle="2" aria-pressed="false">c2</button>
          <button type="button" class="homescool-dhs__chip" data-cycle="3" aria-pressed="false">c3</button>
        </div>
      </section>
      <section class="homescool-dhs__section">
        <h2 class="homescool-dhs__heading" id="homescool-dhs-semana">Semana</h2>
        <div class="homescool-dhs__grid homescool-dhs__grid--weeks" role="group" aria-labelledby="homescool-dhs-semana" data-homescool-weeks></div>
      </section>
      <section class="homescool-dhs__section">
        <h2 class="homescool-dhs__heading" id="homescool-dhs-dia">Día</h2>
        <div class="homescool-dhs__grid homescool-dhs__grid--days" role="group" aria-labelledby="homescool-dhs-dia" data-homescool-days></div>
      </section>
      <section class="homescool-dhs__section">
        <h2 class="homescool-dhs__heading" id="homescool-dhs-materia">Materia</h2>
        <div class="homescool-dhs__grid homescool-dhs__grid--subjects" role="group" aria-labelledby="homescool-dhs-materia" data-homescool-subjects></div>
      </section>
      <button
        class="homescool-dhs__print"
        type="button"
        data-homescool-print
        title="Descargar PDF del material"
        aria-label="Descargar PDF del material"
        disabled
      >
        <span class="material-symbols-outlined" aria-hidden="true">download</span>
        PDF
      </button>
    </div>
  </Fragment>

  <h1 class="page-title-sr">Homescool</h1>

  <div data-homescool-gate hidden class="product-gate">
    <p class="hint">Sign in with Homescool access to view study materials.</p>
    <p class="hint"><a href="/session" data-route>Sign in</a> · <a href="/payments/subscription" data-route>Subscribe</a></p>
  </div>

  <section class="product-workspace homescool-workspace" data-homescool-workspace hidden>
    <div class="product-workspace__main">
      <p class="product-workspace__status" data-homescool-banner>Loading…</p>
      <div class="homescool-workspace__stage" data-homescool-stage>
        <div class="homescool-workspace__overlay" data-homescool-empty hidden>
          <p class="homescool-workspace__empty-msg" data-homescool-empty-msg>
            No se ha cargado material para esta selección.
          </p>
        </div>
        <div class="homescool-workspace__overlay homescool-workspace__overlay--loading" data-homescool-loading hidden>
          <span class="homescool-workspace__spinner" aria-hidden="true"></span>
          <p class="homescool-workspace__loading-msg">Generando vista previa PDF…</p>
        </div>
        <div class="homescool-sheet-host" data-homescool-sheets hidden aria-label="Vista previa PDF de la clase"></div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { requireService, setHidden } from "../../lib/productGate";
  import { showErrorModal } from "../../lib/error-modal";
  import { HOMESCOOL_SUBJECTS } from "../../lib/homescool-eoschool";
  import {
    findCurriculumClass,
    loadHomescoolCurriculum,
    toEoschoolDocument,
    type HomescoolCurriculum,
    type HomescoolCurriculumClass,
  } from "../../lib/homescool-curriculum";
  import {
    downloadPdfBytes,
    fetchHomescoolPdfPreview,
    renderHomescoolPdfPreview,
  } from "../../lib/homescool-pdf-preview";
  import { mustLog } from "../../lib/dev-log";

  const LEVEL = 6;
  const log = (step: string, detail: Record<string, unknown> = {}) => {
    if (mustLog) console.log("[homescool-workspace]", step, detail);
  };

  const gate = document.querySelector("[data-homescool-gate]");
  const workspace = document.querySelector("[data-homescool-workspace]");
  const banner = document.querySelector("[data-homescool-banner]");
  const empty = document.querySelector("[data-homescool-empty]");
  const emptyMsg = document.querySelector("[data-homescool-empty-msg]");
  const loading = document.querySelector("[data-homescool-loading]");
  const sheetsHost = document.querySelector("[data-homescool-sheets]");
  const printBtn = document.querySelector("[data-homescool-print]");
  const weeksHost = document.querySelector("[data-homescool-weeks]");
  const daysHost = document.querySelector("[data-homescool-days]");
  const subjectsHost = document.querySelector("[data-homescool-subjects]");
  const cyclesHost = document.querySelector("[data-homescool-cycles]");

  let curriculum: HomescoolCurriculum | null = null;
  let sheetsReady = false;
  let currentPdfName = "homescool.pdf";
  let currentPdfBytes: Uint8Array | null = null;
  let previewSeq = 0;
  /** Default to week 2 until packs for other weeks exist; boot() snaps to first available cell. */
  let selection = { cycle: 1, week: 2, day: 1, subject: "mat" };

  function setStageMode(mode: "empty" | "loading" | "sheets") {
    setHidden(empty, mode !== "empty");
    setHidden(loading, mode !== "loading");
    setHidden(sheetsHost, mode !== "sheets");
    log("stage.mode", { mode });
  }

  log("boot.start", { level: LEVEL });
  const teacher = await requireService("homescool", { requireSubscription: true });
  log("gate.teacher", { sessionOk: teacher.sessionOk, allowed: teacher.access.allowed });
  const ok = teacher.sessionOk && teacher.access.allowed;
  if (!ok) {
    const guest = await requireService("homescool", { requireSubscription: false });
    log("gate.guest", { sessionOk: guest.sessionOk, allowed: guest.access.allowed });
    if (!guest.sessionOk || !guest.access.allowed) {
      if (banner instanceof HTMLElement) {
        banner.textContent = guest.sessionOk ? "Homescool access required." : "Sign in required.";
      }
      setHidden(gate, false);
      setHidden(workspace, true);
      log("gate.blocked");
    } else {
      await boot();
    }
  } else {
    await boot();
  }

  printBtn?.addEventListener("click", () => {
    void downloadCurrentPdf();
  });

  function downloadCurrentPdf() {
    log("pdf.click", {
      sheetsReady,
      hasBytes: Boolean(currentPdfBytes),
      disabled: printBtn instanceof HTMLButtonElement ? printBtn.disabled : null,
    });
    if (
      !(printBtn instanceof HTMLButtonElement) ||
      printBtn.disabled ||
      !sheetsReady ||
      !currentPdfBytes
    ) {
      return;
    }
    downloadPdfBytes(currentPdfBytes, currentPdfName);
    log("pdf.ok", { pdfName: currentPdfName, bytes: currentPdfBytes.length });
  }

  async function boot() {
    log("boot.enter");
    setHidden(gate, true);
    setHidden(workspace, false);
    buildWeekGrid();
    buildDayGrid();
    buildSubjectGrid();
    bindCycles();
    if (banner instanceof HTMLElement) banner.textContent = "Loading curriculum…";
    const res = await loadHomescoolCurriculum();
    log("boot.curriculum", {
      error: res.error,
      count: res.curriculum?.classCount ?? res.curriculum?.classes.length ?? 0,
    });
    if (res.error || !res.curriculum) {
      showErrorModal({
        message: res.error || "Could not load curriculum.",
        details: "Expected /homescool/curriculum.json",
      });
      if (banner instanceof HTMLElement) banner.textContent = res.error || "Curriculum missing.";
      return;
    }
    curriculum = res.curriculum;
    const deep = new URLSearchParams(window.location.search).get("class");
    log("boot.deep_link", { class: deep });
    if (deep) {
      const m = curriculum.classes.find((row) => row.key === deep);
      if (m) {
        selection = {
          cycle: m.cycle,
          week: m.week,
          day: m.day,
          subject: m.subject,
        };
        log("boot.deep_applied", { ...selection, key: m.key });
      } else {
        log("boot.deep_miss", { key: deep });
      }
    } else if (!findClass()) {
      const first = pickFirstAvailable();
      if (first) {
        selection = {
          cycle: first.cycle,
          week: first.week,
          day: first.day,
          subject: first.subject,
        };
        log("boot.snap_to_available", { ...selection, key: first.key });
      }
    }
    syncChipStates();
    await openSelection();
  }

  function classRows(): HomescoolCurriculumClass[] {
    return (curriculum?.classes ?? []).filter((m) => (m.level ?? LEVEL) === LEVEL);
  }

  function pickFirstAvailable(): HomescoolCurriculumClass | undefined {
    const rows = classRows().slice().sort((a, b) => {
      if (a.cycle !== b.cycle) return a.cycle - b.cycle;
      if (a.week !== b.week) return a.week - b.week;
      if (a.day !== b.day) return a.day - b.day;
      return a.subject.localeCompare(b.subject);
    });
    return rows[0];
  }

  function hasMaterial(partial: {
    cycle?: number;
    week?: number;
    day?: number;
    subject?: string;
  }): boolean {
    return classRows().some(
      (m) =>
        (partial.cycle == null || m.cycle === partial.cycle) &&
        (partial.week == null || m.week === partial.week) &&
        (partial.day == null || m.day === partial.day) &&
        (partial.subject == null || m.subject === partial.subject),
    );
  }

  function buildWeekGrid() {
    if (!(weeksHost instanceof HTMLElement)) return;
    weeksHost.replaceChildren();
    for (let w = 1; w <= 24; w++) {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "homescool-dhs__chip";
      btn.dataset.week = String(w);
      btn.textContent = `s${w}`;
      btn.setAttribute("aria-pressed", w === selection.week ? "true" : "false");
      btn.addEventListener("click", () => {
        selection.week = w;
        log("select.week", { week: w });
        syncChipStates();
        void openSelection();
      });
      weeksHost.append(btn);
    }
  }

  function buildDayGrid() {
    if (!(daysHost instanceof HTMLElement)) return;
    daysHost.replaceChildren();
    for (let d = 1; d <= 5; d++) {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "homescool-dhs__chip";
      btn.dataset.day = String(d);
      btn.textContent = `d${d}`;
      btn.setAttribute("aria-pressed", d === selection.day ? "true" : "false");
      btn.addEventListener("click", () => {
        selection.day = d;
        log("select.day", { day: d });
        syncChipStates();
        void openSelection();
      });
      daysHost.append(btn);
    }
  }

  function buildSubjectGrid() {
    if (!(subjectsHost instanceof HTMLElement)) return;
    subjectsHost.replaceChildren();
    for (const code of HOMESCOOL_SUBJECTS) {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "homescool-dhs__chip";
      btn.dataset.subject = code;
      btn.textContent = code;
      btn.setAttribute("aria-pressed", code === selection.subject ? "true" : "false");
      btn.addEventListener("click", () => {
        selection.subject = code;
        log("select.subject", { subject: code });
        syncChipStates();
        void openSelection();
      });
      subjectsHost.append(btn);
    }
  }

  function bindCycles() {
    cyclesHost?.querySelectorAll("[data-cycle]").forEach((el) => {
      el.addEventListener("click", () => {
        const c = Number((el as HTMLElement).dataset.cycle);
        if (!c) return;
        selection.cycle = c;
        log("select.cycle", { cycle: c });
        syncChipStates();
        void openSelection();
      });
    });
  }

  function syncChipStates() {
    cyclesHost?.querySelectorAll("[data-cycle]").forEach((el) => {
      if (!(el instanceof HTMLElement)) return;
      const cycle = Number(el.dataset.cycle);
      el.setAttribute("aria-pressed", cycle === selection.cycle ? "true" : "false");
      el.toggleAttribute("data-has-material", hasMaterial({ cycle }));
    });
    weeksHost?.querySelectorAll("[data-week]").forEach((el) => {
      if (!(el instanceof HTMLElement)) return;
      const week = Number(el.dataset.week);
      el.setAttribute("aria-pressed", week === selection.week ? "true" : "false");
      el.toggleAttribute("data-has-material", hasMaterial({ cycle: selection.cycle, week }));
    });
    daysHost?.querySelectorAll("[data-day]").forEach((el) => {
      if (!(el instanceof HTMLElement)) return;
      const day = Number(el.dataset.day);
      el.setAttribute("aria-pressed", day === selection.day ? "true" : "false");
      el.toggleAttribute(
        "data-has-material",
        hasMaterial({ cycle: selection.cycle, week: selection.week, day }),
      );
    });
    subjectsHost?.querySelectorAll("[data-subject]").forEach((el) => {
      if (!(el instanceof HTMLElement)) return;
      const subject = el.dataset.subject || "";
      el.setAttribute("aria-pressed", subject === selection.subject ? "true" : "false");
      el.toggleAttribute(
        "data-has-material",
        hasMaterial({
          cycle: selection.cycle,
          week: selection.week,
          day: selection.day,
          subject,
        }),
      );
    });
  }

  function findClass(): HomescoolCurriculumClass | undefined {
    if (!curriculum) return undefined;
    const match = findCurriculumClass(curriculum, selection, LEVEL);
    log("findClass", { ...selection, level: LEVEL, found: Boolean(match), key: match?.key });
    return match;
  }

  async function openSelection() {
    const seq = ++previewSeq;
    log("openSelection.enter", { ...selection, seq });
    sheetsReady = false;
    currentPdfBytes = null;
    currentPdfName = "homescool.pdf";
    if (printBtn instanceof HTMLButtonElement) printBtn.disabled = true;
    const match = findClass();
    if (!match) {
      const msg = `No se ha cargado material\n\nc${selection.cycle} · s${selection.week} · d${selection.day} · ${selection.subject} · nivel ${LEVEL}`;
      setStageMode("empty");
      if (sheetsHost instanceof HTMLElement) sheetsHost.replaceChildren();
      if (emptyMsg instanceof HTMLElement) emptyMsg.textContent = msg;
      if (banner instanceof HTMLElement) {
        banner.textContent = `Sin material · c${selection.cycle} s${selection.week} d${selection.day} · ${selection.subject}`;
      }
      log("openSelection.empty");
      return;
    }
    setStageMode("loading");
    if (banner instanceof HTMLElement) banner.textContent = "Generando vista previa PDF…";
    const doc = toEoschoolDocument(match);
    const preview = await fetchHomescoolPdfPreview(doc);
    if (seq !== previewSeq) {
      log("openSelection.stale", { seq, previewSeq });
      return;
    }
    if (!preview.ok || !preview.pdfBytes || !preview.data) {
      setStageMode("empty");
      if (emptyMsg instanceof HTMLElement) {
        emptyMsg.textContent = "No se pudo generar el PDF de vista previa.";
      }
      showErrorModal({
        message: preview.error || "Could not build PDF preview.",
        requestId: preview.requestId,
        details: preview.requestId ? `request_id=${preview.requestId}` : "",
      });
      if (banner instanceof HTMLElement) banner.textContent = "Preview failed.";
      return;
    }
    if (!(sheetsHost instanceof HTMLElement)) return;
    try {
      const pages = await renderHomescoolPdfPreview(sheetsHost, preview.pdfBytes, {
        pageWidthMm: preview.data.page_width_mm,
        pageHeightMm: preview.data.page_height_mm,
        seq,
        isStale: () => seq !== previewSeq,
      });
      if (seq !== previewSeq || pages === 0) {
        log("openSelection.render_stale", { seq, pages });
        return;
      }
      currentPdfBytes = preview.pdfBytes;
      const safeTitle = (doc.title || "homescool").replace(/[\\/:*?"<>|]+/g, "_").trim() || "homescool";
      currentPdfName = `${safeTitle}-c${doc.cycle}w${doc.week}d${doc.day}.pdf`;
      if (banner instanceof HTMLElement) {
        banner.textContent = `Ciclo ${doc.cycle} · Semana ${doc.week} · Día ${doc.day} · Nivel ${doc.level} · ${doc.subject} · ${doc.title}`;
      }
      document.title = `${doc.title} · Homescool`;
      sheetsReady = true;
      if (printBtn instanceof HTMLButtonElement) printBtn.disabled = false;
      setStageMode("sheets");
      log("openSelection.ready", { key: match.key, pages, pdfName: currentPdfName });
    } catch (err) {
      log("openSelection.render_fail", { err: String(err) });
      setStageMode("empty");
      if (emptyMsg instanceof HTMLElement) {
        emptyMsg.textContent = "No se pudo mostrar el PDF.";
      }
      showErrorModal({ message: "Could not render PDF preview." });
      if (banner instanceof HTMLElement) banner.textContent = "Could not render preview.";
    }
  }
</script>
