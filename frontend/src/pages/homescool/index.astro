  async function loadDocForCell(cell: WorkspaceCell): Promise<EoschoolDocument | null> {
    if (cell.source === "mongo" && cell.materialId) {
      const res = await fetchHomescoolMaterial(cell.materialId);
      if (res.error || !res.material) {
        const backup =
          cell.curriculum ||
          (curriculumBackup
            ? findCurriculumClass(curriculumBackup, {
                cycle: cell.cycle,
                week: cell.week,
                day: cell.day,
                subject: cell.subject,
              }, LEVEL)
            : undefined);
        return backup ? toEoschoolDocument(backup) : null;
      }
      const docUrl = res.documentUrl || `/api/homescool/materials/${cell.materialId}/document`;
      const docRes = await fetch(docUrl, { credentials: "include" });
      if (!docRes.ok) throw new Error(`document ${docRes.status}`);
      const ctype = docRes.headers.get("content-type") || "";
      if (!ctype.includes("json")) throw new Error("Expected eoschool JSON");
      return (await docRes.json()) as EoschoolDocument;
    }
    const backup =
      cell.curriculum ||
      (curriculumBackup
        ? findCurriculumClass(curriculumBackup, {
            cycle: cell.cycle,
            week: cell.week,
            day: cell.day,
            subject: cell.subject,
          }, LEVEL)
        : undefined);
    return backup ? toEoschoolDocument(backup) : null;
  }

  function cellsForPrintMode(mode: PrintMode): WorkspaceCell[] {
    const base = levelCells().filter(
      (c) => c.cycle === selection.cycle && c.week === selection.week,
    );
    if (mode === "current") {
      const one = findCell();
      return one ? [one] : [];
    }
    if (mode === "subject-week") {
      return base
        .filter((c) => c.subject === selection.subject)
        .sort((a, b) => a.day - b.day);
    }
    if (mode === "day-all") {
      return base
        .filter((c) => c.day === selection.day)
        .sort((a, b) => subjectClassNumber(a.subject) - subjectClassNumber(b.subject));
    }
    // week-all
    return base.sort((a, b) => {
      const sa = subjectClassNumber(a.subject) - subjectClassNumber(b.subject);
      if (sa !== 0) return sa;
      return a.day - b.day;
    });
  }

  function setPrintEnabled(enabled: boolean) {
    const printBtn = qs<HTMLButtonElement>("[data-homescool-print]");
