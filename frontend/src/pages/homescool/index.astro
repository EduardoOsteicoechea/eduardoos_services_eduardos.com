---
import { Fragment } from "astro/jsx-runtime";
import Layout from "../../layouts/Layout.astro";
import "../../styles/homescool-workspace.css";
---

<Layout title="Homescool" description="Homescool study materials workspace." page="homescool-workspace" robots="noindex,nofollow" showPageTitle={false}>
  <Fragment slot="dhs">
    <div class="homescool-dhs" data-homescool-dhs>
      <div class="homescool-dhs__row homescool-dhs__row--tabs" role="tablist" aria-label="Ciclo" data-homescool-cycles>
        <button type="button" class="homescool-dhs__chip" data-cycle="1" aria-pressed="true">c1</button>
        <button type="button" class="homescool-dhs__chip" data-cycle="2" aria-pressed="false">c2</button>
        <button type="button" class="homescool-dhs__chip" data-cycle="3" aria-pressed="false">c3</button>
      </div>
      <div class="homescool-dhs__grid homescool-dhs__grid--weeks" aria-label="Semana" data-homescool-weeks></div>
      <div class="homescool-dhs__grid homescool-dhs__grid--days" aria-label="Día" data-homescool-days></div>
      <div class="homescool-dhs__grid homescool-dhs__grid--subjects" aria-label="Materia" data-homescool-subjects></div>
      <button
        class="dhs-action"
        type="button"
        data-homescool-print
        title="Print current material as PDF"
        aria-label="Print current material as PDF"
        disabled
      >
        <span class="icon-btn" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">print</span></span>
        Print
      </button>
    </div>
  </Fragment>

  <h1 class="page-title-sr">Homescool</h1>

  <div data-homescool-gate hidden class="product-gate">
    <p class="hint">Sign in with Homescool access to view study materials.</p>
    <p class="hint"><a href="/session" data-route>Sign in</a> · <a href="/payments/subscription" data-route>Subscribe</a></p>
  </div>

  <section class="product-workspace homescool-workspace" data-homescool-workspace hidden>
    <div class="product-workspace__main">
      <p class="product-workspace__status" data-homescool-banner>Loading…</p>
      <div class="homescool-workspace__stage" data-homescool-stage>
        <p class="homescool-workspace__stage-empty" data-homescool-empty>Select cycle, week, day, and subject.</p>
        <div class="homescool-sheet-host" data-homescool-sheets hidden></div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { requireService, setHidden } from "../../lib/productGate";
  import {
    fetchHomescoolMaterial,
    fetchHomescoolMaterials,
    type EoschoolDocument,
    type HomescoolMaterial,
  } from "../../lib/homescool";
  import { showErrorModal } from "../../lib/error-modal";
  import { HOMESCOOL_SUBJECTS, renderEoschoolPages } from "../../lib/homescool-eoschool";
  import { mustLog } from "../../lib/dev-log";

  const LEVEL = 6;
  const log = (step: string, detail: Record<string, unknown> = {}) => {
    if (mustLog) console.log("[homescool-workspace]", step, detail);
  };

  const gate = document.querySelector("[data-homescool-gate]");
  const workspace = document.querySelector("[data-homescool-workspace]");
  const banner = document.querySelector("[data-homescool-banner]");
  const empty = document.querySelector("[data-homescool-empty]");
  const sheetsHost = document.querySelector("[data-homescool-sheets]");
  const printBtn = document.querySelector("[data-homescool-print]");
  const weeksHost = document.querySelector("[data-homescool-weeks]");
  const daysHost = document.querySelector("[data-homescool-days]");
  const subjectsHost = document.querySelector("[data-homescool-subjects]");
  const cyclesHost = document.querySelector("[data-homescool-cycles]");

  let materials: HomescoolMaterial[] = [];
  let sheetsReady = false;
  let selection = { cycle: 1, week: 1, day: 1, subject: "mat" };

  log("boot.start", { level: LEVEL });
  const teacher = await requireService("homescool", { requireSubscription: true });
  log("gate.teacher", { sessionOk: teacher.sessionOk, allowed: teacher.access.allowed });
  const ok = teacher.sessionOk && teacher.access.allowed;
  if (!ok) {
    const guest = await requireService("homescool", { requireSubscription: false });
    log("gate.guest", { sessionOk: guest.sessionOk, allowed: guest.access.allowed });
    if (!guest.sessionOk || !guest.access.allowed) {
      if (banner instanceof HTMLElement) {
        banner.textContent = guest.sessionOk ? "Homescool access required." : "Sign in required.";
      }
      setHidden(gate, false);
      setHidden(workspace, true);
      log("gate.blocked");
    } else {
      await boot();
    }
  } else {
    await boot();
  }

  printBtn?.addEventListener("click", () => {
    log("print.click", { sheetsReady, disabled: printBtn instanceof HTMLButtonElement ? printBtn.disabled : null });
    if (!(printBtn instanceof HTMLButtonElement) || printBtn.disabled || !sheetsReady) return;
    window.print();
  });

  async function boot() {
    log("boot.enter");
    setHidden(gate, true);
    setHidden(workspace, false);
    buildWeekGrid();
    buildDayGrid();
    buildSubjectGrid();
    bindCycles();
    if (banner instanceof HTMLElement) banner.textContent = "Loading materials…";
    const res = await fetchHomescoolMaterials();
    log("boot.materials", { error: res.error, count: res.materials.length, requestId: res.requestId });
    if (res.error) {
      showErrorModal({
        message: res.error,
        requestId: res.requestId,
        details: res.requestId ? `request_id=${res.requestId}` : "",
      });
      if (banner instanceof HTMLElement) banner.textContent = res.error;
      return;
    }
    materials = res.materials;
    syncChipStates();
    const deep = new URLSearchParams(window.location.search).get("material");
    log("boot.deep_link", { material: deep });
    if (deep) {
      const m = materials.find((row) => row.id === deep && row.format === "eoschool");
      if (m) {
        selection = {
          cycle: m.cycle,
          week: m.week,
          day: m.day,
          subject: m.subject,
        };
        log("boot.deep_applied", { ...selection });
        syncChipStates();
      } else {
        log("boot.deep_miss", { id: deep });
      }
    }
    await openSelection();
  }

  function buildWeekGrid() {
    if (!(weeksHost instanceof HTMLElement)) return;
    weeksHost.replaceChildren();
    for (let w = 1; w <= 24; w++) {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "homescool-dhs__chip";
      btn.dataset.week = String(w);
      btn.textContent = `s${w}`;
      btn.setAttribute("aria-pressed", w === selection.week ? "true" : "false");
      btn.addEventListener("click", () => {
        selection.week = w;
        log("select.week", { week: w });
        syncChipStates();
        void openSelection();
      });
      weeksHost.append(btn);
    }
  }

  function buildDayGrid() {
    if (!(daysHost instanceof HTMLElement)) return;
    daysHost.replaceChildren();
    for (let d = 1; d <= 5; d++) {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "homescool-dhs__chip";
      btn.dataset.day = String(d);
      btn.textContent = `d${d}`;
      btn.setAttribute("aria-pressed", d === selection.day ? "true" : "false");
      btn.addEventListener("click", () => {
        selection.day = d;
        log("select.day", { day: d });
        syncChipStates();
        void openSelection();
      });
      daysHost.append(btn);
    }
  }

  function buildSubjectGrid() {
    if (!(subjectsHost instanceof HTMLElement)) return;
    subjectsHost.replaceChildren();
    for (const code of HOMESCOOL_SUBJECTS) {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "homescool-dhs__chip";
      btn.dataset.subject = code;
      btn.textContent = code;
      btn.setAttribute("aria-pressed", code === selection.subject ? "true" : "false");
      btn.addEventListener("click", () => {
        selection.subject = code;
        log("select.subject", { subject: code });
        syncChipStates();
        void openSelection();
      });
      subjectsHost.append(btn);
    }
  }

  function bindCycles() {
    cyclesHost?.querySelectorAll("[data-cycle]").forEach((el) => {
      el.addEventListener("click", () => {
        const c = Number((el as HTMLElement).dataset.cycle);
        if (!c) return;
        selection.cycle = c;
        log("select.cycle", { cycle: c });
        syncChipStates();
        void openSelection();
      });
    });
  }

  function syncChipStates() {
    cyclesHost?.querySelectorAll("[data-cycle]").forEach((el) => {
      if (!(el instanceof HTMLElement)) return;
      el.setAttribute("aria-pressed", Number(el.dataset.cycle) === selection.cycle ? "true" : "false");
    });
    weeksHost?.querySelectorAll("[data-week]").forEach((el) => {
      if (!(el instanceof HTMLElement)) return;
      el.setAttribute("aria-pressed", Number(el.dataset.week) === selection.week ? "true" : "false");
    });
    daysHost?.querySelectorAll("[data-day]").forEach((el) => {
      if (!(el instanceof HTMLElement)) return;
      el.setAttribute("aria-pressed", Number(el.dataset.day) === selection.day ? "true" : "false");
    });
    subjectsHost?.querySelectorAll("[data-subject]").forEach((el) => {
      if (!(el instanceof HTMLElement)) return;
      el.setAttribute("aria-pressed", el.dataset.subject === selection.subject ? "true" : "false");
    });
  }

  function findMaterial(): HomescoolMaterial | undefined {
    const match = materials.find(
      (m) =>
        m.format === "eoschool" &&
        m.cycle === selection.cycle &&
        m.week === selection.week &&
        m.day === selection.day &&
        (m.level ?? LEVEL) === LEVEL &&
        m.subject === selection.subject,
    );
    log("findMaterial", { ...selection, level: LEVEL, found: Boolean(match), id: match?.id });
    return match;
  }

  async function openSelection() {
    log("openSelection.enter", { ...selection });
    sheetsReady = false;
    if (printBtn instanceof HTMLButtonElement) printBtn.disabled = true;
    const match = findMaterial();
    if (!match) {
      setHidden(empty, false);
      setHidden(sheetsHost, true);
      if (sheetsHost instanceof HTMLElement) sheetsHost.replaceChildren();
      if (banner instanceof HTMLElement) {
        banner.textContent = `Sin material · c${selection.cycle} s${selection.week} d${selection.day} · ${selection.subject} · nivel ${LEVEL}`;
      }
      log("openSelection.empty");
      return;
    }
    if (banner instanceof HTMLElement) banner.textContent = "Loading…";
    const res = await fetchHomescoolMaterial(match.id);
    log("openSelection.meta", {
      error: res.error,
      requestId: res.requestId,
      documentUrl: res.documentUrl,
      format: res.material?.format,
    });
    if (res.error || !res.material) {
      showErrorModal({
        message: res.error || "Could not load material.",
        requestId: res.requestId,
        details: res.requestId ? `request_id=${res.requestId}` : "",
      });
      return;
    }
    const docUrl = res.documentUrl || `/api/homescool/materials/${match.id}/document`;
    try {
      log("openSelection.fetch_document", { docUrl });
      const docRes = await fetch(docUrl, { credentials: "include" });
      log("openSelection.document_status", { status: docRes.status, contentType: docRes.headers.get("content-type") });
      if (!docRes.ok) throw new Error(`document ${docRes.status}`);
      const ctype = docRes.headers.get("content-type") || "";
      if (!ctype.includes("json")) {
        throw new Error("Expected eoschool JSON");
      }
      const doc = (await docRes.json()) as EoschoolDocument;
      log("openSelection.document_parsed", {
        day: doc.day,
        kind: doc.lesson?.kind,
        points: doc.lesson?.points?.length,
        quiz: doc.quiz?.questionCount,
      });
      mountEoschool(doc);
      if (banner instanceof HTMLElement) {
        banner.textContent = `Ciclo ${doc.cycle} · Semana ${doc.week} · Día ${doc.day} · Nivel ${doc.level} · ${doc.subject} · ${doc.title}`;
      }
      document.title = `${doc.title} · Homescool`;
      sheetsReady = true;
      if (printBtn instanceof HTMLButtonElement) printBtn.disabled = false;
      log("openSelection.ready");
    } catch (err) {
      log("openSelection.fail", { err: String(err) });
      showErrorModal({ message: "Could not load eoschool document." });
      if (banner instanceof HTMLElement) banner.textContent = "Could not load document.";
    }
  }

  function mountEoschool(doc: EoschoolDocument) {
    if (!(sheetsHost instanceof HTMLElement)) return;
    setHidden(empty, true);
    setHidden(sheetsHost, false);
    sheetsHost.replaceChildren();
    const pages = renderEoschoolPages(doc);
    log("mountEoschool", { pages: pages.length });
    for (const page of pages) {
      sheetsHost.append(page);
    }
  }
</script>
