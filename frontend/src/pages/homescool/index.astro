  function collectMppeClassDocs(): Array<HomescoolCurriculumClass | EoschoolDocument> {
    const classDocs: Array<HomescoolCurriculumClass | EoschoolDocument> = [];
    if (curriculumBackup?.classes?.length) classDocs.push(...curriculumBackup.classes);
    for (const cell of cells) {
      if (cell.curriculum) classDocs.push(cell.curriculum);
    }
    if (currentDoc) classDocs.push(currentDoc);
    return classDocs;
  }

  function renderMppeSchedulePanel(
    host: HTMLElement,
    schedule: ReturnType<typeof buildMppeScheduleReport>,
  ) {
    host.replaceChildren();
    if (!schedule.cycles.length) {
      const empty = document.createElement("p");
      empty.className = "homescool-mppe-modal__empty";
      empty.textContent = "No hay clases con coordenadas de ciclo/semana/día en el currículo cargado.";
      host.append(empty);
      return;
    }
    for (const cycle of schedule.cycles) {
      const cycleEl = document.createElement("section");
      cycleEl.className = "homescool-mppe-modal__cycle";
      const cycleH = document.createElement("h3");
      cycleH.className = "homescool-mppe-modal__cycle-title";
      cycleH.textContent = `Ciclo ${cycle.cycle} · ${cycle.objectiveIds.length} objetivos · ${cycle.classesWithMppe}/${cycle.classCount} clases con MPPE`;
      cycleEl.append(cycleH);

      for (const week of cycle.weeks) {
        const weekEl = document.createElement("div");
        weekEl.className = "homescool-mppe-modal__week";
        const weekH = document.createElement("h4");
        weekH.className = "homescool-mppe-modal__week-title";
        weekH.textContent = `Semana ${week.week} · ${week.objectiveIds.length} objetivos · ${week.classesWithMppe}/${week.classCount} clases`;
        weekEl.append(weekH);

        for (const day of week.days) {
          const dayEl = document.createElement("div");
          dayEl.className = "homescool-mppe-modal__day";
          const dayH = document.createElement("h5");
          dayH.className = "homescool-mppe-modal__day-title";
          dayH.textContent = `Día ${day.day} · ${day.objectiveCount} objetivos · ${day.classesWithMppe}/${day.classes.length} clases`;
          dayEl.append(dayH);

          const classList = document.createElement("ul");
          classList.className = "homescool-mppe-modal__class-list";
          for (const cls of day.classes) {
            const li = document.createElement("li");
            li.className = `homescool-mppe-modal__class ${
              cls.objectives.length
                ? "homescool-mppe-modal__class--imbued"
                : "homescool-mppe-modal__class--gap"
            }`;
            const head = document.createElement("div");
            head.className = "homescool-mppe-modal__class-head";
            const mark = document.createElement("span");
            mark.className = "homescool-mppe-modal__mark material-symbols-outlined";
            mark.setAttribute("aria-hidden", "true");
            mark.textContent = cls.objectives.length ? "check_circle" : "radio_button_unchecked";
            const name = document.createElement("strong");
            name.className = "homescool-mppe-modal__class-name";
            name.textContent = subjectDisplayName(cls.subject) || cls.subject;
            const title = document.createElement("span");
            title.className = "homescool-mppe-modal__class-title";
            title.textContent = cls.title;
            const key = document.createElement("code");
            key.className = "homescool-mppe-modal__id";
            key.textContent = cls.key;
            head.append(mark, name, title, key);
            li.append(head);

            if (cls.objectives.length) {
              const objUl = document.createElement("ul");
              objUl.className = "homescool-mppe-modal__obj-list";
              for (const obj of cls.objectives) {
                const objLi = document.createElement("li");
                objLi.className = "homescool-mppe-modal__obj";
                const idEl = document.createElement("code");
                idEl.className = "homescool-mppe-modal__id";
                idEl.textContent = obj.id;
                const label = document.createElement("span");
                label.textContent = obj.label;
                objLi.append(idEl, label);
                objUl.append(objLi);
              }
              li.append(objUl);
            } else {
              const none = document.createElement("p");
              none.className = "homescool-mppe-modal__keys";
              none.textContent = "Sin objetivos MPPE declarados";
              li.append(none);
            }
            classList.append(li);
          }
          dayEl.append(classList);
          weekEl.append(dayEl);
        }
        cycleEl.append(weekEl);
      }
      host.append(cycleEl);
    }
  }

  function renderMppeCatalogPanel(
    host: HTMLElement,
    checklist: Awaited<ReturnType<typeof loadMppeChecklist>>,
    coverage: ReturnType<typeof buildMppeCoverage>,
  ) {
    host.replaceChildren();
    if (!checklist) return;
    for (const area of checklist.areas) {
      const areaStats = coverage.byArea[area.id];
      const section = document.createElement("section");
      section.className = "homescool-mppe-modal__area";
      const h = document.createElement("h3");
      h.className = "homescool-mppe-modal__area-title";
      h.textContent = `${area.title} (${areaStats?.imbued ?? 0}/${areaStats?.total ?? 0})`;
      section.append(h);

      for (const comp of area.components) {
        const compEl = document.createElement("div");
        compEl.className = "homescool-mppe-modal__component";
        const ch = document.createElement("h4");
        ch.className = "homescool-mppe-modal__component-title";
        ch.textContent = comp.title;
        compEl.append(ch);
        const ul = document.createElement("ul");
        ul.className = "homescool-mppe-modal__list";
        for (const objective of comp.objectives) {
          const row = coverage.rows.find((r) => r.objective.id === objective.id);
          const li = document.createElement("li");
          li.className = `homescool-mppe-modal__item homescool-mppe-modal__item--${row?.status ?? "gap"}`;
          const mark = document.createElement("span");
          mark.className = "homescool-mppe-modal__mark material-symbols-outlined";
          mark.setAttribute("aria-hidden", "true");
          mark.textContent = row?.status === "imbued" ? "check_circle" : "radio_button_unchecked";
          const main = document.createElement("div");
          main.className = "homescool-mppe-modal__item-main";
          const idEl = document.createElement("code");
          idEl.className = "homescool-mppe-modal__id";
          idEl.textContent = objective.id;
          const text = document.createElement("p");
          text.className = "homescool-mppe-modal__aprendizaje";
          text.textContent = objective.aprendizaje;
          const keys = document.createElement("p");
          keys.className = "homescool-mppe-modal__keys";
          keys.textContent = row?.classKeys.length
            ? `Clases: ${row.classKeys.join(", ")}`
            : "Sin imbuición declarada en clases";
          main.append(idEl, text, keys);
