  async function renderMppeChecklistModal() {
    const summary = qs<HTMLElement>("[data-homescool-mppe-summary]");
    const schedulePanel = qs<HTMLElement>('[data-homescool-mppe-panel="schedule"]');
    const catalogPanel = qs<HTMLElement>('[data-homescool-mppe-panel="catalog"]');
    if (!summary || !schedulePanel || !catalogPanel) return;
    summary.textContent = "Cargando checklist…";
    schedulePanel.replaceChildren();
    catalogPanel.replaceChildren();
    const checklist = await loadMppeChecklist();
    if (!checklist) {
      summary.textContent = "No se pudo cargar el catálogo MPPE.";
      return;
    }
    const classDocs = collectMppeClassDocs();
    const coverage = buildMppeCoverage(checklist, classDocs);
    const schedule = buildMppeScheduleReport(checklist, classDocs);
    summary.textContent =
      `Catálogo ${coverage.imbued}/${coverage.total} · ` +
      `Calendario ${schedule.uniqueObjectiveIds.length} únicos en ${schedule.classesWithMppe}/${schedule.classCount} clases · ` +
      `eoschool master; MPPE cobertura requerida.`;
    renderMppeSchedulePanel(schedulePanel, schedule);
    renderMppeCatalogPanel(catalogPanel, checklist, coverage);
    setMppeModalTab("schedule");
    log("mppe.modal.render", {
      total: coverage.total,
      imbued: coverage.imbued,
      scheduleClasses: schedule.classCount,
      scheduleWithMppe: schedule.classesWithMppe,
      uniqueInSchedule: schedule.uniqueObjectiveIds.length,
    });
  }

