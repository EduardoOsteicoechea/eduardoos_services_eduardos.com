---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Homescool" description="Homescool study materials by cycle." page="homescool" robots="noindex,nofollow">
  <Fragment slot="dhs">
    <a class="dhs-action" href="/homescool/ciclo/3" data-route title="Ciclo 3" aria-label="Ciclo 3">
      <span class="icon-btn" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">menu_book</span></span>
      Ciclo 3
    </a>
    <a class="dhs-action" href="/homescool/learning" data-route title="Learning" aria-label="Learning">
      <span class="icon-btn" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">school</span></span>
      Learning
    </a>
    <a class="dhs-action" href="/homescool/students" data-route title="Students" aria-label="Students">
      <span class="icon-btn" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">group</span></span>
      Students
    </a>
  </Fragment>

  <section class="product-dash" data-homescool>
    <h1 class="page-title-sr">Homescool</h1>
    <p class="status" data-banner>Loading…</p>
    <div data-gate hidden class="product-gate">
      <p class="hint">Sign in with Homescool access to view study materials.</p>
      <p class="hint"><a href="/session" data-route>Sign in</a> · <a href="/payments/subscription" data-route>Subscribe</a></p>
    </div>
    <div data-authed hidden>
      <div class="product-dash__grid" data-cycles></div>
    </div>
  </section>
</Layout>

<script>
  import { requireService, setHidden } from "../../lib/productGate";
  import { clearAgentRoutePayload, setAgentRoutePayload } from "../../lib/api";
  import { fetchHomescoolMaterials } from "../../lib/homescool";
  import { showErrorModal } from "../../lib/error-modal";

  const root = document.querySelector("[data-homescool]");
  const banner = root?.querySelector("[data-banner]");
  const gate = root?.querySelector("[data-gate]");
  const authed = root?.querySelector("[data-authed]");
  const cyclesEl = root?.querySelector("[data-cycles]");

  const result = await requireService("homescool", { requireSubscription: false });
  const linkedOk = result.access.allowed || result.access.reason === "linked_student";
  if (!result.sessionOk || !linkedOk) {
    // Teachers need subscription; linked students are allowed via access endpoint.
    const teacher = await requireService("homescool", { requireSubscription: true });
    if (!teacher.sessionOk || !teacher.access.allowed) {
      if (banner instanceof HTMLElement) {
        banner.textContent = teacher.sessionOk ? "Homescool access required." : "Sign in required.";
      }
      setHidden(gate, false);
      setHidden(authed, true);
    } else {
      await renderDash(teacher);
    }
  } else {
    await renderDash(result);
  }

  async function renderDash(_gate: unknown) {
    if (banner instanceof HTMLElement) banner.textContent = "Materials by cycle";
    setHidden(gate, true);
    setHidden(authed, false);
    const res = await fetchHomescoolMaterials();
    if (res.error) {
      showErrorModal({ message: res.error, requestId: res.requestId, details: res.requestId ? `request_id=${res.requestId}` : "" });
      if (banner instanceof HTMLElement) banner.textContent = res.error;
      return;
    }
    const byCycle = new Map<number, { count: number; empty: boolean }>();
    for (const c of res.cycles.length ? res.cycles : [1, 2, 3].map((n) => ({ cycle: n, count: 0, empty: true }))) {
      byCycle.set(c.cycle, { count: c.count, empty: c.empty });
    }
    for (let n = 1; n <= 3; n++) {
      if (!byCycle.has(n)) byCycle.set(n, { count: 0, empty: true });
    }
    if (!(cyclesEl instanceof HTMLElement)) return;
    cyclesEl.replaceChildren();
    for (let n = 1; n <= 3; n++) {
      const meta = byCycle.get(n)!;
      const a = document.createElement("a");
      a.className = "product-dash__card";
      a.href = `/homescool/ciclo/${n}`;
      a.setAttribute("data-route", "");
      const icon = document.createElement("span");
      icon.className = "material-symbols-outlined";
      icon.setAttribute("aria-hidden", "true");
      icon.textContent = meta.empty ? "folder_off" : "menu_book";
      const title = document.createElement("span");
      title.className = "product-dash__card-title";
      title.textContent = `Ciclo ${n}`;
      const desc = document.createElement("span");
      desc.className = "product-dash__card-desc";
      desc.textContent = meta.empty ? "Sin materiales aún" : `${meta.count} material(es)`;
      a.append(icon, title, desc);
      cyclesEl.append(a);
    }
    setAgentRoutePayload({
      kind: "homescool_dashboard",
      cycles: [...byCycle.entries()].map(([cycle, meta]) => ({
        cycle,
        count: meta.count,
        empty: meta.empty,
      })),
    });
  }
</script>
