---
import Layout from "../../../layouts/Layout.astro";

export function getStaticPaths() {
  return [{ params: { cycle: "1" } }, { params: { cycle: "2" } }, { params: { cycle: "3" } }];
}

const cycle = Number.parseInt(Astro.params.cycle ?? "0", 10);
---

<Layout title={`Homescool · Ciclo ${cycle}`} description="Opens in Homescool workspace." page="homescool-cycle" robots="noindex,nofollow">
  <h1 class="page-title-sr">Ciclo {cycle}</h1>
  <p class="status">Opening workspace…</p>
</Layout>

<script>
  window.location.replace("/homescool");
</script>
