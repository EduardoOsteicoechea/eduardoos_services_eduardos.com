---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Homescool material" description="Opens in Homescool workspace." page="homescool-material" robots="noindex,nofollow">
  <h1 class="page-title-sr">Material</h1>
  <p class="status">Opening workspace…</p>
</Layout>

<script>
  const id = new URLSearchParams(window.location.search).get("id") || "";
  const target = id ? `/homescool?material=${encodeURIComponent(id)}` : "/homescool";
  window.location.replace(target);
</script>
