---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Scrib sheet · Eduardoos"
  description="Edit a Scrib manuscript sheet."
  page="scrib-sheet"
  robots="noindex,nofollow"
>
  <Fragment slot="dhs">
    <a class="dhs-action" href="/scrib" data-route title="Dashboard" aria-label="Dashboard">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">dashboard</span>
      </span>
      Dashboard
    </a>
    <button class="dhs-action" type="button" data-mode="zoom" title="Zoom / pan" aria-label="Zoom / pan">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">zoom_in</span>
      </span>
      Zoom
    </button>
    <button class="dhs-action" type="button" data-mode="draw" title="Draw" aria-label="Draw">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">draw</span>
      </span>
      Draw
    </button>
    <button class="dhs-action" type="button" data-stroke="-" title="Thinner stroke" aria-label="Thinner stroke">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">remove</span>
      </span>
      Stroke −
    </button>
    <span class="scrib-stroke-widget" data-stroke-label>0.35 mm</span>
    <button class="dhs-action" type="button" data-stroke="+" title="Thicker stroke" aria-label="Thicker stroke">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">add</span>
      </span>
      Stroke +
    </button>
    <button class="dhs-action" type="button" data-mode="erase" title="Erase" aria-label="Erase">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">ink_eraser</span>
      </span>
      Erase
    </button>
    <button class="dhs-action" type="button" data-layers title="Layers" aria-label="Layers">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">layers</span>
      </span>
      Layers
    </button>
    <button class="dhs-action" type="button" data-institutes title="Institutes Capita" aria-label="Institutes Capita">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
      </span>
      Capita
    </button>
    <button class="dhs-action" type="button" data-undo title="Undo" aria-label="Undo">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">undo</span>
      </span>
      Undo
    </button>
    <button class="dhs-action" type="button" data-fullscreen title="Fullscreen" aria-label="Fullscreen">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">fullscreen</span>
      </span>
      Fullscreen
    </button>
    <button class="dhs-action" type="button" data-print title="Print PDF" aria-label="Print PDF">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">print</span>
      </span>
      Print PDF
    </button>
    <span class="scrib-save-hint" data-save-hint></span>
  </Fragment>

  <p class="status" data-banner>Loading…</p>
  <div data-gate hidden class="product-gate">
    <p class="hint">Sign in with Scrib access to edit sheets.</p>
    <p class="hint"><a href="/scrib" data-route>Back to Scrib</a></p>
  </div>

  <div class="scrib-viewport" data-viewport hidden>
    <div class="scrib-stage" data-stage>
      <div class="scrib-page" data-page></div>
    </div>
    <div class="scrib-fullscreen-controls" data-fs-controls hidden>
      <button type="button" class="scrib-fullscreen-toggle-header" data-toggle-header title="Toggle chrome" aria-label="Toggle chrome">
        <span class="material-symbols-outlined" aria-hidden="true">view_sidebar</span>
      </button>
      <button type="button" class="scrib-fullscreen-close" data-exit-fs title="Exit fullscreen" aria-label="Exit fullscreen">
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>
    </div>
  </div>

  <div class="scrib-layers-modal" data-layers-modal hidden role="dialog" aria-modal="true" aria-label="Capas">
    <div class="scrib-layers-modal__panel">
      <header class="scrib-layers-modal__head">
        <h2>Capas</h2>
        <button type="button" class="btn" data-layers-close>Cerrar</button>
      </header>
      <ul class="scrib-layers-list" data-layers-list></ul>
    </div>
  </div>

  <div class="scrib-institutes-modal" data-institutes-modal hidden role="dialog" aria-modal="true" aria-label="Institutes Capita">
    <div class="scrib-institutes-modal__panel scrib-layers-modal__panel">
      <header class="scrib-layers-modal__head">
        <h2>Capita</h2>
        <button type="button" class="btn" data-institutes-close>Cerrar</button>
      </header>
      <p class="scrib-institutes-modal__error" data-inst-error hidden></p>
      <p class="scrib-institutes-modal__status" data-inst-status>Loading…</p>
      <div class="scrib-institutes-modal__scroll" data-inst-body hidden>
        <div class="scrib-institutes-modal__libers" data-inst-libers></div>
        <div class="scrib-institutes-modal__step">
          <p class="scrib-institutes-modal__step-label">Caput</p>
          <p class="scrib-institutes-modal__step-meta" data-inst-chapter-meta></p>
          <div class="scrib-institutes-modal__chips scrib-institutes-modal__chips--chapters" data-inst-chapters></div>
        </div>
        <div class="scrib-institutes-modal__step">
          <p class="scrib-institutes-modal__step-label">Paragraph</p>
          <div class="scrib-institutes-modal__chips scrib-institutes-modal__chips--paras" data-inst-paras></div>
        </div>
        <div class="scrib-institutes-modal__text">
          <p class="scrib-institutes-modal__text-id" data-inst-para-id></p>
          <p class="scrib-institutes-modal__text-body" data-inst-para-text></p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { mustLog } from "../../lib/dev-log";
  import { showErrorModal } from "../../lib/error-modal";
  import {
    chapterNavLabel,
    fetchParagraphChapter,
    fetchParagraphIndex,
    groupChaptersByLiber,
    type ParagraphIndexChapter,
    type ParagraphUnit,
  } from "../../lib/calvinsInstitutes";
  import { PREF_SCRIB_INSTITUTES_NAV, getPreference, putPreference } from "../../lib/preferences";
  import { apiFail, requireService, setHidden } from "../../lib/productGate";
  import {
    fetchScribSheet,
    resolveScribSheetFromLocation,
    saveScribSheet,
    SCRIB_BG_SRC,
    SCRIB_LAYER_IDS,
    SCRIB_LAYER_LABELS,
    SCRIB_PAGE_HEIGHT_MM,
    SCRIB_PAGE_WIDTH_MM,
    type ScribLayer,
    type ScribLayerId,
    type ScribSheet,
    type StrokePath,
  } from "../../lib/scrib";
  import { downloadScribSheetPdf } from "../../lib/scribPrint";

  const INK = "#141820";
  const STROKE_MIN = 0.1;
  const STROKE_MAX = 2.5;
  const STROKE_STEP = 0.05;
  const ZOOM_MIN = 0.25;
  const ZOOM_MAX = 4;

  type Mode = "draw" | "zoom" | "erase";
  type UndoEntry = { layerId: string; pathsBefore: StrokePath[] };
  type InstNav = { activeBook: string; chapterId: string | null; paraOrder: number | null };

  const banner = document.querySelector("[data-banner]");
  const gate = document.querySelector("[data-gate]");
  const viewport = document.querySelector("[data-viewport]");
  const stage = document.querySelector("[data-stage]");
  const pageEl = document.querySelector("[data-page]");
  const strokeLabel = document.querySelector("[data-stroke-label]");
  const saveHint = document.querySelector("[data-save-hint]");
  const layersModal = document.querySelector("[data-layers-modal]");
  const layersList = document.querySelector("[data-layers-list]");
  const institutesModal = document.querySelector("[data-institutes-modal]");
  const fsControls = document.querySelector("[data-fs-controls]");

  let sheet: ScribSheet | null = null;
  let mode: Mode = "draw";
  let scale = 1;
  let pan = { x: 0, y: 0 };
  let draftPath = "";
  let drawing = false;
  let activePointerId: number | null = null;
  let points: { x: number; y: number }[] = [];
  let panDrag: { x: number; y: number; panX: number; panY: number } | null = null;
  let pinch: { dist: number; scale: number } | null = null;
  let undoStack: UndoEntry[] = [];
  let saveQueue: Promise<void> = Promise.resolve();
  let queuedSaves = 0;
  let isFullscreen = false;
  let headerVisible = true;

  let instChapters: ParagraphIndexChapter[] = [];
  let instActiveBook = "I";
  let instSelected: ParagraphIndexChapter | null = null;
  let instParas: ParagraphUnit[] = [];
  let instParaOrder: number | null = null;
  let instPendingChapterId: string | null = null;

  function clonePaths(paths: StrokePath[]): StrokePath[] {
    return paths.map((p) => ({ ...p }));
  }

  function ensureLayers(doc: ScribSheet): ScribSheet {
    const byId = new Map(doc.layers.map((l) => [l.id, l]));
    const layers: ScribLayer[] = SCRIB_LAYER_IDS.map((id) => {
      const existing = byId.get(id);
      return { id, opacity: existing?.opacity ?? 1, paths: existing?.paths ?? [] };
    });
    return { ...doc, layers };
  }

  function rootRem(): number {
    const n = parseFloat(getComputedStyle(document.documentElement).fontSize || "16");
    return n > 0 ? n : 16;
  }

  function applyStageTransform() {
    if (!(stage instanceof HTMLElement)) return;
    stage.style.transform = `translate(${pan.x}rem, ${pan.y}rem) scale(${scale})`;
  }

  function updateStrokeLabel() {
    if (strokeLabel instanceof HTMLElement && sheet) {
      strokeLabel.textContent = `${sheet.strokeWidthMm.toFixed(2)} mm`;
    }
  }

  function updateSaveHint() {
    if (saveHint instanceof HTMLElement) {
      saveHint.textContent = queuedSaves > 0 ? "Saving…" : "";
    }
  }

  function pathPoints(d: string): { x: number; y: number }[] {
    const pts: { x: number; y: number }[] = [];
    const re = /[ML]\s*([-\d.]+)\s+([-\d.]+)/gi;
    let m: RegExpExecArray | null;
    while ((m = re.exec(d))) pts.push({ x: Number(m[1]), y: Number(m[2]) });
    return pts;
  }

  function erasePaths(paths: StrokePath[], eraser: { x: number; y: number }[], radiusMm: number): StrokePath[] {
    if (eraser.length === 0) return paths;
    return paths.filter((path) => {
      const pts = pathPoints(path.d);
      if (pts.length === 0) return true;
      const hitR = radiusMm + path.strokeWidth * 0.5;
      for (const p of pts) {
        for (const e of eraser) {
          if (Math.hypot(p.x - e.x, p.y - e.y) <= hitR) return false;
        }
      }
      return true;
    });
  }

  function renderPage() {
    if (!(pageEl instanceof HTMLElement) || !sheet) return;
    pageEl.style.width = `${SCRIB_PAGE_WIDTH_MM}mm`;
    pageEl.style.height = `${SCRIB_PAGE_HEIGHT_MM}mm`;
    pageEl.replaceChildren();
    const bg = document.createElement("img");
    bg.className = "scrib-page__bg";
    bg.src = SCRIB_BG_SRC;
    bg.alt = "";
    bg.draggable = false;
    pageEl.append(bg);
    sheet.layers.forEach((layer, index) => {
      const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
      svg.classList.add("scrib-layer");
      svg.setAttribute("viewBox", `0 0 ${SCRIB_PAGE_WIDTH_MM} ${SCRIB_PAGE_HEIGHT_MM}`);
      svg.setAttribute("width", `${SCRIB_PAGE_WIDTH_MM}mm`);
      svg.setAttribute("height", `${SCRIB_PAGE_HEIGHT_MM}mm`);
      svg.style.zIndex = String(index + 1);
      svg.style.opacity = String(layer.opacity);
      svg.setAttribute("aria-hidden", "true");
      for (const path of layer.paths) {
        const p = document.createElementNS("http://www.w3.org/2000/svg", "path");
        p.setAttribute("d", path.d);
        p.setAttribute("fill", "none");
        p.setAttribute("stroke", INK);
        p.setAttribute("stroke-width", String(path.strokeWidth));
        p.setAttribute("stroke-linecap", "round");
        p.setAttribute("stroke-linejoin", "round");
        svg.appendChild(p);
      }
      if (layer.id === sheet!.activeLayerId && draftPath && mode === "draw") {
        const draft = document.createElementNS("http://www.w3.org/2000/svg", "path");
        draft.setAttribute("d", draftPath);
        draft.setAttribute("fill", "none");
        draft.setAttribute("stroke", INK);
        draft.setAttribute("stroke-width", String(sheet!.strokeWidthMm));
        draft.setAttribute("stroke-linecap", "round");
        draft.setAttribute("stroke-linejoin", "round");
        draft.setAttribute("opacity", "0.85");
        svg.appendChild(draft);
      }
      pageEl.append(svg);
    });
    applyStageTransform();
    updateStrokeLabel();
  }

  function persist(next: ScribSheet) {
    sheet = next;
    queuedSaves += 1;
    updateSaveHint();
    saveQueue = saveQueue
      .catch(() => undefined)
      .then(async () => {
        const res = await saveScribSheet(next);
        if (!res.sheet) apiFail(res.error || "Could not save sheet.", { requestId: res.requestId });
      })
      .finally(() => {
        queuedSaves -= 1;
        updateSaveHint();
      });
  }

  function commitLocal(next: ScribSheet) {
    sheet = ensureLayers(next);
    renderPage();
  }

  function mmFromClient(clientX: number, clientY: number): { x: number; y: number } | null {
    if (!(pageEl instanceof HTMLElement)) return null;
    const rect = pageEl.getBoundingClientRect();
    if (rect.width <= 0 || rect.height <= 0) return null;
    return {
      x: ((clientX - rect.left) / rect.width) * SCRIB_PAGE_WIDTH_MM,
      y: ((clientY - rect.top) / rect.height) * SCRIB_PAGE_HEIGHT_MM,
    };
  }

  function setMode(next: Mode) {
    mode = next;
    if (viewport instanceof HTMLElement) {
      viewport.classList.toggle("scrib-viewport--zoom", mode === "zoom");
    }
    document.querySelectorAll("[data-mode]").forEach((btn) => {
      if (!(btn instanceof HTMLElement)) return;
      btn.setAttribute("aria-pressed", btn.dataset.mode === mode ? "true" : "false");
    });
  }

  function fitSheet() {
    if (!(viewport instanceof HTMLElement)) return;
    const pad = 1; // rem-ish pad via client px → scale only
    const availW = Math.max(120, viewport.clientWidth - pad * 32);
    const availH = Math.max(120, viewport.clientHeight - pad * 32);
    const sx = availW / SCRIB_PAGE_WIDTH_MM;
    const sy = availH / SCRIB_PAGE_HEIGHT_MM;
    scale = Math.min(Math.max(Math.min(sx, sy, 1.5), ZOOM_MIN), ZOOM_MAX);
    pan = { x: 0, y: 0 };
    applyStageTransform();
  }

  function finishStroke() {
    if (!drawing || !sheet) return;
    drawing = false;
    const pts = points;
    points = [];
    draftPath = "";
    if (pts.length < 2) {
      renderPage();
      return;
    }
    const activeId = sheet.activeLayerId;
    let pathsBefore: StrokePath[] = [];
    const layers = sheet.layers.map((layer) => {
      if (layer.id !== activeId) return layer;
      pathsBefore = clonePaths(layer.paths);
      if (mode === "erase") {
        return { ...layer, paths: erasePaths(layer.paths, pts, sheet!.strokeWidthMm) };
      }
      const d = pts.map((p, i) => `${i === 0 ? "M" : "L"} ${p.x.toFixed(3)} ${p.y.toFixed(3)}`).join(" ");
      return { ...layer, paths: [...layer.paths, { d, strokeWidth: sheet!.strokeWidthMm }] };
    });
    undoStack = [...undoStack, { layerId: activeId, pathsBefore }];
    const next = { ...sheet, layers };
    commitLocal(next);
    persist(next);
  }

  function onPointerDown(e: PointerEvent) {
    if (!sheet) return;
    if (mode === "zoom") {
      panDrag = { x: e.clientX, y: e.clientY, panX: pan.x, panY: pan.y };
      (e.currentTarget as Element).setPointerCapture?.(e.pointerId);
      return;
    }
    if (e.pointerType !== "pen") return;
    const pt = mmFromClient(e.clientX, e.clientY);
    if (!pt) return;
    drawing = true;
    activePointerId = e.pointerId;
    points = [pt];
    draftPath = "";
    (e.currentTarget as Element).setPointerCapture?.(e.pointerId);
  }

  function onPointerMove(e: PointerEvent) {
    if (mode === "zoom" && panDrag) {
      const rem = rootRem();
      pan = {
        x: panDrag.panX + (e.clientX - panDrag.x) / rem,
        y: panDrag.panY + (e.clientY - panDrag.y) / rem,
      };
      applyStageTransform();
      return;
    }
    if (!drawing) return;
    if (activePointerId !== null && e.pointerId !== activePointerId) return;
    if (e.pointerType !== "pen") return;
    const pt = mmFromClient(e.clientX, e.clientY);
    if (!pt) return;
    points.push(pt);
    if (mode === "draw") {
      draftPath = points.map((p, i) => `${i === 0 ? "M" : "L"} ${p.x.toFixed(3)} ${p.y.toFixed(3)}`).join(" ");
      renderPage();
    }
  }

  function onPointerUp(e: PointerEvent) {
    if (mode === "zoom") {
      panDrag = null;
      return;
    }
    if (activePointerId !== null && e.pointerId !== activePointerId) return;
    activePointerId = null;
    finishStroke();
  }

  function renderLayersModal() {
    if (!(layersList instanceof HTMLElement) || !sheet) return;
    layersList.replaceChildren();
    for (const layer of sheet.layers) {
      const id = layer.id as ScribLayerId;
      const li = document.createElement("li");
      li.className = "scrib-layer-card";
      const active = document.createElement("label");
      active.className = "scrib-layer-card__active";
      const radio = document.createElement("input");
      radio.type = "radio";
      radio.name = "scrib-active-layer";
      radio.checked = sheet.activeLayerId === layer.id;
      radio.addEventListener("change", () => {
        if (!sheet) return;
        commitLocal({ ...sheet, activeLayerId: layer.id });
      });
      active.append(radio, document.createTextNode(SCRIB_LAYER_LABELS[id] ?? layer.id));
      const opacity = document.createElement("label");
      opacity.className = "scrib-layer-card__opacity";
      opacity.append("Opacidad");
      const range = document.createElement("input");
      range.type = "range";
      range.min = "0";
      range.max = "1";
      range.step = "0.05";
      range.value = String(layer.opacity);
      const pct = document.createElement("span");
      pct.textContent = `${Math.round(layer.opacity * 100)}%`;
      range.addEventListener("input", () => {
        if (!sheet) return;
        const value = Number(range.value);
        pct.textContent = `${Math.round(value * 100)}%`;
        commitLocal({
          ...sheet,
          layers: sheet.layers.map((l) => (l.id === layer.id ? { ...l, opacity: value } : l)),
        });
      });
      opacity.append(range, pct);
      li.append(active, opacity);
      layersList.append(li);
    }
  }

  function openLayers(open: boolean) {
    setHidden(layersModal, !open);
    if (open) {
      setHidden(institutesModal, true);
      renderLayersModal();
    } else if (sheet) persist(sheet);
  }

  async function persistInstNav() {
    const nav: InstNav = {
      activeBook: instActiveBook,
      chapterId: instSelected?.id ?? instPendingChapterId,
      paraOrder: instParaOrder,
    };
    await putPreference(PREF_SCRIB_INSTITUTES_NAV, nav);
  }

  function renderInstitutes() {
    const libers = document.querySelector("[data-inst-libers]");
    const chaptersEl = document.querySelector("[data-inst-chapters]");
    const parasEl = document.querySelector("[data-inst-paras]");
    const meta = document.querySelector("[data-inst-chapter-meta]");
    const paraId = document.querySelector("[data-inst-para-id]");
    const paraText = document.querySelector("[data-inst-para-text]");
    if (!(libers instanceof HTMLElement) || !(chaptersEl instanceof HTMLElement) || !(parasEl instanceof HTMLElement)) return;
    const groups = groupChaptersByLiber(instChapters);
    libers.replaceChildren();
    for (const g of groups) {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "scrib-institutes-modal__liber" + (g.book === instActiveBook ? " is-active" : "");
      btn.textContent = `Liber ${g.book}`;
      btn.addEventListener("click", () => {
        instActiveBook = g.book;
        instSelected = null;
        instParas = [];
        instParaOrder = null;
        void persistInstNav();
        renderInstitutes();
      });
      libers.append(btn);
    }
    const entries = groups.find((g) => g.book === instActiveBook)?.entries ?? [];
    chaptersEl.replaceChildren();
    for (const entry of entries) {
      const chip = document.createElement("button");
      chip.type = "button";
      chip.className = "scrib-institutes-modal__chip" + (instSelected?.id === entry.id ? " is-active" : "");
      chip.textContent = chapterNavLabel(entry);
      chip.title = entry.heading || entry.chapter;
      chip.addEventListener("click", () => void selectChapter(entry));
      chaptersEl.append(chip);
    }
    if (meta instanceof HTMLElement) meta.textContent = instSelected?.heading || "";
    parasEl.replaceChildren();
    for (const p of instParas) {
      const chip = document.createElement("button");
      chip.type = "button";
      chip.className = "scrib-institutes-modal__chip" + (instParaOrder === p.order ? " is-active" : "");
      chip.textContent = String(p.order);
      chip.addEventListener("click", () => {
        instParaOrder = p.order;
        void persistInstNav();
        renderInstitutes();
      });
      parasEl.append(chip);
    }
    const active = instParas.find((p) => p.order === instParaOrder) ?? null;
    if (paraId instanceof HTMLElement) paraId.textContent = active ? `¶ ${active.order}` : "";
    if (paraText instanceof HTMLElement) paraText.textContent = active?.text || "";
  }

  async function selectChapter(entry: ParagraphIndexChapter) {
    instSelected = entry;
    instPendingChapterId = entry.id;
    const status = document.querySelector("[data-inst-status]");
    if (status instanceof HTMLElement) status.textContent = "Loading chapter…";
    try {
      const doc = await fetchParagraphChapter(entry.book, entry.chapter);
      instParas = [...(doc.paragraphs ?? [])]
        .map((p, i) => ({ order: typeof p.order === "number" ? p.order : i + 1, text: p.text || "", id: p.id }))
        .sort((a, b) => a.order - b.order);
      if (instParaOrder == null && instParas[0]) instParaOrder = instParas[0].order;
      if (status instanceof HTMLElement) status.textContent = "";
    } catch (err) {
      instParas = [];
      if (status instanceof HTMLElement) status.textContent = "";
      const errEl = document.querySelector("[data-inst-error]");
      if (errEl instanceof HTMLElement) {
        errEl.textContent = err instanceof Error ? err.message : "Chapter failed.";
        setHidden(errEl, false);
      }
    }
    await persistInstNav();
    renderInstitutes();
  }

  async function openInstitutes(open: boolean) {
    setHidden(institutesModal, !open);
    if (!open) return;
    openLayers(false);
    setHidden(layersModal, true);
    const status = document.querySelector("[data-inst-status]");
    const body = document.querySelector("[data-inst-body]");
    const errEl = document.querySelector("[data-inst-error]");
    setHidden(errEl, true);
    if (instChapters.length === 0) {
      if (status instanceof HTMLElement) status.textContent = "Loading…";
      setHidden(body, true);
      try {
        const idx = await fetchParagraphIndex();
        instChapters = (idx.chapters ?? []).map((c, i) => ({
          id: c.id || `${c.book}-${c.chapter}`,
          order: typeof c.order === "number" ? c.order : i + 1,
          book: c.book,
          chapter: c.chapter,
          heading: c.heading || "",
          paragraphCount: c.paragraphCount,
          url: c.url,
        }));
        const pref = await getPreference<InstNav>(PREF_SCRIB_INSTITUTES_NAV);
        const groups = groupChaptersByLiber(instChapters);
        if (pref.value?.activeBook && groups.some((g) => g.book === pref.value!.activeBook)) {
          instActiveBook = pref.value.activeBook;
        } else {
          instActiveBook = groups[0]?.book ?? "I";
        }
        instPendingChapterId = pref.value?.chapterId ?? null;
        instParaOrder = pref.value?.paraOrder ?? null;
        if (instPendingChapterId) {
          const match = instChapters.find((c) => c.id === instPendingChapterId);
          if (match) await selectChapter(match);
        }
        if (status instanceof HTMLElement) status.textContent = "";
        setHidden(body, false);
        renderInstitutes();
      } catch (err) {
        if (errEl instanceof HTMLElement) {
          errEl.textContent = err instanceof Error ? err.message : "Institutes unavailable.";
          setHidden(errEl, false);
        }
        if (status instanceof HTMLElement) status.textContent = "";
      }
    } else {
      if (status instanceof HTMLElement) status.textContent = "";
      setHidden(body, false);
      renderInstitutes();
    }
  }

  pageEl?.addEventListener("pointerdown", (e) => onPointerDown(e as PointerEvent));
  pageEl?.addEventListener("pointermove", (e) => onPointerMove(e as PointerEvent));
  pageEl?.addEventListener("pointerup", (e) => onPointerUp(e as PointerEvent));
  pageEl?.addEventListener("pointercancel", (e) => onPointerUp(e as PointerEvent));

  if (viewport instanceof HTMLElement) {
    viewport.addEventListener(
      "wheel",
      (e) => {
        if (mode !== "zoom") return;
        e.preventDefault();
        const delta = e.deltaY > 0 ? 0.9 : 1.1;
        scale = Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, scale * delta));
        applyStageTransform();
      },
      { passive: false },
    );
    viewport.addEventListener("touchstart", (e) => {
      if (mode !== "zoom" || e.touches.length !== 2) return;
      const [a, b] = [e.touches[0], e.touches[1]];
      pinch = { dist: Math.hypot(a.clientX - b.clientX, a.clientY - b.clientY), scale };
    });
    viewport.addEventListener(
      "touchmove",
      (e) => {
        if (mode !== "zoom" || !pinch || e.touches.length !== 2) return;
        e.preventDefault();
        const [a, b] = [e.touches[0], e.touches[1]];
        const dist1 = Math.hypot(a.clientX - b.clientX, a.clientY - b.clientY);
        scale = Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, pinch.scale * (dist1 / Math.max(1, pinch.dist))));
        applyStageTransform();
      },
      { passive: false },
    );
    viewport.addEventListener("touchend", () => {
      pinch = null;
    });
  }

  document.querySelectorAll("[data-mode]").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!(btn instanceof HTMLElement)) return;
      const next = btn.dataset.mode;
      if (next === "draw" || next === "zoom" || next === "erase") setMode(next);
    });
  });

  document.querySelectorAll("[data-stroke]").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!sheet || !(btn instanceof HTMLElement)) return;
      const dir = btn.dataset.stroke === "+" ? STROKE_STEP : -STROKE_STEP;
      const strokeWidthMm = Math.min(STROKE_MAX, Math.max(STROKE_MIN, +(sheet.strokeWidthMm + dir).toFixed(2)));
      commitLocal({ ...sheet, strokeWidthMm });
    });
  });

  document.querySelector("[data-undo]")?.addEventListener("click", () => {
    if (!sheet || undoStack.length === 0) return;
    const entry = undoStack[undoStack.length - 1];
    undoStack = undoStack.slice(0, -1);
    const next = {
      ...sheet,
      layers: sheet.layers.map((l) => (l.id === entry.layerId ? { ...l, paths: clonePaths(entry.pathsBefore) } : l)),
    };
    commitLocal(next);
    persist(next);
  });

  document.querySelector("[data-layers]")?.addEventListener("click", () => {
    const open = layersModal instanceof HTMLElement && layersModal.hasAttribute("hidden");
    openLayers(open);
  });
  document.querySelector("[data-layers-close]")?.addEventListener("click", () => openLayers(false));
  layersModal?.addEventListener("pointerdown", (e) => {
    if (e.target === layersModal) openLayers(false);
  });

  document.querySelector("[data-institutes]")?.addEventListener("click", () => {
    const open = institutesModal instanceof HTMLElement && institutesModal.hasAttribute("hidden");
    void openInstitutes(open);
  });
  document.querySelector("[data-institutes-close]")?.addEventListener("click", () => void openInstitutes(false));
  institutesModal?.addEventListener("pointerdown", (e) => {
    if (e.target === institutesModal) void openInstitutes(false);
  });

  document.querySelector("[data-fullscreen]")?.addEventListener("click", async () => {
    try {
      headerVisible = true;
      document.documentElement.classList.remove("scrib-fullscreen--header-hidden");
      await document.documentElement.requestFullscreen();
    } catch {
      showErrorModal({ message: "No se pudo abrir la pantalla completa." });
    }
  });
  document.querySelector("[data-exit-fs]")?.addEventListener("click", async () => {
    try {
      await document.exitFullscreen();
    } catch {
      /* ignore */
    }
  });
  document.querySelector("[data-toggle-header]")?.addEventListener("click", () => {
    headerVisible = !headerVisible;
    document.documentElement.classList.toggle("scrib-fullscreen--header-hidden", !headerVisible);
  });
  document.addEventListener("fullscreenchange", () => {
    isFullscreen = document.fullscreenElement === document.documentElement;
    setHidden(fsControls, !isFullscreen);
    if (!isFullscreen) {
      document.documentElement.classList.remove("scrib-fullscreen--header-hidden");
      headerVisible = true;
    }
  });

  document.querySelector("[data-print]")?.addEventListener("click", async () => {
    if (!sheet || !(pageEl instanceof HTMLElement)) return;
    openLayers(false);
    void openInstitutes(false);
    draftPath = "";
    renderPage();
    try {
      await downloadScribSheetPdf(pageEl, sheet);
    } catch (err) {
      showErrorModal({ message: err instanceof Error ? err.message : "Print failed." });
    }
  });

  const loc = resolveScribSheetFromLocation();
  const gateResult = await requireService("scrib");
  if (!loc || !gateResult.sessionOk || !gateResult.access.allowed) {
    if (banner instanceof HTMLElement) banner.textContent = !loc ? "Missing sheet query." : "Access required.";
    setHidden(gate, false);
    setHidden(viewport, true);
  } else {
    const loaded = await fetchScribSheet(loc.bookId, loc.sheetId);
    if (!loaded.sheet) {
      apiFail(loaded.error || "Sheet not found.", { requestId: loaded.requestId });
      setHidden(gate, false);
      setHidden(viewport, true);
    } else {
      sheet = ensureLayers(loaded.sheet);
      if (banner instanceof HTMLElement) {
        banner.textContent = "";
        banner.hidden = true;
      }
      setHidden(gate, true);
      setHidden(viewport, false);
      setMode("draw");
      renderPage();
      fitSheet();
      if (mustLog) console.log("[scrib] sheet ready", { id: sheet.id, paths: sheet.layers.reduce((n, l) => n + l.paths.length, 0) });
    }
  }
</script>
