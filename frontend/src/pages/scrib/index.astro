---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Scrib · Eduardoos"
  description="Layered US Letter manuscript sheets."
  page="scrib"
  robots="noindex,nofollow"
>
  <Fragment slot="dhs">
    <button class="dhs-action" type="button" data-new-book title="New book" aria-label="New book">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">library_add</span>
      </span>
      New book
    </button>
    <a class="dhs-action" href="/dashboard/latin/calvins-institutes" data-route title="Institutes" aria-label="Institutes">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
      </span>
      Institutes
    </a>
  </Fragment>

  <section class="product-dash scrib-dashboard" data-scrib-hub>
    <h1 class="scrib-dashboard__title">Scrib</h1>
    <p class="status" data-banner>Loading…</p>
    <div data-gate hidden class="product-gate">
      <p class="hint">Scrib subscription required.</p>
      <p class="hint"><a href="/payments/subscription" data-route>Subscribe</a> · <a href="/session" data-route>Sign in</a></p>
    </div>
    <div data-authed hidden>
      <p class="scrib-dashboard__lead">
        Libros de hojas US Letter con capas de manuscrito. Haz clic en el nombre de un libro o una hoja para editarlo.
      </p>
      <form class="scrib-dashboard__new-book" data-create-book>
        <label class="scrib-dashboard__label" for="scrib-book-name">Nuevo libro</label>
        <div class="scrib-dashboard__row">
          <input
            id="scrib-book-name"
            class="scrib-dashboard__input"
            name="name"
            required
            maxlength="120"
            placeholder="Nombre del libro"
          />
          <button class="btn btn--primary" type="submit">Crear libro</button>
        </div>
      </form>
      <p class="scrib-dashboard__error" data-error hidden></p>
      <p class="scrib-dashboard__empty" data-empty hidden>Aún no hay libros. Crea el primero arriba.</p>
      <div class="scrib-books" data-books></div>
    </div>
  </section>
</Layout>

<script>
  import { mustLog } from "../../lib/dev-log";
  import { apiFail, requireService, setHidden } from "../../lib/productGate";
  import {
    createScribBook,
    createScribSheet,
    deleteScribBook,
    deleteScribSheet,
    fetchScribLibrary,
    renameScribBook,
    renameScribSheet,
    scribSheetHref,
    type ScribBookCard,
  } from "../../lib/scrib";

  const root = document.querySelector("[data-scrib-hub]");
  if (!(root instanceof HTMLElement)) throw new Error("scrib hub missing");
  const banner = root.querySelector("[data-banner]");
  const gate = root.querySelector("[data-gate]");
  const authed = root.querySelector("[data-authed]");
  const booksEl = root.querySelector("[data-books]");
  const emptyEl = root.querySelector("[data-empty]");
  const errorEl = root.querySelector("[data-error]");
  let userSafe = "";
  let busy = false;
  let books: ScribBookCard[] = [];

  function setError(msg: string) {
    if (!(errorEl instanceof HTMLElement)) return;
    errorEl.textContent = msg;
    setHidden(errorEl, !msg);
  }

  function onNameKeyDown(e: KeyboardEvent) {
    if (!(e.target instanceof HTMLInputElement)) return;
    if (e.key === "Enter") {
      e.preventDefault();
      e.target.blur();
    }
    if (e.key === "Escape") {
      e.preventDefault();
      void reload();
      e.target.blur();
    }
  }

  function renderBooks() {
    if (!(booksEl instanceof HTMLElement)) return;
    booksEl.replaceChildren();
    setHidden(emptyEl, books.length > 0);
    for (const book of books) {
      const section = document.createElement("section");
      section.className = "scrib-book";
      section.setAttribute("aria-label", book.name);

      const head = document.createElement("div");
      head.className = "scrib-book__head";
      const titleInput = document.createElement("input");
      titleInput.className = "scrib-book__title-input";
      titleInput.setAttribute("aria-label", "Nombre del libro");
      titleInput.value = book.name;
      titleInput.maxLength = 120;
      titleInput.disabled = busy;
      titleInput.addEventListener("blur", () => void commitBookName(book.id, book.name, titleInput.value));
      titleInput.addEventListener("keydown", onNameKeyDown);
      const delBook = document.createElement("button");
      delBook.type = "button";
      delBook.className = "btn scrib-book__delete";
      delBook.textContent = "Eliminar";
      delBook.disabled = busy;
      delBook.addEventListener("click", () => void onDeleteBook(book.id));
      head.append(titleInput, delBook);

      const sheets = document.createElement("div");
      sheets.className = "scrib-sheets";
      sheets.setAttribute("role", "list");
      for (const sheet of book.sheets ?? []) {
        const card = document.createElement("div");
        card.className = "scrib-sheet-card";
        card.setAttribute("role", "listitem");
        const body = document.createElement("div");
        body.className = "scrib-sheet-card__body";
        const nameInput = document.createElement("input");
        nameInput.className = "scrib-sheet-card__name-input";
        nameInput.setAttribute("aria-label", "Nombre de la hoja");
        nameInput.value = sheet.name;
        nameInput.maxLength = 120;
        nameInput.disabled = busy;
        nameInput.addEventListener("blur", () =>
          void commitSheetName(book.id, sheet.id, sheet.name, nameInput.value),
        );
        nameInput.addEventListener("keydown", onNameKeyDown);
        const meta = document.createElement("span");
        meta.className = "scrib-sheet-card__meta";
        meta.textContent = sheet.updatedAt ? new Date(sheet.updatedAt).toLocaleString() : "";
        body.append(nameInput, meta);
        if (userSafe) {
          const open = document.createElement("a");
          open.className = "scrib-sheet-card__open";
          open.href = scribSheetHref(userSafe, book.id, sheet.id);
          open.textContent = "Abrir";
          open.setAttribute("data-route", "");
          body.append(open);
        }
        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "scrib-sheet-card__remove";
        remove.setAttribute("aria-label", `Eliminar ${sheet.name}`);
        remove.textContent = "×";
        remove.disabled = busy;
        remove.addEventListener("click", () => void onDeleteSheet(book.id, sheet.id));
        card.append(body, remove);
        sheets.append(card);
      }
      const newSheet = document.createElement("button");
      newSheet.type = "button";
      newSheet.className = "scrib-sheet-card scrib-sheet-card--new";
      newSheet.textContent = "+ Nueva hoja";
      newSheet.disabled = busy || !userSafe;
      newSheet.addEventListener("click", () => void onNewSheet(book.id));
      sheets.append(newSheet);

      section.append(head, sheets);
      booksEl.append(section);
    }
  }

  async function reload() {
    const res = await fetchScribLibrary();
    if (res.error) {
      setError(res.error);
      books = [];
    } else {
      setError("");
      userSafe = res.userSafe;
      books = res.books;
    }
    renderBooks();
  }

  async function commitBookName(bookId: string, previous: string, nextRaw: string) {
    const next = nextRaw.trim();
    if (!next || next === previous || busy) {
      if (!next) await reload();
      return;
    }
    busy = true;
    const res = await renameScribBook(bookId, next);
    busy = false;
    if (res.error) {
      setError(res.error);
      await reload();
      return;
    }
    await reload();
  }

  async function commitSheetName(bookId: string, sheetId: string, previous: string, nextRaw: string) {
    const next = nextRaw.trim();
    if (!next || next === previous || busy) {
      if (!next) await reload();
      return;
    }
    busy = true;
    const res = await renameScribSheet(bookId, sheetId, next);
    busy = false;
    if (res.error) {
      setError(res.error);
      await reload();
      return;
    }
    await reload();
  }

  async function onNewSheet(bookId: string) {
    if (busy || !userSafe) return;
    busy = true;
    const res = await createScribSheet(bookId, "Hoja nueva");
    busy = false;
    if (res.error || !res.sheet) {
      apiFail(res.error || "Could not create sheet.", { requestId: res.requestId });
      return;
    }
    window.location.href = scribSheetHref(userSafe, bookId, res.sheet.id);
  }

  async function onDeleteBook(bookId: string) {
    if (busy || !window.confirm("¿Eliminar este libro y todas sus hojas?")) return;
    busy = true;
    const res = await deleteScribBook(bookId);
    busy = false;
    if (res.error) {
      apiFail(res.error, { requestId: res.requestId });
      return;
    }
    await reload();
  }

  async function onDeleteSheet(bookId: string, sheetId: string) {
    if (busy || !window.confirm("¿Eliminar esta hoja?")) return;
    busy = true;
    const res = await deleteScribSheet(bookId, sheetId);
    busy = false;
    if (res.error) {
      apiFail(res.error, { requestId: res.requestId });
      return;
    }
    await reload();
  }

  root.querySelector("[data-create-book]")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (busy) return;
    const form = e.target as HTMLFormElement;
    const name = new FormData(form).get("name");
    if (typeof name !== "string" || !name.trim()) return;
    busy = true;
    const res = await createScribBook(name.trim());
    busy = false;
    if (res.error) {
      apiFail(res.error, { requestId: res.requestId });
      return;
    }
    form.reset();
    await reload();
  });

  document.querySelector("[data-new-book]")?.addEventListener("click", () => {
    root.querySelector<HTMLInputElement>("#scrib-book-name")?.focus();
  });

  const gateResult = await requireService("scrib");
  if (!gateResult.sessionOk || !gateResult.access.allowed) {
    if (banner instanceof HTMLElement) banner.textContent = "Access required.";
    setHidden(gate, false);
    setHidden(authed, true);
  } else {
    if (banner instanceof HTMLElement) banner.textContent = "";
    setHidden(gate, true);
    setHidden(authed, false);
    await reload();
    if (mustLog) console.log("[scrib] hub ready", { books: books.length });
  }
</script>
