---
import Layout from "../layouts/Layout.astro";
import { aboutPageSchema, graph, personSchema, websiteSchema } from "../lib/seo";

const description =
  "About Eduardo Osteicoechea: licensed Building Architect (ULA), BIM practitioner, and full-stack AEC AI technologist behind eduardoos.com.";
---

<Layout
  title="Eduardo Osteicoechea"
  description={description}
  jsonLd={graph(websiteSchema(), personSchema(), aboutPageSchema())}
>
  <div class="page">
    <header class="hero">
      <p class="eyebrow">About</p>
      <h1 class="hero__title">Eduardo Osteicoechea</h1>
      <p class="hero__lede">
        Eduardoos is the public home for product work, technical writing, and
        services. The person behind it is Eduardo Osteicoechea — licensed Building
        Architect (Universidad de Los Andes, Cum Laude) and full-stack
        desktop–web–cloud developer.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/contact" data-route>Contact</a>
        <a class="btn" href="/api-docs" data-route>API docs</a>
      </div>
    </header>

    <section class="section" aria-labelledby="credentials-heading">
      <div class="section__head">
        <h2 class="section__title" id="credentials-heading">Credentials and craft</h2>
        <p class="section__lede">
          Focused BIM training includes an Autodesk Authorized Training Center
          Course (2011) and a BIMMASTER.org course. That is professional training,
          not a Master's degree.
        </p>
      </div>
      <ul class="list-check">
        <li>
          <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
          <span>Building Architect, Universidad de Los Andes (Cum Laude).</span>
        </li>
        <li>
          <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
          <span>Autodesk Authorized Training Center Course (2011) and BIMMASTER.org.</span>
        </li>
        <li>
          <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
          <span>Revit/AutoCAD API tooling, AI integrations, and multiplatform AEC products.</span>
        </li>
      </ul>
    </section>

    <section class="section" aria-labelledby="platform-heading">
      <div class="split">
        <div class="section__head">
          <h2 class="section__title" id="platform-heading">How this site is built</h2>
          <p class="section__lede">
            The frontend is generated as static files; navigation happens in the
            browser. Live data is requested only from same-origin <code>/api/</code>.
            Secrets, database URIs, and provider keys stay on the server.
          </p>
        </div>
        <div class="card">
          <span class="card__icon"><span class="material-symbols-outlined" aria-hidden="true">terminal</span></span>
          <h3 class="card__title">For API clients</h3>
          <p class="card__desc">External clients can start with the public API catalog.</p>
          <a class="btn" href="/api-docs" data-route>API docs</a>
        </div>
      </div>
    </section>
  </div>
</Layout>
