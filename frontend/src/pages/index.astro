---
import Layout from "../layouts/Layout.astro";
import {
  PROFILE_EMAIL,
  PROFILE_GITHUB,
  PROFILE_LINKEDIN,
  PROFILE_WHATSAPP,
  PROFILE_WHATSAPP_DISPLAY,
  PROFILE_YOUTUBE,
  profileEducation,
  profileExperience,
  profileExpertiseAnswer,
  profileFaq,
  profileFocusAnswer,
  profileSkillCards,
  profileStack,
  profileWhoAnswer,
} from "../lib/eduardoProfile";
import {
  HOME_FAQS,
  faqSchema,
  graph,
  personSchema,
  websiteSchema,
} from "../lib/seo";

const description =
  "Eduardo Osteicoechea — licensed Building Architect and AEC AI technologist. BIM tools, full-stack platforms, and careful craft at eduardoos.com.";
---

<Layout description={description} jsonLd={graph(websiteSchema(), personSchema(), faqSchema(HOME_FAQS))}>
  <div class="page">
    <header class="hero">
      <p class="eyebrow">
        <span class="material-symbols-outlined" aria-hidden="true">architecture</span>
        Licensed Building Architect · AEC AI Technologist
      </p>
      <h1 class="hero__title" id="who">Architect. BIM engineer. Software builder.</h1>
      <p class="hero__lede">{profileWhoAnswer}</p>
      <div class="hero__actions">
        <a class="btn btn--primary btn--lg" href="/contact" data-route>
          <span class="material-symbols-outlined" aria-hidden="true">mail</span>
          Contact
        </a>
        <a class="btn btn--lg" href={PROFILE_LINKEDIN} rel="noopener noreferrer" target="_blank">LinkedIn</a>
        <a class="btn btn--lg" href="/api-docs" data-route>API docs</a>
      </div>
      <ul class="hero__meta">
        <li><span class="material-symbols-outlined" aria-hidden="true">school</span> Universidad de Los Andes</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">workspaces</span> BIM &amp; Revit API</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">memory</span> AI integrations</li>
      </ul>
    </header>

    <section class="section" aria-label="Professional profile">
      <div class="card-grid">
        <article class="card" id="expertise">
          <span class="card__icon"><span class="material-symbols-outlined" aria-hidden="true">architecture</span></span>
          <h2 class="card__title">Specialization</h2>
          <p class="card__desc">{profileExpertiseAnswer}</p>
        </article>
        <article class="card" id="focus">
          <span class="card__icon"><span class="material-symbols-outlined" aria-hidden="true">flag</span></span>
          <h2 class="card__title">Current focus</h2>
          <p class="card__desc">{profileFocusAnswer}</p>
        </article>
        <article class="card" id="education">
          <span class="card__icon"><span class="material-symbols-outlined" aria-hidden="true">school</span></span>
          <h2 class="card__title">Education and training</h2>
          <ul class="list-check">
            {profileEducation.map((item) => (
              <li>
                <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      </div>
    </section>

    <section class="section" aria-labelledby="experience-heading">
      <div class="section__head">
        <p class="eyebrow">Track record</p>
        <h2 class="section__title" id="experience-heading">Professional experience</h2>
      </div>
      <div class="card-grid">
        {profileExperience.map((job) => (
          <article class="card">
            <span class="card__icon"><span class="material-symbols-outlined" aria-hidden="true">{job.icon}</span></span>
            <h3 class="card__title">{job.org}</h3>
            <p class="card__desc"><strong>{job.role}</strong> · {job.period}</p>
            <p class="card__desc">{job.summary}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="skills-heading">
      <div class="section__head">
        <p class="eyebrow">Capabilities</p>
        <h2 class="section__title" id="skills-heading">Skills</h2>
      </div>
      <div class="card-grid">
        {profileSkillCards.map((skill) => (
          <article class="card">
            <span class="card__icon"><span class="material-symbols-outlined" aria-hidden="true">{skill.icon}</span></span>
            <h3 class="card__title">{skill.title}</h3>
            <p class="card__desc">{skill.description}</p>
          </article>
        ))}
      </div>
      <p class="section__lede">{profileStack}</p>
    </section>

    <section class="section" aria-labelledby="contacts-heading">
      <div class="split">
        <div class="section__head">
          <p class="eyebrow">Public contacts</p>
          <h2 class="section__title" id="contacts-heading">Reach me directly</h2>
          <p class="section__lede">
            Email is the best first step for project inquiries. Everything else is public.
          </p>
          <div class="hero__actions">
            <a class="btn btn--primary" href={`mailto:${PROFILE_EMAIL}`}>
              <span class="material-symbols-outlined" aria-hidden="true">mail</span>
              {PROFILE_EMAIL}
            </a>
          </div>
        </div>
        <div class="card">
          <span class="card__icon"><span class="material-symbols-outlined" aria-hidden="true">link</span></span>
          <h3 class="card__title">Elsewhere</h3>
          <ul class="site-footer__list">
            <li><a href={PROFILE_WHATSAPP} rel="noopener noreferrer" target="_blank">WhatsApp {PROFILE_WHATSAPP_DISPLAY}</a></li>
            <li><a href={PROFILE_LINKEDIN} rel="noopener noreferrer" target="_blank">LinkedIn</a></li>
            <li><a href={PROFILE_GITHUB} rel="noopener noreferrer" target="_blank">GitHub</a></li>
            <li><a href={PROFILE_YOUTUBE} rel="noopener noreferrer" target="_blank">YouTube</a></li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="faq-heading">
      <div class="section__head">
        <p class="eyebrow">FAQ</p>
        <h2 class="section__title" id="faq-heading">Questions</h2>
      </div>
      <div class="faq">
        {profileFaq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
        {HOME_FAQS.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>
