---
import Layout from "../layouts/Layout.astro";
import {
  PROFILE_EMAIL,
  PROFILE_GITHUB,
  PROFILE_LINKEDIN,
  PROFILE_WHATSAPP,
  PROFILE_WHATSAPP_DISPLAY,
  PROFILE_YOUTUBE,
  profileEducation,
  profileExperience,
  profileExpertiseAnswer,
  profileFaq,
  profileFocusAnswer,
  profileSkillCards,
  profileStack,
  profileWhoAnswer,
} from "../lib/eduardoProfile";
import {
  HOME_FAQS,
  faqSchema,
  graph,
  personSchema,
  websiteSchema,
} from "../lib/seo";

const description =
  "Eduardo Osteicoechea — licensed Building Architect and AEC AI technologist. BIM tools, full-stack platforms, and careful craft at eduardoos.com.";
---

<Layout description={description} jsonLd={graph(websiteSchema(), personSchema(), faqSchema(HOME_FAQS))}>
  <h1 id="who">Architect. BIM engineer. Software builder.</h1>
  <p class="lede">
    {profileWhoAnswer}
  </p>
  <p class="lede">
    Reach me via <a href="/contact" data-route>Contact</a>,
    <a href={PROFILE_LINKEDIN} rel="noopener noreferrer" target="_blank">LinkedIn</a>,
    or review the <a href="/api-docs" data-route>API docs</a>.
  </p>

  <section class="home-profile" aria-label="Professional profile">
    <section class="home-profile__block" id="expertise">
      <div class="home-profile__heading">
        <span class="material-symbols-outlined" aria-hidden="true">architecture</span>
        <h2>Specialization</h2>
      </div>
      <p class="lede">{profileExpertiseAnswer}</p>
    </section>

    <section class="home-profile__block" id="focus">
      <div class="home-profile__heading">
        <span class="material-symbols-outlined" aria-hidden="true">flag</span>
        <h2>Current focus</h2>
      </div>
      <p class="lede">{profileFocusAnswer}</p>
    </section>

    <section class="home-profile__block" id="education">
      <div class="home-profile__heading">
        <span class="material-symbols-outlined" aria-hidden="true">school</span>
        <h2>Education and training</h2>
      </div>
      <ul class="home-profile__list">
        {profileEducation.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="home-profile__block" id="experience">
      <div class="home-profile__heading">
        <span class="material-symbols-outlined" aria-hidden="true">work</span>
        <h2>Professional experience</h2>
      </div>
      <div class="home-profile__grid">
        {profileExperience.map((job) => (
          <article class="home-profile__block">
            <div class="home-profile__heading">
              <span class="material-symbols-outlined" aria-hidden="true">{job.icon}</span>
              <h2>{job.org}</h2>
            </div>
            <p class="hint">{job.role} · {job.period}</p>
            <p class="lede">{job.summary}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="home-profile__block" id="skills">
      <div class="home-profile__heading">
        <span class="material-symbols-outlined" aria-hidden="true">handyman</span>
        <h2>Skills</h2>
      </div>
      <div class="home-profile__skills">
        {profileSkillCards.map((skill) => (
          <article class="product-dash__card">
            <span class="material-symbols-outlined" aria-hidden="true">{skill.icon}</span>
            <span class="product-dash__card-title">{skill.title}</span>
            <span class="product-dash__card-desc">{skill.description}</span>
          </article>
        ))}
      </div>
      <p class="lede">{profileStack}</p>
    </section>

    <section class="home-profile__block" id="contact-links">
      <div class="home-profile__heading">
        <span class="material-symbols-outlined" aria-hidden="true">mail</span>
        <h2>Public contacts</h2>
      </div>
      <ul class="home-profile__list">
        <li><a href={`mailto:${PROFILE_EMAIL}`}>{PROFILE_EMAIL}</a></li>
        <li><a href={PROFILE_WHATSAPP} rel="noopener noreferrer" target="_blank">WhatsApp {PROFILE_WHATSAPP_DISPLAY}</a></li>
        <li><a href={PROFILE_LINKEDIN} rel="noopener noreferrer" target="_blank">LinkedIn</a></li>
        <li><a href={PROFILE_GITHUB} rel="noopener noreferrer" target="_blank">GitHub</a></li>
        <li><a href={PROFILE_YOUTUBE} rel="noopener noreferrer" target="_blank">YouTube</a></li>
      </ul>
    </section>
  </section>

  <section class="seo-section" id="faq" aria-labelledby="faq-heading">
    <h2 id="faq-heading">FAQ</h2>
    <div class="faq">
      {profileFaq.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
      {HOME_FAQS.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="system-status panel" aria-live="polite">
    <p id="api-status" class="status">Checking API…</p>
  </section>
</Layout>

<script>
  import { getHealth } from "../lib/api";

  const status = document.getElementById("api-status");

  try {
    const health = await getHealth();
    if (status) {
      status.classList.add("ok");
      status.textContent = `API ${health.status}`;
    }
  } catch {
    if (status) {
      status.classList.add("err");
      const origin = `${window.location.protocol}//${window.location.host}`;
      status.textContent = window.location.protocol === "http:"
        ? `API unavailable on ${origin}. Open https://127.0.0.1:${window.location.port || "4321"}/ instead (production proxy needs HTTPS).`
        : "API unavailable. Stop any old dev server on this port, run npm run dev again, or use npm run dev:local with the Go API running.";
    }
  }
</script>
