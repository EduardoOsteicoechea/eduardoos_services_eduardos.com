---
import Layout from "../layouts/Layout.astro";
import {
  HOME_HEADING,
  homeServiceOffers,
  homeServicesFocus,
  profileEducation,
  profileExperience,
  profileExpertiseAnswer,
  profileFocusAnswer,
  profileSkillCards,
  profileStack,
  profileWhoAnswer,
  profileWhoLead2,
  PROFILE_GITHUB,
  PROFILE_LINKEDIN,
} from "../lib/eduardoProfile";
import { caseStudies } from "../lib/caseStudies";
import {
  faqSchema,
  graph,
  HOME_FAQS,
  personSchema,
  websiteSchema,
} from "../lib/seo";

const description =
  "Senior BIM Software Developer - Revit & AutoCAD APIs, C#/.NET, APS/ACC, ASP.NET Core on AWS. Architect (Cum Laude). Remote.";
const featured = caseStudies.slice(0, 6);
---

<Layout
  title={HOME_HEADING}
  description={description}
  jsonLd={graph(websiteSchema(), personSchema(), faqSchema(HOME_FAQS))}
  page="home"
  pageTitleId="who"
>
  <div class="page">
    <header class="hero">
      <p class="eyebrow">
        <span class="material-symbols-outlined" aria-hidden="true">architecture</span>
        Licensed Building Architect · Revit · AutoCAD · APS · C#/.NET
      </p>
      <p class="hero__lede">{profileWhoAnswer}</p>
      <p class="hero__lede">{profileWhoLead2}</p>
      <ul class="hero__meta">
        <li><span class="material-symbols-outlined" aria-hidden="true">public</span> Remote</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">translate</span> English fluent · Spanish native</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">workspaces</span> 4+ years BIM software</li>
      </ul>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/cv" data-route>Download CV</a>
        <a class="btn btn--primary" href="/portfolio" data-route>Case studies</a>
        <a class="btn" href="/contact" data-route>Contact</a>
      </div>
    </header>

    <section class="section" aria-labelledby="skills-heading">
      <div class="section__head">
        <p class="eyebrow">Capabilities</p>
        <h2 class="section__title" id="skills-heading">Skills matrix</h2>
      </div>
      <div class="card-grid">
        {profileSkillCards.map((skill) => (
          <article class="card">
            <span class="card__icon"><span class="material-symbols-outlined" aria-hidden="true">{skill.icon}</span></span>
            <h3 class="card__title">{skill.title}</h3>
            <p class="card__desc">{skill.description}</p>
          </article>
        ))}
      </div>
      <p class="section__lede">{profileStack}</p>
    </section>

    <section class="section section--evidence" aria-labelledby="cases-heading">
      <div class="section__head">
        <p class="eyebrow">Evidence</p>
        <h2 class="section__title" id="cases-heading">Featured case studies</h2>
      </div>
      <div class="product-dash__grid">
        {featured.map((c) => (
          <a class="product-dash__card" href={`/portfolio/${c.slug}`} data-route>
            <div class="product-dash__card-head">
              <span class="material-symbols-outlined" aria-hidden="true">{c.icon}</span>
              <h3 class="product-dash__card-title">{c.title}</h3>
            </div>
            <p class="product-dash__card-desc">{c.summary}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="tools-heading">
      <div class="section__head">
        <p class="eyebrow">Public tools</p>
        <h2 class="section__title" id="tools-heading">eReport · eoProject · eApi</h2>
      </div>
      <p class="section__lede">{homeServicesFocus}</p>
      <div class="product-dash__grid">
        {homeServiceOffers.map((service) => (
          <a class="product-dash__card" href={service.href} data-route>
            <div class="product-dash__card-head">
              <span class="material-symbols-outlined" aria-hidden="true">{service.icon}</span>
              <h3 class="product-dash__card-title">{service.label}</h3>
            </div>
            <p class="product-dash__card-desc">{service.description}</p>
          </a>
        ))}
      </div>
      <p>
        <a class="btn btn--primary" href="/payments/subscription" data-route>Subscribe</a>
      </p>
    </section>

    <section class="section" id="profile" aria-labelledby="focus-heading">
      <div class="section__head">
        <p class="eyebrow">Profile</p>
        <h2 class="section__title" id="focus-heading">Specialization &amp; focus</h2>
      </div>
      <div class="card-grid home-profile__pair">
        <article class="card" id="expertise">
          <span class="card__icon"><span class="material-symbols-outlined" aria-hidden="true">architecture</span></span>
          <h3 class="card__title">Specialization</h3>
          <p class="card__desc">{profileExpertiseAnswer}</p>
        </article>
        <article class="card" id="focus">
          <span class="card__icon"><span class="material-symbols-outlined" aria-hidden="true">flag</span></span>
          <h3 class="card__title">Current focus</h3>
          <p class="card__desc">{profileFocusAnswer}</p>
        </article>
      </div>
    </section>

    <section class="section" aria-labelledby="experience-heading">
      <div class="section__head">
        <p class="eyebrow">Track record</p>
        <h2 class="section__title" id="experience-heading">Professional experience</h2>
      </div>
      <div class="card-grid">
        {profileExperience.map((job) => (
          <article class="card">
            <span class="card__icon"><span class="material-symbols-outlined" aria-hidden="true">{job.icon}</span></span>
            <h3 class="card__title">{job.org}</h3>
            <p class="card__desc"><strong>{job.role}</strong> · {job.period}</p>
            <p class="card__desc">{job.summary}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="education" aria-labelledby="studies-heading">
      <div class="section__head">
        <p class="eyebrow">Studies</p>
        <h2 class="section__title" id="studies-heading">Education and training</h2>
      </div>
      <div class="card-grid home-profile__education">
        {profileEducation.map((item) => (
          <article class="card">
            <span class="card__icon"><span class="material-symbols-outlined" aria-hidden="true">{item.icon}</span></span>
            <h3 class="card__title">{item.title}</h3>
            <p class="card__desc">{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="faq" aria-labelledby="faq-heading">
      <div class="section__head">
        <p class="eyebrow">FAQ</p>
        <h2 class="section__title" id="faq-heading">Common questions</h2>
      </div>
      <div class="card-grid">
        {HOME_FAQS.map((item) => (
          <article class="card">
            <h3 class="card__title">{item.question}</h3>
            <p class="card__desc">{item.answer}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="contact-heading">
      <div class="section__head">
        <h2 class="section__title" id="contact-heading">Contact</h2>
      </div>
      <p class="section__lede">
        Fluent English, native Spanish. LinkedIn, email, and WhatsApp on the contact page.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/contact" data-route>Contact</a>
        <a class="btn" href={PROFILE_LINKEDIN}>LinkedIn</a>
        <a class="btn" href={PROFILE_GITHUB}>GitHub</a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--rail-gap);
    margin-top: var(--space-padding);
  }

  .section--evidence {
    background: #000000;
    margin-inline: calc(-1 * var(--main-inline));
    padding-inline: var(--main-inline);
  }

  :global(html[data-theme="light"]) .section--evidence {
    background: #ffffff;
  }

  :global(html[data-theme="dark"]) .section--evidence {
    background: #000000;
  }
</style>
