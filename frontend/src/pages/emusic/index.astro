---
import Layout from "../../layouts/Layout.astro";

const cards = [
  {
    href: "/emusic/listen",
    title: "Escucha",
    desc: "Cola, reproducción y letras sincronizadas.",
    icon: "headphones",
    adminOnly: false,
  },
  {
    href: "/emusic/lyrics",
    title: "Letras",
    desc: "Pegar texto, marcar tiempos y guardar .emusic.",
    icon: "lyrics",
    adminOnly: true,
  },
  {
    href: "/emusic/upload",
    title: "Subir",
    desc: "Cargar un archivo .emusic v4 a una pista.",
    icon: "upload_file",
    adminOnly: true,
  },
  {
    href: "/emusic/playlists",
    title: "Playlist",
    desc: "Crear y editar playlists de la biblioteca.",
    icon: "queue_music",
    adminOnly: true,
  },
];
---

<Layout
  title="eMusic"
  description="Dashboard eMusic: escucha, letras sincronizadas, importación y playlists."
  page="emusic-hub"
  robots="noindex,nofollow"
>
  <Fragment slot="dhs">
    <a
      class="dhs-action"
      href="/payments/subscription"
      data-route
      title="Subscribe"
      aria-label="Subscribe"
    >
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">payments</span>
      </span>
      Subscribe
    </a>
  </Fragment>

  <section class="emusic product-dash page-span-all" data-emusic-hub>
    <p class="status" data-banner>Loading…</p>

    <div data-gate hidden class="product-gate">
      <p class="hint">eMusic subscription required.</p>
      <p class="hint">
        <a href="/payments/subscription" data-route>Subscribe</a>
        ·
        <a href="/session" data-route>Sign in</a>
      </p>
    </div>

    <div class="product-dash__grid" data-authed hidden>
      {
        cards.map((card) => (
          <a
            class="product-dash__card"
            href={card.href}
            data-route
            data-emusic-card={card.adminOnly ? "admin" : "all"}
            hidden={card.adminOnly}
          >
            <span class="product-dash__card-head">
              <span class="material-symbols-outlined" aria-hidden="true">{card.icon}</span>
              <span class="product-dash__card-title">{card.title}</span>
            </span>
            <span class="product-dash__card-desc">{card.desc}</span>
          </a>
        ))
      }
    </div>
  </section>
</Layout>

<script>
  import { mustLog } from "../../lib/dev-log";
  import { isPlatformAdmin, refreshAuthSession } from "../../lib/auth";
  import { onAstroPageLoad, requireService, setHidden } from "../../lib/productGate";

  onAstroPageLoad("emusic-hub", async () => {
    const root = document.querySelector("[data-emusic-hub]");
    const banner = root?.querySelector("[data-banner]");
    const gate = root?.querySelector("[data-gate]");
    const authed = root?.querySelector("[data-authed]");
    const adminCards = root?.querySelectorAll("[data-emusic-card='admin']");

    if (banner instanceof HTMLElement) {
      banner.hidden = false;
      banner.textContent = "Loading…";
    }

    await refreshAuthSession();
    const gateResult = await requireService("emusic");
    if (!gateResult.sessionOk || !gateResult.access.allowed) {
      if (banner instanceof HTMLElement) {
        banner.hidden = false;
        banner.textContent = gateResult.sessionOk ? "Subscription required." : "Sign in required.";
      }
      setHidden(gate, false);
      setHidden(authed, true);
      return;
    }

    const admin = isPlatformAdmin();
    adminCards?.forEach((card) => {
      if (card instanceof HTMLElement) card.hidden = !admin;
    });

    setHidden(gate, true);
    setHidden(authed, false);
    if (banner instanceof HTMLElement) banner.hidden = true;
    if (mustLog) console.log("[emusic] hub", { admin });
  });
</script>

<style>
  a.product-dash__card {
    text-decoration: none;
    color: inherit;
  }
</style>
