---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="eMusic"
  description="Curated music library with section playlists."
  page="emusic"
  robots="noindex,nofollow"
>
  <Fragment slot="dhs">
    <a
      class="dhs-action"
      href="/payments/subscription"
      data-route
      title="Subscribe"
      aria-label="Subscribe"
    >
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">payments</span>
      </span>
      Subscribe
    </a>
  </Fragment>

  <section class="emusic product-dash" data-emusic-hub>
    <p class="status" data-banner>Loading…</p>

    <div data-gate hidden class="product-gate">
      <p class="hint">eMusic subscription required.</p>
      <p class="hint">
        <a href="/payments/subscription" data-route>Subscribe</a>
        ·
        <a href="/session" data-route>Sign in</a>
      </p>
    </div>

    <div data-authed hidden>
      <div class="emusic__player">
        <p class="emusic__now-playing" data-now-playing>Select a track</p>
        <audio class="emusic__audio" data-audio controls preload="none"></audio>
      </div>
      <div data-sections></div>
    </div>
  </section>
</Layout>

<script>
  import { EMUSIC_SECTIONS, type EmusicTrack } from "../../lib/emusic";
  import { mustLog } from "../../lib/dev-log";
  import { onAstroPageLoad, requireService, setHidden } from "../../lib/productGate";

  let root: Element | null = null;
  let banner: Element | null = null;
  let gate: Element | null = null;
  let authed: Element | null = null;
  let sectionsEl: Element | null = null;
  let audioEl: HTMLAudioElement | null = null;
  let nowPlayingEl: Element | null = null;
  let activeTrackId = "";

  function setBanner(text: string): void {
    if (banner instanceof HTMLElement) {
      banner.hidden = false;
      banner.textContent = text;
    }
  }

  function playTrack(track: EmusicTrack): void {
    if (!audioEl) return;
    activeTrackId = track.id;
    audioEl.src = track.src;
    void audioEl.play().catch(() => {
      /* autoplay may be blocked; controls remain usable */
    });
    if (nowPlayingEl instanceof HTMLElement) {
      nowPlayingEl.textContent = track.title;
    }
    markActive();
    if (mustLog) console.log("[emusic] play", { id: track.id, src: track.src });
  }

  function markActive(): void {
    if (!sectionsEl) return;
    sectionsEl.querySelectorAll<HTMLButtonElement>("[data-track-id]").forEach((btn) => {
      const id = btn.getAttribute("data-track-id") || "";
      btn.classList.toggle("emusic__track--active", id === activeTrackId);
    });
  }

  function renderSections(): void {
    if (!(sectionsEl instanceof HTMLElement)) return;
    sectionsEl.replaceChildren();
    for (const section of EMUSIC_SECTIONS) {
      const sectionEl = document.createElement("section");
      sectionEl.className = "emusic__section";
      sectionEl.setAttribute("aria-labelledby", `emusic-section-${section.id}`);

      const heading = document.createElement("h2");
      heading.className = "product-dash__section-title";
      heading.id = `emusic-section-${section.id}`;
      heading.textContent = section.title;
      sectionEl.appendChild(heading);

      const list = document.createElement("ul");
      list.className = "emusic__track-list";
      for (const track of section.tracks) {
        const li = document.createElement("li");
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "emusic__track";
        btn.setAttribute("data-track-id", track.id);
        btn.setAttribute("aria-label", `Play ${track.title}`);
        const icon = document.createElement("span");
        icon.className = "material-symbols-outlined emusic__track-icon";
        icon.setAttribute("aria-hidden", "true");
        icon.textContent = "play_arrow";
        const titleEl = document.createElement("span");
        titleEl.className = "emusic__track-title";
        titleEl.textContent = track.title;
        btn.append(icon, titleEl);
        btn.addEventListener("click", () => playTrack(track));
        li.appendChild(btn);
        list.appendChild(li);
      }
      sectionEl.appendChild(list);
      sectionsEl.appendChild(sectionEl);
    }
    markActive();
  }

  onAstroPageLoad("emusic", async () => {
    root = document.querySelector("[data-emusic-hub]");
    banner = root?.querySelector("[data-banner]") ?? null;
    gate = root?.querySelector("[data-gate]") ?? null;
    authed = root?.querySelector("[data-authed]") ?? null;
    sectionsEl = root?.querySelector("[data-sections]") ?? null;
    audioEl = root?.querySelector("[data-audio]") ?? null;
    nowPlayingEl = root?.querySelector("[data-now-playing]") ?? null;

    if (banner instanceof HTMLElement) {
      banner.hidden = false;
      banner.textContent = "Loading…";
    }

    const gateResult = await requireService("emusic");
    if (!gateResult.sessionOk || !gateResult.access.allowed) {
      setBanner(gateResult.sessionOk ? "Subscription required." : "Sign in required.");
      setHidden(gate, false);
      setHidden(authed, true);
      return;
    }

    setHidden(gate, true);
    setHidden(authed, false);
    if (banner instanceof HTMLElement) banner.hidden = true;
    renderSections();
  });
</script>
