---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Articles"
  description="Public reading copies of selected Eduardoos pamphlets, organized by series."
  robots="index,follow"
>
  <header class="seo-only">
    <p class="eyebrow">
      <span class="material-symbols-outlined" aria-hidden="true">article</span>
      Writing
    </p>
    <p class="lede">
      Selected pamphlets published for public reading, grouped by series. Each
      piece is a reading copy of work originally written in the pamphlet editor.
    </p>
  </header>

  <section class="articles-page product-dash" data-articles aria-labelledby="page-title">
    <p class="status" data-articles-status>Loading articles…</p>
    <div class="articles-page__tree" data-articles-list></div>
  </section>
</Layout>

<style is:global>
  /* Keep copy in the document for crawlers; hide from the visual layout. */
  .seo-only {
    position: absolute;
    width: 0.0625rem;
    height: 0.0625rem;
    padding: 0;
    margin: -0.0625rem;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .articles-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-padding);
    grid-column: 1 / span var(--span-full);
    max-width: none;
    margin-inline: 0;
    width: auto;
    min-width: 0;
    justify-self: start;
  }

  .articles-page__tree {
    display: flex;
    flex-direction: column;
    gap: calc(var(--space-padding) * 2);
  }

  .articles-recent,
  .articles-series {
    display: flex;
    flex-direction: column;
    gap: var(--space-padding);
    margin: 0;
    padding: var(--space-padding);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius);
    background: var(--color-surface);
  }

  .articles-recent__title,
  .articles-series > summary {
    display: flex;
    align-items: center;
    gap: var(--rail-gap);
    margin: 0;
    padding: 0;
    font-size: var(--font-size-md);
    font-weight: 650;
    color: var(--color-text);
    border: 0;
  }

  .articles-series > summary {
    cursor: pointer;
    list-style: none;
  }

  .articles-series > summary::-webkit-details-marker {
    display: none;
  }

  .articles-series__count {
    margin-left: auto;
    font-size: var(--font-size-xs);
    color: var(--color-muted);
  }

  .articles-page__empty {
    margin: 0;
    padding: var(--space-padding);
    color: var(--color-muted);
    font-size: var(--font-size-sm);
    background: var(--surface-sunken, var(--color-surface));
    border: var(--border-width) dashed var(--color-border);
    border-radius: var(--border-radius);
  }
</style>

<script>
  import { apiRequest } from "../lib/api";
  import { showErrorModal } from "../lib/error-modal";
  import { mustLog } from "../lib/dev-log";

  const UNASSIGNED_SERIES = "Sin serie";
  const UNASSIGNED_CHAPTER = "Sin capítulo";
  const RECENT_LIMIT = 8;

  type ArticleRow = {
    epamId: string;
    title?: string;
    author?: string;
    date?: string;
    series?: string;
    seriesChapter?: string;
    updatedAt?: string;
  };

  type SeriesCatalogNode = {
    name: string;
    chapters?: Array<{ name: string }>;
  };

  type SeriesTree = {
    count: number;
    series: Array<{ name: string; count: number; items: ArticleRow[] }>;
  };

  function articleSortKey(rec: ArticleRow): string {
    return (rec.updatedAt || rec.date || "").trim();
  }

  /** Chapter label order: numeric ("1","2") then alpha; empty/unassigned last. */
  function chapterSortKey(raw: string): string {
    const name = raw.trim() || UNASSIGNED_CHAPTER;
    if (name === UNASSIGNED_CHAPTER) return "\uffff";
    const n = Number(name);
    if (Number.isFinite(n) && String(n) === name) {
      return `0:${String(n).padStart(8, "0")}`;
    }
    return `1:${name.toLowerCase()}`;
  }

  function compareArticlesInSeries(a: ArticleRow, b: ArticleRow): number {
    const ca = chapterSortKey(a.seriesChapter || "");
    const cb = chapterSortKey(b.seriesChapter || "");
    if (ca !== cb) return ca.localeCompare(cb);
    return (a.title || "").localeCompare(b.title || "") || a.epamId.localeCompare(b.epamId);
  }

  function recentArticles(records: ArticleRow[]): ArticleRow[] {
    return [...records]
      .sort((a, b) => {
        const kb = articleSortKey(b);
        const ka = articleSortKey(a);
        if (kb !== ka) return kb.localeCompare(ka);
        return (a.title || "").localeCompare(b.title || "") || a.epamId.localeCompare(b.epamId);
      })
      .slice(0, RECENT_LIMIT);
  }

  function groupBySeries(records: ArticleRow[], catalog: SeriesCatalogNode[] = []): SeriesTree {
    type SeriesBucket = { displayName: string; items: ArticleRow[] };
    const seriesMap = new Map<string, SeriesBucket>();

    const ensureSeries = (raw: string): SeriesBucket => {
      const displayName = raw.trim() || UNASSIGNED_SERIES;
      const key = displayName.toLowerCase();
      let entry = seriesMap.get(key);
      if (!entry) {
        entry = { displayName, items: [] };
        seriesMap.set(key, entry);
      }
      return entry;
    };

    // Prefer catalog display names when an article's series matches a catalog entry.
    const catalogNames = new Map<string, string>();
    for (const node of catalog) {
      const name = (node.name ?? "").trim();
      if (!name) continue;
      catalogNames.set(name.toLowerCase(), name);
      ensureSeries(name);
    }

    for (const rec of records) {
      const raw = (rec.series ?? "").trim() || UNASSIGNED_SERIES;
      const key = raw.toLowerCase();
      const displayName = catalogNames.get(key) || raw;
      ensureSeries(displayName).items.push(rec);
    }

    const seriesKeys = [...seriesMap.keys()].sort((a, b) =>
      seriesMap.get(a)!.displayName.localeCompare(seriesMap.get(b)!.displayName),
    );
    const series: SeriesTree["series"] = [];
    let count = 0;
    for (const sKey of seriesKeys) {
      const bucket = seriesMap.get(sKey)!;
      bucket.items.sort(compareArticlesInSeries);
      count += bucket.items.length;
      series.push({ name: bucket.displayName, count: bucket.items.length, items: bucket.items });
    }
    return { count, series };
  }

  function appendArticleCard(cards: HTMLElement, article: ArticleRow): void {
    const li = document.createElement("li");
    const link = document.createElement("a");
    link.className = "product-dash__card";
    link.href = `/articles/read?id=${encodeURIComponent(article.epamId)}`;
    link.setAttribute("data-route", "");
    const head = document.createElement("span");
    head.className = "product-dash__card-head";
    const icon = document.createElement("span");
    icon.className = "material-symbols-outlined";
    icon.setAttribute("aria-hidden", "true");
    icon.textContent = "article";
    const title = document.createElement("span");
    title.className = "product-dash__card-title";
    title.textContent = article.title || "Untitled";
    head.append(icon, title);
    link.appendChild(head);
    const meta = [article.author, article.date].filter(Boolean).join(" · ");
    if (meta) {
      const detail = document.createElement("span");
      detail.className = "product-dash__card-desc";
      detail.textContent = meta;
      link.appendChild(detail);
    }
    li.appendChild(link);
    cards.appendChild(li);
  }

  function renderTree(list: HTMLElement, articles: ArticleRow[], tree: SeriesTree) {
    list.replaceChildren();

    const recent = recentArticles(articles);
    if (recent.length) {
      const recentBlock = document.createElement("section");
      recentBlock.className = "articles-recent";
      const recentTitle = document.createElement("h2");
      recentTitle.className = "articles-recent__title";
      recentTitle.textContent = "Recientes";
      recentBlock.appendChild(recentTitle);
      const cards = document.createElement("ul");
      cards.className = "product-dash__grid";
      for (const article of recent) appendArticleCard(cards, article);
      recentBlock.appendChild(cards);
      list.appendChild(recentBlock);
    }

    for (const seriesNode of tree.series) {
      const seriesEl = document.createElement("details");
      seriesEl.className = "articles-series";
      // Open series that have articles so cards are visible without an extra chapter click.
      seriesEl.open = seriesNode.count > 0;

      const seriesSummary = document.createElement("summary");
      const seriesName = document.createElement("span");
      seriesName.textContent = seriesNode.name;
      const seriesCount = document.createElement("span");
      seriesCount.className = "articles-series__count";
      seriesCount.textContent = `${seriesNode.count}`;
      seriesSummary.append(seriesName, seriesCount);
      seriesEl.appendChild(seriesSummary);

      if (seriesNode.items.length) {
        const cards = document.createElement("ul");
        cards.className = "product-dash__grid";
        for (const article of seriesNode.items) appendArticleCard(cards, article);
        seriesEl.appendChild(cards);
      } else {
        const empty = document.createElement("p");
        empty.className = "articles-page__empty";
        empty.textContent = "No articles in this series yet.";
        seriesEl.appendChild(empty);
      }
      list.appendChild(seriesEl);
    }
  }

  async function loadArticles() {
    const status = document.querySelector("[data-articles-status]");
    const list = document.querySelector("[data-articles-list]");
    if (!(status instanceof HTMLElement) || !(list instanceof HTMLElement)) return;
    status.hidden = false;
    status.textContent = "Loading articles…";
    list.replaceChildren();
    const { status: responseStatus, data, requestId } = await apiRequest<{
      articles?: ArticleRow[];
      series?: SeriesCatalogNode[];
    }>("/articles");
    if (mustLog) console.log("[articles] list", { responseStatus, requestId });
    if (responseStatus >= 400) {
      status.textContent = data.message || "Could not load articles.";
      showErrorModal({
        message: data.message || "Could not load articles.",
        requestId,
        details: requestId ? `request_id=${requestId}` : "",
      });
      return;
    }
    const articles = data.articles ?? [];
    const catalog = data.series ?? [];
    const tree = groupBySeries(articles, catalog);
    renderTree(list, articles, tree);
    if (!tree.count && !tree.series.length) {
      status.hidden = false;
      status.textContent = "No public articles are available.";
      const empty = document.createElement("p");
      empty.className = "articles-page__empty";
      empty.textContent = "Articles will appear here when they are published for public reading.";
      list.appendChild(empty);
      return;
    }
    status.hidden = true;
  }

  document.addEventListener("astro:page-load", () => {
    void loadArticles();
  });
</script>
