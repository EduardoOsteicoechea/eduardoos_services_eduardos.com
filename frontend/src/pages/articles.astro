---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Articles"
  description="Public reading copies of selected Eduardoos pamphlets, organized by series and chapter."
  robots="index,follow"
>
  <header class="seo-only">
    <p class="eyebrow">
      <span class="material-symbols-outlined" aria-hidden="true">article</span>
      Writing
    </p>
    <h1 id="articles-title">Articles</h1>
    <p class="lede">
      Selected pamphlets published for public reading, grouped by series and
      chapter. Each piece is a reading copy of work originally written in the
      pamphlet editor.
    </p>
  </header>

  <section class="articles-page" data-articles aria-labelledby="articles-title">
    <p class="status" data-articles-status>Loading articles…</p>
    <div class="articles-page__tree" data-articles-list></div>
  </section>
</Layout>

<style is:global>
  /* Keep copy in the document for crawlers; hide from the visual layout. */
  .seo-only {
    position: absolute;
    width: 0.0625rem;
    height: 0.0625rem;
    padding: 0;
    margin: -0.0625rem;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* main already supplies --main-inline. */
  .articles-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-padding);
    grid-column: 1 / span var(--span-full);
    max-width: none;
    margin-inline: 0;
    width: auto;
    min-width: 0;
  }

  .articles-page__empty {
    margin: 0;
    padding: var(--space-padding);
    color: var(--color-muted);
    font-size: var(--font-size-sm);
    background: var(--surface-sunken);
    border: var(--border-width) dashed var(--eo-line-strong, var(--color-border));
    border-radius: var(--border-radius);
  }
</style>

<script>
  import { apiRequest } from "../lib/api";
  import { showErrorModal } from "../lib/error-modal";
  import { mustLog } from "../lib/dev-log";

  const UNASSIGNED_SERIES = "Sin serie";
  const UNASSIGNED_CHAPTER = "Sin capítulo";

  type ArticleRow = {
    epamId: string;
    title?: string;
    author?: string;
    date?: string;
    series?: string;
    seriesChapter?: string;
  };

  type SeriesTree = {
    count: number;
    series: Array<{ name: string; count: number; chapters: Array<{ name: string; items: ArticleRow[] }> }>;
  };

  function groupBySeries(records: ArticleRow[]): SeriesTree {
    const seriesMap = new Map<string, Map<string, ArticleRow[]>>();
    for (const rec of records) {
      const sk = (rec.series ?? "").trim() || UNASSIGNED_SERIES;
      const ck = (rec.seriesChapter ?? "").trim() || UNASSIGNED_CHAPTER;
      if (!seriesMap.has(sk)) seriesMap.set(sk, new Map());
      const chapters = seriesMap.get(sk)!;
      if (!chapters.has(ck)) chapters.set(ck, []);
      chapters.get(ck)!.push(rec);
    }
    const seriesNames = [...seriesMap.keys()].sort((a, b) => a.localeCompare(b));
    const series: SeriesTree["series"] = [];
    let count = 0;
    for (const sName of seriesNames) {
      const chaptersMap = seriesMap.get(sName)!;
      const chapterNames = [...chaptersMap.keys()].sort((a, b) => a.localeCompare(b));
      const chapters: SeriesTree["series"][number]["chapters"] = [];
      let seriesCount = 0;
      for (const cName of chapterNames) {
        const items = chaptersMap.get(cName)!;
        items.sort((a, b) => (a.title || "").localeCompare(b.title || "") || a.epamId.localeCompare(b.epamId));
        count += items.length;
        seriesCount += items.length;
        chapters.push({ name: cName, items });
      }
      series.push({ name: sName, count: seriesCount, chapters });
    }
    return { count, series };
  }

  function renderTree(list: HTMLElement, tree: SeriesTree) {
    list.replaceChildren();
    for (const seriesNode of tree.series) {
      const seriesEl = document.createElement("details");
      seriesEl.className = "articles-series";
      seriesEl.open = true;

      const seriesSummary = document.createElement("summary");
      const seriesName = document.createElement("span");
      seriesName.textContent = seriesNode.name;
      const seriesCount = document.createElement("span");
      seriesCount.className = "articles-series__count";
      seriesCount.textContent = `${seriesNode.count}`;
      seriesSummary.append(seriesName, seriesCount);
      seriesEl.appendChild(seriesSummary);

      for (const chapter of seriesNode.chapters) {
        const chapterEl = document.createElement("details");
        chapterEl.className = "articles-chapter";
        chapterEl.open = true;
        const chapterSummary = document.createElement("summary");
        const chapterName = document.createElement("span");
        chapterName.textContent = chapter.name;
        chapterSummary.appendChild(chapterName);
        chapterEl.appendChild(chapterSummary);

        const cards = document.createElement("ul");
        cards.className = "articles-cards";
        for (const article of chapter.items) {
          const li = document.createElement("li");
          const link = document.createElement("a");
          link.className = "articles-card";
          link.href = `/articles/read?id=${encodeURIComponent(article.epamId)}`;
          link.setAttribute("data-route", "");
          const title = document.createElement("strong");
          title.className = "articles-card__title";
          title.textContent = article.title || "Untitled";
          link.appendChild(title);
          const meta = [article.author, article.date].filter(Boolean).join(" · ");
          if (meta) {
            const detail = document.createElement("span");
            detail.className = "articles-card__meta";
            detail.textContent = meta;
            link.appendChild(detail);
          }
          li.appendChild(link);
          cards.appendChild(li);
        }
        chapterEl.appendChild(cards);
        seriesEl.appendChild(chapterEl);
      }
      list.appendChild(seriesEl);
    }
  }

  async function loadArticles() {
    const status = document.querySelector("[data-articles-status]");
    const list = document.querySelector("[data-articles-list]");
    if (!(status instanceof HTMLElement) || !(list instanceof HTMLElement)) return;
    status.hidden = false;
    status.textContent = "Loading articles…";
    list.replaceChildren();
    const { status: responseStatus, data, requestId } = await apiRequest<{
      articles?: ArticleRow[];
    }>("/articles");
    if (mustLog) console.log("[articles] list", { responseStatus, requestId });
    if (responseStatus >= 400) {
      status.textContent = data.message || "Could not load articles.";
      showErrorModal({
        message: data.message || "Could not load articles.",
        requestId,
        details: requestId ? `request_id=${requestId}` : "",
      });
      return;
    }
    const articles = data.articles ?? [];
    const tree = groupBySeries(articles);
    renderTree(list, tree);
    if (!tree.count) {
      status.hidden = false;
      status.textContent = "No public articles are available.";
      const empty = document.createElement("p");
      empty.className = "articles-page__empty";
      empty.textContent = "Articles will appear here when they are published for public reading.";
      list.appendChild(empty);
      return;
    }
    status.hidden = true;
  }

  document.addEventListener("astro:page-load", () => {
    void loadArticles();
  });
</script>
