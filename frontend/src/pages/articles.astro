---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Articles"
  description="Public reading copies of selected Eduardoos pamphlets, organized by series."
  robots="index,follow"
>
  <header class="seo-only">
    <p class="eyebrow">
      <span class="material-symbols-outlined" aria-hidden="true">article</span>
      Writing
    </p>
    <p class="lede">
      Selected pamphlets published for public reading, grouped by series. Each
      piece is a reading copy of work originally written in the pamphlet editor.
    </p>
  </header>

  <section class="articles-page product-dash" data-articles aria-labelledby="page-title">
    <p class="status" data-articles-status>Loading articles…</p>
    <div class="articles-page__tree" data-articles-list></div>
  </section>
</Layout>

<style is:global>
  /* Keep copy in the document for crawlers; hide from the visual layout. */
  .seo-only {
    position: absolute;
    width: 0.0625rem;
    height: 0.0625rem;
    padding: 0;
    margin: -0.0625rem;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* 0.75× density on Articles: chrome menu, title band, cards, gaps. */
  .shell:has(.articles-page) {
    --articles-scale: 0.75;
  }

  .shell:has(.articles-page) .app-header .header-menu.icon-btn {
    width: calc(var(--menu-button-size) * var(--articles-scale));
    height: calc(var(--menu-button-size) * var(--articles-scale));
  }

  .shell:has(.articles-page) .header-menu-svg {
    width: calc(var(--menu-button-size) * 0.55 * var(--articles-scale));
    height: calc(var(--menu-button-size) * 0.55 * var(--articles-scale));
  }

  .shell:has(.articles-page) > main > .page-title {
    min-height: calc(
      (var(--space-padding) + var(--menu-button-size) + var(--space-margin)) * var(--articles-scale)
    );
    padding-top: calc(
      ((var(--menu-button-size) * var(--articles-scale)) - (var(--font-size-xl) * var(--articles-scale) * 1.2)) / 2
    );
  }

  .shell:has(.articles-page) > main > .page-title h1 {
    font-size: calc(var(--font-size-xl) * var(--articles-scale));
  }

  .articles-page {
    --articles-space: calc(var(--space-padding) * var(--articles-scale, 0.75));
    --articles-gap: calc(var(--rail-gap) * var(--articles-scale, 0.75));
    --articles-font-md: calc(var(--font-size-md) * var(--articles-scale, 0.75));
    --articles-font-sm: calc(var(--font-size-sm) * var(--articles-scale, 0.75));
    --articles-font-xs: calc(var(--font-size-xs) * var(--articles-scale, 0.75));
    --articles-icon: calc(var(--icon-size) * var(--articles-scale, 0.75));
    display: flex;
    flex-direction: column;
    gap: var(--articles-space);
    grid-column: 1 / span var(--span-full);
    max-width: none;
    margin-inline: 0;
    width: auto;
    min-width: 0;
    justify-self: stretch;
  }

  .articles-page__tree {
    display: flex;
    flex-direction: column;
    gap: calc(var(--articles-space) * 1.5);
    min-width: 0;
  }

  .articles-recent,
  .articles-series {
    display: flex;
    flex-direction: column;
    gap: var(--articles-space);
    margin: 0;
    padding: var(--articles-space);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius);
    background: var(--color-surface);
    min-width: 0;
  }

  .articles-recent__title,
  .articles-series > summary,
  .articles-chapter > summary {
    display: flex;
    align-items: center;
    gap: var(--articles-gap);
    margin: 0;
    padding: 0;
    font-size: var(--articles-font-md);
    font-weight: 650;
    color: var(--color-text);
    border: 0;
  }

  .articles-series > summary,
  .articles-chapter > summary {
    cursor: pointer;
    list-style: none;
  }

  .articles-series > summary::-webkit-details-marker,
  .articles-chapter > summary::-webkit-details-marker {
    display: none;
  }

  .articles-chapter {
    display: flex;
    flex-direction: column;
    gap: var(--articles-space);
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .articles-chapter > summary {
    font-size: var(--articles-font-sm);
    font-weight: 600;
    color: var(--color-muted);
  }

  .articles-series__count,
  .articles-chapter__count {
    margin-left: auto;
    font-size: var(--articles-font-xs);
    color: var(--color-muted);
  }

  .articles-page .product-dash__grid {
    grid-template-columns: repeat(auto-fill, minmax(calc(11rem * var(--articles-scale, 0.75)), 1fr));
    gap: var(--articles-gap);
  }

  .articles-page .product-dash__card {
    padding: var(--articles-space);
    gap: var(--articles-gap);
  }

  .articles-page .product-dash__card-title {
    font-size: var(--articles-font-sm);
  }

  .articles-page .product-dash__card-desc {
    font-size: var(--articles-font-xs);
  }

  .articles-page .product-dash__card .material-symbols-outlined {
    font-size: var(--articles-icon);
    width: var(--articles-icon);
    height: var(--articles-icon);
  }

  .articles-page__empty {
    margin: 0;
    padding: var(--articles-space);
    color: var(--color-muted);
    font-size: var(--articles-font-sm);
    background: var(--surface-sunken, var(--color-surface));
    border: var(--border-width) dashed var(--color-border);
    border-radius: var(--border-radius);
  }
</style>

<script>
  import { apiRequest } from "../lib/api";
  import { showErrorModal } from "../lib/error-modal";
  import { mustLog } from "../lib/dev-log";

  const UNASSIGNED_SERIES = "Sin serie";
  const UNASSIGNED_CHAPTER = "Sin capítulo";
  const RECENT_LIMIT = 8;

  type ArticleRow = {
    epamId: string;
    title?: string;
    author?: string;
    date?: string;
    series?: string;
    seriesChapter?: string;
    updatedAt?: string;
  };

  type SeriesCatalogNode = {
    name: string;
    chapters?: Array<{ name: string }>;
  };

  type ChapterBucket = { name: string; count: number; items: ArticleRow[] };

  type SeriesTree = {
    count: number;
    series: Array<{ name: string; count: number; chapters: ChapterBucket[] }>;
  };

  function articleSortKey(rec: ArticleRow): string {
    return (rec.updatedAt || rec.date || "").trim();
  }

  /** Chapter label order: numeric ("1","2") then alpha; empty/unassigned last. */
  function chapterSortKey(raw: string): string {
    const name = raw.trim() || UNASSIGNED_CHAPTER;
    if (name === UNASSIGNED_CHAPTER) return "\uffff";
    const n = Number(name);
    if (Number.isFinite(n) && String(n) === name) {
      return `0:${String(n).padStart(8, "0")}`;
    }
    return `1:${name.toLowerCase()}`;
  }

  function chapterDisplayName(raw: string): string {
    const name = raw.trim() || UNASSIGNED_CHAPTER;
    if (name === UNASSIGNED_CHAPTER) return name;
    if (/^(capítulo|capitulo|chapter)\b/i.test(name)) return name;
    return `Capítulo ${name}`;
  }

  function compareArticlesInChapter(a: ArticleRow, b: ArticleRow): number {
    return (a.title || "").localeCompare(b.title || "") || a.epamId.localeCompare(b.epamId);
  }

  function recentArticles(records: ArticleRow[]): ArticleRow[] {
    return [...records]
      .sort((a, b) => {
        const kb = articleSortKey(b);
        const ka = articleSortKey(a);
        if (kb !== ka) return kb.localeCompare(ka);
        return (a.title || "").localeCompare(b.title || "") || a.epamId.localeCompare(b.epamId);
      })
      .slice(0, RECENT_LIMIT);
  }

  function groupChapters(
    items: ArticleRow[],
    catalogChapters: Array<{ name: string }> = [],
  ): ChapterBucket[] {
    type Bucket = { displayName: string; rawName: string; items: ArticleRow[] };
    const map = new Map<string, Bucket>();

    const ensure = (raw: string): Bucket => {
      const rawName = raw.trim() || UNASSIGNED_CHAPTER;
      const key = rawName.toLowerCase();
      let entry = map.get(key);
      if (!entry) {
        entry = { displayName: chapterDisplayName(rawName), rawName, items: [] };
        map.set(key, entry);
      }
      return entry;
    };

    for (const ch of catalogChapters) {
      const name = (ch.name ?? "").trim();
      if (name) ensure(name);
    }
    for (const rec of items) {
      ensure(rec.seriesChapter || "").items.push(rec);
    }

    return [...map.values()]
      .sort((a, b) => chapterSortKey(a.rawName).localeCompare(chapterSortKey(b.rawName)))
      .map((bucket) => {
        bucket.items.sort(compareArticlesInChapter);
        return { name: bucket.displayName, count: bucket.items.length, items: bucket.items };
      })
      .filter((ch) => ch.count > 0);
  }

  function groupBySeries(records: ArticleRow[], catalog: SeriesCatalogNode[] = []): SeriesTree {
    type SeriesBucket = {
      displayName: string;
      items: ArticleRow[];
      catalogChapters: Array<{ name: string }>;
    };
    const seriesMap = new Map<string, SeriesBucket>();

    const ensureSeries = (
      raw: string,
      catalogChapters: Array<{ name: string }> = [],
    ): SeriesBucket => {
      const displayName = raw.trim() || UNASSIGNED_SERIES;
      const key = displayName.toLowerCase();
      let entry = seriesMap.get(key);
      if (!entry) {
        entry = { displayName, items: [], catalogChapters: [] };
        seriesMap.set(key, entry);
      }
      if (catalogChapters.length && !entry.catalogChapters.length) {
        entry.catalogChapters = catalogChapters;
      }
      return entry;
    };

    const catalogNames = new Map<string, string>();
    const catalogChaptersBySeries = new Map<string, Array<{ name: string }>>();
    for (const node of catalog) {
      const name = (node.name ?? "").trim();
      if (!name) continue;
      const key = name.toLowerCase();
      catalogNames.set(key, name);
      catalogChaptersBySeries.set(key, node.chapters ?? []);
    }

    for (const rec of records) {
      const raw = (rec.series ?? "").trim() || UNASSIGNED_SERIES;
      const key = raw.toLowerCase();
      const displayName = catalogNames.get(key) || raw;
      ensureSeries(displayName, catalogChaptersBySeries.get(key) || []).items.push(rec);
    }

    const seriesKeys = [...seriesMap.keys()].sort((a, b) =>
      seriesMap.get(a)!.displayName.localeCompare(seriesMap.get(b)!.displayName),
    );
    const series: SeriesTree["series"] = [];
    let count = 0;
    for (const sKey of seriesKeys) {
      const bucket = seriesMap.get(sKey)!;
      if (!bucket.items.length) continue;
      const chapters = groupChapters(bucket.items, bucket.catalogChapters);
      const seriesCount = chapters.reduce((n, ch) => n + ch.count, 0);
      if (seriesCount === 0) continue;
      count += seriesCount;
      series.push({ name: bucket.displayName, count: seriesCount, chapters });
    }
    return { count, series };
  }

  function isQuizArticle(article: ArticleRow): boolean {
    return /\bquiz\b/i.test(article.title || "");
  }

  function appendArticleCard(cards: HTMLElement, article: ArticleRow): void {
    const li = document.createElement("li");
    const link = document.createElement("a");
    link.className = "product-dash__card";
    link.href = `/articles/read?id=${encodeURIComponent(article.epamId)}`;
    link.setAttribute("data-route", "");
    const head = document.createElement("span");
    head.className = "product-dash__card-head";
    const icon = document.createElement("span");
    icon.className = "material-symbols-outlined";
    icon.setAttribute("aria-hidden", "true");
    icon.textContent = isQuizArticle(article) ? "quiz" : "article";
    const title = document.createElement("span");
    title.className = "product-dash__card-title";
    title.textContent = article.title || "Untitled";
    head.append(icon, title);
    link.appendChild(head);
    const meta = [article.author, article.date].filter(Boolean).join(" · ");
    if (meta) {
      const detail = document.createElement("span");
      detail.className = "product-dash__card-desc";
      detail.textContent = meta;
      link.appendChild(detail);
    }
    li.appendChild(link);
    cards.appendChild(li);
  }

  function renderTree(list: HTMLElement, articles: ArticleRow[], tree: SeriesTree) {
    list.replaceChildren();

    const recent = recentArticles(articles);
    if (recent.length) {
      const recentBlock = document.createElement("section");
      recentBlock.className = "articles-recent";
      const recentTitle = document.createElement("h2");
      recentTitle.className = "articles-recent__title";
      recentTitle.textContent = "Recientes";
      recentBlock.appendChild(recentTitle);
      const cards = document.createElement("ul");
      cards.className = "product-dash__grid";
      for (const article of recent) appendArticleCard(cards, article);
      recentBlock.appendChild(cards);
      list.appendChild(recentBlock);
    }

    for (const seriesNode of tree.series) {
      if (seriesNode.count === 0 || !seriesNode.chapters.length) continue;

      const seriesEl = document.createElement("details");
      seriesEl.className = "articles-series";
      seriesEl.open = true;

      const seriesSummary = document.createElement("summary");
      const seriesName = document.createElement("span");
      seriesName.textContent = seriesNode.name;
      const seriesCount = document.createElement("span");
      seriesCount.className = "articles-series__count";
      seriesCount.textContent = `${seriesNode.count}`;
      seriesSummary.append(seriesName, seriesCount);
      seriesEl.appendChild(seriesSummary);

      for (const chapter of seriesNode.chapters) {
        if (chapter.count === 0) continue;
        const chapterEl = document.createElement("details");
        chapterEl.className = "articles-chapter";
        chapterEl.open = true;
        const chapterSummary = document.createElement("summary");
        const chapterName = document.createElement("span");
        chapterName.textContent = chapter.name;
        const chapterCount = document.createElement("span");
        chapterCount.className = "articles-chapter__count";
        chapterCount.textContent = `${chapter.count}`;
        chapterSummary.append(chapterName, chapterCount);
        chapterEl.appendChild(chapterSummary);
        const cards = document.createElement("ul");
        cards.className = "product-dash__grid";
        for (const article of chapter.items) appendArticleCard(cards, article);
        chapterEl.appendChild(cards);
        seriesEl.appendChild(chapterEl);
      }
      list.appendChild(seriesEl);
    }
  }

  async function loadArticles() {
    const status = document.querySelector("[data-articles-status]");
    const list = document.querySelector("[data-articles-list]");
    if (!(status instanceof HTMLElement) || !(list instanceof HTMLElement)) return;
    status.hidden = false;
    status.textContent = "Loading articles…";
    list.replaceChildren();
    const { status: responseStatus, data, requestId } = await apiRequest<{
      articles?: ArticleRow[];
      series?: SeriesCatalogNode[];
    }>("/articles");
    if (mustLog) console.log("[articles] list", { responseStatus, requestId });
    if (responseStatus >= 400) {
      status.textContent = data.message || "Could not load articles.";
      showErrorModal({
        message: data.message || "Could not load articles.",
        requestId,
        details: requestId ? `request_id=${requestId}` : "",
      });
      return;
    }
    const articles = data.articles ?? [];
    const catalog = data.series ?? [];
    const tree = groupBySeries(articles, catalog);
    renderTree(list, articles, tree);
    if (!tree.count && !tree.series.length) {
      status.hidden = false;
      status.textContent = "No public articles are available.";
      const empty = document.createElement("p");
      empty.className = "articles-page__empty";
      empty.textContent = "Articles will appear here when they are published for public reading.";
      list.appendChild(empty);
      return;
    }
    status.hidden = true;
  }

  document.addEventListener("astro:page-load", () => {
    void loadArticles();
  });
</script>
