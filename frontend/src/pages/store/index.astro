---
import { Fragment } from "astro/jsx-runtime";
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Store"
  description="Browse company storefronts: sections, product types, and inventory-backed products."
>
  <Fragment slot="dhs">
    <a class="dhs-action" href="/eoadmin/mine" data-route title="My orders" aria-label="My orders">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">receipt_long</span>
      </span>
      My orders
    </a>
  </Fragment>

  <div class="page">
    <header class="hero">
      <p class="eyebrow">
        <span class="material-symbols-outlined" aria-hidden="true">storefront</span>
        Commerce
      </p>
      <h1 class="hero__title">Store</h1>
      <p class="hero__lede">
        Choose a company. Checkout creates an eoadmin payment statement that an
        administrator approves.
      </p>
      <p class="status" data-banner>Loading companies…</p>
    </header>

    <section class="eostore-shop" data-store-hub aria-label="Company storefronts">
      <div class="eostore-shop-grid" data-company-grid></div>
    </section>
  </div>
</Layout>

<script>
  import { showErrorModal } from "../../lib/error-modal";
  import { mustLog } from "../../lib/dev-log";
  import {
    companyCartHref,
    companyStoreHref,
    listPublicCompanies,
    type EostoreCompany,
  } from "../../lib/eostore";

  const root = document.querySelector("[data-store-hub]");
  if (root instanceof HTMLElement) {
    const banner = document.querySelector("[data-banner]");
    const grid = root.querySelector("[data-company-grid]");

    const setBanner = (text: string) => {
      if (banner instanceof HTMLElement) banner.textContent = text;
    };

    const fail = (message: string, requestId = "", debug = "") => {
      showErrorModal({
        message,
        requestId,
        details: requestId ? `request_id=${requestId}` : "",
        debug,
      });
    };

    const render = (companies: EostoreCompany[]) => {
      if (!(grid instanceof HTMLElement)) return;
      grid.innerHTML = "";
      if (!companies.length) {
        setBanner("No companies published yet.");
        const empty = document.createElement("p");
        empty.className = "eostore-hint";
        empty.textContent = "Company storefronts will appear here when they are published.";
        grid.appendChild(empty);
        return;
      }
      setBanner(`${companies.length} compan${companies.length === 1 ? "y" : "ies"} available.`);
      companies.forEach((c) => {
        const card = document.createElement("article");
        card.className = "eostore-shop-card";

        const icon = document.createElement("span");
        icon.className = "eostore-shop-card__icon";
        const material = document.createElement("span");
        material.className = "material-symbols-outlined";
        material.setAttribute("aria-hidden", "true");
        material.textContent = "storefront";
        icon.appendChild(material);

        const h = document.createElement("h2");
        h.textContent = c.name;
        const meta = document.createElement("p");
        meta.className = "eostore-hint";
        meta.textContent = c.id;
        const desc = document.createElement("p");
        desc.className = "lede";
        desc.textContent = c.description || "";

        const actions = document.createElement("div");
        actions.className = "eostore-actions";
        const open = document.createElement("a");
        open.className = "btn btn--primary";
        open.href = companyStoreHref(c.id);
        open.setAttribute("data-route", "");
        open.textContent = "Open store";
        const cart = document.createElement("a");
        cart.className = "btn";
        cart.href = companyCartHref(c.id);
        cart.setAttribute("data-route", "");
        cart.textContent = "Cart";
        actions.append(open, cart);

        card.append(icon, h, meta, desc, actions);
        grid.appendChild(card);
      });
    };

    void (async () => {
      if (mustLog) console.log("store.hub.load");
      const res = await listPublicCompanies();
      if (res.status !== 200) {
        setBanner("Could not load companies.");
        fail(res.data.message || "Could not load companies.", res.requestId, res.data.debug);
        return;
      }
      render(res.data.companies || []);
    })();
  }
</script>

<style is:global>
  .eostore-shop-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--button-size);
    height: var(--button-size);
    color: var(--color-accent);
    background: var(--accent-soft);
    border-radius: var(--radius-md);
  }

  .eostore-shop-card__icon .material-symbols-outlined {
    font-size: var(--icon-size);
  }
</style>
