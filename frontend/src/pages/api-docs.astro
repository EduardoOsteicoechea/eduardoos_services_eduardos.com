---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="API documentation"
  description="Eduardoos external API catalog for API-key clients. Same-origin /api/ docs; eReport and Homescool materials."
>
  <div class="page" data-api-docs>
    <header class="hero">
      <p class="eyebrow">External API</p>
      <h1 class="hero__title">API documentation</h1>
      <p class="hero__lede">
        Public catalog for API-key clients. Signed-in site users keep cookie and
        CSRF authentication. eReport bytes live on the VPS filesystem. Homescool
        study materials use Mongo metadata plus media/homescool/. Sidecars:
        .ereport (eReport) and .eoschool (Homescool).
      </p>
    </header>

    <section class="section" aria-labelledby="catalog-heading">
      <div class="section__head">
        <h2 class="section__title" id="catalog-heading">Live catalog</h2>
        <p class="status" data-banner>Loading catalog…</p>
      </div>
      <pre class="panel" data-docs></pre>
    </section>
  </div>
</Layout>

<script>
  import { fetchAPIDocs } from "../lib/ereport";
  import { showErrorModal } from "../lib/error-modal";
  import { onBoundPageReady } from "../lib/session-ui";

  onBoundPageReady("[data-api-docs]", (root) => {
    const banner = root.querySelector("[data-banner]");
    const docs = root.querySelector("[data-docs]");
    void (async () => {
      const res = await fetchAPIDocs();
      if (res.status !== 200) {
        if (banner instanceof HTMLElement) {
          banner.textContent = res.data.message || "Could not load API docs.";
          banner.className = "status err";
        }
        showErrorModal({
          message: res.data.message || "Could not load API docs.",
          requestId: res.data.request_id,
          details: res.data.request_id ? `request_id=${res.data.request_id}` : "",
        });
        return;
      }
      if (docs instanceof HTMLElement) {
        if (banner instanceof HTMLElement) {
          banner.textContent = "Live catalog from GET /api/v1/docs.";
          banner.className = "status ok";
        }
        docs.textContent = JSON.stringify(res.data, null, 2);
      }
    })();
  });
</script>
