---
import { Fragment } from "astro/jsx-runtime";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="eReport" page="ereport">
  <Fragment slot="dhs">
    <button class="dhs-action" type="button" data-hub-view="dashboard" title="eReport" aria-label="Dashboard">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">dashboard</span>
      </span>
      Dashboard
    </button>
    <button class="dhs-action" type="button" data-hub-view="orgs" title="eReport" aria-label="Orgs">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">corporate_fare</span>
      </span>
      Orgs
    </button>
    <button class="dhs-action" type="button" data-hub-view="register" title="eReport" aria-label="New org">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">domain_add</span>
      </span>
      New org
    </button>
    <button class="dhs-action" type="button" data-hub-view="new-report" title="eReport" aria-label="New report">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">post_add</span>
      </span>
      New report
    </button>
    <button class="dhs-action" type="button" data-hub-view="recent" title="eReport" aria-label="Recent">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">history</span>
      </span>
      Recent
    </button>
    <button class="dhs-action" type="button" data-hub-view="manage" title="eReport" aria-label="Manage orgs">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">folder_managed</span>
      </span>
      Manage orgs
    </button>
    <button class="dhs-action" type="button" data-hub-view="manage-reports" title="eReport" aria-label="Manage reports">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">delete_sweep</span>
      </span>
      Manage reports
    </button>
  </Fragment>

  <section class="product-dash ereport-hub" data-ereport-hub aria-busy="true">
    <div class="ereport-hub__loading" data-ereport-loading role="status" aria-live="polite">
      <span class="ereport-hub__loading-ring" aria-hidden="true"></span>
      Loading eReport…
    </div>
    <p class="status" data-banner>Loading session…</p>
    <p class="panel ereport-signin-card" data-guest-fallback hidden>
      Sign in to open your eReport hub.
      <a class="btn btn--primary" href="/session" data-route>Log in</a>
      <a class="ereport-signin-card__alt" href="/session/register" data-route>Create an account</a>
    </p>

    <div class="product-gate panel" data-subscription-gate hidden>
      <p class="hint">eReport subscription required.</p>
      <p class="hint">
        <a href="/payments/subscription" data-route>Subscribe</a>
        ·
        <a href="/session" data-route>Sign in</a>
      </p>
    </div>

    <div data-authed-panel hidden>
      <p class="hint" data-create-hint hidden>eReport subscription required to create orgs and reports.</p>
      <p class="ereport-hub__error" data-hub-error hidden></p>

      <div data-view="dashboard">
        <section class="ereport-hub__recents" data-dashboard-recents>
          <h2 class="product-dash__section-title">Recent reports</h2>
          <div class="ereport-hub__recents-grid" data-dashboard-recent-cards></div>
          <p class="hint" data-dashboard-recents-empty hidden>No recent reports yet. Create one to get started.</p>
        </section>

        <section class="ereport-hub__recents" data-dashboard-shared>
          <h2 class="product-dash__section-title">Shared with me</h2>
          <div class="ereport-hub__recents-grid" data-dashboard-shared-cards></div>
          <p class="hint" data-dashboard-shared-empty hidden>No shared reports yet. Needs an eReport subscription when someone shares with your account.</p>
        </section>

        <section class="ereport-hub__options" aria-labelledby="ereport-options-title">
          <h2 class="product-dash__section-title" id="ereport-options-title">eReport options</h2>
          <div class="product-dash__grid">
            <button class="product-dash__card" type="button" data-hub-view="orgs">
              <span class="material-symbols-outlined" aria-hidden="true">corporate_fare</span>
              <span class="product-dash__card-title">Orgs</span>
              <span class="product-dash__card-desc" data-count-orgs>0 visible</span>
            </button>
            <button class="product-dash__card" type="button" data-hub-view="register">
              <span class="material-symbols-outlined" aria-hidden="true">domain_add</span>
              <span class="product-dash__card-title">+ New org</span>
              <span class="product-dash__card-desc">Create a client organization</span>
            </button>
            <button class="product-dash__card" type="button" data-hub-view="recent">
              <span class="material-symbols-outlined" aria-hidden="true">history</span>
              <span class="product-dash__card-title">Recent reports</span>
              <span class="product-dash__card-desc" data-count-recent>0 recent</span>
            </button>
            <button class="product-dash__card" type="button" data-hub-view="new-report">
              <span class="material-symbols-outlined" aria-hidden="true">post_add</span>
              <span class="product-dash__card-title">+ New report</span>
              <span class="product-dash__card-desc">Create report in an org</span>
            </button>
            <button class="product-dash__card" type="button" data-hub-view="manage">
              <span class="material-symbols-outlined" aria-hidden="true">folder_managed</span>
              <span class="product-dash__card-title">Manage orgs</span>
              <span class="product-dash__card-desc">Order, hide, delete</span>
            </button>
            <button class="product-dash__card" type="button" data-hub-view="manage-reports">
              <span class="material-symbols-outlined" aria-hidden="true">delete_sweep</span>
              <span class="product-dash__card-title">Manage reports</span>
              <span class="product-dash__card-desc" data-count-manage-reports>Delete reports</span>
            </button>
          </div>
        </section>
      </div>

      <div data-view="orgs">
        <button class="btn" type="button" data-hub-back>Back to dashboard</button>
        <h2 class="product-dash__section-title">Organizations</h2>
        <div class="product-dash__grid" data-org-cards></div>

        <div data-org-detail hidden>
          <h3 data-org-detail-name></h3>

          <div class="product-dash__grid" data-org-actions>
            <button class="product-dash__card" type="button" data-org-panel="edit">
              <span class="material-symbols-outlined" aria-hidden="true">edit</span>
              <span class="product-dash__card-title">Edit org</span>
              <span class="product-dash__card-desc">Rename this organization</span>
            </button>
            <button class="product-dash__card" type="button" data-org-panel="reports">
              <span class="material-symbols-outlined" aria-hidden="true">description</span>
              <span class="product-dash__card-title">Reports</span>
              <span class="product-dash__card-desc" data-count-reports>0 report(s)</span>
            </button>
            <button class="product-dash__card" type="button" data-org-panel="invite">
              <span class="material-symbols-outlined" aria-hidden="true">mail</span>
              <span class="product-dash__card-title">Invite</span>
              <span class="product-dash__card-desc">Magic link to the org list</span>
            </button>
          </div>

          <div data-org-panel-view="edit" hidden>
            <button class="btn" type="button" data-org-panel-back>Back to org cards</button>
            <form class="ereport-hub__form" data-rename-form>
              <label>
                Org name
                <input name="name" required maxlength="120" />
              </label>
              <div class="ereport-hub__row">
                <button class="btn btn--primary" type="submit">Save org name</button>
              </div>
            </form>
          </div>

          <div data-org-panel-view="reports" hidden>
            <button class="btn" type="button" data-org-panel-back>Back to org cards</button>
            <form class="ereport-hub__form" data-org-report-form>
              <label>
                Report name
                <input name="tema" required maxlength="200" />
              </label>
              <div class="ereport-hub__row">
                <button class="btn btn--primary" type="submit" data-needs-create>New report</button>
                <button class="btn" type="button" data-import-btn="panel" data-needs-create>Import .ereport</button>
              </div>
            </form>
            <ul class="ereport-list" data-report-list></ul>
          </div>

          <div data-org-panel-view="invite" hidden>
            <button class="btn" type="button" data-org-panel-back>Back to org cards</button>
            <form class="ereport-hub__form" data-org-invite-form>
              <label>
                Email
                <input name="email" type="email" required />
              </label>
              <label>
                Duration (hours)
                <input name="hours" type="number" min="1" max="720" value="24" />
              </label>
              <div class="ereport-hub__row">
                <button class="btn btn--primary" type="submit">Send magic link</button>
              </div>
            </form>
            <p class="hint" data-invite-link hidden></p>
          </div>

          <div data-org-panel-view="report-share" hidden>
            <button class="btn" type="button" data-org-panel-back>Back to reports</button>
            <h2 class="product-dash__section-title">Share report</h2>
            <p class="hint" data-report-share-name></p>
            <form class="ereport-hub__form" data-report-share-form>
              <input type="hidden" name="reportId" data-report-share-id />
              <label>
                Duration (hours)
                <input name="hours" type="number" min="1" max="720" value="24" required />
              </label>
              <label>
                Invitation message
                <textarea name="message" rows="3" maxlength="2000" required placeholder="Please review this eReport."></textarea>
              </label>
              <label>
                Emails to notify (one per line)
                <textarea name="emails" rows="4" required placeholder="person@company.com"></textarea>
              </label>
              <div class="ereport-hub__row">
                <button class="btn btn--primary" type="submit">Create link and email</button>
              </div>
            </form>
            <p class="hint">Anyone with the link can edit until expiry. Eduardo OS accounts with eReport also get Shared with me.</p>
            <p class="hint" data-report-share-link hidden></p>
          </div>
        </div>
      </div>

      <div data-view="register">
        <button class="btn" type="button" data-hub-back>Back to dashboard</button>
        <h2 class="product-dash__section-title">New organization</h2>
        <form class="ereport-hub__form" data-register-form>
          <label>
            Organization name
            <input name="name" required maxlength="120" placeholder="Client / project org" />
          </label>
          <label>
            First report name
            <input name="firstReportName" required maxlength="200" placeholder="e.g. Model QA — Sprint 1" />
          </label>
          <div class="ereport-hub__row">
            <button class="btn btn--primary" type="submit" data-needs-create>Create org + first report</button>
          </div>
        </form>
      </div>

      <div data-view="new-report">
        <button class="btn" type="button" data-hub-back>Back to dashboard</button>
        <h2 class="product-dash__section-title">New report</h2>
        <form class="ereport-hub__form" data-report-form>
          <label>
            Organization
            <select name="orgId" required data-org-select></select>
          </label>
          <label>
            Report name
            <input name="tema" required maxlength="200" />
          </label>
          <div class="ereport-hub__row">
            <button class="btn btn--primary" type="submit" data-needs-create>Create report</button>
            <button class="btn" type="button" data-import-btn="form" data-needs-create>Import .ereport</button>
            <button class="btn" type="button" data-hub-view="register" data-no-orgs hidden>Register an org first</button>
          </div>
        </form>
        <input type="file" accept=".ereport,application/json" data-import-file hidden />
      </div>

      <div data-view="recent">
        <button class="btn" type="button" data-hub-back>Back to dashboard</button>
        <h2 class="product-dash__section-title">Recent reports</h2>
        <ul class="ereport-list" data-recent-list></ul>
      </div>

      <div data-view="manage">
        <button class="btn" type="button" data-hub-back>Back to dashboard</button>
        <h2 class="product-dash__section-title">Manage organizations</h2>
        <form class="ereport-hub__form" data-manage-rename-form>
          <label>
            Rename org
            <select name="orgId" required data-manage-select></select>
          </label>
          <label>
            New name
            <input name="name" required maxlength="120" />
          </label>
          <div class="ereport-hub__row">
            <button class="btn btn--primary" type="submit">Save name</button>
            <button class="btn btn--primary" type="button" data-hub-view="register">New org</button>
          </div>
        </form>
        <ul class="ereport-list" data-manage-list></ul>
      </div>

      <div data-view="manage-reports">
        <button class="btn" type="button" data-hub-back>Back to dashboard</button>
        <h2 class="product-dash__section-title">Manage reports</h2>
        <p class="hint">Open, snapshot history, or delete permanently.</p>
        <ul class="ereport-list" data-manage-reports-list></ul>
      </div>

      <div data-view="history">
        <button class="btn" type="button" data-hub-back>Back to manage reports</button>
        <h2 class="product-dash__section-title">Report history</h2>
        <p class="hint" data-history-report-name></p>
        <div class="ereport-hub__row">
          <button class="btn btn--primary" type="button" data-history-save-now>Save snapshot</button>
          <button class="btn" type="button" data-history-refresh>Refresh</button>
        </div>
        <ul class="ereport-list" data-hub-history-list></ul>
        <p class="ereport-hub__error" data-hub-history-error hidden></p>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { clearAgentRoutePayload, setAgentRoutePayload } from "../../lib/api";
  import {
    createEreportOrg,
    createOrgInvite,
    createOrgReport,
    createReportHistory,
    createReportInvite,
    deleteEreportOrg,
    deleteOrgReport,
    downloadEreportSnapshot,
    fetchEreportAccess,
    fetchEreportOrg,
    fetchEreportOrgs,
    fetchOrgReport,
    fetchReportHistorySnapshot,
    fetchSharedReports,
    importOrgReport,
    listReportHistory,
    restoreReportHistory,
    updateEreportOrgs,
    workspaceHref,
    type EreportHistoryCard,
    type EreportSharedCard,
    type OrgCard,
    type RecentReportCard,
    type ReportCard,
  } from "../../lib/ereport";
  import { showErrorModal } from "../../lib/error-modal";
  import { requireService, setHidden } from "../../lib/productGate";
  import { onBoundPageReady, reportFailure, requireAuth, sessionCopy, setBanner, setBusy } from "../../lib/session-ui";

  const HUB_VIEWS = ["dashboard", "orgs", "register", "new-report", "recent", "manage", "manage-reports", "history"];

  onBoundPageReady("[data-ereport-hub]", (root) => {
    const copy = sessionCopy();
    let canCreate = false;
    let ownerSafe = "";
    let orgs: OrgCard[] = [];
    let recent: RecentReportCard[] = [];
    let allReports: RecentReportCard[] = [];
    let sharedReports: EreportSharedCard[] = [];
    let historyOrgId = "";
    let historyReportId = "";
    let activeOrgId = "";
    let reports: ReportCard[] = [];
    let importOrgId = "";

    const fail = (status: number, data: { message?: string; request_id?: string; error?: string; debug?: string }, success: string) =>
      reportFailure(copy, status, data, success);

    const setHubError = (text: string) => {
      const box = root.querySelector("[data-hub-error]");
      if (!(box instanceof HTMLElement)) return;
      box.hidden = !text;
      box.textContent = text;
    };

    const showOrgPanel = (panel: string) => {
      root.querySelectorAll("[data-org-panel-view]").forEach((node) => {
        if (node instanceof HTMLElement) node.hidden = node.dataset.orgPanelView !== panel;
      });
      const actions = root.querySelector("[data-org-actions]");
      if (actions instanceof HTMLElement) actions.hidden = panel !== "";
    };

    const resetOrgPanels = () => {
      showOrgPanel("");
      const link = root.querySelector("[data-invite-link]");
      if (link instanceof HTMLElement) {
        link.hidden = true;
        link.replaceChildren();
      }
    };

    const setView = (raw: string) => {
      const view = HUB_VIEWS.includes(raw) ? raw : "dashboard";
      root.querySelectorAll("[data-view]").forEach((node) => {
        if (node instanceof HTMLElement) node.hidden = node.dataset.view !== view;
      });
      document.querySelectorAll("[data-hub-view]").forEach((btn) => {
        if (!(btn instanceof HTMLElement) || !btn.classList.contains("icon-btn")) return;
        if (btn.dataset.hubView === view) btn.setAttribute("aria-pressed", "true");
        else btn.removeAttribute("aria-pressed");
      });
      const url = new URL(window.location.href);
      if (view === "dashboard") url.searchParams.delete("view");
      else url.searchParams.set("view", view);
      window.history.replaceState({}, "", url);
      setHubError("");
      setAgentRoutePayload({
        kind: "ereport_hub",
        view,
        canCreate,
        ownerSafe,
        activeOrgId,
        orgs,
        recent,
        reports,
        allReports,
      });
      if (view === "manage-reports") void refreshManageReports();
      if (view === "history") void refreshHubHistory();
    };

    const fillSelect = (selector: string, placeholder: string) => {
      const select = root.querySelector(selector);
      if (!(select instanceof HTMLSelectElement)) return;
      const previous = select.value;
      const visible = orgs.filter((o) => !o.hidden);
      select.replaceChildren();
      const empty = document.createElement("option");
      empty.value = "";
      empty.textContent = placeholder;
      select.append(empty);
      for (const org of visible) {
        const option = document.createElement("option");
        option.value = org.id;
        option.textContent = org.name;
        select.append(option);
      }
      if (visible.some((o) => o.id === previous)) select.value = previous;
    };

    const paintCounts = () => {
      const visibleOrgs = orgs.filter((o) => !o.hidden).length;
      const orgCount = root.querySelector("[data-count-orgs]");
      if (orgCount instanceof HTMLElement) orgCount.textContent = `${visibleOrgs} visible`;
      const recentCount = root.querySelector("[data-count-recent]");
      if (recentCount instanceof HTMLElement) recentCount.textContent = `${recent.length} recent`;
      const reportCount = root.querySelector("[data-count-reports]");
      if (reportCount instanceof HTMLElement) reportCount.textContent = `${reports.length} report(s)`;
      const manageReportsCount = root.querySelector("[data-count-manage-reports]");
      if (manageReportsCount instanceof HTMLElement) {
        manageReportsCount.textContent =
          allReports.length > 0 ? `${allReports.length} report(s)` : "Delete reports";
      }
      const noOrgs = root.querySelector("[data-no-orgs]");
      if (noOrgs instanceof HTMLElement) noOrgs.hidden = visibleOrgs > 0;
    };

    const paintOrgCards = () => {
      const grid = root.querySelector("[data-org-cards]");
      if (!(grid instanceof HTMLElement)) return;
      grid.replaceChildren();
      const visible = orgs.filter((o) => !o.hidden);
      if (visible.length === 0) {
        const empty = document.createElement("p");
        empty.className = "hint";
        empty.textContent = "No organizations yet. Create one first.";
        grid.append(empty);
        return;
      }
      for (const org of visible) {
        const card = document.createElement("button");
        card.type = "button";
        card.className = "product-dash__card";
        if (org.id === activeOrgId) card.classList.add("product-dash__card--active");
        card.dataset.openOrg = org.id;
        const icon = document.createElement("span");
        icon.className = "material-symbols-outlined";
        icon.setAttribute("aria-hidden", "true");
        icon.textContent = "corporate_fare";
        const title = document.createElement("span");
        title.className = "product-dash__card-title";
        title.textContent = org.name;
        const desc = document.createElement("span");
        desc.className = "product-dash__card-desc";
        desc.textContent = org.id === activeOrgId ? "Selected" : "Select org";
        card.append(icon, title, desc);
        grid.append(card);
      }
    };

    const formatReportDate = (iso: string) => {
      if (!iso) return "—";
      const d = new Date(iso);
      if (Number.isNaN(d.getTime())) return iso.slice(0, 10) || "—";
      return d.toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" });
    };

    const paintDashboardRecents = () => {
      const grid = root.querySelector("[data-dashboard-recent-cards]");
      const empty = root.querySelector("[data-dashboard-recents-empty]");
      if (!(grid instanceof HTMLElement)) return;
      grid.replaceChildren();
      const items = recent.slice(0, 5);
      if (empty instanceof HTMLElement) empty.hidden = items.length > 0;
      for (const report of items) {
        const card = document.createElement("a");
        card.className = "product-dash__card ereport-hub__recent-card";
        card.href = workspaceHref(report.orgId, report.id, ownerSafe);
        card.dataset.route = "";
        card.title = report.tema;

        const title = document.createElement("span");
        title.className = "product-dash__card-title";
        title.textContent = report.tema;

        const meta = document.createElement("span");
        meta.className = "product-dash__card-desc";
        meta.textContent = `${report.orgName || report.orgId} · ${formatReportDate(report.updatedAt)}`;

        const stats = document.createElement("span");
        stats.className = "ereport-hub__recent-stats";
        const open = Number(report.openCount) || 0;
        const completed = Number(report.completedCount) || 0;
        const openEl = document.createElement("span");
        openEl.className = "ereport-hub__recent-stat ereport-hub__recent-stat--open";
        openEl.textContent = `${open} open`;
        const doneEl = document.createElement("span");
        doneEl.className = "ereport-hub__recent-stat ereport-hub__recent-stat--done";
        doneEl.textContent = `${completed} done`;
        stats.append(openEl, doneEl);

        card.append(title, meta, stats);
        grid.append(card);
      }
    };

    const paintSharedCards = () => {
      const grid = root.querySelector("[data-dashboard-shared-cards]");
      const empty = root.querySelector("[data-dashboard-shared-empty]");
      if (!(grid instanceof HTMLElement)) return;
      grid.replaceChildren();
      if (empty instanceof HTMLElement) empty.hidden = sharedReports.length > 0;
      for (const report of sharedReports) {
        const card = document.createElement("a");
        card.className = "product-dash__card ereport-hub__recent-card";
        card.href = workspaceHref(report.orgId, report.reportId, report.ownerSafe || "", { shared: true });
        card.dataset.route = "";
        card.title = report.tema;
        const title = document.createElement("span");
        title.className = "product-dash__card-title";
        title.textContent = report.tema || report.reportId;
        const meta = document.createElement("span");
        meta.className = "product-dash__card-desc";
        meta.textContent = `Shared by ${report.ownerEmail || report.ownerSafe || "owner"} · ${formatReportDate(report.updatedAt)}`;
        card.append(title, meta);
        grid.append(card);
      }
    };

    const refreshShared = async () => {
      const res = await fetchSharedReports();
      if (res.status === 200) {
        sharedReports = res.data.items || [];
      } else {
        sharedReports = [];
        if (res.status === 403) {
          setBanner(root, "Shared with me requires an eReport subscription.", "err");
        }
      }
      paintSharedCards();
    };

    const refreshHubHistory = async () => {
      const list = root.querySelector("[data-hub-history-list]");
      const err = root.querySelector("[data-hub-history-error]");
      const nameEl = root.querySelector("[data-history-report-name]");
      if (!(list instanceof HTMLElement) || !historyOrgId || !historyReportId) return;
      if (nameEl instanceof HTMLElement) {
        nameEl.textContent = `${historyOrgId} / ${historyReportId}`;
      }
      if (err instanceof HTMLElement) err.hidden = true;
      list.replaceChildren();
      const res = await listReportHistory(historyOrgId, historyReportId);
      if (res.status !== 200) {
        if (err instanceof HTMLElement) {
          err.hidden = false;
          err.textContent = res.data.message || "Could not load history.";
        }
        return;
      }
      const items = (res.data.items || []) as EreportHistoryCard[];
      if (!items.length) {
        const empty = document.createElement("li");
        empty.className = "hint";
        empty.textContent = "No snapshots yet.";
        list.append(empty);
        return;
      }
      for (const item of items) {
        const li = document.createElement("li");
        li.textContent = `${item.tema || "Snapshot"} · ${item.source} · ${item.createdAt}`;
        const restore = document.createElement("button");
        restore.type = "button";
        restore.className = "btn";
        restore.textContent = "Restore";
        restore.dataset.hubHistoryRestore = item.id;
        const download = document.createElement("button");
        download.type = "button";
        download.className = "btn";
        download.textContent = "Download .ereport";
        download.dataset.hubHistoryDownload = item.id;
        li.append(restore, download);
        list.append(li);
      }
    };

    const paintRecent = () => {
      paintDashboardRecents();
      paintSharedCards();
      const list = root.querySelector("[data-recent-list]");
      if (!(list instanceof HTMLElement)) return;
      list.replaceChildren();
      if (recent.length === 0) {
        const empty = document.createElement("li");
        empty.className = "hint";
        empty.textContent = "No recent org reports yet.";
        list.append(empty);
        return;
      }
      for (const report of recent) {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = workspaceHref(report.orgId, report.id, ownerSafe);
        a.dataset.route = "";
        a.textContent = `${report.tema} · ${report.orgName || report.orgId}`;
        li.append(a);
        list.append(li);
      }
    };

    const paintManage = () => {
      const list = root.querySelector("[data-manage-list]");
      if (!(list instanceof HTMLElement)) return;
      list.replaceChildren();
      const sorted = [...orgs].sort((a, b) => a.order - b.order);
      if (sorted.length === 0) {
        const empty = document.createElement("li");
        empty.className = "hint";
        empty.textContent = "No organizations yet.";
        list.append(empty);
        return;
      }
      for (const org of sorted) {
        const li = document.createElement("li");
        const name = document.createElement("strong");
        name.textContent = org.name + (org.hidden ? " (hidden)" : "");
        const up = document.createElement("button");
        up.type = "button";
        up.className = "btn";
        up.textContent = "Up";
        up.dataset.moveOrg = org.id;
        up.dataset.dir = "-1";
        const down = document.createElement("button");
        down.type = "button";
        down.className = "btn";
        down.textContent = "Down";
        down.dataset.moveOrg = org.id;
        down.dataset.dir = "1";
        const hide = document.createElement("button");
        hide.type = "button";
        hide.className = "btn";
        hide.textContent = org.hidden ? "Show" : "Hide";
        hide.dataset.hideOrg = org.id;
        const del = document.createElement("button");
        del.type = "button";
        del.className = "btn btn--red";
        del.textContent = "Delete";
        del.dataset.deleteOrg = org.id;
        li.append(name, up, down, hide, del);
        list.append(li);
      }
    };

    const loadAllReports = async () => {
      const visible = orgs.filter((o) => !o.hidden);
      const batches = await Promise.all(
        visible.map(async (org) => {
          const res = await fetchEreportOrg(org.id);
          if (res.status !== 200) return [] as RecentReportCard[];
          return (res.data.reports || []).map((report) => ({
            ...report,
            orgId: org.id,
            orgName: org.name,
          }));
        }),
      );
      allReports = batches.flat().sort((a, b) => (b.updatedAt || "").localeCompare(a.updatedAt || ""));
    };

    const paintManageReports = () => {
      const list = root.querySelector("[data-manage-reports-list]");
      if (!(list instanceof HTMLElement)) return;
      list.replaceChildren();
      if (allReports.length === 0) {
        const empty = document.createElement("li");
        empty.className = "hint";
        empty.textContent = "No reports yet.";
        list.append(empty);
        return;
      }
      for (const report of allReports) {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = workspaceHref(report.orgId, report.id, ownerSafe);
        a.dataset.route = "";
        a.textContent = report.tema || report.id;
        const meta = document.createElement("span");
        meta.className = "hint";
        meta.textContent = `${report.orgName || report.orgId} · ${formatReportDate(report.updatedAt)}`;
        const hist = document.createElement("button");
        hist.type = "button";
        hist.className = "btn";
        hist.textContent = "History";
        hist.dataset.historyOrg = report.orgId;
        hist.dataset.historyReport = report.id;
        hist.dataset.reportName = report.tema || report.id;
        const del = document.createElement("button");
        del.type = "button";
        del.className = "btn btn--red";
        del.textContent = "Delete";
        del.dataset.deleteReport = report.id;
        del.dataset.deleteReportOrg = report.orgId;
        del.dataset.reportName = report.tema || report.id;
        li.append(a, meta, hist, del);
        list.append(li);
      }
    };

    const refreshManageReports = async () => {
      const list = root.querySelector("[data-manage-reports-list]");
      if (list instanceof HTMLElement) {
        list.replaceChildren();
        const loading = document.createElement("li");
        loading.className = "hint";
        loading.textContent = "Loading reports…";
        list.append(loading);
      }
      await loadAllReports();
      paintManageReports();
      paintCounts();
    };

    const paintReports = () => {
      const list = root.querySelector("[data-report-list]");
      if (!(list instanceof HTMLElement)) return;
      list.replaceChildren();
      if (reports.length === 0) {
        const empty = document.createElement("li");
        empty.className = "hint";
        empty.textContent = "This organization has no reports yet.";
        list.append(empty);
        return;
      }
      for (const report of reports) {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = workspaceHref(activeOrgId, report.id, ownerSafe);
        a.dataset.route = "";
        a.textContent = report.tema || report.id;
        const invite = document.createElement("button");
        invite.type = "button";
        invite.className = "btn";
        invite.textContent = "Share";
        invite.dataset.inviteReport = report.id;
        invite.dataset.reportName = report.tema || report.id;
        const del = document.createElement("button");
        del.type = "button";
        del.className = "btn btn--red";
        del.textContent = "Delete";
        del.dataset.deleteReport = report.id;
        del.dataset.deleteReportOrg = activeOrgId;
        del.dataset.reportName = report.tema || report.id;
        li.append(a, invite, del);
        list.append(li);
      }
    };

    const openOrg = async (orgId: string) => {
      activeOrgId = orgId;
      const res = await fetchEreportOrg(orgId);
      if (res.status !== 200) {
        const message = fail(res.status, res.data, "");
        setBanner(root, message.text, message.kind);
        return;
      }
      reports = res.data.reports || [];
      const detail = root.querySelector("[data-org-detail]");
      const name = root.querySelector("[data-org-detail-name]");
      if (detail instanceof HTMLElement) detail.hidden = false;
      if (name instanceof HTMLElement) name.textContent = res.data.org?.name || orgId;
      const rename = root.querySelector("[data-rename-form] input[name='name']");
      if (rename instanceof HTMLInputElement) rename.value = res.data.org?.name || "";
      paintOrgCards();
      paintReports();
      paintCounts();
      resetOrgPanels();
      setAgentRoutePayload({
        kind: "ereport_hub",
        view: new URLSearchParams(window.location.search).get("view") || "dashboard",
        canCreate,
        ownerSafe,
        activeOrgId,
        orgs,
        recent,
        reports,
      });
    };

    const reload = async () => {
      const access = await fetchEreportAccess();
      canCreate = Boolean(access.status === 200 && access.data.canCreate);
      ownerSafe = access.data.ownerSafe || "";
      const hint = root.querySelector("[data-create-hint]");
      if (hint instanceof HTMLElement) hint.hidden = canCreate;
      root.querySelectorAll("[data-needs-create]").forEach((node) => {
        if (node instanceof HTMLButtonElement) node.disabled = !canCreate;
      });
      const orgsRes = await fetchEreportOrgs();
      if (orgsRes.status !== 200) {
        const message = fail(orgsRes.status, orgsRes.data, "");
        setBanner(root, message.text, message.kind);
        return;
      }
      ownerSafe = orgsRes.data.ownerSafe || ownerSafe;
      orgs = orgsRes.data.orgs || [];
      recent = orgsRes.data.recentReports || [];
      fillSelect("[data-org-select]", "Select an organization…");
      fillSelect("[data-manage-select]", "Select an organization…");
      paintOrgCards();
      paintRecent();
      paintManage();
      paintCounts();
      void refreshShared();
      setAgentRoutePayload({
        kind: "ereport_hub",
        view: new URLSearchParams(window.location.search).get("view") || "dashboard",
        canCreate,
        ownerSafe,
        activeOrgId,
        orgs,
        recent,
        reports,
      });
      if (activeOrgId && orgs.some((o) => o.id === activeOrgId)) await openOrg(activeOrgId);
    };

    const runImport = async (orgId: string, file: File) => {
      if (!orgId) {
        setHubError("Select an organization…");
        return;
      }
      if (!/\.ereport$/i.test(file.name)) {
        setHubError("Solo archivos .ereport");
        return;
      }
      let payload: Record<string, unknown>;
      try {
        payload = JSON.parse(await file.text()) as Record<string, unknown>;
      } catch {
        setHubError("El .ereport no tiene sections[]");
        return;
      }
      if (!Array.isArray(payload.sections)) {
        setHubError("El .ereport no tiene sections[]");
        return;
      }
      const tema = String(payload.reportName || payload.reportNumber || file.name.replace(/\.ereport$/i, "") || "Importado");
      const res = await importOrgReport(orgId, tema, payload);
      const message = fail(res.status, res.data, "Report imported.");
      setBanner(root, message.text, message.kind);
      if (res.status === 201 && res.data.meta) {
        window.location.href = workspaceHref(orgId, res.data.meta.id, res.data.meta.ownerSafe || ownerSafe);
      }
    };

    void (async () => {
      try {
        const me = await requireAuth(root, copy);
        if (!me) return;
        const gate = root.querySelector("[data-subscription-gate]");
        const panel = root.querySelector("[data-authed-panel]");
        const access = await requireService("ereport");
        if (!access.access.allowed) {
          setHidden(gate, false);
          setHidden(panel, true);
          setBanner(root, "eReport subscription required.", "err");
          return;
        }
        setHidden(gate, true);
        setHidden(panel, false);
        setBanner(root, "");
        try {
          await reload();
        } catch {
          setBanner(root, copy.loadError, "err");
        }
        setView(new URLSearchParams(window.location.search).get("view") || "dashboard");
      } finally {
        root.dataset.ereportReady = "true";
        root.setAttribute("aria-busy", "false");
        const loading = root.querySelector("[data-ereport-loading]");
        if (loading instanceof HTMLElement) loading.hidden = true;
      }
    })();

    document.addEventListener("click", (event) => {
      const node = event.target;
      if (!(node instanceof Element)) return;
      const viewBtn = node.closest("[data-hub-view]");
      if (viewBtn instanceof HTMLElement && viewBtn.dataset.hubView) {
        setView(viewBtn.dataset.hubView);
      }
    });

    root.addEventListener("click", async (event) => {
      const node = event.target;
      if (!(node instanceof Element)) return;

      if (node.closest("[data-hub-back]")) {
        resetOrgPanels();
        const historyView = root.querySelector('[data-view="history"]');
        if (historyView instanceof HTMLElement && !historyView.hidden) {
          setView("manage-reports");
          return;
        }
        setView("dashboard");
        return;
      }
      const historyOpen = node.closest("[data-history-org]");
      if (historyOpen instanceof HTMLElement && historyOpen.dataset.historyOrg && historyOpen.dataset.historyReport) {
        historyOrgId = historyOpen.dataset.historyOrg;
        historyReportId = historyOpen.dataset.historyReport;
        const nameEl = root.querySelector("[data-history-report-name]");
        if (nameEl instanceof HTMLElement) {
          nameEl.textContent = historyOpen.dataset.reportName || historyReportId;
        }
        setView("history");
        return;
      }
      if (node.closest("[data-history-save-now]")) {
        if (!historyOrgId || !historyReportId) return;
        void (async () => {
          const current = await fetchOrgReport(historyOrgId, historyReportId);
          if (current.status !== 200 || !current.data.payload) {
            setHubError(current.data.message || "Could not read report for snapshot.");
            return;
          }
          const snap = await createReportHistory(historyOrgId, historyReportId, {
            payload: current.data.payload,
            tema: current.data.meta?.tema,
            label: "manual",
          });
          if (snap.status >= 300) {
            setHubError(snap.data.message || "Could not save snapshot.");
            return;
          }
          setBanner(root, "Snapshot saved.", "ok");
          void refreshHubHistory();
        })();
        return;
      }
      if (node.closest("[data-history-refresh]")) {
        void refreshHubHistory();
        return;
      }
      const hubRestore = node.closest("[data-hub-history-restore]");
      if (hubRestore instanceof HTMLElement && hubRestore.dataset.hubHistoryRestore && historyOrgId && historyReportId) {
        void restoreReportHistory(historyOrgId, historyReportId, hubRestore.dataset.hubHistoryRestore).then((res) => {
          if (res.status !== 200) {
            setHubError(res.data.message || "Could not restore.");
            return;
          }
          setBanner(root, "Snapshot restored.", "ok");
        });
        return;
      }
      const hubDownload = node.closest("[data-hub-history-download]");
      if (hubDownload instanceof HTMLElement && hubDownload.dataset.hubHistoryDownload && historyOrgId && historyReportId) {
        void fetchReportHistorySnapshot(historyOrgId, historyReportId, hubDownload.dataset.hubHistoryDownload).then((res) => {
          const snap = res.data.snapshot as { payload?: Record<string, unknown>; tema?: string; id?: string } | undefined;
          if (res.status !== 200 || !snap?.payload) {
            setHubError(res.data.message || "Could not download.");
            return;
          }
          downloadEreportSnapshot(`${snap.tema || "snapshot"}-${snap.id || "history"}`, snap.payload);
        });
        return;
      }
      if (node.closest("[data-org-panel-back]")) {
        const sharePanel = root.querySelector('[data-org-panel-view="report-share"]');
        if (sharePanel instanceof HTMLElement && !sharePanel.hidden) {
          showOrgPanel("reports");
          return;
        }
        resetOrgPanels();
        return;
      }

      const orgCard = node.closest("[data-open-org]");
      if (orgCard instanceof HTMLElement && orgCard.dataset.openOrg) {
        await openOrg(orgCard.dataset.openOrg);
        return;
      }

      const panelBtn = node.closest("[data-org-panel]");
      if (panelBtn instanceof HTMLElement && panelBtn.dataset.orgPanel) {
        showOrgPanel(panelBtn.dataset.orgPanel);
        return;
      }

      const importBtn = node.closest("[data-import-btn]");
      if (importBtn instanceof HTMLElement) {
        const form = root.querySelector("[data-report-form]");
        importOrgId =
          importBtn.dataset.importBtn === "panel"
            ? activeOrgId
            : form instanceof HTMLFormElement
              ? String(new FormData(form).get("orgId") || "")
              : "";
        if (!importOrgId) {
          setHubError("Select an organization…");
          return;
        }
        const input = root.querySelector("[data-import-file]");
        if (input instanceof HTMLInputElement) input.click();
        return;
      }

      const inviteBtn = node.closest("[data-invite-report]");
      if (inviteBtn instanceof HTMLElement && inviteBtn.dataset.inviteReport && activeOrgId) {
        const idInput = root.querySelector("[data-report-share-id]");
        const nameEl = root.querySelector("[data-report-share-name]");
        if (idInput instanceof HTMLInputElement) idInput.value = inviteBtn.dataset.inviteReport;
        if (nameEl instanceof HTMLElement) {
          nameEl.textContent = inviteBtn.dataset.reportName || inviteBtn.dataset.inviteReport;
        }
        const link = root.querySelector("[data-report-share-link]");
        if (link instanceof HTMLElement) {
          link.hidden = true;
          link.replaceChildren();
        }
        showOrgPanel("report-share");
        return;
      }

      const delReport = node.closest("[data-delete-report]");
      if (delReport instanceof HTMLElement && delReport.dataset.deleteReport) {
        const orgId = delReport.dataset.deleteReportOrg || activeOrgId;
        if (!orgId) return;
        if (!window.confirm(`Delete report “${delReport.dataset.reportName || ""}”? This cannot be undone.`)) return;
        const res = await deleteOrgReport(orgId, delReport.dataset.deleteReport);
        const message = fail(res.status, res.data, "Report deleted.");
        setBanner(root, message.text, message.kind);
        if (res.status === 200) {
          await reload();
          if (orgId === activeOrgId) await openOrg(activeOrgId);
          const currentView = new URLSearchParams(window.location.search).get("view");
          if (currentView === "manage-reports") await refreshManageReports();
        }
        return;
      }

      const hideOrg = node.closest("[data-hide-org]");
      if (hideOrg instanceof HTMLElement && hideOrg.dataset.hideOrg) {
        const org = orgs.find((o) => o.id === hideOrg.dataset.hideOrg);
        if (!org) return;
        const res = await updateEreportOrgs([{ id: org.id, hidden: !org.hidden, order: org.order }]);
        const message = fail(res.status, res.data, "Organization updated.");
        setBanner(root, message.text, message.kind);
        if (res.status === 200) await reload();
        return;
      }

      const moveOrg = node.closest("[data-move-org]");
      if (moveOrg instanceof HTMLElement && moveOrg.dataset.moveOrg) {
        const dir = Number(moveOrg.dataset.dir);
        const sorted = [...orgs].sort((a, b) => a.order - b.order);
        const idx = sorted.findIndex((o) => o.id === moveOrg.dataset.moveOrg);
        const current = sorted[idx];
        const swap = sorted[idx + dir];
        if (!current || !swap) return;
        const res = await updateEreportOrgs([
          { id: current.id, order: swap.order, hidden: current.hidden },
          { id: swap.id, order: current.order, hidden: swap.hidden },
        ]);
        const message = fail(res.status, res.data, "Order updated.");
        setBanner(root, message.text, message.kind);
        if (res.status === 200) await reload();
        return;
      }

      const delOrg = node.closest("[data-delete-org]");
      if (delOrg instanceof HTMLElement && delOrg.dataset.deleteOrg) {
        if (!window.confirm("Delete this org and its reports?")) return;
        const res = await deleteEreportOrg(delOrg.dataset.deleteOrg);
        const message = fail(res.status, res.data, "Organization deleted.");
        setBanner(root, message.text, message.kind);
        if (res.status === 200) {
          activeOrgId = "";
          const detail = root.querySelector("[data-org-detail]");
          if (detail instanceof HTMLElement) detail.hidden = true;
          await reload();
        }
      }
    });

    root.querySelector("[data-import-file]")?.addEventListener("change", async (event) => {
      const input = event.currentTarget;
      if (!(input instanceof HTMLInputElement) || !input.files?.[0]) return;
      if (!canCreate) {
        showErrorModal({ message: "eReport subscription required." });
        return;
      }
      await runImport(importOrgId, input.files[0]);
      input.value = "";
    });

    root.querySelector("[data-register-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;
      if (!canCreate) {
        setHubError("eReport subscription required.");
        return;
      }
      setBusy(form, true);
      const data = new FormData(form);
      const res = await createEreportOrg(String(data.get("name") || ""), String(data.get("firstReportName") || ""));
      setBusy(form, false);
      const message = fail(res.status, res.data, "Organization created.");
      setBanner(root, message.text, message.kind);
      if (res.status === 201 && res.data.report && res.data.org) {
        window.location.href = workspaceHref(res.data.org.id, res.data.report.id, res.data.report.ownerSafe || ownerSafe);
        return;
      }
      if (res.status === 201) await reload();
    });

    root.querySelector("[data-report-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;
      if (!canCreate) {
        setHubError("eReport subscription required.");
        return;
      }
      const data = new FormData(form);
      const orgId = String(data.get("orgId") || "");
      const tema = String(data.get("tema") || "").trim();
      if (!orgId) {
        setHubError("Select an organization…");
        return;
      }
      if (!tema) return;
      setBusy(form, true);
      const res = await createOrgReport(orgId, tema);
      setBusy(form, false);
      const message = fail(res.status, res.data, "Report created.");
      setBanner(root, message.text, message.kind);
      if (res.status === 201 && res.data.meta) {
        window.location.href = workspaceHref(orgId, res.data.meta.id, res.data.meta.ownerSafe || ownerSafe);
      }
    });

    root.querySelector("[data-org-report-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement) || !activeOrgId) return;
      if (!canCreate) {
        setHubError("eReport subscription required.");
        return;
      }
      const tema = String(new FormData(form).get("tema") || "").trim();
      if (!tema) return;
      setBusy(form, true);
      const res = await createOrgReport(activeOrgId, tema);
      setBusy(form, false);
      const message = fail(res.status, res.data, "Report created.");
      setBanner(root, message.text, message.kind);
      if (res.status === 201 && res.data.meta) {
        window.location.href = workspaceHref(activeOrgId, res.data.meta.id, res.data.meta.ownerSafe || ownerSafe);
      }
    });

    root.querySelector("[data-rename-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement) || !activeOrgId) return;
      const name = String(new FormData(form).get("name") || "").trim();
      if (!name) return;
      const res = await updateEreportOrgs([{ id: activeOrgId, name }]);
      const message = fail(res.status, res.data, "Organization renamed.");
      setBanner(root, message.text, message.kind);
      if (res.status === 200) await reload();
    });

    root.querySelector("[data-manage-rename-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;
      const data = new FormData(form);
      const orgId = String(data.get("orgId") || "");
      const name = String(data.get("name") || "").trim();
      if (!orgId || !name) return;
      const res = await updateEreportOrgs([{ id: orgId, name }]);
      const message = fail(res.status, res.data, "Organization renamed.");
      setBanner(root, message.text, message.kind);
      if (res.status === 200) await reload();
    });

    root.querySelector("[data-org-invite-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement) || !activeOrgId) return;
      const data = new FormData(form);
      const hours = Math.max(1, Number(data.get("hours") || 24));
      const res = await createOrgInvite(activeOrgId, String(data.get("email") || ""), hours);
      const message = fail(res.status, res.data, "Invite sent.");
      setBanner(root, message.text, message.kind);
      const link = root.querySelector("[data-invite-link]");
      if (link instanceof HTMLElement && res.data.link) {
        const a = document.createElement("a");
        a.href = res.data.link;
        a.textContent = res.data.link;
        link.replaceChildren(a);
        link.hidden = false;
      }
    });

    root.querySelector("[data-report-share-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement) || !activeOrgId) return;
      const data = new FormData(form);
      const reportId = String(data.get("reportId") || "").trim();
      const hours = Math.max(1, Math.min(720, Number(data.get("hours") || 24)));
      const messageText = String(data.get("message") || "").trim();
      const emails = String(data.get("emails") || "")
        .split(/[\n,;]+/)
        .map((e) => e.trim())
        .filter(Boolean);
      if (!reportId || !messageText || emails.length === 0) {
        setHubError("Indica duración, mensaje y al menos un correo.");
        return;
      }
      const res = await createReportInvite(activeOrgId, reportId, {
        emails,
        durationHours: hours,
        message: messageText,
      });
      const message = fail(res.status, res.data, "Link creado y correos enviados.");
      setBanner(root, message.text, message.kind);
      setHubError(message.kind === "err" ? message.text : "");
      const link = root.querySelector("[data-report-share-link]");
      if (link instanceof HTMLElement && res.data.link) {
        link.replaceChildren();
        const a = document.createElement("a");
        a.href = res.data.link;
        a.target = "_blank";
        a.rel = "noopener noreferrer";
        a.textContent = res.data.link;
        link.append(a);
        if (res.data.hash) {
          const hash = document.createElement("span");
          hash.textContent = `Hash: ${res.data.hash}`;
          link.append(document.createElement("br"), hash);
        }
        link.hidden = false;
      }
    });

    document.addEventListener(
      "astro:before-swap",
      () => {
        clearAgentRoutePayload();
      },
      { once: true },
    );
  });
</script>
