---
/**
 * Cookie-less Mode W iframe — same UI chrome as the eduardoos.com quick issue modal.
 * No Layout shell (no Register/Log in, no site footer).
 */
import "../../styles/global.css";
import "../../styles/ereport-chrome.css";
---

<!doctype html>
<html lang="en" data-theme="dark" data-page="ereport-embed-issue">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Website issues · eReport</title>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
    />
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem("theme");
          if (theme === "light" || theme === "dark") {
            document.documentElement.setAttribute("data-theme", theme);
          }
          const font = localStorage.getItem("root-font-size");
          if (font) document.documentElement.style.fontSize = font;
        } catch (_) {}
      })();
    </script>
    <style is:inline>
      /*
        Mode W option A: this document fills the host bare iframe 100%.
        Card size/chrome live on .eos-ereport-embed-frame--bare (embed-theme.css).
        Do not re-apply a smaller max-width here or the panel sits top-left in a void.
      */
      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: var(--color-bg, #121212);
        color: var(--color-text, #f5f5f5);
      }
      body.ereport-embed-issue-body {
        display: flex;
        flex-direction: column;
        box-sizing: border-box;
        width: 100%;
        height: 100%;
        padding: 0;
      }
      .ereport-embed-issue-frame.ereport-quick-overlay__frame {
        flex: 1 1 auto;
        width: 100%;
        max-width: none;
        height: 100%;
        max-height: none;
        min-height: 0;
        border: 0;
        border-radius: 0;
        box-shadow: none;
        background: transparent;
        box-sizing: border-box;
      }
      /* Issue card opens in-iframe (Mode W Open) — fill the bare host frame. */
      .ereport-issue-card-overlay {
        position: fixed;
        inset: 0;
        z-index: var(--z-modal, 40);
      }
      .ereport-issue-card-overlay__frame {
        width: 100%;
        max-width: none;
        height: 100%;
        max-height: none;
        border-radius: 0;
      }
    </style>
  </head>
  <body class="ereport-embed-issue-body">
    <div
      class="ereport-quick-overlay__frame ereport-embed-issue-frame"
      data-ereport-embed-issue
      role="dialog"
      aria-modal="true"
      aria-label="Website issues"
    >
      <header class="ereport-quick-overlay__bar">
        <h1 class="ereport-quick-overlay__title" data-ei-title>Website issues</h1>
        <div class="ereport-quick-overlay__bar-actions">
          <button type="button" class="icon-btn" data-ei-close aria-label="Close" title="Close">
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
          </button>
        </div>
      </header>
      <p class="ereport-quick-overlay__context" data-ei-context></p>
      <ul class="ereport-quick-overlay__list" data-ei-list></ul>
      <div class="ereport-quick-overlay__compose" data-ei-compose hidden>
        <button type="button" class="icon-btn" data-ei-add aria-label="Add issue" title="Add issue" disabled>
          <span class="material-symbols-outlined" aria-hidden="true">add</span>
        </button>
        <div class="ereport-quick-overlay__input-row" data-ei-input-row hidden>
          <textarea
            data-ei-input
            rows="3"
            placeholder="Issue title. Description after the first period…"
            disabled
          ></textarea>
          <button type="button" class="btn btn--primary" data-ei-submit disabled>Save issue</button>
        </div>
      </div>
      <p class="status ereport-quick-overlay__status" data-ei-status></p>
    </div>
    <script>
      import { startEreportEmbedIssue } from "../../lib/ereport-embed-issue";
      const root = document.querySelector("[data-ereport-embed-issue]");
      if (root instanceof HTMLElement) startEreportEmbedIssue(root);
    </script>
  </body>
</html>
