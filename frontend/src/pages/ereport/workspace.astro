---
import { Fragment } from "astro/jsx-runtime";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="eReport workspace" page="ereport-workspace">
  <Fragment slot="dhs">
    <button class="dhs-action" type="button" data-tracker-cmd="toggle-sidebar" title="Mostrar u ocultar la sidebar del reporte" aria-label="Toggle sidebar del reporte">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">view_sidebar</span>
      </span>
      Sidebar
    </button>
    <a class="dhs-action" href="/ereport" data-route title="eReport workspace" aria-label="Volver al Tablero">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">grid_view</span>
      </span>
      Volver al Tablero
    </a>
    <button class="dhs-action" type="button" data-open-modal="open" title="eReport workspace" aria-label="Abrir reporte">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">folder_open</span>
      </span>
      Abrir
    </button>
    <button class="dhs-action" type="button" data-workspace-save title="Guardar y snapshot" aria-label="Guardar">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">cloud_upload</span>
      </span>
      Save
    </button>
    <button class="dhs-action" type="button" data-tracker-cmd="save-export" title="eReport workspace" aria-label="Descargar reporte">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">download</span>
      </span>
      Download
    </button>
    <button class="dhs-action" type="button" data-open-modal="history" title="Historial de snapshots" aria-label="History">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">history</span>
      </span>
      History
    </button>
    <button class="dhs-action" type="button" data-open-modal="share" data-owner-only title="eReport workspace" aria-label="Compartir con usuarios">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">share</span>
      </span>
      Compartir
    </button>
    <button class="dhs-action" type="button" data-open-modal="ids" data-owner-only title="eReport workspace" aria-label="Mostrar Org ID y Report ID">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">tag</span>
      </span>
      IDs
    </button>
  </Fragment>

  <section class="ereport-workspace" data-ereport-workspace>
    <p class="status" data-banner>Loading session…</p>
    <p class="panel ereport-signin-card" data-guest-fallback hidden>
      Sign in to open this report.
      <a class="btn btn--primary" href="/session" data-route>Log in</a>
      <a class="ereport-signin-card__alt" href="/session/register" data-route>Create an account</a>
    </p>
    <div class="ereport-workspace-body" data-authed-panel hidden>
      <iframe class="ereport-iframe" title="eReport workspace" data-tracker></iframe>
    </div>
    <div class="ereport-modal" data-modal="open" hidden>
      <div class="panel" role="dialog" aria-modal="true" aria-labelledby="ereport-open-title">
        <h2 id="ereport-open-title">Abrir reporte</h2>
        <p class="hint">Los cambios se guardan solos: en el archivo local si abriste desde el dispositivo, o en la nube si el reporte está en el VPS.</p>
        <div class="ereport-modal-actions">
          <button class="btn btn--primary" type="button" data-open-source="device">Desde el dispositivo</button>
          <button class="btn btn--primary" type="button" data-open-source="cloud">Desde la nube</button>
          <button class="btn" type="button" data-close-modal>Cerrar</button>
        </div>
      </div>
    </div>
    <div class="ereport-modal" data-modal="open-cloud" hidden>
      <div class="panel" role="dialog" aria-modal="true" aria-labelledby="ereport-open-cloud-title">
        <h2 id="ereport-open-cloud-title">Reportes en la nube</h2>
        <p class="hint">Elige un reporte; los cambios siguientes se guardan solo en la nube.</p>
        <ul class="ereport-list" data-open-cloud-list></ul>
        <p class="ereport-hub__error" data-open-cloud-error hidden></p>
        <div class="ereport-modal-actions">
          <button class="btn" type="button" data-close-modal>Cerrar</button>
        </div>
      </div>
    </div>
    <div class="ereport-modal" data-modal="share" hidden>
      <div class="panel" role="dialog" aria-modal="true" aria-labelledby="ereport-share-title">
        <h2 id="ereport-share-title">Compartir</h2>
        <form data-share-form>
          <label>
            Duración (horas)
            <input name="hours" type="number" min="1" max="720" value="24" required />
          </label>
          <label>
            Mensaje de invitación
            <textarea name="message" rows="3" maxlength="2000" required placeholder="Te comparto este eReport para revisión."></textarea>
          </label>
          <label>
            Correos a enviar (uno por línea)
            <textarea name="emails" rows="4" required placeholder="persona@empresa.com"></textarea>
          </label>
          <button class="btn btn--primary" type="submit">Crear link y enviar</button>
        </form>
        <ul class="ereport-list" data-share-list></ul>
        <p class="hint">Anyone with the link can edit the report until it expires. Registered Eduardo OS users with an eReport subscription also get it under Shared with me.</p>
        <p class="hint" data-share-link hidden></p>
        <p class="ereport-hub__error" data-share-error hidden></p>
        <div class="ereport-modal-actions">
          <button class="btn" type="button" data-share-copy hidden>Copiar link</button>
          <button class="btn btn--primary" type="button" data-close-modal>Listo</button>
        </div>
      </div>
    </div>
    <div class="ereport-modal" data-modal="history" hidden>
      <div class="panel" role="dialog" aria-modal="true" aria-labelledby="ereport-history-title">
        <h2 id="ereport-history-title">History</h2>
        <p class="hint">Save a snapshot, restore, or download a .ereport file.</p>
        <div class="ereport-modal-actions">
          <button class="btn btn--primary" type="button" data-history-save>Save snapshot</button>
          <button class="btn" type="button" data-history-refresh>Refresh</button>
        </div>
        <ul class="ereport-list" data-history-list></ul>
        <p class="ereport-hub__error" data-history-error hidden></p>
        <div class="ereport-modal-actions">
          <button class="btn" type="button" data-close-modal>Close</button>
        </div>
      </div>
    </div>
    <div class="ereport-modal" data-modal="ids" hidden>
      <div class="panel ereport-ids-panel" role="dialog" aria-modal="true" aria-labelledby="ereport-ids-title">
        <h2 id="ereport-ids-title">IDs del reporte</h2>
        <p class="hint">Úsalos con el connector / API key (`EDUARDOOS_ORG_ID`, `EDUARDOOS_REPORT_ID`).</p>
        <form class="ereport-ids-form" data-ids-form>
          <label for="ereport-modal-org-id">
            Org ID
            <input
              id="ereport-modal-org-id"
              type="text"
              readonly
              spellcheck="false"
              autocomplete="off"
              data-ids-org
            />
          </label>
          <label for="ereport-modal-report-id">
            Report ID
            <input
              id="ereport-modal-report-id"
              type="text"
              readonly
              spellcheck="false"
              autocomplete="off"
              data-ids-report
            />
          </label>
          <p class="ereport-hub__error" data-ids-copy-status hidden></p>
          <div class="ereport-modal-actions">
            <button class="btn" type="button" data-copy-id="org">Copiar org</button>
            <button class="btn" type="button" data-copy-id="report">Copiar report</button>
            <button class="btn btn--primary" type="button" data-copy-id="both">Copiar ambos</button>
            <button class="btn" type="button" data-close-modal>Cerrar</button>
          </div>
        </form>
      </div>
    </div>
    <input type="file" accept=".ereport,application/json" data-local-fallback hidden />
  </section>
</Layout>

<script>
  import { clearAgentRoutePayload, setAgentRoutePayload } from "../../lib/api";
  import {
    createReportHistory,
    createReportInvite,
    downloadEreportSnapshot,
    fetchEreportOrgs,
    fetchEreportOrg,
    fetchOrgReport,
    fetchReportHistorySnapshot,
    fetchSharedReport,
    listReportHistory,
    ownerImageUploadPath,
    refreshCsrf,
    rememberedCsrf,
    restoreReportHistory,
    saveOrgReport,
    saveSharedReport,
    sharedImageUploadPath,
    updateEreportOrgs,
    type EreportHistoryCard,
    type EreportPayload,
  } from "../../lib/ereport";
  import {
    clearLocalEreportFile,
    hasLocalEreportFile,
    openLocalEreportFile,
    saveLocalEreportFile,
  } from "../../lib/ereport-local-file";
  import { readPrettyEreportPath, trackerIframeSrc, workspaceHref } from "../../lib/ereport-routes";
  import {
    resolveUiScale,
    siteIsDark,
    startTrackerHost,
    trackerCommandMessage,
    trackerConfigMessage,
    trackerLoadMessage,
    type TrackerCommand,
    type TrackerHost,
  } from "../../lib/ereport-workspace";
  import { genericMessage, onBoundPageReady, reportFailure, requireAuth, sessionCopy, setBanner } from "../../lib/session-ui";
  import { EREPORT_OPEN_LOCAL_EVENT } from "../../lib/error-modal";

  onBoundPageReady("[data-ereport-workspace]", (root) => {
    const copy = sessionCopy();
    const params = new URLSearchParams(window.location.search);
    const pretty = readPrettyEreportPath(window.location.pathname);
    let orgId = params.get("org")?.trim() || "";
    let reportId = params.get("report")?.trim() || pretty.reportId;
    let ownerSafe = params.get("user")?.trim() || pretty.ownerSafe;
    let isShared = params.get("shared") === "1";
    let canEditShared = true;
    /** Cloud = VPS report; local = File System Access .ereport (autosave only that side). */
    let saveTarget: "cloud" | "local" = "cloud";
    const iframe = root.querySelector("[data-tracker]");
    let payload: EreportPayload | null = null;

    let tema = "";
    let host: TrackerHost | null = null;
    let disposed = false;
    const pendingCmds: TrackerCommand[] = [];
    const invited = new Set<string>();
    const disposers: Array<() => void> = [];

    const publishAgentPayload = (next: EreportPayload | null) => {
      if (!next) {
        clearAgentRoutePayload();
        return;
      }
      setAgentRoutePayload({
        kind: "ereport_report",
        orgId,
        reportId,
        tema,
        saveTarget,
        payload: next,
      });
    };

    const onDoc = <K extends keyof DocumentEventMap>(
      type: K,
      listener: (event: DocumentEventMap[K]) => void,
      options?: boolean | AddEventListenerOptions,
    ) => {
      document.addEventListener(type, listener as EventListener, options);
      disposers.push(() => document.removeEventListener(type, listener as EventListener, options));
    };

    const onWin = (type: string, listener: EventListener) => {
      window.addEventListener(type, listener);
      disposers.push(() => window.removeEventListener(type, listener));
    };

    const closeModals = () => {
      root.querySelectorAll("[data-modal]").forEach((node) => {
        if (node instanceof HTMLElement) node.hidden = true;
      });
      document.querySelectorAll("body > [data-modal]").forEach((node) => {
        if (node instanceof HTMLElement) {
          node.hidden = true;
          if (!root.contains(node)) root.append(node);
        }
      });
      document.querySelectorAll("[data-open-modal]").forEach((btn) => {
        if (btn instanceof HTMLElement) btn.removeAttribute("aria-pressed");
      });
    };

    const dispose = () => {
      if (disposed) return;
      disposed = true;
      closeModals();
      clearAgentRoutePayload();
      clearLocalEreportFile();
      host?.destroy();
      host = null;
      for (const stop of disposers.splice(0)) stop();
      delete root.dataset.bound;
      delete root.dataset.boundKey;
    };

    onDoc("astro:before-swap", dispose, { once: true });

    const modalIsOpen = () =>
      [...root.querySelectorAll("[data-modal]")].some((node) => node instanceof HTMLElement && !node.hidden) ||
      [...document.querySelectorAll("body > [data-modal]")].some((node) => node instanceof HTMLElement && !node.hidden);

    const sendCmd = (command: TrackerCommand) => {
      if (host) {
        host.post(trackerCommandMessage(command));
        return;
      }
      pendingCmds.push(command);
    };

    const persistCloud = async (next: EreportPayload, opts: { silent?: boolean } = {}) => {
      if (disposed || !orgId || !reportId) return false;
      payload = next;
      publishAgentPayload(next);
      const nextTema = String(next.reportName || next.appTitle || tema || "Sin tema").trim() || tema;
      tema = nextTema;
      const res = isShared
        ? await saveSharedReport(orgId, reportId, { payload: next, tema: nextTema })
        : await saveOrgReport(orgId, reportId, { payload: next, tema: nextTema });
      if (disposed) return false;
      const orgName = String(next.orgName || "").trim();
      if (!isShared && res.status < 300 && orgName) {
        await updateEreportOrgs([{ id: orgId, name: orgName }]);
      }
      // Background autosave must never open the global error modal: the user did not
      // start an action. Timeouts (status 0) stay fully quiet; other failures use banner only.
      if (opts.silent) {
        const message = genericMessage(copy, res.status, res.data, "Autosaved.");
        if (message.kind === "err") {
          if (res.status !== 0) setBanner(root, message.text, "err");
          return false;
        }
        setBanner(root, "Autosaved.", "ok");
        return true;
      }
      const message = reportFailure(copy, res.status, res.data, "Autosaved.");
      if (message.kind === "err") {
        setBanner(root, message.text, message.kind);
        return false;
      }
      setBanner(root, "Autosaved.", "ok");
      return true;
    };

    const persistLocal = async (next: EreportPayload) => {
      if (disposed || !hasLocalEreportFile()) return false;
      payload = next;
      publishAgentPayload(next);
      tema = String(next.reportName || next.appTitle || tema || "Sin tema").trim() || tema;
      try {
        await saveLocalEreportFile(next);
        setBanner(root, "Autosaved locally.", "ok");
        return true;
      } catch (err) {
        setBanner(root, err instanceof Error ? err.message : "Could not save locally.", "err");
        return false;
      }
    };

    const persist = async (next: EreportPayload, opts: { silent?: boolean } = {}) => {
      if (saveTarget === "local") {
        return persistLocal(next);
      }
      return persistCloud(next, opts);
    };

    const attachHost = (nextPayload: EreportPayload) => {
      if (disposed || !(iframe instanceof HTMLIFrameElement)) return;
      if (saveTarget === "cloud" && (!orgId || !reportId)) return;
      publishAgentPayload(nextPayload);
      const uploadUrl =
        orgId && reportId
          ? isShared
            ? sharedImageUploadPath(orgId, reportId)
            : ownerImageUploadPath(orgId, reportId)
          : "";
      const canDelete = !isShared || canEditShared;
      const pushConfig = () => {
        void refreshCsrf().then(() => {
          if (disposed || !host) return;
          host.post(trackerConfigMessage(uploadUrl, rememberedCsrf(), { canDelete }));
        });
      };
      host?.destroy();
      host = startTrackerHost(iframe, {
        origin: window.location.origin,
        uploadUrl,
        csrf: rememberedCsrf(),
        payload: nextPayload,
        canDelete,
        handlers: {
          onCloudSave: (next) => {
            if (isShared && !canEditShared) return;
            void persist(next as EreportPayload, { silent: true });
          },
          onError: (message) => setBanner(root, message, "err"),
          onNeedConfig: () => {
            pushConfig();
          },
        },
      });
      // Bust cache so the iframe always reboots and receives a fresh config message.
      iframe.src = trackerIframeSrc();
      for (const command of pendingCmds.splice(0)) {
        host.post(trackerCommandMessage(command));
      }
    };

    const liveOrgId = () => orgId || params.get("org")?.trim() || "";
    const liveReportId = () => reportId || params.get("report")?.trim() || pretty.reportId || "";

    const fillIdsFields = (modal?: HTMLElement | null) => {
      const hostEl =
        modal ||
        (root.querySelector('[data-modal="ids"]') as HTMLElement | null) ||
        (document.querySelector('[data-modal="ids"]') as HTMLElement | null);
      if (!(hostEl instanceof HTMLElement)) return;
      const orgVal = liveOrgId();
      const reportVal = liveReportId();
      const orgInput = hostEl.querySelector("[data-ids-org]");
      const reportInput = hostEl.querySelector("[data-ids-report]");
      if (orgInput instanceof HTMLInputElement) {
        orgInput.value = orgVal;
        orgInput.defaultValue = orgVal;
        orgInput.title = orgVal;
      }
      if (reportInput instanceof HTMLInputElement) {
        reportInput.value = reportVal;
        reportInput.defaultValue = reportVal;
        reportInput.title = reportVal;
      }
    };

    const paintCloudList = async () => {
      const list = root.querySelector("[data-open-cloud-list]") || document.querySelector("[data-open-cloud-list]");
      const err = root.querySelector("[data-open-cloud-error]") || document.querySelector("[data-open-cloud-error]");
      if (!(list instanceof HTMLElement)) return;
      list.replaceChildren();
      if (err instanceof HTMLElement) {
        err.hidden = true;
        err.textContent = "";
      }
      const listed = await fetchEreportOrgs();
      if (disposed) return;
      if (listed.status !== 200) {
        if (err instanceof HTMLElement) {
          err.hidden = false;
          err.textContent = listed.data.message || "Could not list reports.";
        }
        return;
      }
      ownerSafe = listed.data.ownerSafe || ownerSafe;
      const recent = listed.data.recentReports || [];
      if (!recent.length) {
        const empty = document.createElement("li");
        empty.textContent = "No hay reportes recientes en la nube.";
        list.append(empty);
        return;
      }
      for (const item of recent) {
        const li = document.createElement("li");
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "btn";
        btn.textContent = `${item.tema || "Sin tema"} · ${item.orgName || item.orgId}`;
        btn.dataset.openCloudOrg = item.orgId;
        btn.dataset.openCloudReport = item.id;
        li.append(btn);
        list.append(li);
      }
    };

    const syncOwnerOnlyChrome = () => {
      document.querySelectorAll("[data-owner-only]").forEach((node) => {
        if (node instanceof HTMLElement) {
          node.hidden = isShared;
        }
      });
    };

    const paintHistoryList = async () => {
      const list = root.querySelector("[data-history-list]") || document.querySelector("[data-history-list]");
      const err = root.querySelector("[data-history-error]") || document.querySelector("[data-history-error]");
      if (!(list instanceof HTMLElement) || !orgId || !reportId) return;
      if (isShared) {
        list.replaceChildren();
        const note = document.createElement("li");
        note.className = "hint";
        note.textContent = "Snapshot history is available to the report owner.";
        list.append(note);
        return;
      }
      if (err instanceof HTMLElement) err.hidden = true;
      list.replaceChildren();
      const res = await listReportHistory(orgId, reportId);
      if (res.status !== 200) {
        if (err instanceof HTMLElement) {
          err.hidden = false;
          err.textContent = res.data.message || "Could not load history.";
        }
        return;
      }
      const items = res.data.items || [];
      if (!items.length) {
        const empty = document.createElement("li");
        empty.textContent = "No snapshots yet. Use Save snapshot below.";
        list.append(empty);
        return;
      }
      for (const item of items as EreportHistoryCard[]) {
        const li = document.createElement("li");
        li.textContent = `${item.tema || "Snapshot"} · ${item.source || "manual"} · ${item.createdAt || ""}`;
        const restore = document.createElement("button");
        restore.type = "button";
        restore.className = "btn";
        restore.textContent = "Restore";
        restore.dataset.historyRestore = item.id;
        const download = document.createElement("button");
        download.type = "button";
        download.className = "btn";
        download.textContent = "Download .ereport";
        download.dataset.historyDownload = item.id;
        li.append(restore, download);
        list.append(li);
      }
    };

    const openModal = (name: string) => {
      closeModals();
      const modal = root.querySelector(`[data-modal="${name}"]`) || document.querySelector(`[data-modal="${name}"]`);
      if (!(modal instanceof HTMLElement)) return;
      if (modal.parentElement !== document.body) {
        document.body.append(modal);
      }
      modal.hidden = false;
      document.querySelector(`[data-open-modal="${name}"]`)?.setAttribute("aria-pressed", "true");
      if (name === "ids") {
        fillIdsFields(modal);
        const status = modal.querySelector("[data-ids-copy-status]");
        if (status instanceof HTMLElement) {
          status.hidden = true;
          status.textContent = "";
        }
        const orgInput = modal.querySelector("[data-ids-org]");
        if (orgInput instanceof HTMLInputElement) {
          orgInput.focus();
          orgInput.select();
        }
      }
      if (name === "open-cloud") {
        void paintCloudList();
      }
      if (name === "history") {
        const saveBtn = modal.querySelector("[data-history-save]");
        if (saveBtn instanceof HTMLElement) {
          saveBtn.hidden = isShared;
        }
        void paintHistoryList();
      }
    };

    const loadCloudReport = async (nextOrg: string, nextReport: string) => {
      if (disposed || !nextOrg || !nextReport) return;
      clearLocalEreportFile();
      saveTarget = "cloud";
      orgId = nextOrg;
      reportId = nextReport;
      await refreshCsrf();
      if (disposed) return;
      const res = await fetchOrgReport(orgId, reportId);
      if (disposed) return;
      if (res.status !== 200 || !res.data.payload || !res.data.meta) {
        reportFailure(copy, res.status, res.data, "");
        setBanner(root, res.data.message || "Report not found.", "err");
        return;
      }
      ownerSafe = res.data.meta.ownerSafe || ownerSafe;
      tema = res.data.meta.tema;
      payload = {
        ...res.data.payload,
        reportName: String(res.data.payload.reportName || res.data.meta.tema || "").trim() || res.data.meta.tema,
      };
      fillIdsFields();
      const href = workspaceHref(orgId, reportId, ownerSafe);
      if (href && window.location.pathname + window.location.search !== href) {
        window.history.replaceState({}, "", href);
      }
      setBanner(root, "Editing on the VPS filesystem.", "ok");
      attachHost(payload);
      closeModals();
    };

    const loadLocalPayload = (next: EreportPayload) => {
      /* Caller already bound the File System Access handle via openLocalEreportFile. */
      saveTarget = "local";
      payload = next;
      tema = String(next.reportName || next.appTitle || tema || "Sin tema").trim() || tema;
      fillIdsFields();
      setBanner(root, "Editing local .ereport (autosave to device).", "ok");
      attachHost(next);
      closeModals();
    };

    /** Pretty `/ereport/{user}/{id}` carries no org, so find the one holding this report. */
    const resolveOrgId = async (report: string): Promise<string> => {
      const listed = await fetchEreportOrgs();
      if (listed.status !== 200) return "";
      ownerSafe = listed.data.ownerSafe || ownerSafe;
      const recent = (listed.data.recentReports || []).find((item) => item.id === report);
      if (recent) return recent.orgId;
      for (const org of listed.data.orgs || []) {
        if (disposed) return "";
        const detail = await fetchEreportOrg(org.id);
        if (detail.status === 200 && (detail.data.reports || []).some((item) => item.id === report)) {
          return org.id;
        }
      }
      return "";
    };

    const openFromDevice = async () => {
      try {
        const data = await openLocalEreportFile();
        if (disposed) return;
        loadLocalPayload(data as EreportPayload);
      } catch (err) {
        const msg = err instanceof Error ? err.message : String(err);
        const fallback = root.querySelector("[data-local-fallback]");
        if (fallback instanceof HTMLInputElement && /Chrome|Edge|HTTPS|localhost/i.test(msg)) {
          fallback.value = "";
          fallback.click();
          return;
        }
        setBanner(root, msg || "Could not open local file.", "err");
      }
    };

    const onErrorLoadEreport = () => {
      void openFromDevice();
    };
    document.addEventListener(EREPORT_OPEN_LOCAL_EVENT, onErrorLoadEreport);
    disposers.push(() => document.removeEventListener(EREPORT_OPEN_LOCAL_EVENT, onErrorLoadEreport));

    void requireAuth(root, copy).then(async (me) => {
      if (!me || disposed) return;
      syncOwnerOnlyChrome();
      if (!orgId && reportId && !isShared) {
        orgId = await resolveOrgId(reportId);
        if (disposed) return;
      }
      if (!orgId || !reportId) {
        setBanner(root, "Missing organization or report.", "err");
        return;
      }
      saveTarget = "cloud";
      clearLocalEreportFile();
      await refreshCsrf();
      if (disposed) return;
      const res = isShared ? await fetchSharedReport(orgId, reportId) : await fetchOrgReport(orgId, reportId);
      if (disposed) return;
      if (res.status !== 200 || !res.data.payload || !res.data.meta) {
        reportFailure(copy, res.status, res.data, "");
        setBanner(
          root,
          res.data.message || (isShared ? "Shared report not found (eReport subscription required)." : "Report not found."),
          "err",
        );
        return;
      }
      ownerSafe = res.data.meta.ownerSafe || ownerSafe;
      tema = res.data.meta.tema;
      canEditShared = res.data.canEdit !== false;
      isShared = isShared || Boolean((res.data as { shared?: boolean }).shared);
      syncOwnerOnlyChrome();
      payload = {
        ...res.data.payload,
        reportName: String(res.data.payload.reportName || res.data.meta.tema || "").trim() || res.data.meta.tema,
      };
      fillIdsFields();
      setBanner(root, isShared ? "Editing shared report." : "Editing on the VPS filesystem.", "ok");
      attachHost(payload);
    });

    onDoc("click", (event) => {
      if (disposed) return;
      const node = event.target;
      if (!(node instanceof Element)) return;
      if (node.closest("[data-close-modal]")) {
        closeModals();
        return;
      }
      const overlay = node.closest("[data-modal]");
      if (overlay instanceof HTMLElement && node === overlay) {
        closeModals();
        return;
      }
      const openSource = node.closest("[data-open-source]");
      if (openSource instanceof HTMLElement && openSource.dataset.openSource) {
        if (openSource.dataset.openSource === "device") {
          void openFromDevice();
          return;
        }
        if (openSource.dataset.openSource === "cloud") {
          openModal("open-cloud");
          return;
        }
      }
      const cloudPick = node.closest("[data-open-cloud-org]");
      if (cloudPick instanceof HTMLElement && cloudPick.dataset.openCloudOrg && cloudPick.dataset.openCloudReport) {
        isShared = false;
        syncOwnerOnlyChrome();
        void loadCloudReport(cloudPick.dataset.openCloudOrg, cloudPick.dataset.openCloudReport);
        return;
      }
      if (node.closest("[data-workspace-save]")) {
        if (!host || (isShared && !canEditShared)) return;
        void host.collect(60000).then(async (next) => {
          const ok = await persist(next as EreportPayload);
          if (!ok || isShared || !orgId || !reportId) {
            if (ok) setBanner(root, "Saved.", "ok");
            return;
          }
          const snap = await createReportHistory(orgId, reportId, {
            payload: next as EreportPayload,
            tema: String(next.reportName || next.appTitle || tema || "").trim(),
            label: "manual",
          });
          if (snap.status >= 300) {
            setBanner(root, snap.data.message || "Saved, but snapshot failed.", "err");
            return;
          }
          setBanner(root, "Saved + snapshot.", "ok");
        });
        return;
      }
      if (node.closest("[data-history-save]")) {
        if (isShared || !orgId || !reportId || !host) {
          if (isShared) setBanner(root, "Only the owner can save snapshots.", "err");
          return;
        }
        void host.collect(60000).then(async (next) => {
          await persist(next as EreportPayload);
          const snap = await createReportHistory(orgId, reportId, {
            payload: next as EreportPayload,
            tema: String(next.reportName || next.appTitle || tema || "").trim(),
            label: "manual",
          });
          if (snap.status >= 300) {
            setBanner(root, snap.data.message || "Could not save snapshot.", "err");
            return;
          }
          setBanner(root, "Snapshot saved.", "ok");
          void paintHistoryList();
        });
        return;
      }
      if (node.closest("[data-history-refresh]")) {
        void paintHistoryList();
        return;
      }
      const restoreBtn = node.closest("[data-history-restore]");
      if (restoreBtn instanceof HTMLElement && restoreBtn.dataset.historyRestore && orgId && reportId) {
        void restoreReportHistory(orgId, reportId, restoreBtn.dataset.historyRestore).then((res) => {
          if (res.status !== 200 || !res.data.payload) {
            setBanner(root, res.data.message || "Could not restore.", "err");
            return;
          }
          payload = res.data.payload;
          tema = res.data.meta?.tema || tema;
          host?.post(trackerLoadMessage(payload));
          setBanner(root, "Snapshot restored.", "ok");
          closeModals();
        });
        return;
      }
      const downloadBtn = node.closest("[data-history-download]");
      if (downloadBtn instanceof HTMLElement && downloadBtn.dataset.historyDownload && orgId && reportId) {
        void fetchReportHistorySnapshot(orgId, reportId, downloadBtn.dataset.historyDownload).then((res) => {
          const snap = res.data.snapshot as { payload?: EreportPayload; tema?: string; id?: string } | undefined;
          if (res.status !== 200 || !snap?.payload) {
            setBanner(root, res.data.message || "Could not download snapshot.", "err");
            return;
          }
          downloadEreportSnapshot(`${snap.tema || "snapshot"}-${snap.id || "history"}`, snap.payload);
        });
        return;
      }
      const cmd = node.closest("[data-tracker-cmd]");
      if (cmd instanceof HTMLElement && cmd.dataset.trackerCmd) {
        sendCmd(cmd.dataset.trackerCmd as TrackerCommand);
        return;
      }
      const modalBtn = node.closest("[data-open-modal]");
      if (modalBtn instanceof HTMLElement && modalBtn.dataset.openModal) {
        openModal(modalBtn.dataset.openModal);
      }
    });

    onDoc(
      "keydown",
      (event) => {
        if (disposed || event.key !== "Escape" || !modalIsOpen()) return;
        event.stopPropagation();
        closeModals();
      },
      true,
    );

    const onScale = () => host?.post({ target: "ereport-tracker", type: "text-scale", scale: resolveUiScale() });
    const onTheme = () => host?.post({ target: "ereport-tracker", type: "theme", dark: siteIsDark() });
    onWin("ereport-ui-scale", onScale);
    onWin("ereport-theme", onTheme);

    root.querySelector("[data-ids-form]")?.addEventListener("submit", (event) => {
      event.preventDefault();
    });

    root.querySelector("[data-local-fallback]")?.addEventListener("change", (event) => {
      const input = event.currentTarget;
      if (!(input instanceof HTMLInputElement) || !input.files?.length) return;
      const file = input.files[0];
      if (!/\.ereport$/i.test(file.name)) {
        setBanner(root, "Solo archivos .ereport", "err");
        return;
      }
      const reader = new FileReader();
      reader.onload = () => {
        try {
          const data = JSON.parse(String(reader.result || ""));
          if (!data.sections || !Array.isArray(data.sections)) throw new Error("sin sections[]");
          /* Fallback picker has no writable handle — stay on cloud target for this workspace. */
          saveTarget = "cloud";
          clearLocalEreportFile();
          payload = data as EreportPayload;
          tema = String(data.reportName || data.appTitle || tema || "Sin tema").trim() || tema;
          publishAgentPayload(payload);
          host?.post(trackerLoadMessage(payload));
          void persistCloud(payload);
          setBanner(root, "Loaded local file into this cloud report (autosave → cloud).", "ok");
          closeModals();
        } catch (err) {
          setBanner(root, err instanceof Error ? err.message : "Invalid .ereport", "err");
        }
      };
      reader.readAsText(file);
      input.value = "";
    });

    onDoc("click", async (event) => {
      if (disposed) return;
      const node = event.target;
      if (!(node instanceof Element)) return;
      const copyId = node.closest("[data-copy-id]");
      if (copyId instanceof HTMLElement && copyId.dataset.copyId) {
        const kind = copyId.dataset.copyId;
        const orgVal = liveOrgId();
        const reportVal = liveReportId();
        const text =
          kind === "org"
            ? orgVal
            : kind === "report"
              ? reportVal
              : `EDUARDOOS_ORG_ID=${orgVal}\nEDUARDOOS_REPORT_ID=${reportVal}`;
        const status =
          document.querySelector("[data-ids-copy-status]") || root.querySelector("[data-ids-copy-status]");
        if (!text.trim()) {
          if (status instanceof HTMLElement) {
            status.hidden = false;
            status.textContent = "IDs aún no disponibles.";
          }
          return;
        }
        try {
          await navigator.clipboard.writeText(text);
          if (status instanceof HTMLElement) {
            status.hidden = false;
            status.textContent = "Copiado.";
            status.classList.remove("ereport-hub__error");
          }
        } catch {
          if (status instanceof HTMLElement) {
            status.hidden = false;
            status.textContent = "No se pudo copiar.";
          }
        }
      }
    });

    root.querySelector("[data-share-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement) || disposed) return;
      if (saveTarget !== "cloud" || !orgId || !reportId) {
        setBanner(root, "Compartir requiere un reporte en la nube.", "err");
        return;
      }
      const data = new FormData(form);
      const hours = Math.max(1, Math.min(720, Number(data.get("hours") || 24)));
      const message = String(data.get("message") || "").trim();
      const emails = String(data.get("emails") || "")
        .split(/[\n,;]+/)
        .map((e) => e.trim())
        .filter(Boolean);
      const err = root.querySelector("[data-share-error]") || document.querySelector("[data-share-error]");
      const copyBtn = root.querySelector("[data-share-copy]") || document.querySelector("[data-share-copy]");
      if (!message || emails.length === 0) {
        if (err instanceof HTMLElement) {
          err.hidden = false;
          err.textContent = "Indica un mensaje y al menos un correo.";
        }
        return;
      }
      const res = await createReportInvite(orgId, reportId, {
        emails,
        durationHours: hours,
        message,
      });
      const messageResult = reportFailure(copy, res.status, res.data, "Link creado y correos enviados.");
      if (messageResult.kind === "err") {
        setBanner(root, messageResult.text, messageResult.kind);
        if (err instanceof HTMLElement) {
          err.hidden = false;
          err.textContent = messageResult.text;
        }
        return;
      }
      if (err instanceof HTMLElement) err.hidden = true;
      for (const email of emails) invited.add(email);
      const list = root.querySelector("[data-share-list]");
      if (list instanceof HTMLElement) {
        const li = document.createElement("li");
        const label = document.createElement("span");
        label.textContent = `${emails.join(", ")} · ${hours}h`;
        li.append(label);
        if (res.data.link) {
          const link = document.createElement("a");
          link.href = res.data.link;
          link.target = "_blank";
          link.rel = "noopener noreferrer";
          link.textContent = "Abrir enlace";
          li.append(document.createTextNode(" · "), link);
        }
        list.append(li);
      }
      const linkBox = root.querySelector("[data-share-link]");
      if (linkBox instanceof HTMLElement && res.data.link) {
        linkBox.hidden = false;
        linkBox.replaceChildren();
        const linkText = document.createElement("a");
        linkText.href = res.data.link;
        linkText.target = "_blank";
        linkText.rel = "noopener noreferrer";
        linkText.textContent = res.data.link;
        linkBox.append(linkText);
        if (res.data.hash) {
          const hashLine = document.createElement("span");
          hashLine.textContent = `Hash: ${res.data.hash}`;
          linkBox.append(document.createElement("br"), hashLine);
        }
        if (copyBtn instanceof HTMLButtonElement) {
          copyBtn.hidden = false;
          copyBtn.onclick = async () => {
            try {
              await navigator.clipboard.writeText(String(res.data.link || ""));
              setBanner(root, "Link copiado.", "ok");
            } catch {
              setBanner(root, "No se pudo copiar el link.", "err");
            }
          };
        }
      }
      form.reset();
      const hoursInput = form.elements.namedItem("hours");
      if (hoursInput instanceof HTMLInputElement) hoursInput.value = "24";
      setBanner(root, messageResult.text, messageResult.kind);
    });
  });
</script>
