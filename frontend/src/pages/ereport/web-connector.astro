---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="eReport connector"
  page="ereport-web-connector"
  robots="noindex,nofollow"
  showPageTitle={false}
  description="eReport web connector — session + subscription gated issue editing for a fixed site report."
>
  <h1 class="page-title-sr">eReport connector</h1>
  <section class="ereport-wc" data-ereport-web-connector>
    <header class="ereport-wc__hero">
      <p class="ereport-wc__eyebrow">eReport</p>
      <p class="ereport-wc__title" aria-hidden="true">Connector</p>
      <p class="ereport-wc__report" data-wc-report-label hidden></p>
      <p class="status ereport-wc__status" data-wc-status>Loading…</p>
    </header>

    <div class="ereport-wc__card" data-wc-auth hidden>
      <h2>Access</h2>
      <p class="hint" data-wc-auth-msg>Checking session…</p>
    </div>

    <div class="ereport-wc__card" data-wc-path hidden>
      <h2><span class="ereport-wc__step">1</span> Organization &amp; report</h2>
      <label>
        Organization
        <select data-wc-org></select>
      </label>
      <label>
        Report
        <select data-wc-report></select>
      </label>
    </div>

    <div class="ereport-wc__stack" data-wc-cascade hidden>
      <div class="ereport-wc__card">
        <div class="ereport-wc__card-head">
          <h2><span class="ereport-wc__step">2</span> Section</h2>
          <button type="button" class="ereport-wc__btn ereport-wc__btn--ghost" data-wc-section-create title="Create section">
            Create
          </button>
        </div>
        <label>
          Section
          <select data-wc-section></select>
        </label>
        <div class="ereport-wc__editor" data-wc-section-fields hidden>
          <label>
            Title
            <input type="text" data-wc-section-title />
          </label>
          <label>
            Concept
            <textarea data-wc-section-concept rows="3"></textarea>
          </label>
          <button type="button" class="ereport-wc__btn ereport-wc__btn--primary" data-wc-section-save>Save section</button>
        </div>
      </div>

      <div class="ereport-wc__card">
        <div class="ereport-wc__card-head">
          <h2><span class="ereport-wc__step">3</span> Subsection</h2>
          <button type="button" class="ereport-wc__btn ereport-wc__btn--ghost" data-wc-group-create title="Create subsection">
            Create
          </button>
        </div>
        <label>
          Subsection
          <select data-wc-group></select>
        </label>
        <div class="ereport-wc__editor" data-wc-group-fields hidden>
          <label>
            Title
            <input type="text" data-wc-group-title />
          </label>
          <label>
            Concept
            <textarea data-wc-group-concept rows="3"></textarea>
          </label>
          <button type="button" class="ereport-wc__btn ereport-wc__btn--primary" data-wc-group-save>Save subsection</button>
        </div>
      </div>

      <div class="ereport-wc__card">
        <div class="ereport-wc__card-head">
          <h2><span class="ereport-wc__step">4</span> Issue</h2>
          <button type="button" class="ereport-wc__btn ereport-wc__btn--ghost" data-wc-item-create title="Create issue">
            Create
          </button>
        </div>
        <label>
          Issue
          <select data-wc-item></select>
        </label>
        <div class="ereport-wc__editor" data-wc-item-fields hidden>
          <label>
            Name
            <input type="text" data-wc-item-nombre />
          </label>
          <label>
            Incidencia
            <textarea data-wc-item-incidencia rows="4"></textarea>
          </label>
          <div class="ereport-wc__pair">
            <label>
              Fecha incidencia
              <input type="datetime-local" data-wc-item-fecha-inc />
            </label>
            <label>
              Status
              <select data-wc-item-status>
                <option value="">(empty)</option>
                <option value="reprobado">reprobado</option>
                <option value="aprobado">aprobado</option>
                <option value="no_aplica">no_aplica</option>
              </select>
            </label>
          </div>
          <label>
            Solución
            <textarea data-wc-item-solucion rows="3"></textarea>
          </label>
          <label>
            Fecha solución
            <input type="datetime-local" data-wc-item-fecha-sol />
          </label>
          <button type="button" class="ereport-wc__btn ereport-wc__btn--primary" data-wc-item-save>Save issue</button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  html[data-page="ereport-web-connector"] .app-header,
  html[data-page="ereport-web-connector"] #main-menu,
  html[data-page="ereport-web-connector"] #dynamic-header,
  html[data-page="ereport-web-connector"] #agent-sidebar,
  html[data-page="ereport-web-connector"] .app-header--end {
    display: none !important;
  }

  html[data-page="ereport-web-connector"] {
    background: var(--color-bg);
  }

  html[data-page="ereport-web-connector"] body {
    background: var(--color-bg);
  }

  html[data-page="ereport-web-connector"] main {
    display: block;
    padding: var(--space-padding);
    margin: 0;
    max-width: none;
  }

  html[data-page="ereport-web-connector"] main > .ereport-wc {
    display: flex;
    flex-direction: column;
    gap: var(--space-padding);
    grid-column: unset;
    max-width: 56rem;
  }

  .ereport-wc__hero {
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
    padding-bottom: var(--space-padding);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .ereport-wc__eyebrow {
    margin: 0;
    font-size: var(--font-size-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .ereport-wc__title {
    margin: 0;
    font-size: var(--font-size-xl);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.2;
  }

  .ereport-wc__report {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text);
  }

  .ereport-wc__status {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }

  .ereport-wc__stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-padding);
  }

  .ereport-wc__card {
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
    padding: var(--space-padding);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius);
    background: var(--color-surface);
  }

  .ereport-wc__card h2 {
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--rail-gap);
    font-size: var(--font-size-md);
    font-weight: 600;
  }

  .ereport-wc__card-head {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--rail-gap);
  }

  .ereport-wc__step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    border: var(--border-width) solid var(--color-border);
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .ereport-wc__card label {
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }

  .ereport-wc__card .hint {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }

  .ereport-wc__card .hint a {
    color: var(--color-link);
  }

  .ereport-wc__card select,
  .ereport-wc__card input:not([type="checkbox"]),
  .ereport-wc__card textarea {
    width: auto;
    min-width: 0;
    font-family: var(--font-family);
    font-size: var(--font-size-md);
    color: var(--color-text);
    background: var(--color-bg);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius);
  }

  .ereport-wc__card select,
  .ereport-wc__card input:not([type="checkbox"]) {
    height: var(--control-height);
    padding: var(--control-padding-block) var(--control-padding-inline);
  }

  .ereport-wc__card textarea {
    min-height: var(--textarea-min-height);
    padding: var(--control-padding-block) var(--control-padding-inline);
    resize: vertical;
  }

  .ereport-wc__editor {
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
    margin-top: var(--rail-gap);
    padding-top: var(--space-padding);
    border-top: var(--border-width) solid var(--color-border);
  }

  .ereport-wc__pair {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--rail-gap);
  }

  .ereport-wc__pair > label {
    flex: 1;
    min-width: 10rem;
  }

  .ereport-wc__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--control-height);
    padding: var(--control-padding-block) var(--control-padding-inline);
    border-radius: var(--border-radius);
    border: var(--border-width) solid transparent;
    font-family: var(--font-family);
    font-size: var(--font-size-md);
    cursor: pointer;
    align-self: flex-start;
  }

  .ereport-wc__btn--primary {
    background: var(--color-button-bg);
    color: var(--color-button-fg);
    border-color: var(--color-button-bg);
  }

  .ereport-wc__btn--ghost {
    background: transparent;
    color: var(--color-text);
    border-color: var(--color-border);
  }
</style>

<script>
  import { startEreportWebConnector } from "../../lib/ereport-web-connector";

  const root = document.querySelector("[data-ereport-web-connector]");
  if (root instanceof HTMLElement) {
    startEreportWebConnector(root);
  }
</script>
