---
import { Fragment } from "astro/jsx-runtime";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="eostore · Products dashboard" robots="noindex,nofollow">
  <Fragment slot="dhs">
    <button class="dhs-action" type="button" data-refresh title="Refresh" aria-label="Refresh">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">refresh</span>
      </span>
      Refresh
    </button>
  </Fragment>

  <section class="eostore-board" data-eostore-admin>
    <h1>eostore</h1>
    <p class="lede">Products dashboard: manage catalog companies, sections, types, and inventory-backed products (USD + Bs).</p>
    <p class="status" data-banner>Checking session…</p>

    <div class="eostore-tabs" role="tablist" data-tabs>
      <button type="button" class="btn" data-tab="companies" aria-selected="false">Companies</button>
      <button type="button" class="btn" data-tab="sections" aria-selected="false">Sections</button>
      <button type="button" class="btn" data-tab="types" aria-selected="false">Types</button>
      <button type="button" class="btn" data-tab="products" aria-selected="true">Products</button>
      <button type="button" class="btn" data-tab="import" aria-selected="false">Import</button>
    </div>

    <div class="eostore-pane" data-pane="companies" hidden>
      <form class="eostore-panel" data-company-form hidden>
        <h2 data-company-form-title>Add company</h2>
        <input type="hidden" data-co-edit-guid value="" />
        <div class="eostore-field">
          <label for="co-name">Name</label>
          <input id="co-name" type="text" data-co-name required />
          <p class="eostore-error" data-co-error="name" hidden></p>
        </div>
        <div class="eostore-field">
          <label for="co-id">Public id / slug (optional)</label>
          <input id="co-id" type="text" data-co-id placeholder="acme" />
          <p class="eostore-hint">Used in the public store URL, for example /store/acme.</p>
          <p class="eostore-error" data-co-error="id" hidden></p>
        </div>
        <div class="eostore-field">
          <label for="co-desc">Description</label>
          <textarea id="co-desc" data-co-desc></textarea>
        </div>
        <div class="eostore-actions">
          <button class="btn btn--primary" type="submit" data-company-submit>Create company</button>
          <button class="btn" type="button" data-company-cancel hidden>Cancel edit</button>
        </div>
      </form>
      <div class="eostore-columns" data-company-list></div>
    </div>

    <div class="eostore-pane" data-pane="sections" hidden>
      <form class="eostore-panel" data-section-form hidden>
        <h2 data-section-form-title>Add product section</h2>
        <input type="hidden" data-sec-edit-guid value="" />
        <div class="eostore-field">
          <label for="sec-company">Company</label>
          <select id="sec-company" data-sec-company required></select>
          <p class="eostore-error" data-sec-error="company_guid" hidden></p>
        </div>
        <div class="eostore-field">
          <label for="sec-name">Name</label>
          <input id="sec-name" type="text" data-sec-name required />
          <p class="eostore-error" data-sec-error="name" hidden></p>
        </div>
        <div class="eostore-field">
          <label for="sec-id">Friendly id (optional)</label>
          <input id="sec-id" type="text" data-sec-id />
        </div>
        <div class="eostore-field">
          <label for="sec-desc">Description</label>
          <textarea id="sec-desc" data-sec-desc></textarea>
        </div>
        <div class="eostore-actions">
          <button class="btn btn--primary" type="submit" data-section-submit>Create section</button>
          <button class="btn" type="button" data-section-cancel hidden>Cancel edit</button>
        </div>
      </form>
      <div class="eostore-columns" data-section-list></div>
    </div>

    <div class="eostore-pane" data-pane="types" hidden>
      <form class="eostore-panel" data-type-form hidden>
        <h2 data-type-form-title>Add product type</h2>
        <input type="hidden" data-typ-edit-guid value="" />
        <div class="eostore-field">
          <label for="typ-section">Section</label>
          <select id="typ-section" data-typ-section required></select>
          <p class="eostore-error" data-typ-error="section_guid" hidden></p>
        </div>
        <div class="eostore-field">
          <label for="typ-name">Name</label>
          <input id="typ-name" type="text" data-typ-name required />
          <p class="eostore-error" data-typ-error="name" hidden></p>
        </div>
        <div class="eostore-field">
          <label for="typ-id">Friendly id (optional)</label>
          <input id="typ-id" type="text" data-typ-id />
        </div>
        <div class="eostore-field">
          <label for="typ-desc">Description</label>
          <textarea id="typ-desc" data-typ-desc></textarea>
        </div>
        <div class="eostore-actions">
          <button class="btn btn--primary" type="submit" data-type-submit>Create type</button>
          <button class="btn" type="button" data-type-cancel hidden>Cancel edit</button>
        </div>
      </form>
      <div class="eostore-columns" data-type-list></div>
    </div>

    <div class="eostore-pane" data-pane="products">
      <div class="eostore-toolbar">
        <div class="eostore-field">
          <label for="pr-search">Search</label>
          <input id="pr-search" type="search" data-pr-search placeholder="Name, id, SKU, #tag" />
        </div>
        <div class="eostore-field">
          <label for="pr-filter-status">Status</label>
          <select id="pr-filter-status" data-pr-filter-status>
            <option value="all">All</option>
            <option value="active">Active</option>
            <option value="draft">Draft</option>
            <option value="archived">Archived</option>
          </select>
        </div>
        <div class="eostore-field">
          <label for="pr-filter-section">Section</label>
          <select id="pr-filter-section" data-pr-filter-section></select>
        </div>
        <div class="eostore-field">
          <label for="pr-sort">Sort</label>
          <select id="pr-sort" data-pr-sort>
            <option value="recent">Recently updated</option>
            <option value="name">Name</option>
            <option value="price">Price</option>
            <option value="stock">Stock</option>
          </select>
        </div>
        <div class="eostore-field">
          <label for="pr-filter-stock">Stock</label>
          <select id="pr-filter-stock" data-pr-filter-stock>
            <option value="all">All</option>
            <option value="attention">Needs attention</option>
            <option value="low">Low stock</option>
            <option value="out">Out of stock</option>
            <option value="in">In stock</option>
          </select>
        </div>
        <div class="eostore-actions">
          <button class="btn btn--primary" type="button" data-product-new>New product</button>
        </div>
      </div>

      <p class="eostore-meta" data-inventory-summary></p>

      <form class="eostore-panel eostore-editor" data-product-form hidden novalidate>
        <fieldset class="eostore-fieldset">
          <legend data-product-form-title>Add product</legend>
          <input type="hidden" data-pr-edit-guid value="" />
          <div class="eostore-field">
            <label for="pr-type">Product type</label>
            <select id="pr-type" data-pr-type required></select>
            <p class="eostore-error" data-error="type_guid" hidden></p>
          </div>
          <div class="eostore-field">
            <label for="pr-name">Name</label>
            <input id="pr-name" type="text" data-pr-name required />
            <p class="eostore-error" data-error="name" hidden></p>
          </div>
          <div class="eostore-field">
            <label for="pr-id">Slug / friendly id (optional)</label>
            <input id="pr-id" type="text" data-pr-id placeholder="beach-towel" />
            <p class="eostore-hint" data-pr-slug-preview></p>
            <p class="eostore-error" data-error="id" hidden></p>
          </div>
          <div class="eostore-field">
            <label for="pr-desc">Description</label>
            <textarea id="pr-desc" data-pr-desc></textarea>
          </div>
          <div class="eostore-ai" data-pr-ai hidden>
            <p class="eostore-meta">AI description (DeepSeek vision)</p>
            <div class="eostore-field">
              <label for="pr-ai-words">Length <span data-pr-ai-words-label>100 words</span></label>
              <input id="pr-ai-words" type="range" data-pr-ai-words min="25" max="1000" step="25" value="100" />
            </div>
            <div class="eostore-actions">
              <button class="btn btn--primary" type="button" data-pr-ai-generate>Regenerate description</button>
            </div>
            <p class="eostore-hint" data-pr-ai-hint hidden>Save the product and upload at least one image to enable AI.</p>
          </div>
          <div class="eostore-field">
            <label for="pr-tags">Hashtags (space or comma separated)</label>
            <input id="pr-tags" type="text" data-pr-tags placeholder="coast soft" />
          </div>
        </fieldset>

        <fieldset class="eostore-fieldset">
          <legend>Pricing</legend>
          <div class="eostore-field">
            <label for="pr-usd">Base price USD</label>
            <input id="pr-usd" type="number" data-pr-usd min="0" step="0.01" value="0" required />
            <p class="eostore-error" data-error="price_base_usd" hidden></p>
          </div>
          <div class="eostore-field">
            <label for="pr-discount">Discount <span data-pr-discount-label>0%</span></label>
            <input id="pr-discount" type="range" data-pr-discount min="0" max="100" step="5" value="0" />
            <p class="eostore-error" data-error="discount_percent" hidden></p>
          </div>
          <div class="eostore-field">
            <label for="pr-bs">Bs per USD</label>
            <input id="pr-bs" type="number" data-pr-bs min="0" step="0.01" value="0" required />
            <p class="eostore-error" data-error="bs_per_usd" hidden></p>
          </div>
          <p class="eostore-price" data-pr-preview>Final: $0.00 · Bs 0.00</p>
        </fieldset>

        <fieldset class="eostore-fieldset">
          <legend>Inventory</legend>
          <div class="eostore-field">
            <label for="pr-units">Units</label>
            <input id="pr-units" type="number" data-pr-units min="0" step="1" value="0" required />
            <p class="eostore-error" data-error="units" hidden></p>
            <p class="eostore-hint" data-pr-stock-hint></p>
          </div>
        </fieldset>

        <fieldset class="eostore-fieldset">
          <legend>Publishing &amp; SEO</legend>
          <div class="eostore-field">
            <label for="pr-status">Status</label>
            <select id="pr-status" data-pr-status>
              <option value="draft">Draft</option>
              <option value="active">Active</option>
              <option value="archived">Archived</option>
            </select>
            <p class="eostore-hint">Active products appear in the public store.</p>
            <p class="eostore-error" data-error="status" hidden></p>
          </div>
          <div class="eostore-field">
            <label for="pr-sku">SKU (optional)</label>
            <input id="pr-sku" type="text" data-pr-sku />
          </div>
          <div class="eostore-field">
            <label for="pr-seo-title">SEO title (optional)</label>
            <input id="pr-seo-title" type="text" data-pr-seo-title maxlength="120" />
          </div>
          <div class="eostore-field">
            <label for="pr-seo-desc">SEO description (optional)</label>
            <textarea id="pr-seo-desc" data-pr-seo-desc maxlength="320"></textarea>
          </div>
        </fieldset>

        <fieldset class="eostore-fieldset" data-pr-images-section>
          <legend>Media</legend>
          <div class="eostore-field" data-pr-new-image-hint>
            <p class="eostore-hint">Save the product first, then add images.</p>
          </div>
          <div class="eostore-field" data-pr-image-upload hidden>
            <label for="pr-image-file">Add image</label>
            <input id="pr-image-file" type="file" data-pr-image-file accept="image/jpeg,image/png,image/webp" />
            <div class="eostore-gallery" data-pr-gallery></div>
          </div>
        </fieldset>

        <div class="eostore-actions">
          <button class="btn btn--primary" type="submit" data-product-submit>Create product</button>
          <button class="btn" type="button" data-product-duplicate hidden>Duplicate</button>
          <button class="btn" type="button" data-product-cancel hidden>Cancel edit</button>
          <span class="eostore-hint" data-pr-dirty hidden>Unsaved changes</span>
        </div>
      </form>

      <div class="eostore-columns" data-product-list></div>
      <div class="eostore-pagination" data-product-pagination hidden></div>
    </div>

    <div class="eostore-pane" data-pane="import" hidden>
      <div class="eostore-panel eostore-import">
        <h2>Import catalog</h2>
        <p class="eostore-hint">
          Paste or load an eostore import payload. Import is idempotent: matching company,
          section, type, and product ids are updated and the rest are created. Validate with a
          dry run first if unsure.
        </p>
        <div class="eostore-field">
          <label for="import-file">Load JSON file</label>
          <input id="import-file" type="file" data-import-file accept="application/json,.json" />
        </div>
        <div class="eostore-field">
          <label for="import-json">Payload</label>
          <textarea id="import-json" data-import-json spellcheck="false" placeholder='{ "company": { "id": "your-company", "name": "Your Company" }, "sections": [], "products": [] }'></textarea>
        </div>
        <div class="eostore-actions">
          <button class="btn" type="button" data-import-dry>Validate (dry run)</button>
          <button class="btn btn--primary" type="button" data-import-run>Import</button>
          <span class="eostore-hint" data-import-status></span>
        </div>
        <pre class="eostore-import-result" data-import-result hidden></pre>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { getMe } from "../../lib/api";
  import { refreshStoreChrome } from "../../lib/chrome";
  import { showErrorModal } from "../../lib/error-modal";
  import { mustLog } from "../../lib/dev-log";
  import {
    createCompany,
    createProduct,
    createSection,
    createType,
    companyCartHref,
    companyProductHref,
    companyStoreHref,
    deleteCompany,
    deleteProduct,
    deleteProductImage,
    deleteSection,
    deleteType,
    describeProduct,
    filterProducts,
    formatMoney,
    hasFieldErrors,
    importCatalog,
    listCompanies,
    listProducts,
    listSections,
    listTypes,
    pageSlice,
    parseHashtags,
    productStatusLabel,
    productStockLabel,
    productStockState,
    reorderProductImages,
    slugifyProduct,
    updateCompany,
    updateProduct,
    updateProductImageAlt,
    updateSection,
    updateType,
    uploadProductImage,
    validateProductInput,
    type EostoreCompany,
    type EostoreProduct,
    type EostoreSection,
    type EostoreType,
    type ProductFieldErrors,
    type ProductSortKey,
  } from "../../lib/eostore";

  const PAGE_SIZE = 10;

  const root = document.querySelector("[data-eostore-admin]");
  if (root instanceof HTMLElement) {
    const banner = root.querySelector("[data-banner]");
    let companies: EostoreCompany[] = [];
    let sections: EostoreSection[] = [];
    let types: EostoreType[] = [];
    let products: EostoreProduct[] = [];
    let tab = "products";
    let page = 1;
    let dirty = false;
    let saving = false;

    const q = <T extends Element = HTMLElement>(sel: string) => root.querySelector(sel) as T | null;

    const setBanner = (text: string, kind = "") => {
      if (banner instanceof HTMLElement) {
        banner.textContent = text;
        banner.className = `status ${kind}`.trim();
      }
    };

    const fail = (message: string, requestId?: string, debug?: string) => {
      setBanner(message, "err");
      showErrorModal({ message, requestId, details: requestId ? `request_id=${requestId}` : "", debug });
    };

    const fillSelect = (el: Element | null, options: { value: string; label: string }[], placeholder: string) => {
      if (!(el instanceof HTMLSelectElement)) return;
      const prev = el.value;
      el.innerHTML = "";
      const empty = document.createElement("option");
      empty.value = "";
      empty.textContent = placeholder;
      el.appendChild(empty);
      options.forEach((opt) => {
        const o = document.createElement("option");
        o.value = opt.value;
        o.textContent = opt.label;
        el.appendChild(o);
      });
      if (prev && options.some((opt) => opt.value === prev)) el.value = prev;
    };

    const companyLabel = (guid: string) => companies.find((c) => c.guid === guid)?.name || guid;
    const sectionLabel = (guid: string) => {
      const s = sections.find((x) => x.guid === guid);
      return s ? `${s.name} · ${companyLabel(s.company_guid)}` : guid;
    };
    const typeLabel = (guid: string) => {
      const t = types.find((x) => x.guid === guid);
      return t ? `${t.name} · ${sectionLabel(t.section_guid)}` : guid;
    };

    const refreshCatalogSelects = () => {
      fillSelect(
        q("[data-sec-company]"),
        companies.map((c) => ({ value: c.guid, label: `${c.name} (${c.id})` })),
        "Select company",
      );
      fillSelect(
        q("[data-typ-section]"),
        sections.map((s) => ({ value: s.guid, label: `${s.name} · ${companyLabel(s.company_guid)}` })),
        "Select section",
      );
      fillSelect(
        q("[data-pr-type]"),
        types.map((t) => ({ value: t.guid, label: typeLabel(t.guid) })),
        "Select type",
      );
      fillSelect(
        q("[data-pr-filter-section]"),
        sections.map((s) => ({ value: s.guid, label: `${s.name} · ${companyLabel(s.company_guid)}` })),
        "All sections",
      );
    };

    // --- company / section / type forms ---

    const setValue = (sel: string, value: string) => {
      const el = root.querySelector(sel);
      if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el instanceof HTMLSelectElement) {
        el.value = value;
      }
    };

    const setFormGroups = (
      prefix: string,
      opts: { title: string; submit: string; editing: boolean },
    ) => {
      const title = q(`[data-${prefix}-form-title]`);
      if (title) title.textContent = opts.title;
      const submit = q(`[data-${prefix}-submit]`);
      if (submit) submit.textContent = opts.submit;
      const cancel = q(`[data-${prefix}-cancel]`);
      if (cancel instanceof HTMLElement) cancel.hidden = !opts.editing;
    };

    const clearGroupErrors = (prefix: string) => {
      root.querySelectorAll(`[data-${prefix}-error]`).forEach((el) => {
        if (el instanceof HTMLElement) {
          el.hidden = true;
          el.textContent = "";
        }
      });
    };

    const showGroupErrors = (prefix: string, errors: Record<string, string>) => {
      clearGroupErrors(prefix);
      Object.entries(errors).forEach(([field, message]) => {
        const el = root.querySelector(`[data-${prefix}-error="${field}"]`);
        if (el instanceof HTMLElement) {
          el.textContent = message;
          el.hidden = false;
        }
      });
    };

    const setEditGuid = (sel: string, guid: string) => {
      const el = q<HTMLInputElement>(sel);
      if (el) el.value = guid;
    };

    const clearCompanyForm = () => {
      const form = q<HTMLFormElement>("[data-company-form]");
      if (form) form.reset();
      setEditGuid("[data-co-edit-guid]", "");
      setFormGroups("company", { title: "Add company", submit: "Create company", editing: false });
      clearGroupErrors("co");
    };

    const fillCompanyForm = (c: EostoreCompany) => {
      setEditGuid("[data-co-edit-guid]", c.guid);
      setValue("[data-co-name]", c.name || "");
      setValue("[data-co-id]", c.id || "");
      setValue("[data-co-desc]", c.description || "");
      setFormGroups("company", { title: `Edit company · ${c.name}`, submit: "Save changes", editing: true });
      clearGroupErrors("co");
      q("[data-company-form]")?.scrollIntoView({ behavior: "smooth", block: "start" });
    };

    const clearSectionForm = () => {
      const form = q<HTMLFormElement>("[data-section-form]");
      if (form) form.reset();
      setEditGuid("[data-sec-edit-guid]", "");
      setFormGroups("section", { title: "Add product section", submit: "Create section", editing: false });
      clearGroupErrors("sec");
    };

    const fillSectionForm = (s: EostoreSection) => {
      refreshCatalogSelects();
      setEditGuid("[data-sec-edit-guid]", s.guid);
      setValue("[data-sec-company]", s.company_guid || "");
      setValue("[data-sec-name]", s.name || "");
      setValue("[data-sec-id]", s.id || "");
      setValue("[data-sec-desc]", s.description || "");
      setFormGroups("section", { title: `Edit section · ${s.name}`, submit: "Save changes", editing: true });
      clearGroupErrors("sec");
      q("[data-section-form]")?.scrollIntoView({ behavior: "smooth", block: "start" });
    };

    const clearTypeForm = () => {
      const form = q<HTMLFormElement>("[data-type-form]");
      if (form) form.reset();
      setEditGuid("[data-typ-edit-guid]", "");
      setFormGroups("type", { title: "Add product type", submit: "Create type", editing: false });
      clearGroupErrors("typ");
    };

    const fillTypeForm = (t: EostoreType) => {
      refreshCatalogSelects();
      setEditGuid("[data-typ-edit-guid]", t.guid);
      setValue("[data-typ-section]", t.section_guid || "");
      setValue("[data-typ-name]", t.name || "");
      setValue("[data-typ-id]", t.id || "");
      setValue("[data-typ-desc]", t.description || "");
      setFormGroups("type", { title: `Edit type · ${t.name}`, submit: "Save changes", editing: true });
      clearGroupErrors("typ");
      q("[data-type-form]")?.scrollIntoView({ behavior: "smooth", block: "start" });
    };

    const confirmDelete = (title: string, detail: string): boolean =>
      window.confirm(detail ? `${title}\n\n${detail}` : title);

    // --- render companies / sections / types ---

    const renderCompanies = () => {
      const list = q("[data-company-list]");
      if (!(list instanceof HTMLElement)) return;
      list.innerHTML = "";
      if (!companies.length) {
        list.appendChild(hint("No companies yet. Add your first company above."));
        return;
      }
      companies.forEach((c) => {
        const card = document.createElement("article");
        card.className = "eostore-card";
        const h = document.createElement("h3");
        h.textContent = c.name;
        const companySections = sections.filter((s) => s.company_guid === c.guid);
        const companyTypes = types.filter((t) => t.company_guid === c.guid);
        const companyProducts = products.filter((p) => p.company_guid === c.guid);
        const meta = document.createElement("p");
        meta.className = "eostore-meta";
        meta.textContent = `id ${c.id} · ${companySections.length} section(s) · ${companyTypes.length} type(s) · ${companyProducts.length} product(s)`;
        const desc = document.createElement("p");
        desc.className = "eostore-hint";
        desc.textContent = c.description || "";
        const actions = document.createElement("div");
        actions.className = "eostore-actions";
        const openStore = document.createElement("a");
        openStore.className = "btn btn--primary";
        openStore.href = companyStoreHref(c.id);
        openStore.setAttribute("data-route", "");
        openStore.textContent = "Open store";
        const openCart = document.createElement("a");
        openCart.className = "btn";
        openCart.href = companyCartHref(c.id);
        openCart.setAttribute("data-route", "");
        openCart.textContent = "Cart";
        const edit = document.createElement("button");
        edit.type = "button";
        edit.className = "btn";
        edit.textContent = "Edit";
        edit.addEventListener("click", () => fillCompanyForm(c));
        const del = document.createElement("button");
        del.type = "button";
        del.className = "btn";
        del.textContent = "Delete";
        del.addEventListener("click", async () => {
          const children = companySections.length + companyTypes.length + companyProducts.length;
          const detail = children
            ? `This permanently deletes ${companySections.length} section(s), ${companyTypes.length} type(s), and ${companyProducts.length} product(s) with their images.`
            : "This company has no products yet.";
          if (!confirmDelete(`Delete “${c.name}”?`, detail)) return;
          const res = await deleteCompany(c.guid);
          if (res.status !== 200) {
            fail(res.data.message || "Delete failed.", res.requestId, res.data.debug);
            return;
          }
          if (currentCompanyGuid() === c.guid) clearCompanyForm();
          setBanner(`Deleted company “${c.name}”.`);
          void refreshStoreChrome();
          await loadAll();
        });
        actions.append(openStore, openCart, edit, del);
        card.append(h, meta, desc, actions);
        list.appendChild(card);
      });
    };

    const renderSections = () => {
      const list = q("[data-section-list]");
      if (!(list instanceof HTMLElement)) return;
      list.innerHTML = "";
      if (!sections.length) {
        list.appendChild(hint("No sections yet. Add a section under a company."));
        return;
      }
      sections.forEach((s) => {
        const card = document.createElement("article");
        card.className = "eostore-card";
        const h = document.createElement("h3");
        h.textContent = s.name;
        const sectionTypes = types.filter((t) => t.section_guid === s.guid);
        const sectionProducts = products.filter((p) => p.section_guid === s.guid);
        const meta = document.createElement("p");
        meta.className = "eostore-meta";
        meta.textContent = `id ${s.id} · ${companyLabel(s.company_guid)} · ${sectionTypes.length} type(s) · ${sectionProducts.length} product(s)`;
        const desc = document.createElement("p");
        desc.className = "eostore-hint";
        desc.textContent = s.description || "";
        const actions = document.createElement("div");
        actions.className = "eostore-actions";
        const edit = document.createElement("button");
        edit.type = "button";
        edit.className = "btn";
        edit.textContent = "Edit";
        edit.addEventListener("click", () => fillSectionForm(s));
        const del = document.createElement("button");
        del.type = "button";
        del.className = "btn";
        del.textContent = "Delete";
        del.addEventListener("click", async () => {
          const detail = `This permanently deletes ${sectionTypes.length} type(s) and ${sectionProducts.length} product(s) with their images.`;
          if (!confirmDelete(`Delete section “${s.name}”?`, detail)) return;
          const res = await deleteSection(s.guid);
          if (res.status !== 200) {
            fail(res.data.message || "Delete failed.", res.requestId, res.data.debug);
            return;
          }
          setBanner(`Deleted section “${s.name}”.`);
          await loadAll();
        });
        actions.append(edit, del);
        card.append(h, meta, desc, actions);
        list.appendChild(card);
      });
    };

    const renderTypes = () => {
      const list = q("[data-type-list]");
      if (!(list instanceof HTMLElement)) return;
      list.innerHTML = "";
      if (!types.length) {
        list.appendChild(hint("No types yet. Add a type under a section."));
        return;
      }
      types.forEach((t) => {
        const card = document.createElement("article");
        card.className = "eostore-card";
        const h = document.createElement("h3");
        h.textContent = t.name;
        const typeProducts = products.filter((p) => p.type_guid === t.guid);
        const meta = document.createElement("p");
        meta.className = "eostore-meta";
        meta.textContent = `id ${t.id} · ${sectionLabel(t.section_guid)} · ${typeProducts.length} product(s)`;
        const desc = document.createElement("p");
        desc.className = "eostore-hint";
        desc.textContent = t.description || "";
        const actions = document.createElement("div");
        actions.className = "eostore-actions";
        const edit = document.createElement("button");
        edit.type = "button";
        edit.className = "btn";
        edit.textContent = "Edit";
        edit.addEventListener("click", () => fillTypeForm(t));
        const del = document.createElement("button");
        del.type = "button";
        del.className = "btn";
        del.textContent = "Delete";
        del.addEventListener("click", async () => {
          const detail = `This permanently deletes ${typeProducts.length} product(s) with their images.`;
          if (!confirmDelete(`Delete type “${t.name}”?`, detail)) return;
          const res = await deleteType(t.guid);
          if (res.status !== 200) {
            fail(res.data.message || "Delete failed.", res.requestId, res.data.debug);
            return;
          }
          setBanner(`Deleted type “${t.name}”.`);
          await loadAll();
        });
        actions.append(edit, del);
        card.append(h, meta, desc, actions);
        list.appendChild(card);
      });
    };

    const hint = (text: string) => {
      const p = document.createElement("p");
      p.className = "eostore-hint";
      p.textContent = text;
      return p;
    };

    const badge = (text: string, kind: string) => {
      const span = document.createElement("span");
      span.className = `eostore-badge eostore-badge--${kind}`;
      span.textContent = text;
      return span;
    };

    // --- product list with search / filter / sort / pagination ---

    const filteredProducts = () =>
      filterProducts(products, {
        query: (q<HTMLInputElement>("[data-pr-search]")?.value || "").trim(),
        sectionGuid: q<HTMLSelectElement>("[data-pr-filter-section]")?.value || "",
        status: q<HTMLSelectElement>("[data-pr-filter-status]")?.value || "all",
        stock: (q<HTMLSelectElement>("[data-pr-filter-stock]")?.value || "all") as
          | "all"
          | "in"
          | "low"
          | "out"
          | "attention",
        sort: (q<HTMLSelectElement>("[data-pr-sort]")?.value || "recent") as ProductSortKey,
      });

    const renderInventorySummary = () => {
      const el = q("[data-inventory-summary]");
      if (!(el instanceof HTMLElement)) return;
      if (!products.length) {
        el.textContent = "";
        return;
      }
      const units = products.reduce((n, p) => n + (Number(p.units) || 0), 0);
      const low = products.filter((p) => productStockState(p.units) === "low").length;
      const out = products.filter((p) => productStockState(p.units) === "out").length;
      const value = products.reduce(
        (n, p) => n + (Number(p.price_final_usd ?? p.price_base_usd) || 0) * (Number(p.units) || 0),
        0,
      );
      el.textContent = `${products.length} products · ${units} units in stock · ${low} low · ${out} out · inventory value $${formatMoney(value)}`;
    };

    const renderProducts = () => {
      const list = q("[data-product-list]");
      if (!(list instanceof HTMLElement)) return;
      renderInventorySummary();
      list.innerHTML = "";
      const all = filteredProducts();
      const slice = pageSlice(all, page, PAGE_SIZE);
      page = slice.page;

      if (!products.length) {
        list.appendChild(hint("No products yet. Choose a type and create one."));
        renderPagination(0, 1);
        return;
      }
      if (!all.length) {
        list.appendChild(hint("No products match these filters."));
        renderPagination(0, 1);
        return;
      }
      slice.items.forEach((p) => list.appendChild(productCard(p)));
      renderPagination(slice.total, slice.pages);
    };

    const renderPagination = (total: number, pages: number) => {
      const wrap = q("[data-product-pagination]");
      if (!(wrap instanceof HTMLElement)) return;
      wrap.innerHTML = "";
      wrap.hidden = pages <= 1;
      if (pages <= 1) return;
      const prev = document.createElement("button");
      prev.type = "button";
      prev.className = "btn";
      prev.textContent = "Previous";
      prev.disabled = page <= 1;
      prev.addEventListener("click", () => {
        page -= 1;
        renderProducts();
      });
      const label = document.createElement("span");
      label.className = "eostore-meta";
      label.textContent = `Page ${page} of ${pages} · ${total} products`;
      const next = document.createElement("button");
      next.type = "button";
      next.className = "btn";
      next.textContent = "Next";
      next.disabled = page >= pages;
      next.addEventListener("click", () => {
        page += 1;
        renderProducts();
      });
      wrap.append(prev, label, next);
    };

    const productCard = (p: EostoreProduct) => {
      const card = document.createElement("article");
      card.className = "eostore-card";

      const head = document.createElement("div");
      head.className = "eostore-card-head";
      const h = document.createElement("h3");
      h.textContent = p.name;
      head.appendChild(h);
      head.appendChild(badge(productStatusLabel(p.status), p.status || "draft"));
      if (p.discount_percent > 0) head.appendChild(badge(`−${p.discount_percent}%`, "sale"));
      const stock = productStockState(p.units);
      if (stock !== "in") head.appendChild(badge(productStockLabel(p.units), stock));

      const meta = document.createElement("p");
      meta.className = "eostore-meta";
      meta.textContent = `id ${p.id} · guid ${p.guid} · ${typeLabel(p.type_guid)}`;

      const price = document.createElement("p");
      price.className = "eostore-price";
      price.textContent = `USD ${formatMoney(p.price_base_usd)} − ${p.discount_percent}% → ${formatMoney(p.price_final_usd)} · Bs ${formatMoney(p.price_bs)} (${formatMoney(p.bs_per_usd)} Bs/USD) · ${p.units} units`;

      const tags = document.createElement("p");
      tags.className = "eostore-hint";
      tags.textContent = (p.hashtags || []).map((t) => `#${t}`).join(" ");

      const desc = document.createElement("p");
      desc.className = "eostore-desc";
      desc.textContent = p.description || "";

      const thumbs = document.createElement("div");
      thumbs.className = "eostore-thumbs";
      (p.images || []).slice(0, 4).forEach((img) => {
        const wrap = document.createElement("div");
        wrap.className = "eostore-thumb";
        if (img.url) {
          const image = document.createElement("img");
          image.src = img.url;
          image.alt = img.alt || p.name;
          wrap.appendChild(image);
        }
        thumbs.appendChild(wrap);
      });

      const inventory = document.createElement("div");
      inventory.className = "eostore-inventory";
      const invLabel = document.createElement("span");
      invLabel.className = "eostore-hint";
      invLabel.textContent = "Stock";
      const dec = document.createElement("button");
      dec.type = "button";
      dec.className = "btn";
      dec.textContent = "−";
      dec.setAttribute("aria-label", `Decrease stock for ${p.name}`);
      const invInput = document.createElement("input");
      invInput.type = "number";
      invInput.min = "0";
      invInput.step = "1";
      invInput.value = String(p.units ?? 0);
      invInput.setAttribute("aria-label", `Stock units for ${p.name}`);
      const inc = document.createElement("button");
      inc.type = "button";
      inc.className = "btn";
      inc.textContent = "+";
      inc.setAttribute("aria-label", `Increase stock for ${p.name}`);
      const saveStock = document.createElement("button");
      saveStock.type = "button";
      saveStock.className = "btn btn--primary";
      saveStock.textContent = "Save stock";
      const commitStock = async (units: number) => {
        const next = Math.max(0, Math.floor(units) || 0);
        invInput.value = String(next);
        saveStock.disabled = true;
        const res = await updateProduct(p.guid, { units: next });
        saveStock.disabled = false;
        if (res.status !== 200 || !res.data.product) {
          fail(res.data.message || "Could not update stock.", res.requestId, res.data.debug);
          return;
        }
        applyProductUpdate(res.data.product);
        setBanner(`Stock updated · ${res.data.product.name} now ${res.data.product.units}.`);
      };
      dec.addEventListener("click", () => void commitStock((Number(invInput.value) || 0) - 1));
      inc.addEventListener("click", () => void commitStock((Number(invInput.value) || 0) + 1));
      saveStock.addEventListener("click", () => void commitStock(Number(invInput.value) || 0));
      inventory.append(invLabel, dec, invInput, inc, saveStock);

      const actions = document.createElement("div");
      actions.className = "eostore-actions";
      const edit = document.createElement("button");
      edit.type = "button";
      edit.className = "btn btn--primary";
      edit.textContent = "Edit";
      edit.addEventListener("click", () => {
        if (!confirmDiscard()) return;
        fillProductForm(p);
        q("[data-product-form]")?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
      const dup = document.createElement("button");
      dup.type = "button";
      dup.className = "btn";
      dup.textContent = "Duplicate";
      dup.addEventListener("click", () => {
        if (!confirmDiscard()) return;
        duplicateInto(p);
      });
      const del = document.createElement("button");
      del.type = "button";
      del.className = "btn";
      del.textContent = "Delete";
      del.addEventListener("click", async () => {
        const res = await deleteProduct(p.guid);
        if (res.status !== 200) {
          fail(res.data.message || "Delete failed.", res.requestId, res.data.debug);
          return;
        }
        if (currentEditGuid() === p.guid) clearProductForm();
        await loadAll();
      });
      actions.append(edit, dup, del);

      card.append(head, meta, price, tags, desc, thumbs, inventory, actions);
      return card;
    };

    // --- product editor ---

    const currentEditGuid = () => (q<HTMLInputElement>("[data-pr-edit-guid]")?.value || "").trim();
    const currentCompanyGuid = () => (q<HTMLInputElement>("[data-co-edit-guid]")?.value || "").trim();
    const currentSectionGuid = () => (q<HTMLInputElement>("[data-sec-edit-guid]")?.value || "").trim();
    const currentTypeGuid = () => (q<HTMLInputElement>("[data-typ-edit-guid]")?.value || "").trim();

    const setDirty = (value: boolean) => {
      dirty = value;
      const flag = q("[data-pr-dirty]");
      if (flag instanceof HTMLElement) flag.hidden = !value;
    };

    const confirmDiscard = (): boolean => {
      if (!dirty) return true;
      return window.confirm("Discard unsaved changes?");
    };

    const clearErrors = () => {
      root.querySelectorAll("[data-error]").forEach((el) => {
        if (el instanceof HTMLElement) {
          el.hidden = true;
          el.textContent = "";
        }
      });
    };

    const showErrors = (errors: ProductFieldErrors) => {
      clearErrors();
      Object.entries(errors).forEach(([field, message]) => {
        const el = root.querySelector(`[data-error="${field}"]`);
        if (el instanceof HTMLElement) {
          el.textContent = message;
          el.hidden = false;
        }
      });
      const first = Object.keys(errors)[0];
      const input = first ? root.querySelector(`[data-pr-${fieldAttr(first)}]`) : null;
      if (input instanceof HTMLElement) input.focus();
    };

    const fieldAttr = (name: string) => {
      switch (name) {
        case "type_guid":
          return "type";
        case "price_base_usd":
          return "usd";
        case "discount_percent":
          return "discount";
        case "bs_per_usd":
          return "bs";
        default:
          return name === "id" ? "id" : name;
      }
    };

    const updatePreview = () => {
      const usd = Number(q<HTMLInputElement>("[data-pr-usd]")?.value || 0);
      const discount = Number(q<HTMLInputElement>("[data-pr-discount]")?.value || 0);
      const bs = Number(q<HTMLInputElement>("[data-pr-bs]")?.value || 0);
      const label = q("[data-pr-discount-label]");
      if (label) label.textContent = `${discount}%`;
      const finalUsd = usd * (1 - discount / 100);
      const preview = q("[data-pr-preview]");
      if (preview) preview.textContent = `Final: $${formatMoney(finalUsd)} · Bs ${formatMoney(finalUsd * bs)}`;
    };

    const updateSlugPreview = () => {
      const el = q("[data-pr-slug-preview]");
      if (!(el instanceof HTMLElement)) return;
      const typed = (q<HTMLInputElement>("[data-pr-id]")?.value || "").trim();
      const typeGuid = q<HTMLSelectElement>("[data-pr-type]")?.value || "";
      const typ = types.find((t) => t.guid === typeGuid);
      const sec = typ ? sections.find((s) => s.guid === typ.section_guid) : undefined;
      const company = sec ? companies.find((c) => c.guid === sec.company_guid) : undefined;
      const slug = typed || slugifyProduct(q<HTMLInputElement>("[data-pr-name]")?.value || "");
      if (!company || !slug) {
        el.textContent = "";
        return;
      }
      el.textContent = `Public URL: ${companyProductHref(company.id, slug)}`;
    };

    const updateStockHint = () => {
      const el = q("[data-pr-stock-hint]");
      if (!(el instanceof HTMLElement)) return;
      const units = Number(q<HTMLInputElement>("[data-pr-units]")?.value || 0);
      const state = productStockState(units);
      el.textContent = state === "out" ? "Shown as out of stock." : state === "low" ? "Shown as low stock." : "";
    };

    const renderGallery = (p: EostoreProduct | null) => {
      const gallery = q("[data-pr-gallery]");
      const upload = q("[data-pr-image-upload]");
      const newHint = q("[data-pr-new-image-hint]");
      if (!(gallery instanceof HTMLElement)) return;
      gallery.innerHTML = "";
      const exists = Boolean(p && p.guid);
      if (upload instanceof HTMLElement) upload.hidden = !exists;
      if (newHint instanceof HTMLElement) newHint.hidden = exists;
      if (!exists || !p) return;
      const images = p.images || [];
      if (!images.length) {
        gallery.appendChild(hint("No images yet. Upload a JPEG, PNG, or WebP (max 8 MB)."));
        return;
      }
      images.forEach((img, index) => {
        const item = document.createElement("div");
        item.className = "eostore-gallery-item";
        item.draggable = true;
        item.dataset.index = String(index);
        if (img.url) {
          const image = document.createElement("img");
          image.src = img.url;
          image.alt = img.alt || p.name;
          item.appendChild(image);
        }
        const altLabel = document.createElement("label");
        altLabel.className = "eostore-gallery-alt";
        const altText = document.createElement("span");
        altText.textContent = index === 0 ? "Alt text · primary" : "Alt text";
        const altInput = document.createElement("input");
        altInput.type = "text";
        altInput.value = img.alt || "";
        altInput.maxLength = 200;
        altInput.placeholder = "Describe the image";
        altInput.addEventListener("change", async () => {
          const res = await updateProductImageAlt(p.guid, img.id, altInput.value.trim());
          if (res.status !== 200 || !res.data.product) {
            fail(res.data.message || "Could not save alt text.", res.requestId, res.data.debug);
            return;
          }
          applyProductUpdate(res.data.product);
        });
        altLabel.append(altText, altInput);
        item.appendChild(altLabel);

        const controls = document.createElement("div");
        controls.className = "eostore-gallery-controls";
        const up = document.createElement("button");
        up.type = "button";
        up.className = "btn";
        up.textContent = "◀";
        up.title = "Move left";
        up.disabled = index === 0;
        up.addEventListener("click", () => void moveImage(p, index, index - 1));
        const down = document.createElement("button");
        down.type = "button";
        down.className = "btn";
        down.textContent = "▶";
        down.title = "Move right";
        down.disabled = index === images.length - 1;
        down.addEventListener("click", () => void moveImage(p, index, index + 1));
        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "btn";
        remove.textContent = "Remove";
        remove.addEventListener("click", async () => {
          const res = await deleteProductImage(p.guid, img.id);
          if (res.status !== 200 || !res.data.product) {
            fail(res.data.message || "Image delete failed.", res.requestId, res.data.debug);
            return;
          }
          applyProductUpdate(res.data.product);
        });
        controls.append(up, down, remove);
        item.appendChild(controls);
        gallery.appendChild(item);
      });
    };

    const moveImage = async (p: EostoreProduct, from: number, to: number) => {
      const ids = (p.images || []).map((img) => img.id);
      if (to < 0 || to >= ids.length) return;
      const [moved] = ids.splice(from, 1);
      ids.splice(to, 0, moved);
      const res = await reorderProductImages(p.guid, ids);
      if (res.status !== 200 || !res.data.product) {
        fail(res.data.message || "Could not reorder images.", res.requestId, res.data.debug);
        return;
      }
      applyProductUpdate(res.data.product);
    };

    const applyProductUpdate = (updated: EostoreProduct) => {
      const idx = products.findIndex((x) => x.guid === updated.guid);
      if (idx >= 0) products[idx] = updated;
      else products.push(updated);
      renderProducts();
      if (currentEditGuid() === updated.guid) {
        renderGallery(updated);
        setAiPanel(updated);
      }
    };

    const setAiPanel = (p: EostoreProduct | null) => {
      const panel = q("[data-pr-ai]");
      const gen = q("[data-pr-ai-generate]");
      const hintEl = q("[data-pr-ai-hint]");
      if (!(panel instanceof HTMLElement)) return;
      if (!p || !p.guid) {
        panel.hidden = true;
        return;
      }
      panel.hidden = false;
      const hasImages = (p.images || []).length > 0;
      if (gen instanceof HTMLButtonElement) {
        gen.disabled = !hasImages;
        gen.hidden = false;
      }
      if (hintEl instanceof HTMLElement) hintEl.hidden = hasImages;
    };

    const readForm = () => ({
      editGuid: currentEditGuid(),
      type_guid: q<HTMLSelectElement>("[data-pr-type]")?.value || "",
      id: (q<HTMLInputElement>("[data-pr-id]")?.value || "").trim(),
      name: (q<HTMLInputElement>("[data-pr-name]")?.value || "").trim(),
      description: (q<HTMLTextAreaElement>("[data-pr-desc]")?.value || "").trim(),
      hashtags: parseHashtags(q<HTMLInputElement>("[data-pr-tags]")?.value || ""),
      price_base_usd: Number(q<HTMLInputElement>("[data-pr-usd]")?.value || 0),
      discount_percent: Number(q<HTMLInputElement>("[data-pr-discount]")?.value || 0),
      bs_per_usd: Number(q<HTMLInputElement>("[data-pr-bs]")?.value || 0),
      units: Number(q<HTMLInputElement>("[data-pr-units]")?.value || 0),
      status: q<HTMLSelectElement>("[data-pr-status]")?.value || "draft",
      sku: (q<HTMLInputElement>("[data-pr-sku]")?.value || "").trim(),
      seo_title: (q<HTMLInputElement>("[data-pr-seo-title]")?.value || "").trim(),
      seo_description: (q<HTMLTextAreaElement>("[data-pr-seo-desc]")?.value || "").trim(),
    });

    const clearProductForm = () => {
      const form = q("[data-product-form]");
      if (form instanceof HTMLFormElement) form.reset();
      const editGuid = q<HTMLInputElement>("[data-pr-edit-guid]");
      if (editGuid) editGuid.value = "";
      const title = q("[data-product-form-title]");
      if (title) title.textContent = "Add product";
      const submit = q<HTMLButtonElement>("[data-product-submit]");
      if (submit) submit.textContent = "Create product";
      const cancel = q("[data-product-cancel]");
      if (cancel instanceof HTMLElement) cancel.hidden = true;
      const dup = q("[data-product-duplicate]");
      if (dup instanceof HTMLElement) dup.hidden = true;
      const status = q<HTMLSelectElement>("[data-pr-status]");
      if (status) status.value = "draft";
      const wordsEl = q<HTMLInputElement>("[data-pr-ai-words]");
      if (wordsEl) wordsEl.value = "100";
      const wordsLabel = q("[data-pr-ai-words-label]");
      if (wordsLabel) wordsLabel.textContent = "100 words";
      clearErrors();
      setAiPanel(null);
      renderGallery(null);
      updatePreview();
      updateSlugPreview();
      updateStockHint();
      setDirty(false);
    };

    const fillProductForm = (p: EostoreProduct) => {
      refreshCatalogSelects();
      const set = (sel: string, value: string) => {
        const el = root.querySelector(sel);
        if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el instanceof HTMLSelectElement) el.value = value;
      };
      const editGuid = q<HTMLInputElement>("[data-pr-edit-guid]");
      if (editGuid) editGuid.value = p.guid;
      set("[data-pr-type]", p.type_guid || "");
      set("[data-pr-name]", p.name || "");
      set("[data-pr-id]", p.id || "");
      set("[data-pr-desc]", p.description || "");
      set("[data-pr-tags]", (p.hashtags || []).join(" "));
      set("[data-pr-usd]", String(p.price_base_usd ?? 0));
      set("[data-pr-discount]", String(p.discount_percent ?? 0));
      set("[data-pr-bs]", String(p.bs_per_usd ?? 0));
      set("[data-pr-units]", String(p.units ?? 0));
      set("[data-pr-status]", p.status || "draft");
      set("[data-pr-sku]", p.sku || "");
      set("[data-pr-seo-title]", p.seo_title || "");
      set("[data-pr-seo-desc]", p.seo_description || "");
      const title = q("[data-product-form-title]");
      if (title) title.textContent = `Edit product · ${p.name}`;
      const submit = q<HTMLButtonElement>("[data-product-submit]");
      if (submit) submit.textContent = "Save changes";
      const cancel = q("[data-product-cancel]");
      if (cancel instanceof HTMLElement) cancel.hidden = false;
      const dup = q("[data-product-duplicate]");
      if (dup instanceof HTMLElement) dup.hidden = false;
      clearErrors();
      setAiPanel(p);
      renderGallery(p);
      updatePreview();
      updateSlugPreview();
      updateStockHint();
      setDirty(false);
      if (mustLog) console.log("eostore.product.edit.fill", { guid: p.guid, id: p.id, status: p.status, images: (p.images || []).length });
    };

    const duplicateInto = (p: EostoreProduct) => {
      clearProductForm();
      const editGuid = q<HTMLInputElement>("[data-pr-edit-guid]");
      if (editGuid) editGuid.value = "";
      const set = (sel: string, value: string) => {
        const el = root.querySelector(sel);
        if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el instanceof HTMLSelectElement) el.value = value;
      };
      set("[data-pr-type]", p.type_guid || "");
      set("[data-pr-name]", `${p.name} copy`);
      set("[data-pr-id]", "");
      set("[data-pr-desc]", p.description || "");
      set("[data-pr-tags]", (p.hashtags || []).join(" "));
      set("[data-pr-usd]", String(p.price_base_usd ?? 0));
      set("[data-pr-discount]", String(p.discount_percent ?? 0));
      set("[data-pr-bs]", String(p.bs_per_usd ?? 0));
      set("[data-pr-units]", "0");
      set("[data-pr-status]", "draft");
      set("[data-pr-sku]", "");
      set("[data-pr-seo-title]", p.seo_title || "");
      set("[data-pr-seo-desc]", p.seo_description || "");
      const title = q("[data-product-form-title]");
      if (title) title.textContent = `Duplicate product · ${p.name}`;
      const submit = q<HTMLButtonElement>("[data-product-submit]");
      if (submit) submit.textContent = "Create product";
      const cancel = q("[data-product-cancel]");
      if (cancel instanceof HTMLElement) cancel.hidden = false;
      const dup = q("[data-product-duplicate]");
      if (dup instanceof HTMLElement) dup.hidden = true;
      renderGallery(null);
      setAiPanel(null);
      updatePreview();
      updateSlugPreview();
      updateStockHint();
      setDirty(true);
      q("[data-product-form]")?.scrollIntoView({ behavior: "smooth", block: "start" });
    };

    // --- events ---

    root.querySelector("[data-tabs]")?.addEventListener("click", (ev) => {
      const btn = (ev.target as HTMLElement)?.closest?.("[data-tab]");
      if (!(btn instanceof HTMLButtonElement) || !btn.dataset.tab) return;
      if (btn.dataset.tab !== "products" && !confirmDiscard()) return;
      showTab(btn.dataset.tab);
    });

    const showTab = (next: string) => {
      tab = next;
      root.querySelectorAll("[data-tab]").forEach((btn) => {
        if (btn instanceof HTMLButtonElement) {
          btn.setAttribute("aria-selected", btn.dataset.tab === next ? "true" : "false");
        }
      });
      root.querySelectorAll("[data-pane]").forEach((pane) => {
        if (pane instanceof HTMLElement) pane.hidden = pane.dataset.pane !== next;
      });
    };

    q("[data-product-new]")?.addEventListener("click", () => {
      if (!confirmDiscard()) return;
      clearProductForm();
      q("[data-product-form]")?.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    q("[data-product-cancel]")?.addEventListener("click", () => {
      if (!confirmDiscard()) return;
      clearProductForm();
    });

    q("[data-product-duplicate]")?.addEventListener("click", () => {
      const guid = currentEditGuid();
      const p = products.find((x) => x.guid === guid);
      if (p) duplicateInto(p);
    });

    const form = q<HTMLFormElement>("[data-product-form]");
    form?.addEventListener("input", () => {
      if (form.dataset.loading === "true") return;
      setDirty(true);
    });

    q("[data-pr-name]")?.addEventListener("input", updateSlugPreview);
    q("[data-pr-id]")?.addEventListener("input", updateSlugPreview);
    q("[data-pr-type]")?.addEventListener("change", updateSlugPreview);
    q("[data-pr-usd]")?.addEventListener("input", updatePreview);
    q("[data-pr-discount]")?.addEventListener("input", updatePreview);
    q("[data-pr-bs]")?.addEventListener("input", updatePreview);
    q("[data-pr-units]")?.addEventListener("input", updateStockHint);
    q("[data-pr-ai-words]")?.addEventListener("input", () => {
      const label = q("[data-pr-ai-words-label]");
      const n = Number(q<HTMLInputElement>("[data-pr-ai-words]")?.value || 100);
      if (label) label.textContent = `${n} words`;
    });

    q("[data-pr-image-file]")?.addEventListener("change", async () => {
      const input = q<HTMLInputElement>("[data-pr-image-file]");
      const guid = currentEditGuid();
      const file = input?.files?.[0];
      if (!input || !guid || !file) return;
      const product = products.find((x) => x.guid === guid);
      input.disabled = true;
      const res = await uploadProductImage(guid, file);
      input.disabled = false;
      input.value = "";
      if (res.status !== 200 || !res.data.product) {
        fail(res.data.message || "Upload failed.", res.requestId, res.data.debug);
        return;
      }
      applyProductUpdate(res.data.product);
      if (product) renderGallery(res.data.product);
    });

    q("[data-pr-ai-generate]")?.addEventListener("click", async () => {
      const guid = currentEditGuid();
      if (!guid) return;
      const product = products.find((x) => x.guid === guid);
      if (!product) {
        fail("Save the product before generating a description.");
        return;
      }
      const images = product.images || [];
      if (!images.length) {
        fail("Upload at least one product image before generating a description.");
        return;
      }
      const gen = q<HTMLButtonElement>("[data-pr-ai-generate]");
      if (gen) gen.disabled = true;
      const wordCount = Number(q<HTMLInputElement>("[data-pr-ai-words]")?.value || 100);
      const latestImageId = images[images.length - 1]?.id || "";
      const res = await describeProduct(guid, wordCount, latestImageId);
      if (gen) gen.disabled = false;
      if (res.status !== 200) {
        fail(res.data.message || "AI description failed.", res.requestId, res.data.debug);
        return;
      }
      await loadAll();
      const updated = products.find((x) => x.guid === guid);
      if (updated) fillProductForm(updated);
    });

    form?.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      if (saving) return;
      const input = readForm();
      const errors = validateProductInput(input);
      if (hasFieldErrors(errors)) {
        showErrors(errors);
        return;
      }
      clearErrors();
      const body = {
        type_guid: input.type_guid,
        name: input.name,
        id: input.id,
        description: input.description,
        hashtags: input.hashtags,
        price_base_usd: input.price_base_usd,
        discount_percent: input.discount_percent,
        bs_per_usd: input.bs_per_usd,
        units: input.units,
        status: input.status,
        sku: input.sku,
        seo_title: input.seo_title,
        seo_description: input.seo_description,
        visible: input.status === "active",
      };
      saving = true;
      const submit = q<HTMLButtonElement>("[data-product-submit]");
      if (submit) submit.disabled = true;
      const res = input.editGuid ? await updateProduct(input.editGuid, body) : await createProduct(body);
      saving = false;
      if (submit) submit.disabled = false;
      if (res.status !== 200 || !res.data.product) {
        fail(
          res.data.message || (input.editGuid ? "Update product failed." : "Create product failed."),
          res.requestId,
          res.data.debug,
        );
        return;
      }
      const saved = res.data.product;
      const idx = products.findIndex((x) => x.guid === saved.guid);
      if (idx >= 0) products[idx] = saved;
      else products.push(saved);
      renderProducts();
      fillProductForm(saved);
      setBanner(`Saved ${saved.name}.`);
    });

    q("[data-company-form]")?.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      const guid = currentCompanyGuid();
      const name = (q<HTMLInputElement>("[data-co-name]")?.value || "").trim();
      const id = (q<HTMLInputElement>("[data-co-id]")?.value || "").trim();
      const description = (q<HTMLTextAreaElement>("[data-co-desc]")?.value || "").trim();
      const errors: Record<string, string> = {};
      if (!name) errors.name = "Name is required.";
      if (id && !slugifyProduct(id)) errors.id = "Use letters, numbers, and hyphens.";
      if (Object.keys(errors).length) {
        showGroupErrors("co", errors);
        return;
      }
      const submit = q<HTMLButtonElement>("[data-company-submit]");
      if (submit) submit.disabled = true;
      const res = guid
        ? await updateCompany(guid, { id, name, description })
        : await createCompany({ id, name, description });
      if (submit) submit.disabled = false;
      if (res.status !== 200) {
        fail(res.data.message || "Save company failed.", res.requestId, res.data.debug);
        return;
      }
      clearCompanyForm();
      setBanner(guid ? `Saved company “${name}”.` : `Created company “${name}”.`);
      void refreshStoreChrome();
      await loadAll();
    });
    q("[data-company-cancel]")?.addEventListener("click", () => clearCompanyForm());

    q("[data-section-form]")?.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      const guid = currentSectionGuid();
      const company_guid = q<HTMLSelectElement>("[data-sec-company]")?.value || "";
      const name = (q<HTMLInputElement>("[data-sec-name]")?.value || "").trim();
      const id = (q<HTMLInputElement>("[data-sec-id]")?.value || "").trim();
      const description = (q<HTMLTextAreaElement>("[data-sec-desc]")?.value || "").trim();
      const errors: Record<string, string> = {};
      if (!company_guid) errors.company_guid = "Choose a company.";
      if (!name) errors.name = "Name is required.";
      if (Object.keys(errors).length) {
        showGroupErrors("sec", errors);
        return;
      }
      const submit = q<HTMLButtonElement>("[data-section-submit]");
      if (submit) submit.disabled = true;
      const res = guid
        ? await updateSection(guid, { id, name, description })
        : await createSection({ company_guid, id, name, description });
      if (submit) submit.disabled = false;
      if (res.status !== 200) {
        fail(res.data.message || "Save section failed.", res.requestId, res.data.debug);
        return;
      }
      clearSectionForm();
      setBanner(guid ? `Saved section “${name}”.` : `Created section “${name}”.`);
      await loadAll();
    });
    q("[data-section-cancel]")?.addEventListener("click", () => clearSectionForm());

    q("[data-type-form]")?.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      const guid = currentTypeGuid();
      const section_guid = q<HTMLSelectElement>("[data-typ-section]")?.value || "";
      const name = (q<HTMLInputElement>("[data-typ-name]")?.value || "").trim();
      const id = (q<HTMLInputElement>("[data-typ-id]")?.value || "").trim();
      const description = (q<HTMLTextAreaElement>("[data-typ-desc]")?.value || "").trim();
      const errors: Record<string, string> = {};
      if (!section_guid) errors.section_guid = "Choose a section.";
      if (!name) errors.name = "Name is required.";
      if (Object.keys(errors).length) {
        showGroupErrors("typ", errors);
        return;
      }
      const submit = q<HTMLButtonElement>("[data-type-submit]");
      if (submit) submit.disabled = true;
      const res = guid
        ? await updateType(guid, { id, name, description })
        : await createType({ section_guid, id, name, description });
      if (submit) submit.disabled = false;
      if (res.status !== 200) {
        fail(res.data.message || "Save type failed.", res.requestId, res.data.debug);
        return;
      }
      clearTypeForm();
      setBanner(guid ? `Saved type “${name}”.` : `Created type “${name}”.`);
      await loadAll();
    });
    q("[data-type-cancel]")?.addEventListener("click", () => clearTypeForm());

    const setImportStatus = (text: string, kind = "") => {
      const status = q("[data-import-status]");
      if (status) {
        status.textContent = text;
        status.className = `eostore-hint ${kind}`.trim();
      }
    };

    const readImportPayload = (): Record<string, unknown> | null => {
      const raw = (q<HTMLTextAreaElement>("[data-import-json]")?.value || "").trim();
      if (!raw) {
        setImportStatus("Paste or load a JSON payload first.", "err");
        return null;
      }
      try {
        const parsed = JSON.parse(raw);
        if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
          setImportStatus("Payload must be a JSON object.", "err");
          return null;
        }
        return parsed as Record<string, unknown>;
      } catch {
        setImportStatus("Payload is not valid JSON.", "err");
        return null;
      }
    };

    const runImport = async (dryRun: boolean) => {
      const payload = readImportPayload();
      if (!payload) {
        return;
      }
      const btn = q<HTMLButtonElement>(dryRun ? "[data-import-dry]" : "[data-import-run]");
      if (btn) btn.disabled = true;
      setImportStatus(dryRun ? "Validating…" : "Importing…");
      payload.dry_run = dryRun;
      const res = await importCatalog(payload);
      if (btn) btn.disabled = false;
      if (res.status !== 200) {
        setImportStatus("Import failed.", "err");
        fail(res.data.message || "Import failed.", res.requestId, res.data.debug);
        return;
      }
      const data = res.data;
      const summary = [
        `company ${data.company_created ? "created" : "reused"}`,
        `sections +${data.sections_created ?? 0}`,
        `types +${data.types_created ?? 0}`,
        `products +${data.products_created ?? 0}`,
        `updated ${data.products_updated ?? 0}`,
        `failed ${data.failed ?? 0}`,
      ].join(" · ");
      setImportStatus(`${summary}${data.dry_run ? " (dry run)" : ""}`, (data.failed ?? 0) > 0 ? "err" : "ok");
      const result = q<HTMLPreElement>("[data-import-result]");
      if (result) {
        result.textContent = JSON.stringify(data.results ?? data, null, 2);
        result.hidden = false;
      }
      if (!dryRun) {
        await loadAll();
      }
    };

    q("[data-import-file]")?.addEventListener("change", async () => {
      const input = q<HTMLInputElement>("[data-import-file]");
      const file = input?.files?.[0];
      if (!input || !file) {
        return;
      }
      const text = await file.text();
      const area = q<HTMLTextAreaElement>("[data-import-json]");
      if (area) area.value = text;
      input.value = "";
      setImportStatus(`Loaded ${file.name}.`);
    });

    q("[data-import-dry]")?.addEventListener("click", () => void runImport(true));
    q("[data-import-run]")?.addEventListener("click", () => void runImport(false));

    const onFilterChange = () => {
      page = 1;
      renderProducts();
    };
    q("[data-pr-search]")?.addEventListener("input", onFilterChange);
    q("[data-pr-filter-status]")?.addEventListener("change", onFilterChange);
    q("[data-pr-filter-section]")?.addEventListener("change", onFilterChange);
    q("[data-pr-filter-stock]")?.addEventListener("change", onFilterChange);
    q("[data-pr-sort]")?.addEventListener("change", onFilterChange);

    document.querySelector("[data-refresh]")?.addEventListener("click", () => void loadAll());

    window.addEventListener("beforeunload", (ev) => {
      if (!dirty) return;
      ev.preventDefault();
      ev.returnValue = "";
    });

    // --- data load ---

    const loadAll = async () => {
      if (mustLog) console.log("eostore.load.start", { tab });
      const [c, s, t, p] = await Promise.all([listCompanies(), listSections(), listTypes(), listProducts()]);
      const failed = [c, s, t, p].find((r) => r.status !== 200);
      if (failed) {
        fail(failed.data.message || "Could not load catalog.", failed.requestId, failed.data.debug);
        return;
      }
      companies = c.data.companies || [];
      sections = s.data.sections || [];
      types = t.data.types || [];
      products = p.data.products || [];
      refreshCatalogSelects();
      renderCompanies();
      renderSections();
      renderTypes();
      renderProducts();
      setBanner(`${companies.length} companies · ${sections.length} sections · ${types.length} types · ${products.length} products.`);
      if (mustLog) console.log("eostore.load.ok", { companies: companies.length, products: products.length });
    };

    showTab("products");

    void (async () => {
      const me = await getMe();
      if (me.status !== 200 || me.data.role !== "admin") {
        setBanner("Administrator session required.", "err");
        return;
      }
      root.querySelectorAll("form").forEach((f) => {
        if (f instanceof HTMLElement) f.hidden = false;
      });
      clearProductForm();
      clearCompanyForm();
      clearSectionForm();
      clearTypeForm();
      await loadAll();
    })();
  }
</script>
