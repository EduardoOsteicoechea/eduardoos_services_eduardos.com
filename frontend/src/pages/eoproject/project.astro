---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="eoProject"
  description="Project stages, photos, and IFC versions."
  page="eoproject-project"
  robots="noindex,nofollow"
>
  <Fragment slot="dhs">
    <a class="dhs-action" href="/eoproject" data-route title="All projects" aria-label="All projects">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">folder_open</span>
      </span>
      Projects
    </a>
    <button class="dhs-action" type="button" data-refresh title="Refresh" aria-label="Refresh">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">refresh</span>
      </span>
      Refresh
    </button>
    <button class="dhs-action" type="button" data-share title="Share link" aria-label="Share link">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">share</span>
      </span>
      Share
    </button>
  </Fragment>

  <section class="eoproject product-dash" data-eoproject-project>
    <p class="status" data-banner>Loading…</p>

    <div data-gate hidden class="product-gate">
      <p class="hint">eoProject subscription required.</p>
      <p class="hint">
        <a href="/payments/subscription" data-route>Subscribe</a>
        ·
        <a href="/session" data-route>Sign in</a>
      </p>
    </div>

    <div data-authed hidden>
      <form class="eoproject__toolbar" data-add-stage>
        <label class="eoproject__field">
          New stage
          <input class="eoproject__input" name="name" required maxlength="120" placeholder="Stage name" />
        </label>
        <button class="eoproject__btn eoproject__btn--primary" type="submit">Add stage</button>
      </form>

      <p class="eoproject__empty" data-empty-stages hidden>No stages yet.</p>
      <div class="eoproject__stages" data-stages></div>

      <section class="eoproject__shares">
        <h2 class="eoproject__subhead">Client view</h2>
        <p class="hint">
          Magic link for clients. They see the stages, photos, videos and IFC read-only, in the order you set.
        </p>
        <div class="eoproject__client-panel" data-client-panel></div>
        <h3 class="eoproject__subhead">All links</h3>
        <ul class="eoproject__list" data-shares></ul>
      </section>
    </div>

    <div class="eoproject__modal-backdrop" data-share-modal hidden>
      <div class="eoproject__modal" role="dialog" aria-modal="true" aria-labelledby="eoproject-share-title">
        <div class="eoproject__modal-head">
          <h2 id="eoproject-share-title">Create share link</h2>
          <button
            class="eoproject__icon-btn"
            type="button"
            data-share-close
            title="Close"
            aria-label="Close share dialog"
          >
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
          </button>
        </div>
        <form class="eoproject__toolbar" data-share-form>
          <label class="eoproject__field">
            Label
            <input class="eoproject__input" name="label" maxlength="80" placeholder="Client review" />
          </label>
          <label class="eoproject__field eoproject__field--narrow">
            Duration
            <select class="eoproject__select" name="durationHours">
              <option value="24">24 hours</option>
              <option value="72" selected>72 hours</option>
              <option value="168">7 days</option>
              <option value="720">30 days</option>
            </select>
          </label>
          <button class="eoproject__btn eoproject__btn--primary" type="submit">Create link</button>
        </form>
        <p class="eoproject__link" data-share-result hidden></p>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { mustLog } from "../../lib/dev-log";
  import {
    createEoprojectIfcViewer,
    type EoprojectIfcViewer,
  } from "../../lib/eoproject-ifc-viewer";
  import {
    createEoprojectPhotoViewer,
    downloadEoprojectPhoto,
    loadEoprojectImage,
    type EoprojectPhotoViewerItem,
  } from "../../lib/eoproject-photo-viewer";
  import {
    createEoprojectShare,
    createEoprojectStage,
    deleteEoprojectDocument,
    deleteEoprojectIfc,
    deleteEoprojectPhoto,
    deleteEoprojectShare,
    deleteEoprojectStage,
    deleteEoprojectVideo,
    eoprojectDocumentFileUrl,
    eoprojectIfcFileUrl,
    eoprojectInvitePageUrl,
    eoprojectPhotoFileUrl,
    eoprojectVideoFileUrl,
    fetchEoprojectDashboard,
    listEoprojectDocuments,
    listEoprojectShares,
    reorderEoprojectPhotos,
    reorderEoprojectStages,
    updateEoprojectPhotoTag,
    uploadEoprojectDocument,
    uploadEoprojectIfc,
    uploadEoprojectPhoto,
    uploadEoprojectVideo,
    type EoprojectDashboard,
    type EoprojectPhoto,
    type EoprojectPhotoDocument,
    type EoprojectShare,
    type EoprojectStageBundle,
  } from "../../lib/eoproject";
  import type { UploadProgress } from "../../lib/api";
  import { clearAgentRoutePayload, setAgentRoutePayload } from "../../lib/api";
  import { apiFail, requireService, setHidden } from "../../lib/productGate";

  const root = document.querySelector("[data-eoproject-project]");
  const banner = root?.querySelector("[data-banner]");
  const gate = root?.querySelector("[data-gate]");
  const authed = root?.querySelector("[data-authed]");
  const titleEl = document.querySelector("[data-page-title], [data-title]");
  const descEl = root?.querySelector("[data-desc]");
  const stagesEl = root?.querySelector("[data-stages]");
  const emptyStages = root?.querySelector("[data-empty-stages]");
  const sharesEl = root?.querySelector("[data-shares]");
  const clientPanel = root?.querySelector("[data-client-panel]");
  const shareModal = root?.querySelector("[data-share-modal]");
  const shareResult = root?.querySelector("[data-share-result]");

  const projectId = new URLSearchParams(location.search).get("id") || "";
  let dashboard: EoprojectDashboard | null = null;
  const viewers = new Map<string, EoprojectIfcViewer>();
  const photoViewer = createEoprojectPhotoViewer();

  function setBanner(text: string) {
    if (banner instanceof HTMLElement) banner.textContent = text;
  }

  function iconBtn(name: string, label: string, danger = false): HTMLButtonElement {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = danger
      ? "eoproject__icon-btn eoproject__icon-btn--danger"
      : "eoproject__icon-btn";
    btn.title = label;
    btn.setAttribute("aria-label", label);
    const icon = document.createElement("span");
    icon.className = "material-symbols-outlined";
    icon.setAttribute("aria-hidden", "true");
    icon.textContent = name;
    btn.appendChild(icon);
    return btn;
  }

  function progressEl(label: string): { root: HTMLDivElement; set: (percent: number) => void } {
    const root = document.createElement("div");
    root.className = "eoproject__progress";
    const text = document.createElement("span");
    text.textContent = label;
    const bar = document.createElement("div");
    bar.className = "eoproject__progress-bar";
    const fill = document.createElement("span");
    fill.className = "eoproject__progress-fill";
    bar.appendChild(fill);
    root.append(text, bar);
    const set = (percent: number) => {
      fill.style.width = `${Math.max(0, Math.min(100, percent))}%`;
    };
    return { root, set };
  }

  function readVideoDuration(file: File): Promise<number> {
    return new Promise((resolve) => {
      const url = URL.createObjectURL(file);
      const video = document.createElement("video");
      video.preload = "metadata";
      video.onloadedmetadata = () => {
        URL.revokeObjectURL(url);
        resolve(Number.isFinite(video.duration) ? video.duration : 0);
      };
      video.onerror = () => {
        URL.revokeObjectURL(url);
        resolve(0);
      };
      video.src = url;
    });
  }

  function photoItemsForStage(bundle: EoprojectStageBundle): EoprojectPhotoViewerItem[] {
    return bundle.photos.map((photo) => {
      const src = photo.url || eoprojectPhotoFileUrl(projectId, bundle.stage.id, photo.id);
      return {
        src,
        downloadUrl: src,
        name: photo.originalName || `photo-${photo.id}`,
      };
    });
  }

  function orderedStages(): EoprojectStageBundle[] {
    if (!dashboard) return [];
    return [...dashboard.stages].sort(
      (a, b) => a.stage.sortOrder - b.stage.sortOrder || a.stage.name.localeCompare(b.stage.name),
    );
  }

  async function moveStage(stageId: string, delta: number) {
    const list = orderedStages();
    const idx = list.findIndex((b) => b.stage.id === stageId);
    const target = idx + delta;
    if (idx < 0 || target < 0 || target >= list.length) return;
    const ids = list.map((b) => b.stage.id);
    [ids[idx], ids[target]] = [ids[target], ids[idx]];
    const res = await reorderEoprojectStages(projectId, ids);
    if (!res.ok) {
      apiFail(res.error || "Could not reorder stages.", { requestId: res.requestId });
      return;
    }
    await reload();
  }

  async function movePhoto(stageId: string, photoId: string, delta: number) {
    const bundle = dashboard?.stages.find((s) => s.stage.id === stageId);
    if (!bundle) return;
    const ids = bundle.photos.map((p) => p.id);
    const idx = ids.indexOf(photoId);
    const target = idx + delta;
    if (idx < 0 || target < 0 || target >= ids.length) return;
    [ids[idx], ids[target]] = [ids[target], ids[idx]];
    const res = await reorderEoprojectPhotos(projectId, stageId, ids);
    if (!res.ok) {
      apiFail(res.error || "Could not reorder photos.", { requestId: res.requestId });
      return;
    }
    await reload();
  }

  async function ensureViewer(stageId: string, host: HTMLElement): Promise<EoprojectIfcViewer> {
    let viewer = viewers.get(stageId);
    if (viewer) return viewer;
    viewer = await createEoprojectIfcViewer(host);
    viewers.set(stageId, viewer);
    return viewer;
  }

  async function loadIfc(stageId: string, versionId: string, statusEl: HTMLElement | null) {
    const host = stagesEl?.querySelector<HTMLElement>(`[data-viewer="${stageId}"]`);
    if (!host) return;
    if (statusEl) statusEl.textContent = "Loading IFC…";
    try {
      const viewer = await ensureViewer(stageId, host);
      await viewer.loadFromUrl(eoprojectIfcFileUrl(projectId, stageId, versionId), {
        credentials: "include",
      });
      if (statusEl) statusEl.textContent = "IFC loaded.";
    } catch (err) {
      if (mustLog) console.log("[eoproject] ifc error", err);
      if (statusEl) statusEl.textContent = "Could not load IFC.";
      apiFail(err instanceof Error ? err.message : "Could not load IFC.");
    }
  }

  function renderDocs(stageId: string, photo: EoprojectPhoto): HTMLElement {
    const wrap = document.createElement("div");
    wrap.className = "eoproject__docs";
    const list = document.createElement("ul");
    list.className = "eoproject__doc-list";

    const renderList = (docs: EoprojectPhotoDocument[]) => {
      list.replaceChildren();
      for (const d of docs) {
        const li = document.createElement("li");
        li.className = "eoproject__doc-row";
        const link = document.createElement("a");
        link.href = d.url || eoprojectDocumentFileUrl(projectId, stageId, photo.id, d.id);
        link.textContent = d.originalName || d.id;
        link.target = "_blank";
        link.rel = "noopener";
        const del = iconBtn("delete", `Delete document ${d.originalName || ""}`, true);
        del.addEventListener("click", async () => {
          if (!confirm("Delete this document?")) return;
          const res = await deleteEoprojectDocument(projectId, stageId, photo.id, d.id);
          if (!res.ok) {
            apiFail(res.error || "Delete failed.", { requestId: res.requestId });
            return;
          }
          await refreshDocs();
        });
        li.append(link, del);
        list.appendChild(li);
      }
    };

    const refreshDocs = async () => {
      const res = await listEoprojectDocuments(projectId, stageId, photo.id);
      if (res.error) {
        apiFail(res.error, { requestId: res.requestId });
        return;
      }
      renderList(res.documents);
    };

    const attach = document.createElement("form");
    attach.className = "eoproject__upload-row";
    const label = document.createElement("label");
    label.className = "eoproject__field";
    label.append("Attach document");
    const input = document.createElement("input");
    input.className = "eoproject__input";
    input.type = "file";
    input.name = "file";
    input.required = true;
    label.appendChild(input);
    const submit = document.createElement("button");
    submit.type = "submit";
    submit.className = "eoproject__btn";
    submit.textContent = "Upload";
    attach.append(label, submit);
    attach.addEventListener("submit", async (event) => {
      event.preventDefault();
      const file = input.files?.[0];
      if (!file) return;
      const progress = progressEl("Uploading document");
      attach.appendChild(progress.root);
      const res = await uploadEoprojectDocument(projectId, stageId, photo.id, file, (p) => progress.set(p.percent));
      progress.root.remove();
      if (!res.document) {
        apiFail(res.error || "Upload failed.", { requestId: res.requestId });
        return;
      }
      attach.reset();
      await refreshDocs();
    });

    void refreshDocs();
    wrap.append(list, attach);
    return wrap;
  }

  function renderPhotos(bundle: EoprojectStageBundle, mount: HTMLElement) {
    mount.replaceChildren();
    const items = photoItemsForStage(bundle);
    bundle.photos.forEach((photo, photoIndex) => {
      const card = document.createElement("div");
      card.className = "eoproject__photo";

      const src = items[photoIndex]?.src || eoprojectPhotoFileUrl(projectId, bundle.stage.id, photo.id);
      const openBtn = document.createElement("button");
      openBtn.type = "button";
      openBtn.className = "eoproject__photo-thumb";
      openBtn.title = `View ${photo.originalName || "photo"}`;
      openBtn.setAttribute("aria-label", `View ${photo.originalName || "stage photo"}`);
      const img = document.createElement("img");
      img.alt = photo.originalName || "Stage photo";
      img.loading = "lazy";
      loadEoprojectImage(img, src);
      openBtn.appendChild(img);
      openBtn.addEventListener("click", () => photoViewer.open(items, photoIndex));

      const tag = document.createElement("p");
      tag.className = "eoproject__photo-tag";
      tag.textContent = photo.tag || "";
      tag.hidden = !photo.tag;

      const tagInput = document.createElement("input");
      tagInput.className = "eoproject__tag-input";
      tagInput.type = "text";
      tagInput.maxLength = 120;
      tagInput.placeholder = "Add tag";
      tagInput.value = photo.tag || "";
      tagInput.hidden = true;
      tagInput.addEventListener("keydown", async (event) => {
        if (event.key !== "Enter") return;
        event.preventDefault();
        const value = tagInput.value.trim();
        const res = await updateEoprojectPhotoTag(projectId, bundle.stage.id, photo.id, value);
        if (!res.photo) {
          apiFail(res.error || "Could not update tag.", { requestId: res.requestId });
          return;
        }
        tag.textContent = res.photo.tag || "";
        tag.hidden = !res.photo.tag;
        tagInput.value = res.photo.tag || "";
        tagInput.hidden = true;
      });
      tag.addEventListener("dblclick", () => {
        tag.hidden = true;
        tagInput.hidden = false;
        tagInput.focus();
      });

      const caption = document.createElement("div");
      caption.className = "eoproject__photo-caption";
      caption.textContent = photo.originalName || photo.id;

      const actions = document.createElement("div");
      actions.className = "eoproject__photo-actions";
      const downloadBtn = iconBtn("download", `Download ${photo.originalName || "photo"}`);
      downloadBtn.addEventListener("click", async () => {
        try {
          await downloadEoprojectPhoto(
            items[photoIndex]?.downloadUrl || src,
            photo.originalName || `photo-${photo.id}`,
          );
        } catch (err) {
          apiFail(err instanceof Error ? err.message : "Download failed.");
        }
      });
      const del = iconBtn("delete", `Delete photo ${photo.originalName || ""}`, true);
      del.addEventListener("click", async () => {
        if (!confirm("Delete this photo?")) return;
        const res = await deleteEoprojectPhoto(projectId, bundle.stage.id, photo.id);
        if (!res.ok) {
          apiFail(res.error || "Delete failed.", { requestId: res.requestId });
          return;
        }
        await reload();
      });
      const moveUp = iconBtn("arrow_upward", `Move ${photo.originalName || "photo"} up`);
      moveUp.disabled = photoIndex <= 0;
      moveUp.addEventListener("click", () => void movePhoto(bundle.stage.id, photo.id, -1));
      const moveDown = iconBtn("arrow_downward", `Move ${photo.originalName || "photo"} down`);
      moveDown.disabled = photoIndex >= bundle.photos.length - 1;
      moveDown.addEventListener("click", () => void movePhoto(bundle.stage.id, photo.id, 1));
      actions.append(moveUp, moveDown, downloadBtn, del);

      card.append(openBtn, tag, tagInput, caption, actions, renderDocs(bundle.stage.id, photo));
      mount.appendChild(card);
    });
  }

  function renderStage(bundle: EoprojectStageBundle): HTMLElement {
    const section = document.createElement("section");
    section.className = "eoproject__stage";

    const head = document.createElement("div");
    head.className = "eoproject__stage-head";
    const h2 = document.createElement("h2");
    h2.textContent = bundle.stage.name;
    const delStage = iconBtn("delete", `Delete stage ${bundle.stage.name}`, true);
    delStage.addEventListener("click", async () => {
      if (!confirm(`Delete stage “${bundle.stage.name}” and its files?`)) return;
      viewers.get(bundle.stage.id)?.dispose();
      viewers.delete(bundle.stage.id);
      const res = await deleteEoprojectStage(projectId, bundle.stage.id);
      if (!res.ok) {
        apiFail(res.error || "Delete failed.", { requestId: res.requestId });
        return;
      }
      await reload();
    });
    const stageList = orderedStages();
    const stageIdx = stageList.findIndex((b) => b.stage.id === bundle.stage.id);
    const moveUp = iconBtn("arrow_upward", `Move ${bundle.stage.name} up`);
    moveUp.disabled = stageIdx <= 0;
    moveUp.addEventListener("click", () => void moveStage(bundle.stage.id, -1));
    const moveDown = iconBtn("arrow_downward", `Move ${bundle.stage.name} down`);
    moveDown.disabled = stageIdx < 0 || stageIdx >= stageList.length - 1;
    moveDown.addEventListener("click", () => void moveStage(bundle.stage.id, 1));
    head.append(h2, moveUp, moveDown, delStage);

    const photoHead = document.createElement("h3");
    photoHead.className = "eoproject__subhead";
    photoHead.textContent = "Photos";
    const gallery = document.createElement("div");
    gallery.className = "eoproject__gallery";
    renderPhotos(bundle, gallery);

    const photoForm = document.createElement("form");
    photoForm.className = "eoproject__upload-row";
    const photoLabel = document.createElement("label");
    photoLabel.className = "eoproject__field";
    photoLabel.append("Upload photo");
    const photoInput = document.createElement("input");
    photoInput.className = "eoproject__input";
    photoInput.name = "file";
    photoInput.type = "file";
    photoInput.accept = "image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp";
    photoInput.required = true;
    photoLabel.appendChild(photoInput);
    const photoTagField = document.createElement("label");
    photoTagField.className = "eoproject__field eoproject__field--narrow";
    photoTagField.append("Tag");
    const photoTagInput = document.createElement("input");
    photoTagInput.className = "eoproject__input";
    photoTagInput.name = "tag";
    photoTagInput.maxLength = 120;
    photoTagInput.placeholder = "Optional";
    photoTagField.appendChild(photoTagInput);
    const photoSubmit = document.createElement("button");
    photoSubmit.className = "eoproject__btn";
    photoSubmit.type = "submit";
    photoSubmit.textContent = "Upload";
    photoForm.append(photoLabel, photoTagField, photoSubmit);
    photoForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      const file = photoInput.files?.[0];
      if (!file) return;
      const lower = file.name.toLowerCase();
      const okExt = /\.(jpe?g|png|webp)$/.test(lower);
      if (!okExt) {
        apiFail("Use a JPEG, PNG, or WebP image (HEIC/HEIF is not supported).");
        return;
      }
      const progress = progressEl("Uploading photo");
      photoForm.appendChild(progress.root);
      photoSubmit.disabled = true;
      const res = await uploadEoprojectPhoto(projectId, bundle.stage.id, file, {
        tag: photoTagInput.value.trim(),
        onProgress: (p: UploadProgress) => progress.set(p.percent),
      });
      photoSubmit.disabled = false;
      progress.root.remove();
      if (!res.photo) {
        apiFail(res.error || "Upload failed.", { requestId: res.requestId });
        return;
      }
      await reload();
    });

    const ifcHead = document.createElement("h3");
    ifcHead.className = "eoproject__subhead";
    ifcHead.textContent = "IFC models";

    const ifcRow = document.createElement("div");
    ifcRow.className = "eoproject__upload-row";
    const select = document.createElement("select");
    select.className = "eoproject__select";
    select.setAttribute("aria-label", `IFC versions for ${bundle.stage.name}`);
    const versions = [...bundle.ifcVersions].sort((a, b) => b.version - a.version);
    if (versions.length === 0) {
      const opt = document.createElement("option");
      opt.value = "";
      opt.textContent = "No versions yet";
      select.appendChild(opt);
      select.disabled = true;
    } else {
      for (const v of versions) {
        const opt = document.createElement("option");
        opt.value = v.id;
        opt.textContent = `v${v.version}${v.label ? ` — ${v.label}` : ""} (${v.originalName})`;
        select.appendChild(opt);
      }
    }
    const viewBtn = document.createElement("button");
    viewBtn.type = "button";
    viewBtn.className = "eoproject__btn eoproject__btn--primary";
    viewBtn.textContent = "View";
    viewBtn.disabled = versions.length === 0;
    const delIfc = iconBtn("delete", "Delete selected IFC version", true);
    delIfc.disabled = versions.length === 0;

    const viewerHost = document.createElement("div");
    viewerHost.className = "eoproject__viewer";
    viewerHost.dataset.viewer = bundle.stage.id;
    const viewerStatus = document.createElement("p");
    viewerStatus.className = "eoproject__viewer-status";
    viewerStatus.textContent = versions.length
      ? "Select a version and click View."
      : "Upload an IFC file to preview.";

    viewBtn.addEventListener("click", () => {
      if (!select.value) return;
      void loadIfc(bundle.stage.id, select.value, viewerStatus);
    });
    delIfc.addEventListener("click", async () => {
      if (!select.value) return;
      if (!confirm("Delete this IFC version?")) return;
      const res = await deleteEoprojectIfc(projectId, bundle.stage.id, select.value);
      if (!res.ok) {
        apiFail(res.error || "Delete failed.", { requestId: res.requestId });
        return;
      }
      viewers.get(bundle.stage.id)?.dispose();
      viewers.delete(bundle.stage.id);
      await reload();
    });
    ifcRow.append(select, viewBtn, delIfc);

    const ifcForm = document.createElement("form");
    ifcForm.className = "eoproject__upload-row";
    const ifcFileLabel = document.createElement("label");
    ifcFileLabel.className = "eoproject__field";
    ifcFileLabel.append("Upload IFC");
    const ifcInput = document.createElement("input");
    ifcInput.className = "eoproject__input";
    ifcInput.name = "file";
    ifcInput.type = "file";
    ifcInput.accept = ".ifc,application/octet-stream";
    ifcInput.required = true;
    ifcFileLabel.appendChild(ifcInput);
    const ifcLabelField = document.createElement("label");
    ifcLabelField.className = "eoproject__field eoproject__field--narrow";
    ifcLabelField.append("Label");
    const ifcLabelInput = document.createElement("input");
    ifcLabelInput.className = "eoproject__input";
    ifcLabelInput.name = "label";
    ifcLabelInput.maxLength = 80;
    ifcLabelInput.placeholder = "Optional";
    ifcLabelField.appendChild(ifcLabelInput);
    const ifcSubmit = document.createElement("button");
    ifcSubmit.className = "eoproject__btn";
    ifcSubmit.type = "submit";
    ifcSubmit.textContent = "Upload IFC";
    ifcForm.append(ifcFileLabel, ifcLabelField, ifcSubmit);
    ifcForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      const file = ifcInput.files?.[0];
      const label = ifcLabelInput.value.trim();
      if (!file) return;
      const progress = progressEl("Uploading IFC");
      ifcForm.appendChild(progress.root);
      const res = await uploadEoprojectIfc(projectId, bundle.stage.id, file, {
        label: label || undefined,
        onProgress: (p: UploadProgress) => progress.set(p.percent),
      });
      progress.root.remove();
      if (!res.version) {
        apiFail(res.error || "Upload failed.", { requestId: res.requestId });
        return;
      }
      await reload();
    });

    const videoHead = document.createElement("h3");
    videoHead.className = "eoproject__subhead";
    videoHead.textContent = "Videos";
    const videoList = document.createElement("div");
    videoList.className = "eoproject__videos";
    const renderVideos = () => {
      videoList.replaceChildren();
      for (const video of bundle.videos ?? []) {
        const row = document.createElement("div");
        row.className = "eoproject__video-row";
        const player = document.createElement("video");
        player.className = "eoproject__video";
        player.controls = true;
        player.preload = "metadata";
        player.src = video.url || eoprojectVideoFileUrl(projectId, bundle.stage.id, video.id);
        const del = iconBtn("delete", `Delete video ${video.originalName || ""}`, true);
        del.addEventListener("click", async () => {
          if (!confirm("Delete this video?")) return;
          const res = await deleteEoprojectVideo(projectId, bundle.stage.id, video.id);
          if (!res.ok) {
            apiFail(res.error || "Delete failed.", { requestId: res.requestId });
            return;
          }
          await reload();
        });
        row.append(player, del);
        videoList.appendChild(row);
      }
    };
    renderVideos();

    const videoForm = document.createElement("form");
    videoForm.className = "eoproject__upload-row";
    const videoLabel = document.createElement("label");
    videoLabel.className = "eoproject__field";
    videoLabel.append("Upload video");
    const videoInput = document.createElement("input");
    videoInput.className = "eoproject__input";
    videoInput.name = "file";
    videoInput.type = "file";
    videoInput.accept = "video/mp4,.mp4";
    videoInput.required = true;
    videoLabel.appendChild(videoInput);
    const videoSubmit = document.createElement("button");
    videoSubmit.className = "eoproject__btn";
    videoSubmit.type = "submit";
    videoSubmit.textContent = "Upload video";
    videoForm.append(videoLabel, videoSubmit);
    videoForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      const file = videoInput.files?.[0];
      if (!file) return;
      const duration = await readVideoDuration(file);
      if (duration > 600) {
        apiFail("Videos must be 10 minutes or shorter.");
        return;
      }
      const progress = progressEl("Uploading video");
      videoForm.appendChild(progress.root);
      videoSubmit.disabled = true;
      const res = await uploadEoprojectVideo(projectId, bundle.stage.id, file, (p) => progress.set(p.percent));
      videoSubmit.disabled = false;
      progress.root.remove();
      if (!res.video) {
        apiFail(res.error || "Upload failed.", { requestId: res.requestId });
        return;
      }
      await reload();
    });

    const viewerWrap = document.createElement("div");
    viewerWrap.className = "eoproject__viewer-wrap";
    viewerWrap.append(viewerHost, viewerStatus);

    section.append(head, photoHead, gallery, photoForm, ifcHead, ifcRow, ifcForm, videoHead, videoList, videoForm, viewerWrap);
    return section;
  }

  function copyText(value: string, button: HTMLButtonElement, done = "Copied") {
    const original = button.textContent;
    void navigator.clipboard
      .writeText(value)
      .then(() => {
        button.textContent = done;
        globalThis.setTimeout(() => {
          button.textContent = original;
        }, 1500);
      })
      .catch(() => apiFail("Could not copy the link."));
  }

  function createShareButton(label = "Create client link"): HTMLButtonElement {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "eoproject__btn eoproject__btn--primary";
    btn.textContent = label;
    btn.addEventListener("click", () => openShareModal(true));
    return btn;
  }

  function renderClientPanel(shares: EoprojectShare[]) {
    if (!(clientPanel instanceof HTMLElement)) return;
    clientPanel.replaceChildren();
    const active = shares
      .filter(
        (share) =>
          !share.expired && Boolean(share.link) && new Date(share.expiresAt).getTime() > Date.now(),
      )
      .sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime())[0];
    const activeLink = active?.link ?? "";

    if (!active || !activeLink) {
      const empty = document.createElement("p");
      empty.className = "eoproject__empty";
      empty.textContent =
        "No active client link yet. Create one and it will stay visible here.";
      clientPanel.append(empty, createShareButton());
      return;
    }

    const linkRow = document.createElement("div");
    linkRow.className = "eoproject__client-link-row";
    const link = document.createElement("a");
    link.className = "eoproject__client-link";
    link.href = activeLink;
    link.target = "_blank";
    link.rel = "noopener";
    link.textContent = activeLink;
    linkRow.appendChild(link);

    const actions = document.createElement("div");
    actions.className = "eoproject__client-actions";
    const copy = document.createElement("button");
    copy.type = "button";
    copy.className = "eoproject__btn";
    copy.textContent = "Copy link";
    copy.addEventListener("click", () => copyText(activeLink, copy));
    const open = document.createElement("a");
    open.className = "eoproject__btn";
    open.href = activeLink;
    open.target = "_blank";
    open.rel = "noopener";
    open.textContent = "Open";
    actions.append(copy, open, createShareButton("New link"));

    const meta = document.createElement("p");
    meta.className = "eoproject__client-meta";
    meta.textContent = `${active.label || "Client link"} · expires ${new Date(active.expiresAt).toLocaleString()}`;

    const preview = document.createElement("iframe");
    preview.className = "eoproject__client-preview";
    preview.loading = "lazy";
    preview.title = "Client view preview";
    preview.src = activeLink;

    clientPanel.append(linkRow, actions, meta, preview);
  }

  function renderShares(shares: EoprojectShare[]) {
    if (!(sharesEl instanceof HTMLElement)) return;
    sharesEl.replaceChildren();
    for (const share of shares) {
      const li = document.createElement("li");
      li.className = "eoproject__share-row";
      const meta = document.createElement("div");
      meta.className = "eoproject__share-meta";
      const expired = Boolean(share.expired) || new Date(share.expiresAt).getTime() <= Date.now();
      meta.textContent = `${share.label || "Share"} · expires ${new Date(share.expiresAt).toLocaleString()}${expired ? " · expired" : ""}`;
      const del = iconBtn("delete", "Delete share link", true);
      del.addEventListener("click", async () => {
        if (!confirm("Revoke this share link?")) return;
        const res = await deleteEoprojectShare(projectId, share.id);
        if (!res.ok) {
          apiFail(res.error || "Delete failed.", { requestId: res.requestId });
          return;
        }
        await reloadShares();
      });
      li.append(meta, del);
      sharesEl.appendChild(li);
    }
  }

  async function reloadShares() {
    const res = await listEoprojectShares(projectId);
    if (res.error) {
      apiFail(res.error, { requestId: res.requestId });
      return;
    }
    renderShares(res.shares);
    renderClientPanel(res.shares);
  }

  async function reload() {
    for (const v of viewers.values()) v.dispose();
    viewers.clear();
    const res = await fetchEoprojectDashboard(projectId);
    if (!res.dashboard) {
      apiFail(res.error || "Could not load project.", { requestId: res.requestId });
      setBanner("Project unavailable.");
      return;
    }
    dashboard = res.dashboard;
    setAgentRoutePayload({
      kind: "eoproject_dashboard",
      projectId,
      project: dashboard.project,
      stages: dashboard.stages.map((bundle) => ({
        id: bundle.stage.id,
        name: bundle.stage.name,
        sortOrder: bundle.stage.sortOrder,
        photoCount: bundle.photos?.length ?? 0,
        ifcCount: bundle.ifcVersions?.length ?? 0,
      })),
    });
    if (titleEl instanceof HTMLElement) titleEl.textContent = dashboard.project.name;
    if (descEl instanceof HTMLElement) {
      descEl.textContent =
        dashboard.project.description || "Project stages, photos, and IFC versions.";
    }
    const stages = [...dashboard.stages].sort(
      (a, b) => a.stage.sortOrder - b.stage.sortOrder || a.stage.name.localeCompare(b.stage.name),
    );
    setBanner(`${stages.length} stage${stages.length === 1 ? "" : "s"}`);
    setHidden(emptyStages, stages.length > 0);
    if (stagesEl instanceof HTMLElement) {
      stagesEl.replaceChildren();
      for (const bundle of stages) stagesEl.appendChild(renderStage(bundle));
    }
    await reloadShares();
  }

  function openShareModal(open: boolean) {
    setHidden(shareModal, !open);
    if (shareResult instanceof HTMLElement) {
      shareResult.hidden = true;
      shareResult.textContent = "";
    }
  }

  root?.querySelector("[data-add-stage]")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.target as HTMLFormElement;
    const name = String(new FormData(form).get("name") || "").trim();
    if (!name) return;
    const res = await createEoprojectStage(projectId, name);
    if (!res.stage) {
      apiFail(res.error || "Could not create stage.", { requestId: res.requestId });
      return;
    }
    form.reset();
    await reload();
  });

  document.querySelector("[data-refresh]")?.addEventListener("click", () => void reload());
  document.querySelector("[data-share]")?.addEventListener("click", () => openShareModal(true));
  root?.querySelector("[data-share-close]")?.addEventListener("click", () => openShareModal(false));
  shareModal?.addEventListener("click", (event) => {
    if (event.target === shareModal) openShareModal(false);
  });

  root?.querySelector("[data-share-form]")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.target as HTMLFormElement;
    const fd = new FormData(form);
    const label = String(fd.get("label") || "").trim();
    const durationHours = Number(fd.get("durationHours") || 72);
    const res = await createEoprojectShare(projectId, label, durationHours);
    if (!res.share) {
      apiFail(res.error || "Could not create share.", { requestId: res.requestId });
      return;
    }
    const link =
      res.share.link ||
      (res.share.token ? `${location.origin}${eoprojectInvitePageUrl(res.share.token)}` : "");
    if (shareResult instanceof HTMLElement) {
      shareResult.hidden = false;
      shareResult.replaceChildren();
      const linkText = document.createElement("span");
      linkText.textContent = link || "Share created.";
      shareResult.appendChild(linkText);
      if (link) {
        const copy = document.createElement("button");
        copy.type = "button";
        copy.className = "eoproject__btn";
        copy.textContent = "Copy link";
        copy.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(link);
            copy.textContent = "Copied";
            globalThis.setTimeout(() => {
              copy.textContent = "Copy link";
            }, 1500);
          } catch {
            apiFail("Could not copy the link.");
          }
        });
        shareResult.appendChild(copy);
      }
    }
    if (mustLog) console.log("[eoproject] share", res.share.id);
    await reloadShares();
  });

  window.addEventListener("resize", () => {
    for (const v of viewers.values()) v.resize();
  });

  if (!projectId) {
    setBanner("Missing project id.");
    setHidden(gate, false);
  } else {
    const gateResult = await requireService("eoproject");
    if (!gateResult.sessionOk || !gateResult.access.allowed) {
      setBanner(gateResult.sessionOk ? "Subscription required." : "Sign in required.");
      setHidden(gate, false);
      setHidden(authed, true);
    } else {
      setHidden(gate, true);
      setHidden(authed, false);
      await reload();
    }
  }

  document.addEventListener(
    "astro:before-swap",
    () => {
      clearAgentRoutePayload();
    },
    { once: true },
  );
</script>
