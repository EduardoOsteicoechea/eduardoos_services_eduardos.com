---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Session · Eduardoos">
  <section class="session-grid" data-session>
    <h1>Session</h1>
    <p class="lede">
      Sign-in uses HttpOnly cookies. CSRF tokens stay in memory. This page cannot
      authorize anything the Go API would deny.
    </p>
    <p class="status" data-banner>Loading session…</p>

    <form class="panel" data-login hidden>
      <h2>Sign in</h2>
      <label>
        Email or username
        <input name="identifier" autocomplete="username" required />
      </label>
      <label>
        Password
        <input type="password" name="password" autocomplete="current-password" required minlength="12" maxlength="128" />
      </label>
      <button type="submit">Sign in</button>
    </form>

    <form class="panel" data-register hidden>
      <h2>Create account</h2>
      <label>
        Email
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label>
        Username
        <input name="username" autocomplete="username" required minlength="3" maxlength="32" pattern="[a-z0-9_]+" />
      </label>
      <label>
        Password
        <input type="password" name="password" autocomplete="new-password" required minlength="12" maxlength="128" />
      </label>
      <p class="hint">Usernames are 3–32 characters: lowercase letters, digits, underscore.</p>
      <button type="submit">Register</button>
    </form>

    <form class="panel" data-verify hidden>
      <h2>Verify email</h2>
      <label>
        Email
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label>
        Six-digit code
        <input name="otp" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required />
      </label>
      <button type="submit">Verify</button>
    </form>

    <form class="panel" data-resend hidden>
      <h2>Resend verification</h2>
      <label>
        Email
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <button type="submit">Send code</button>
    </form>

    <form class="panel" data-request-reset hidden>
      <h2>Request password reset</h2>
      <label>
        Email
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <button type="submit">Send reset code</button>
    </form>

    <form class="panel" data-reset hidden>
      <h2>Reset password</h2>
      <label>
        Email
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label>
        Six-digit code
        <input name="otp" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required />
      </label>
      <label>
        New password
        <input type="password" name="new_password" autocomplete="new-password" required minlength="12" maxlength="128" />
      </label>
      <button type="submit">Reset password</button>
    </form>

    <div class="panel" data-profile hidden>
      <h2>Profile</h2>
      <p class="hint" data-profile-summary></p>
      <img class="session-avatar" data-avatar-img hidden alt="" />
      <form data-profile-form>
        <label>
          Display name
          <input name="display_name" maxlength="80" />
        </label>
        <label>
          Username
          <input name="username" required minlength="3" maxlength="32" pattern="[a-z0-9_]+" />
        </label>
        <label>
          Phone (E.164)
          <input name="phone" placeholder="+15551234567" />
        </label>
        <button type="submit">Save profile</button>
      </form>
      <form data-avatar-form>
        <label>
          Avatar (JPEG, PNG, or WebP)
          <input type="file" name="file" accept="image/jpeg,image/png,image/webp" />
        </label>
        <button type="submit">Upload avatar</button>
        <button type="button" data-avatar-delete>Remove avatar</button>
      </form>
      <form data-password-form>
        <h2>Change password</h2>
        <label>
          Current password
          <input type="password" name="current_password" autocomplete="current-password" required minlength="12" />
        </label>
        <label>
          New password
          <input type="password" name="new_password" autocomplete="new-password" required minlength="12" maxlength="128" />
        </label>
        <button type="submit">Update password</button>
      </form>
      <button type="button" data-logout>Sign out</button>
    </div>
  </section>
</Layout>

<script>
  import {
    deleteAvatar,
    getCsrf,
    getMe,
    patchJSON,
    postJSON,
    uploadAvatar,
    type MeResponse,
  } from "../lib/api";

  const root = document.querySelector("[data-session]");
  if (root instanceof HTMLElement) {
    const banner = root.querySelector("[data-banner]");
    const signedOut = root.querySelectorAll("[data-login], [data-register], [data-verify], [data-resend], [data-request-reset], [data-reset]");
    const profile = root.querySelector("[data-profile]");
    const summary = root.querySelector("[data-profile-summary]");
    const avatarImg = root.querySelector("[data-avatar-img]");

    const setBanner = (text: string, kind = "") => {
      if (banner instanceof HTMLElement) {
        banner.textContent = text;
        banner.className = `status ${kind}`.trim();
      }
    };

    const setBusy = (form: HTMLFormElement, busy: boolean) => {
      form.querySelectorAll("button, input").forEach((node) => {
        if (node instanceof HTMLButtonElement || node instanceof HTMLInputElement) {
          node.disabled = busy;
        }
      });
    };

    const showSignedOut = (visible: boolean) => {
      signedOut.forEach((node) => {
        if (node instanceof HTMLElement) {
          node.hidden = !visible;
        }
      });
      if (profile instanceof HTMLElement) {
        profile.hidden = visible;
      }
    };

    const fillProfile = (data: MeResponse) => {
      if (summary instanceof HTMLElement) {
        summary.textContent = `${data.email ?? ""} · @${data.username ?? ""} · ${data.role ?? ""}`;
      }
      const form = root.querySelector("[data-profile-form]");
      if (form instanceof HTMLFormElement) {
        const display = form.elements.namedItem("display_name");
        const username = form.elements.namedItem("username");
        const phone = form.elements.namedItem("phone");
        if (display instanceof HTMLInputElement) display.value = data.display_name ?? "";
        if (username instanceof HTMLInputElement) username.value = data.username ?? "";
        if (phone instanceof HTMLInputElement) phone.value = data.phone ?? "";
      }
      if (avatarImg instanceof HTMLImageElement) {
        if (data.avatar) {
          avatarImg.src = `/api/profile/avatar?ts=${Date.now()}`;
          avatarImg.hidden = false;
        } else {
          avatarImg.removeAttribute("src");
          avatarImg.hidden = true;
        }
      }
    };

    const applyMe = async () => {
      setBanner("Loading session…");
      const { status, data } = await getMe();
      if (status === 401) {
        showSignedOut(true);
        setBanner("Sign in or create an account.", "");
        return;
      }
      if (status !== 200) {
        showSignedOut(true);
        setBanner("Could not load the session.", "err");
        return;
      }
      showSignedOut(false);
      fillProfile(data);
      setBanner("Signed in. Profile changes apply only to your account.", "ok");
    };

    const genericMessage = (status: number, data: MeResponse, success: string) => {
      if (status === 429) return { text: "Too many attempts. Try later.", kind: "err" };
      if (status === 409) return { text: "That username is already taken.", kind: "err" };
      if (status === 413) return { text: "That file is too large.", kind: "err" };
      if (status === 403) return { text: "The request was rejected.", kind: "err" };
      if (status === 401) return { text: data.error === "invalid_credentials" ? "Sign-in failed." : "Unauthorized.", kind: "err" };
      if (status === 400) return { text: "Check the form and try again.", kind: "err" };
      if (status >= 200 && status < 300) return { text: success, kind: "ok" };
      return { text: "Something went wrong.", kind: "err" };
    };

    void getCsrf().then(() => applyMe());

    root.querySelector("[data-login]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;
      setBusy(form, true);
      setBanner("Signing in…");
      const ident = String(new FormData(form).get("identifier") ?? "").trim();
      const password = String(new FormData(form).get("password") ?? "");
      const body = ident.includes("@") ? { email: ident, password } : { username: ident, password };
      const result = await postJSON<MeResponse>("/auth/login", body);
      setBusy(form, false);
      const message = genericMessage(result.status, result.data, "Signed in.");
      setBanner(message.text, message.kind);
      if (result.status === 200) {
        await applyMe();
      }
    });

    root.querySelector("[data-register]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;
      setBusy(form, true);
      setBanner("Creating account…");
      const data = new FormData(form);
      const result = await postJSON<MeResponse>("/auth/register", {
        email: String(data.get("email") ?? ""),
        username: String(data.get("username") ?? ""),
        password: String(data.get("password") ?? ""),
      });
      setBusy(form, false);
      const message = genericMessage(result.status, result.data, "If that email can be used, a verification code was sent.");
      setBanner(message.text, message.kind);
    });

    root.querySelector("[data-verify]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;
      setBusy(form, true);
      setBanner("Verifying…");
      const data = new FormData(form);
      const result = await postJSON<MeResponse>("/auth/verify-email", {
        email: String(data.get("email") ?? ""),
        otp: String(data.get("otp") ?? ""),
      });
      setBusy(form, false);
      const message = genericMessage(result.status, result.data, "Verification accepted.");
      setBanner(message.text, message.kind);
      await applyMe();
    });

    root.querySelector("[data-resend]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;
      setBusy(form, true);
      const data = new FormData(form);
      const result = await postJSON<MeResponse>("/auth/resend-verification", { email: String(data.get("email") ?? "") });
      setBusy(form, false);
      const message = genericMessage(result.status, result.data, "If that account needs verification, a new code was sent.");
      setBanner(message.text, message.kind);
    });

    root.querySelector("[data-request-reset]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;
      setBusy(form, true);
      const data = new FormData(form);
      const result = await postJSON<MeResponse>("/auth/request-password-reset", { email: String(data.get("email") ?? "") });
      setBusy(form, false);
      const message = genericMessage(result.status, result.data, "If that account exists, a reset code was sent.");
      setBanner(message.text, message.kind);
    });

    root.querySelector("[data-reset]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;
      setBusy(form, true);
      const data = new FormData(form);
      const result = await postJSON<MeResponse>("/auth/reset-password", {
        email: String(data.get("email") ?? ""),
        otp: String(data.get("otp") ?? ""),
        new_password: String(data.get("new_password") ?? ""),
      });
      setBusy(form, false);
      const message = genericMessage(result.status, result.data, "Password updated. Sign in with the new password.");
      setBanner(message.text, message.kind);
      await applyMe();
    });

    root.querySelector("[data-profile-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;
      setBusy(form, true);
      setBanner("Saving profile…");
      const data = new FormData(form);
      const phone = String(data.get("phone") ?? "").trim();
      const displayName = String(data.get("display_name") ?? "").trim();
      const result = await patchJSON<MeResponse>("/profile", {
        display_name: displayName === "" ? null : displayName,
        username: String(data.get("username") ?? ""),
        phone,
      });
      setBusy(form, false);
      const message = genericMessage(result.status, result.data, "Profile saved.");
      setBanner(message.text, message.kind);
      if (result.status === 200) fillProfile(result.data);
    });

    root.querySelector("[data-avatar-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;
      const fileInput = form.elements.namedItem("file");
      if (!(fileInput instanceof HTMLInputElement) || !fileInput.files?.[0]) {
        setBanner("Choose an image file.", "err");
        return;
      }
      setBusy(form, true);
      setBanner("Uploading avatar…");
      const result = await uploadAvatar(fileInput.files[0]);
      setBusy(form, false);
      const message = genericMessage(result.status, result.data, "Avatar updated.");
      setBanner(message.text, message.kind);
      if (result.status === 200) fillProfile(result.data);
    });

    root.querySelector("[data-avatar-delete]")?.addEventListener("click", async () => {
      setBanner("Removing avatar…");
      const result = await deleteAvatar();
      const message = genericMessage(result.status, result.data, "Avatar removed.");
      setBanner(message.text, message.kind);
      if (result.status === 200) fillProfile(result.data);
    });

    root.querySelector("[data-password-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;
      setBusy(form, true);
      const data = new FormData(form);
      const result = await postJSON<MeResponse>("/auth/change-password", {
        current_password: String(data.get("current_password") ?? ""),
        new_password: String(data.get("new_password") ?? ""),
      });
      setBusy(form, false);
      const message = genericMessage(result.status, result.data, "Password changed.");
      setBanner(message.text, message.kind);
    });

    root.querySelector("[data-logout]")?.addEventListener("click", async () => {
      setBanner("Signing out…");
      await postJSON("/auth/logout", {});
      await applyMe();
    });
  }
</script>
