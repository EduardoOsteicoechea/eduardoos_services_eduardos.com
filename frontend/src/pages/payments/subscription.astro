---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Subscription"
  description="Subscribe to Eduardoos product services."
  page="payments-subscription"
  robots="noindex,nofollow"
>
  <Fragment slot="dhs">
    <button class="dhs-action" type="button" data-sub-pay data-authed-only hidden title="Pay with PayPal" aria-label="Pay with PayPal">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">payments</span>
      </span>
      Pay with PayPal
    </button>
    <a class="dhs-action" href="/session" data-route data-guest-only title="Sign in" aria-label="Sign in">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">login</span>
      </span>
      Sign in
    </a>
    <a class="dhs-action" href="/session/register" data-route data-guest-only title="Create account" aria-label="Create account">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">person_add</span>
      </span>
      Create account
    </a>
  </Fragment>

  <section class="product-dash subscription-page" data-subscription>

    <div class="panel subscription-page__guest" data-guest hidden>
      <p class="subscription-page__guest-copy">
        Sign in or create an account so payment intents attach to your session email.
      </p>
      <div class="subscription-page__guest-actions">
        <a class="btn btn--primary" href="/session" data-route>Sign in</a>
        <a class="btn" href="/session/register" data-route>Create account</a>
      </div>
    </div>

    <div data-authed hidden>
      <div class="subscription-page__billing" role="group" aria-label="Billing period">
        <span class="subscription-page__billing-label subscription-page__billing-label--active" data-billing-label="monthly">Monthly</span>
        <button
          class="subscription-page__switch"
          type="button"
          role="switch"
          aria-checked="false"
          aria-label="Toggle yearly billing"
          data-period-switch
        >
          <span class="subscription-page__switch-thumb" aria-hidden="true"></span>
        </button>
        <span class="subscription-page__billing-label" data-billing-label="yearly">Yearly</span>
      </div>

      <div class="product-dash__grid subscription-page__grid" data-services role="group" aria-label="Services"></div>

      <p class="hint" data-total>Total: $0.00</p>
      <p class="hint" data-message hidden></p>

      <form
        class="subscription-page__paypal-form"
        data-paypal
        method="post"
        action="https://www.paypal.com/cgi-bin/webscr"
        target="_blank"
        rel="noopener"
      >
        <input type="hidden" name="cmd" value="_s-xclick" />
        <input type="hidden" name="hosted_button_id" data-paypal-button value="" />
        <input type="hidden" name="custom" data-paypal-custom value="" />
        <button class="paypal-btn" type="submit" data-paypal-submit>
          <span class="paypal-btn__mark" aria-hidden="true">PayPal</span>
          <span class="paypal-btn__label">Pay with PayPal</span>
        </button>
      </form>
    </div>
  </section>

  <div id="subscription-service-modal" class="subscription-service-modal" hidden>
    <div
      class="subscription-service-modal__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="subscription-service-title"
    >
      <header class="subscription-service-modal__toolbar">
        <h2 id="subscription-service-title" data-service-modal-title></h2>
        <button class="icon-btn" type="button" data-service-modal-close aria-label="Close">
          <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
      </header>
      <p class="subscription-service-modal__price" data-service-modal-price></p>
      <div class="subscription-service-modal__body" data-service-modal-body></div>
    </div>
  </div>
</Layout>

<script>
  import { mustLog } from "../../lib/dev-log";
  import { showErrorModal } from "../../lib/error-modal";
  import {
    PAYPAL_FORM_ACTION,
    createSubscriptionIntent,
    fetchSubscriptionCatalog,
    paypalHostedButtonIdFallback,
    quoteSubscription,
    subscriptionServiceDetails,
    type BillingPeriod,
    type PaymentIntentResponse,
    type SubscriptionService,
  } from "../../lib/payments";
  import { requireSession, setHidden } from "../../lib/productGate";

  const root = document.querySelector("[data-subscription]");
  if (!(root instanceof HTMLElement)) throw new Error("subscription root missing");

  const guest = root.querySelector("[data-guest]");
  const authed = root.querySelector("[data-authed]");
  const servicesEl = root.querySelector("[data-services]");
  const totalEl = root.querySelector("[data-total]");
  const messageEl = root.querySelector("[data-message]");
  const periodSwitch = root.querySelector("[data-period-switch]");
  const paypalForm = root.querySelector("[data-paypal]");
  const paypalButton = root.querySelector("[data-paypal-button]");
  const paypalCustom = root.querySelector("[data-paypal-custom]");
  const paypalSubmit = root.querySelector("[data-paypal-submit]");
  const serviceModal = document.getElementById("subscription-service-modal");
  const serviceModalTitle = serviceModal?.querySelector("[data-service-modal-title]");
  const serviceModalPrice = serviceModal?.querySelector("[data-service-modal-price]");
  const serviceModalBody = serviceModal?.querySelector("[data-service-modal-body]");

  let catalog: SubscriptionService[] = [];
  let selected: string[] = ["epam"];
  let billingPeriod: BillingPeriod = "monthly";
  let email = "";
  let intent: PaymentIntentResponse | null = null;
  let paying = false;

  function setServiceModalOpen(open: boolean): void {
    if (!(serviceModal instanceof HTMLElement)) return;
    serviceModal.hidden = !open;
  }

  function openServiceModal(service: SubscriptionService): void {
    if (serviceModalTitle instanceof HTMLElement) {
      serviceModalTitle.textContent = service.label;
    }
    if (serviceModalPrice instanceof HTMLElement) {
      serviceModalPrice.textContent = `$${service.monthlyUsd.toFixed(2)}/mo`;
    }
    if (serviceModalBody instanceof HTMLElement) {
      serviceModalBody.replaceChildren();
      const details = subscriptionServiceDetails(service);
      for (const paragraph of details.split(/\n+/).map((p) => p.trim()).filter(Boolean)) {
        const p = document.createElement("p");
        p.textContent = paragraph;
        serviceModalBody.appendChild(p);
      }
    }
    setServiceModalOpen(true);
  }

  function setPeriod(next: BillingPeriod): void {
    billingPeriod = next;
    const yearly = next === "yearly";
    if (periodSwitch instanceof HTMLButtonElement) {
      periodSwitch.setAttribute("aria-checked", yearly ? "true" : "false");
      periodSwitch.classList.toggle("subscription-page__switch--yearly", yearly);
    }
    root.querySelectorAll("[data-billing-label]").forEach((node) => {
      if (!(node instanceof HTMLElement)) return;
      node.classList.toggle(
        "subscription-page__billing-label--active",
        node.dataset.billingLabel === next,
      );
    });
    intent = null;
    renderTotal();
  }

  function renderServices(): void {
    if (!(servicesEl instanceof HTMLElement)) return;
    servicesEl.replaceChildren();
    for (const service of catalog) {
      const checked = selected.includes(service.id);
      const label = document.createElement("label");
      label.className = checked
        ? "product-dash__card subscription-page__service product-dash__card--selected"
        : "product-dash__card subscription-page__service";
      label.innerHTML = `
        <input class="subscription-page__service-input" type="checkbox" value="${service.id}" ${checked ? "checked" : ""} />
        <span class="product-dash__card-head">
          <span class="material-symbols-outlined" aria-hidden="true">${service.icon}</span>
          <span class="product-dash__card-title">${service.label}</span>
          <button
            class="icon-btn subscription-page__info"
            type="button"
            data-service-info
            aria-label="About ${service.label}"
            title="About ${service.label}"
          >
            <span class="material-symbols-outlined" aria-hidden="true">open_in_full</span>
          </button>
        </span>
        <span class="product-dash__card-desc">${service.description}</span>
        <span class="product-dash__card-desc">$${service.monthlyUsd.toFixed(2)}/mo</span>
      `;
      label.querySelector("input")?.addEventListener("change", () => {
        selected = selected.includes(service.id)
          ? selected.filter((id) => id !== service.id)
          : [...selected, service.id];
        intent = null;
        renderServices();
        renderTotal();
      });
      label.querySelector("[data-service-info]")?.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        openServiceModal(service);
      });
      servicesEl.appendChild(label);
    }
  }

  function renderTotal(): void {
    if (!(totalEl instanceof HTMLElement)) return;
    const amount = quoteSubscription(selected, billingPeriod, catalog).toFixed(2);
    totalEl.textContent = `Total: $${amount} ${billingPeriod}`;
  }

  function setMessage(text: string): void {
    if (!(messageEl instanceof HTMLElement)) return;
    messageEl.hidden = !text;
    messageEl.textContent = text;
  }

  async function ensureIntent(): Promise<PaymentIntentResponse | null> {
    if (selected.length === 0) {
      showErrorModal({ message: "Select at least one service." });
      return null;
    }
    if (intent?.intent_id && intent.billing_period === billingPeriod) {
      const sameServices =
        Array.isArray(intent.services) &&
        intent.services.length === selected.length &&
        selected.every((id) => intent?.services?.includes(id));
      if (sameServices) return intent;
    }
    if (mustLog) console.log("[subscription] create intent", { selected, billingPeriod });
    const result = await createSubscriptionIntent(email, selected, billingPeriod);
    if (!result.data?.intent_id) {
      const msg = (result.error || "").toLowerCase();
      if (msg.includes("unauthorized") || msg.includes("sign in")) {
        email = "";
        setHidden(guest, false);
        setHidden(authed, true);
        return null;
      }
      showErrorModal({
        message: result.error || "Could not create PayPal checkout.",
        requestId: result.requestId,
      });
      return null;
    }
    intent = result.data;
    return intent;
  }

  async function payWithPayPal(event?: Event): Promise<void> {
    event?.preventDefault();
    if (!email) {
      setHidden(guest, false);
      setHidden(authed, true);
      return;
    }
    if (paying) return;
    paying = true;
    if (paypalSubmit instanceof HTMLButtonElement) paypalSubmit.disabled = true;
    try {
      const ready = await ensureIntent();
      if (!ready || !(paypalForm instanceof HTMLFormElement)) return;

      const buttonId = (ready.hosted_button_id || paypalHostedButtonIdFallback()).trim();
      if (!buttonId || buttonId === "PLACEHOLDER_HOSTED_BUTTON") {
        showErrorModal({
          message: "PayPal is not configured yet. Ask an admin to set PAYPAL_HOSTED_BUTTON_ID.",
        });
        return;
      }

      if (paypalButton instanceof HTMLInputElement) paypalButton.value = buttonId;
      if (paypalCustom instanceof HTMLInputElement) paypalCustom.value = ready.intent_id;

      const checkoutUrl = (ready.paypal_checkout_url || PAYPAL_FORM_ACTION).trim();
      paypalForm.action = checkoutUrl || PAYPAL_FORM_ACTION;

      setMessage(`Checkout ready · $${ready.amount} ${ready.currency}`);
      if (mustLog) {
        console.log("[subscription] submit paypal", {
          intentId: ready.intent_id,
          buttonId,
          action: paypalForm.action,
        });
      }
      paypalForm.submit();
    } finally {
      paying = false;
      if (paypalSubmit instanceof HTMLButtonElement) paypalSubmit.disabled = false;
    }
  }

  periodSwitch?.addEventListener("click", () => {
    setPeriod(billingPeriod === "monthly" ? "yearly" : "monthly");
  });

  paypalForm?.addEventListener("submit", (event) => {
    void payWithPayPal(event);
  });
  document.querySelector("[data-sub-pay]")?.addEventListener("click", () => {
    void payWithPayPal();
  });

  serviceModal?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (target.closest("[data-service-modal-close]") || target === serviceModal) {
      setServiceModalOpen(false);
    }
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    if (serviceModal instanceof HTMLElement && !serviceModal.hidden) {
      setServiceModalOpen(false);
    }
  });

  // Quiet: guests (and refresh timeouts) must see Sign in / Register, not the error modal.
  const session = await requireSession({ quiet: true });
  catalog = await fetchSubscriptionCatalog();
  if (!session.ok) {
    email = "";
    setHidden(guest, false);
    setHidden(authed, true);
  } else {
    email = session.email;
    setHidden(guest, true);
    setHidden(authed, false);
    setPeriod("monthly");
    renderServices();
    renderTotal();
  }
</script>
