---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="eVoice · Eduardoos" description="Text-to-audio projects." page="evoice" robots="noindex,nofollow">
  <Fragment slot="dhs">
    <button class="dhs-action" type="button" data-refresh title="Refresh" aria-label="Refresh">
      <span class="icon-btn" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">refresh</span></span>
      Refresh
    </button>
    <button class="dhs-action" type="button" data-generate title="Generate" aria-label="Generate">
      <span class="icon-btn" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">record_voice_over</span></span>
      Generate
    </button>
    <button class="dhs-action" type="button" data-share title="Share playlist" aria-label="Share playlist">
      <span class="icon-btn" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">share</span></span>
      Share
    </button>
  </Fragment>

  <section class="product-dash" data-evoice>
    <h1>eVoice</h1>
    <p class="status" data-banner>Loading…</p>
    <div data-gate hidden class="product-gate">
      <p class="hint">eVoice subscription (or allowlist) required.</p>
      <p class="hint"><a href="/payments/subscription" data-route>Subscribe</a></p>
    </div>
    <div data-authed hidden>
      <form class="product-form" data-create>
        <label>New project <input name="name" required maxlength="64" /></label>
        <button class="btn btn--primary" type="submit">Create project</button>
      </form>
      <label>Project
        <select data-project></select>
      </label>
      <form class="product-form" data-upload>
        <label>Upload document <input name="file" type="file" accept=".txt,.md,.docx,.pdf,text/plain" required /></label>
        <button class="btn" type="submit">Upload</button>
      </form>
      <h2 class="product-dash__section-title">Docs</h2>
      <ul class="product-list" data-docs></ul>
      <h2 class="product-dash__section-title">Audios</h2>
      <ul class="product-list evoice-playlist" data-audios></ul>
      <p class="hint" data-job hidden></p>
      <p class="hint" data-share-url hidden></p>
    </div>
  </section>
</Layout>

<script>
  import {
    createEvoiceProject,
    createEvoiceShare,
    evoiceFileUrl,
    fetchEvoiceAudios,
    fetchEvoiceDocs,
    fetchEvoiceJob,
    fetchEvoiceMe,
    fetchEvoiceProjects,
    startEvoiceGenerate,
    uploadEvoiceDoc,
  } from "../../lib/evoice";
  import { mustLog } from "../../lib/dev-log";
  import { apiFail, requireService, setHidden } from "../../lib/productGate";

  const root = document.querySelector("[data-evoice]");
  const banner = root?.querySelector("[data-banner]");
  const gate = root?.querySelector("[data-gate]");
  const authed = root?.querySelector("[data-authed]");
  const projectSelect = root?.querySelector("[data-project]");
  const docsEl = root?.querySelector("[data-docs]");
  const audiosEl = root?.querySelector("[data-audios]");
  const jobEl = root?.querySelector("[data-job]");
  const shareEl = root?.querySelector("[data-share-url]");

  let ownerSafe = "";

  async function reloadProjects() {
    const me = await fetchEvoiceMe();
    if (me.error) {
      apiFail(me.error, { requestId: me.requestId });
      return;
    }
    ownerSafe = me.userSafe;
    const projects = await fetchEvoiceProjects(ownerSafe);
    if (projects.error) {
      apiFail(projects.error, { requestId: projects.requestId });
      return;
    }
    if (!(projectSelect instanceof HTMLSelectElement)) return;
    projectSelect.replaceChildren();
    for (const name of projects.projects) {
      const opt = document.createElement("option");
      opt.value = name;
      opt.textContent = name;
      projectSelect.appendChild(opt);
    }
    if (projectSelect.value) await reloadProject();
  }

  async function reloadProject() {
    if (!(projectSelect instanceof HTMLSelectElement) || !projectSelect.value) return;
    const project = projectSelect.value;
    const docs = await fetchEvoiceDocs(ownerSafe, project);
    const audios = await fetchEvoiceAudios(ownerSafe, project);
    if (docs.error) apiFail(docs.error, { requestId: docs.requestId });
    if (audios.error) apiFail(audios.error, { requestId: audios.requestId });
    if (docsEl instanceof HTMLElement) {
      docsEl.replaceChildren();
      for (const doc of docs.docs) {
        const li = document.createElement("li");
        li.textContent = `${doc.name} (${doc.size} B)`;
        docsEl.appendChild(li);
      }
    }
    if (audiosEl instanceof HTMLElement) {
      audiosEl.replaceChildren();
      for (const audio of audios.audios) {
        const li = document.createElement("li");
        const label = document.createElement("span");
        label.textContent = audio.name;
        const player = document.createElement("audio");
        player.controls = true;
        player.preload = "none";
        player.src = evoiceFileUrl(ownerSafe, project, "audios", audio.name);
        li.append(label, player);
        audiosEl.appendChild(li);
      }
    }
    if (banner instanceof HTMLElement) {
      banner.textContent = `${project} · ${docs.docs.length} docs · ${audios.audios.length} audios`;
    }
  }

  async function pollJob(jobId: string) {
    for (let i = 0; i < 60; i++) {
      const { job, error, requestId } = await fetchEvoiceJob(jobId);
      if (!job) {
        apiFail(error || "Job missing.", { requestId });
        return;
      }
      if (jobEl instanceof HTMLElement) {
        jobEl.hidden = false;
        jobEl.textContent = `Job ${job.id}: ${job.state}${job.progress != null ? ` (${job.progress}%)` : ""}`;
      }
      if (job.state === "done" || job.state === "failed" || job.state === "stopped") {
        await reloadProject();
        return;
      }
      await new Promise((r) => setTimeout(r, 2000));
    }
  }

  root?.querySelector("[data-create]")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const name = String(new FormData(event.target as HTMLFormElement).get("name") || "").trim();
    const created = await createEvoiceProject(name, ownerSafe);
    if (!created.project) {
      apiFail(created.error || "Create failed.", { requestId: created.requestId });
      return;
    }
    (event.target as HTMLFormElement).reset();
    await reloadProjects();
  });

  root?.querySelector("[data-upload]")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(projectSelect instanceof HTMLSelectElement)) return;
    const file = (event.target as HTMLFormElement).querySelector<HTMLInputElement>('input[type="file"]')?.files?.[0];
    if (!file) return;
    const res = await uploadEvoiceDoc(ownerSafe, projectSelect.value, file);
    if (!res.ok) {
      apiFail(res.error || "Upload failed.", { requestId: res.requestId });
      return;
    }
    await reloadProject();
  });

  projectSelect?.addEventListener("change", () => void reloadProject());
  document.querySelector("[data-refresh]")?.addEventListener("click", () => void reloadProjects());
  document.querySelector("[data-generate]")?.addEventListener("click", async () => {
    if (!(projectSelect instanceof HTMLSelectElement) || !projectSelect.value) return;
    const started = await startEvoiceGenerate(ownerSafe, projectSelect.value, { mode: "standard" });
    if (!started.job) {
      apiFail(started.error || "Generate failed.", { requestId: started.requestId });
      return;
    }
    if (mustLog) console.log("[evoice] job", started.job.id);
    void pollJob(started.job.id);
  });
  document.querySelector("[data-share]")?.addEventListener("click", async () => {
    if (!(projectSelect instanceof HTMLSelectElement) || !projectSelect.value) return;
    const audios = await fetchEvoiceAudios(ownerSafe, projectSelect.value);
    const names = audios.audios.map((a) => a.name);
    const share = await createEvoiceShare(ownerSafe, projectSelect.value, names);
    if (share.error) {
      apiFail(share.error, { requestId: share.requestId });
      return;
    }
    const url = share.url || (share.token ? `${location.origin}/evoice/invite?token=${encodeURIComponent(share.token)}` : "");
    if (shareEl instanceof HTMLElement) {
      shareEl.hidden = false;
      shareEl.textContent = url ? `Share: ${url}` : "Share created.";
    }
  });

  const gateResult = await requireService("evoice");
  if (!gateResult.sessionOk || !gateResult.access.allowed) {
    if (banner instanceof HTMLElement) banner.textContent = gateResult.sessionOk ? "Subscription required." : "Sign in required.";
    setHidden(gate, false);
    setHidden(authed, true);
  } else {
    setHidden(gate, true);
    setHidden(authed, false);
    await reloadProjects();
  }
</script>
