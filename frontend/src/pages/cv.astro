---
import Layout from "../layouts/Layout.astro";
import {
  HOME_HEADING,
  PROFILE_EMAIL,
  PROFILE_GITHUB,
  PROFILE_LINKEDIN,
  PROFILE_SITE,
  profileEducation,
  profileExperience,
  profileSkillCards,
  profileStack,
  profileWhoAnswer,
} from "../lib/eduardoProfile";

const description =
  "CV - Eduardo Osteicoechea, Senior BIM Software Developer. Revit & AutoCAD APIs, C#/.NET, APS, ASP.NET Core, AWS.";
const pdfHref = "/cv/Eduardo_Osteicoechea_Sr_BIM_Software_Developer.pdf";
---

<Layout
  title={`CV · ${HOME_HEADING}`}
  description={description}
  robots="index,follow"
  page="cv"
>
  <section class="product-dash cv-page">
    <p class="lede">{profileWhoAnswer}</p>
    <p>
      <a class="btn btn--primary" href={pdfHref} download>Download PDF</a>
      <a class="btn" href="/contact" data-route>Contact</a>
    </p>
    <p class="cv-page__meta">
      {PROFILE_EMAIL} · <a href={PROFILE_LINKEDIN}>LinkedIn</a> ·
      <a href={PROFILE_GITHUB}>GitHub</a> · <a href={PROFILE_SITE}>{PROFILE_SITE.replace("https://", "")}</a>
      · Remote LatAm (UTC-4) · English fluent
    </p>

    <h2>Core skills</h2>
    <ul>
      {profileSkillCards.map((s) => (
        <li><strong>{s.title}:</strong> {s.description}</li>
      ))}
    </ul>
    <p>{profileStack}</p>

    <h2>Experience</h2>
    {profileExperience.map((job) => (
      <article class="product-dash__card">
        <h3 class="product-dash__card-title">{job.role} - {job.org}</h3>
        <p class="product-dash__card-desc">{job.period}</p>
        <p class="product-dash__card-desc">{job.summary}</p>
      </article>
    ))}

    <h2>Education</h2>
    {profileEducation.map((item) => (
      <article class="product-dash__card">
        <h3 class="product-dash__card-title">{item.title}</h3>
        <p class="product-dash__card-desc">{item.description}</p>
      </article>
    ))}
  </section>
</Layout>

<style>
  .cv-page {
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
  }
  .cv-page__meta {
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }
  .cv-page ul {
    margin: 0;
    padding-inline-start: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: var(--rail-gap);
  }
</style>
