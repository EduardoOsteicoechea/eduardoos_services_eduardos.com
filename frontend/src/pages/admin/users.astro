---
import { Fragment } from "astro/jsx-runtime";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Users" robots="noindex,nofollow">
  <Fragment slot="dhs">
    <button class="dhs-action" type="button" data-users-refresh title="Refresh list" aria-label="Refresh list">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">refresh</span>
      </span>
      Refresh
    </button>
  </Fragment>

  <section class="diag" data-admin-users>
    <h1>Registered users</h1>
    <p class="lede">
      Administrator-only list of accounts on this site. Data is loaded from the Go API
      after your session is verified.
    </p>

    <p class="status" data-banner>Checking session…</p>

    <div class="panel" data-table-wrap hidden>
      <p class="hint" data-count></p>
      <div class="admin-users-scroll">
        <table class="admin-users-table">
          <thead>
            <tr>
              <th scope="col">Email</th>
              <th scope="col">Username</th>
              <th scope="col">Role</th>
              <th scope="col">Status</th>
              <th scope="col">Verified</th>
              <th scope="col">Service access</th>
              <th scope="col">Created</th>
            </tr>
          </thead>
          <tbody data-users-body></tbody>
        </table>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { apiRequest, getAdminUsers, getMe } from "../../lib/api";
  import { showErrorModal } from "../../lib/error-modal";

  const root = document.querySelector("[data-admin-users]");
  if (root instanceof HTMLElement) {
    const banner = root.querySelector("[data-banner]");
    const tableWrap = root.querySelector("[data-table-wrap]");
    const count = root.querySelector("[data-count]");
    const body = root.querySelector("[data-users-body]");
    const refreshBtn = document.querySelector("[data-users-refresh]");

    const setBanner = (text: string, kind = "") => {
      if (!(banner instanceof HTMLElement)) {
        return;
      }
      banner.textContent = text;
      banner.className = `status ${kind}`.trim();
    };

    const showTable = (visible: boolean) => {
      if (tableWrap instanceof HTMLElement) {
        tableWrap.hidden = !visible;
      }
    };

    const fail = (message: string, requestId?: string, debug?: string) => {
      setBanner(message, "err");
      showTable(false);
      showErrorModal({
        message,
        requestId,
        details: requestId ? `request_id=${requestId}` : "",
        debug,
      });
    };

    const formatDate = (value: string) => {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) {
        return value;
      }
      return date.toLocaleString();
    };

    const renderRows = (users: Array<{
      email: string;
      username: string;
      role: string;
      status: string;
      email_verified: boolean;
      id: string;
      admin_services?: string[];
      created_at: string;
    }>) => {
      if (!(body instanceof HTMLElement)) {
        return;
      }
      body.replaceChildren();
      for (const user of users) {
        const row = document.createElement("tr");
        const cells = [
          user.email,
          user.username,
          user.role,
          user.status,
          user.email_verified ? "yes" : "no",
        ];
        for (const text of cells) {
          const cell = document.createElement("td");
          cell.textContent = text;
          row.appendChild(cell);
        }
        const access = document.createElement("td");
        access.className = "admin-users-services";
        const form = document.createElement("form");
        form.dataset.userServices = user.id;
        const granted = new Set(user.admin_services ?? []);
        for (const service of ["pamphlet", "homescool", "scrib", "ereport", "evoice", "eoproject", "api"]) {
          const label = document.createElement("label");
          const input = document.createElement("input");
          input.type = "checkbox";
          input.name = "service";
          input.value = service;
          input.checked = granted.has(service);
          label.append(input, ` ${service}`);
          form.append(label);
        }
        const save = document.createElement("button");
        save.type = "submit";
        save.textContent = "Save";
        form.appendChild(save);
        access.appendChild(form);
        row.appendChild(access);
        const created = document.createElement("td");
        created.textContent = formatDate(user.created_at);
        row.appendChild(created);
        body.appendChild(row);
      }
      if (count instanceof HTMLElement) {
        count.textContent = `${users.length} registered user${users.length === 1 ? "" : "s"}.`;
      }
    };

    const loadUsers = async () => {
      setBanner("Loading users…");
      const result = await getAdminUsers();
      if (result.status === 401 || result.status === 403) {
        fail(result.data.message || "Unauthorized.", result.data.request_id, result.data.debug);
        document.querySelectorAll("[data-admin-only]").forEach((node) => node.setAttribute("hidden", ""));
        return;
      }
      if (result.status >= 400) {
        fail(result.data.message || "Could not load users.", result.data.request_id, result.data.debug);
        return;
      }
      const users = result.data.users ?? [];
      renderRows(users);
      showTable(true);
      setBanner("User list loaded.", "ok");
    };

    const applyMe = async () => {
      const { status, data, requestId } = await getMe();
      if (status === 401) {
        setBanner("Sign in with an administrator account.", "err");
        document.querySelectorAll("[data-admin-only]").forEach((node) => node.setAttribute("hidden", ""));
        showTable(false);
        return;
      }
      if (status !== 200) {
        fail(data.message || "Could not load the session.", data.request_id || requestId, data.debug);
        return;
      }
      if (data.role !== "admin") {
        setBanner("Unauthorized.", "err");
        document.querySelectorAll("[data-admin-only]").forEach((node) => node.setAttribute("hidden", ""));
        showTable(false);
        return;
      }
      document.querySelectorAll("[data-admin-only]").forEach((node) => node.removeAttribute("hidden"));
      await loadUsers();
    };

    void applyMe();

    refreshBtn?.addEventListener("click", () => {
      void loadUsers();
    });

    body?.addEventListener("submit", (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || !form.dataset.userServices) return;
      event.preventDefault();
      const services = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="service"]:checked')).map((input) => input.value);
      void (async () => {
        const result = await apiRequest<{ services?: string[] }>(`/admin/users/${encodeURIComponent(form.dataset.userServices || "")}/services`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ services }),
        });
        if (result.status >= 400) {
          fail(result.data.message || "Could not update service access.", result.requestId, result.data.debug);
          return;
        }
        setBanner("Service access updated.", "ok");
      })();
    });
  }
</script>
