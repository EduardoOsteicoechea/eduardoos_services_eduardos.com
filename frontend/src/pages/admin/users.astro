---
import { Fragment } from "astro/jsx-runtime";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Registered users" robots="noindex,nofollow">
  <Fragment slot="dhs">
    <button class="dhs-action" type="button" data-users-refresh title="Refresh list" aria-label="Refresh list">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">refresh</span>
      </span>
      Refresh
    </button>
  </Fragment>

  <section class="product-dash admin-users" data-admin-users>

    <p class="status" data-banner>Checking session…</p>

    <div class="admin-users__panel" data-table-wrap hidden>
      <label class="admin-users__search">
        <span class="page-title-sr">Search users</span>
        <input type="search" data-users-search placeholder="Search users…" autocomplete="off" />
      </label>
      <ul class="admin-users__list" data-users-body></ul>
    </div>
  </section>
</Layout>

<script>
  import { apiRequest, getAdminUsers, getMe } from "../../lib/api";
  import { showErrorModal } from "../../lib/error-modal";

  const SERVICES = ["epam", "articles", "homescool", "scrib", "ereport", "ereport-connector", "evoice", "eoproject", "api"] as const;

  const root = document.querySelector("[data-admin-users]");
  if (root instanceof HTMLElement) {
    const banner = root.querySelector("[data-banner]");
    const tableWrap = root.querySelector("[data-table-wrap]");
    const body = root.querySelector("[data-users-body]");
    const searchLabel = root.querySelector(".admin-users__search");
    const searchInput = root.querySelector("[data-users-search]");
    const pageTitle = document.querySelector("main > .page-title");
    const refreshBtn = document.querySelector("[data-users-refresh]");
    const searchDesktopMq = window.matchMedia("(min-width: 48rem)");

    const setBanner = (text: string, kind = "") => {
      if (!(banner instanceof HTMLElement)) {
        return;
      }
      banner.textContent = text;
      banner.className = `status ${kind}`.trim();
      banner.hidden = !text;
    };

    const placeSearch = () => {
      if (!(searchLabel instanceof HTMLElement) || !(tableWrap instanceof HTMLElement)) {
        return;
      }
      const dockInTitle =
        searchDesktopMq.matches &&
        pageTitle instanceof HTMLElement &&
        !tableWrap.hidden;
      if (dockInTitle) {
        if (searchLabel.parentElement !== pageTitle) {
          pageTitle.appendChild(searchLabel);
        }
        return;
      }
      if (searchLabel.parentElement !== tableWrap) {
        const list = body instanceof HTMLElement ? body : tableWrap.firstElementChild;
        tableWrap.insertBefore(searchLabel, list);
      }
    };

    const showTable = (visible: boolean) => {
      if (tableWrap instanceof HTMLElement) {
        tableWrap.hidden = !visible;
      }
      placeSearch();
    };

    const fail = (message: string, requestId?: string, debug?: string) => {
      setBanner(message, "err");
      showTable(false);
      showErrorModal({
        message,
        requestId,
        details: requestId ? `request_id=${requestId}` : "",
        debug,
      });
    };

    const formatDate = (value: string) => {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) {
        return value;
      }
      return date.toLocaleString();
    };

    const metaItem = (label: string, value: string, kind = "") => {
      const item = document.createElement("div");
      item.className = kind
        ? `admin-user-card__meta-item admin-user-card__meta-item--${kind}`
        : "admin-user-card__meta-item";
      const dt = document.createElement("dt");
      dt.textContent = label;
      const dd = document.createElement("dd");
      dd.textContent = value;
      item.append(dt, dd);
      return item;
    };

    const applySearchFilter = () => {
      if (!(body instanceof HTMLElement) || !(searchInput instanceof HTMLInputElement)) {
        return;
      }
      const query = searchInput.value.trim().toLowerCase();
      for (const card of body.querySelectorAll<HTMLElement>(".admin-user-card")) {
        const haystack = card.dataset.search || "";
        card.hidden = query.length > 0 && !haystack.includes(query);
      }
    };

    const renderRows = (users: Array<{
      email: string;
      username: string;
      role: string;
      status: string;
      email_verified: boolean;
      id: string;
      admin_services?: string[];
      created_at: string;
    }>) => {
      if (!(body instanceof HTMLElement)) {
        return;
      }
      body.replaceChildren();
      for (const user of users) {
        const card = document.createElement("li");
        card.className = "admin-user-card";
        const verified = user.email_verified ? "yes" : "no";
        const created = formatDate(user.created_at);
        card.dataset.search = [
          user.email,
          user.username,
          user.role,
          user.status,
          verified,
          created,
          ...(user.admin_services ?? []),
        ]
          .join(" ")
          .toLowerCase();

        const info = document.createElement("div");
        info.className = "admin-user-card__info";
        const meta = document.createElement("dl");
        meta.className = "admin-user-card__meta";
        meta.append(
          metaItem("Email", user.email, "email"),
          metaItem("Username", user.username, "username"),
          metaItem("Role", user.role),
          metaItem("Status", user.status),
          metaItem("Verified", verified),
          metaItem("Created", created),
        );
        info.appendChild(meta);

        const access = document.createElement("div");
        access.className = "admin-users-services";
        const form = document.createElement("form");
        form.dataset.userServices = user.id;

        const chips = document.createElement("div");
        chips.className = "admin-users-services__chips";
        const granted = new Set(user.admin_services ?? []);
        for (const service of SERVICES) {
          const label = document.createElement("label");
          label.className = "admin-users-services__chip";
          const input = document.createElement("input");
          input.type = "checkbox";
          input.name = "service";
          input.value = service;
          input.checked = granted.has(service);
          const span = document.createElement("span");
          span.textContent = service;
          label.append(input, span);
          chips.append(label);
        }

        form.append(chips);
        access.appendChild(form);
        card.append(info, access);
        body.appendChild(card);
      }
      applySearchFilter();
    };

    const loadUsers = async () => {
      setBanner("Loading users…");
      const result = await getAdminUsers();
      if (result.status === 401 || result.status === 403) {
        fail(result.data.message || "Unauthorized.", result.data.request_id, result.data.debug);
        document.querySelectorAll("[data-admin-only]").forEach((node) => node.setAttribute("hidden", ""));
        return;
      }
      if (result.status >= 400) {
        fail(result.data.message || "Could not load users.", result.data.request_id, result.data.debug);
        return;
      }
      const users = result.data.users ?? [];
      renderRows(users);
      showTable(true);
      setBanner("");
    };

    const applyMe = async () => {
      const { status, data, requestId } = await getMe();
      if (status === 401) {
        setBanner("Sign in with an administrator account.", "err");
        document.querySelectorAll("[data-admin-only]").forEach((node) => node.setAttribute("hidden", ""));
        showTable(false);
        return;
      }
      if (status !== 200) {
        fail(data.message || "Could not load the session.", data.request_id || requestId, data.debug);
        return;
      }
      if (data.role !== "admin") {
        setBanner("Unauthorized.", "err");
        document.querySelectorAll("[data-admin-only]").forEach((node) => node.setAttribute("hidden", ""));
        showTable(false);
        return;
      }
      document.querySelectorAll("[data-admin-only]").forEach((node) => node.removeAttribute("hidden"));
      await loadUsers();
    };

    void applyMe();
    placeSearch();
    searchDesktopMq.addEventListener("change", placeSearch);

    refreshBtn?.addEventListener("click", () => {
      void loadUsers();
    });

    searchInput?.addEventListener("input", () => {
      applySearchFilter();
    });

    body?.addEventListener("submit", (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || !form.dataset.userServices) return;
      event.preventDefault();
    });

    const savingByUser = new Map<string, boolean>();
    const pendingByUser = new Map<string, string[]>();

    const saveServices = async (form: HTMLFormElement, services: string[]) => {
      const userId = form.dataset.userServices || "";
      if (!userId) return;
      if (savingByUser.get(userId)) {
        pendingByUser.set(userId, services);
        return;
      }
      savingByUser.set(userId, true);
      form.setAttribute("aria-busy", "true");
      const inputs = form.querySelectorAll<HTMLInputElement>('input[name="service"]');
      inputs.forEach((input) => {
        input.disabled = true;
      });
      const result = await apiRequest<{ services?: string[] }>(`/admin/users/${encodeURIComponent(userId)}/services`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ services }),
      });
      inputs.forEach((input) => {
        input.disabled = false;
      });
      form.removeAttribute("aria-busy");
      savingByUser.set(userId, false);
      if (result.status >= 400) {
        fail(result.data.message || "Could not update service access.", result.requestId, result.data.debug);
        await loadUsers();
        return;
      }
      const pending = pendingByUser.get(userId);
      if (pending) {
        pendingByUser.delete(userId);
        await saveServices(form, pending);
        return;
      }
      setBanner("");
    };

    body?.addEventListener("change", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement) || target.name !== "service") return;
      const form = target.form;
      if (!(form instanceof HTMLFormElement) || !form.dataset.userServices) return;
      const services = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="service"]:checked')).map((input) => input.value);
      void saveServices(form, services);
    });
  }
</script>
