---
import { Fragment } from "astro/jsx-runtime";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Registered users" robots="noindex,nofollow">
  <Fragment slot="dhs">
    <button class="dhs-action" type="button" data-users-refresh title="Refresh list" aria-label="Refresh list">
      <span class="icon-btn" aria-hidden="true">
        <span class="material-symbols-outlined" aria-hidden="true">refresh</span>
      </span>
      Refresh
    </button>
  </Fragment>

  <section class="product-dash admin-users" data-admin-users>
    <h1 class="page-title-sr">Registered users</h1>

    <p class="status" data-banner>Checking session…</p>

    <div class="admin-users__panel" data-table-wrap hidden>
      <p class="hint" data-count></p>
      <ul class="admin-users__list" data-users-body></ul>
    </div>
  </section>
</Layout>

<script>
  import { apiRequest, getAdminUsers, getMe } from "../../lib/api";
  import { showErrorModal } from "../../lib/error-modal";

  const SERVICES = ["pamphlet", "homescool", "scrib", "ereport", "evoice", "eoproject", "api", "eocode"] as const;

  const root = document.querySelector("[data-admin-users]");
  if (root instanceof HTMLElement) {
    const banner = root.querySelector("[data-banner]");
    const tableWrap = root.querySelector("[data-table-wrap]");
    const count = root.querySelector("[data-count]");
    const body = root.querySelector("[data-users-body]");
    const refreshBtn = document.querySelector("[data-users-refresh]");

    const setBanner = (text: string, kind = "") => {
      if (!(banner instanceof HTMLElement)) {
        return;
      }
      banner.textContent = text;
      banner.className = `status ${kind}`.trim();
    };

    const showTable = (visible: boolean) => {
      if (tableWrap instanceof HTMLElement) {
        tableWrap.hidden = !visible;
      }
    };

    const fail = (message: string, requestId?: string, debug?: string) => {
      setBanner(message, "err");
      showTable(false);
      showErrorModal({
        message,
        requestId,
        details: requestId ? `request_id=${requestId}` : "",
        debug,
      });
    };

    const formatDate = (value: string) => {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) {
        return value;
      }
      return date.toLocaleString();
    };

    const metaItem = (label: string, value: string) => {
      const item = document.createElement("div");
      item.className = "admin-user-card__meta-item";
      const dt = document.createElement("dt");
      dt.textContent = label;
      const dd = document.createElement("dd");
      dd.textContent = value;
      item.append(dt, dd);
      return item;
    };

    const renderRows = (users: Array<{
      email: string;
      username: string;
      role: string;
      status: string;
      email_verified: boolean;
      id: string;
      admin_services?: string[];
      created_at: string;
    }>) => {
      if (!(body instanceof HTMLElement)) {
        return;
      }
      body.replaceChildren();
      for (const user of users) {
        const card = document.createElement("li");
        card.className = "admin-user-card";

        const head = document.createElement("header");
        head.className = "admin-user-card__head";
        const email = document.createElement("p");
        email.className = "admin-user-card__email";
        email.textContent = user.email;
        const username = document.createElement("p");
        username.className = "admin-user-card__username";
        username.textContent = user.username;
        head.append(email, username);

        const meta = document.createElement("dl");
        meta.className = "admin-user-card__meta";
        meta.append(
          metaItem("Role", user.role),
          metaItem("Status", user.status),
          metaItem("Verified", user.email_verified ? "yes" : "no"),
          metaItem("Created", formatDate(user.created_at)),
        );

        const access = document.createElement("div");
        access.className = "admin-users-services";
        const form = document.createElement("form");
        form.dataset.userServices = user.id;

        const legend = document.createElement("p");
        legend.className = "admin-users-services__legend";
        legend.textContent = "Service access";

        const chips = document.createElement("div");
        chips.className = "admin-users-services__chips";
        const granted = new Set(user.admin_services ?? []);
        for (const service of SERVICES) {
          const label = document.createElement("label");
          label.className = "admin-users-services__chip";
          const input = document.createElement("input");
          input.type = "checkbox";
          input.name = "service";
          input.value = service;
          input.checked = granted.has(service);
          const span = document.createElement("span");
          span.textContent = service;
          label.append(input, span);
          chips.append(label);
        }

        const save = document.createElement("button");
        save.type = "submit";
        save.textContent = "Save access";

        form.append(legend, chips, save);
        access.appendChild(form);
        card.append(head, meta, access);
        body.appendChild(card);
      }
      if (count instanceof HTMLElement) {
        count.textContent = `${users.length} registered user${users.length === 1 ? "" : "s"}.`;
      }
    };

    const loadUsers = async () => {
      setBanner("Loading users…");
      const result = await getAdminUsers();
      if (result.status === 401 || result.status === 403) {
        fail(result.data.message || "Unauthorized.", result.data.request_id, result.data.debug);
        document.querySelectorAll("[data-admin-only]").forEach((node) => node.setAttribute("hidden", ""));
        return;
      }
      if (result.status >= 400) {
        fail(result.data.message || "Could not load users.", result.data.request_id, result.data.debug);
        return;
      }
      const users = result.data.users ?? [];
      renderRows(users);
      showTable(true);
      setBanner("User list loaded.", "ok");
    };

    const applyMe = async () => {
      const { status, data, requestId } = await getMe();
      if (status === 401) {
        setBanner("Sign in with an administrator account.", "err");
        document.querySelectorAll("[data-admin-only]").forEach((node) => node.setAttribute("hidden", ""));
        showTable(false);
        return;
      }
      if (status !== 200) {
        fail(data.message || "Could not load the session.", data.request_id || requestId, data.debug);
        return;
      }
      if (data.role !== "admin") {
        setBanner("Unauthorized.", "err");
        document.querySelectorAll("[data-admin-only]").forEach((node) => node.setAttribute("hidden", ""));
        showTable(false);
        return;
      }
      document.querySelectorAll("[data-admin-only]").forEach((node) => node.removeAttribute("hidden"));
      await loadUsers();
    };

    void applyMe();

    refreshBtn?.addEventListener("click", () => {
      void loadUsers();
    });

    body?.addEventListener("submit", (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || !form.dataset.userServices) return;
      event.preventDefault();
      const services = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="service"]:checked')).map((input) => input.value);
      const saveButton = form.querySelector("button[type=submit]");
      if (saveButton instanceof HTMLButtonElement) {
        saveButton.disabled = true;
      }
      void (async () => {
        const result = await apiRequest<{ services?: string[] }>(`/admin/users/${encodeURIComponent(form.dataset.userServices || "")}/services`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ services }),
        });
        if (saveButton instanceof HTMLButtonElement) {
          saveButton.disabled = false;
        }
        if (result.status >= 400) {
          fail(result.data.message || "Could not update service access.", result.requestId, result.data.debug);
          return;
        }
        await loadUsers();
        setBanner("Service access updated.", "ok");
      })();
    });
  }
</script>
